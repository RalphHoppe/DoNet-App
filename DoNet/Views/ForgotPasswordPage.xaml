<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DoNet.Views.ForgotPasswordPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DoNet.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource AppBackgroundBrush}">

    <Page.Resources>
        <Storyboard x:Key="IntroStoryboard">
            <DoubleAnimation Storyboard.TargetName="ContentPanel"
                             Storyboard.TargetProperty="(UIElement.Opacity)"
                             From="0" To="1" Duration="0:0:0.30" />
            <DoubleAnimation Storyboard.TargetName="ContentPanel"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                             From="10" To="0" Duration="0:0:0.38">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Page.Resources>

    <Grid>
        <!-- Same fixed 352px column as the rest of the flow. -->
        <StackPanel x:Name="ContentPanel"
                    Width="352"
                    Margin="0,-24,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

            <StackPanel.RenderTransform>
                <TranslateTransform />
            </StackPanel.RenderTransform>

            <controls:DoNetLogo Width="118" HorizontalAlignment="Center" />

            <TextBlock Style="{StaticResource TitleTextStyle}"
                       Margin="0,26,0,0"
                       LineHeight="26"
                       LineStackingStrategy="BlockLineHeight"
                       Text="Forgot your password?" />

            <!--
                Left-aligned from here down. The copy is the substance of this screen,
                not a caption, so it reads as a block rather than being centred.
            -->
            <TextBlock Margin="0,28,0,0"
                       FontFamily="{StaticResource BalooSemiBoldFont}"
                       FontSize="{StaticResource BodyFontSize}"
                       LineHeight="20"
                       LineStackingStrategy="BlockLineHeight"
                       Foreground="{StaticResource DangerHeadingBrush}"
                       Text="Reset all data" />

            <!--
                One TextBlock with an explicit break, not two: the gap between the two
                sentences is the same as the gap between wrapped lines, so a second
                TextBlock would need its margin kept in sync with LineHeight by hand.
            -->
            <TextBlock Margin="0,10,0,0"
                       FontFamily="{StaticResource BalooFont}"
                       FontSize="{StaticResource BodyFontSize}"
                       LineHeight="22"
                       LineStackingStrategy="BlockLineHeight"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource DangerBodyBrush}">
                <Run Text="Use this only if you truly forgot your password, and you want to erase all data." />
                <LineBreak />
                <Run Text="Resetting deletes all your saved data and cannot be undone." />
            </TextBlock>

            <!--
                Collapsed unless the delete actually fails, which should not happen. It
                takes no space when hidden rather than reserving a slot, because an empty
                gap here would read as a layout mistake.
            -->
            <TextBlock Margin="0,14,0,0"
                       FontFamily="{StaticResource BalooFont}"
                       FontSize="{StaticResource NoticeFontSize}"
                       LineHeight="16"
                       LineStackingStrategy="BlockLineHeight"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource ErrorForegroundBrush}"
                       Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                       Visibility="{x:Bind ViewModel.HasError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

            <Button Margin="0,32,0,0"
                    Style="{StaticResource DangerButtonStyle}"
                    Command="{x:Bind ViewModel.ResetCommand}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Canvas Width="16" Height="16" VerticalAlignment="Center">
                        <Path Stretch="None"
                              Stroke="{StaticResource TextOnBrandBrush}"
                              StrokeThickness="1.3"
                              StrokeLineJoin="Round"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Data="M2.9,4.5 H13.1 M6.4,4.5 V3.3 A0.9,0.9 0 0 1 7.3,2.4 H8.7 A0.9,0.9 0 0 1 9.6,3.3 V4.5 M4.3,4.5 V13.1 A1.2,1.2 0 0 0 5.5,14.3 H10.5 A1.2,1.2 0 0 0 11.7,13.1 V4.5" />
                    </Canvas>
                    <!--
                        Font and tracking are restated rather than inherited from the
                        ContentPresenter: inheritance through a panel into a TextBlock is
                        reliable for Foreground but not worth gambling on for the caption.
                    -->
                    <TextBlock Margin="9,0,0,0"
                               VerticalAlignment="Center"
                               FontFamily="{StaticResource JerseyFont}"
                               FontSize="{StaticResource ButtonFontSize}"
                               CharacterSpacing="40"
                               Text="{x:Bind ViewModel.ResetLabel, Mode=OneWay}" />
                </StackPanel>
            </Button>

            <Button Margin="0,12,0,0"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Content="BACK TO LOCK SCREEN"
                    Command="{x:Bind ViewModel.BackToLockCommand}" />
        </StackPanel>
    </Grid>
</Page>
