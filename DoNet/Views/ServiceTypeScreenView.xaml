<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DoNet.Views.ServiceTypeScreenView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:DoNet.Views"
    mc:Ignorable="d">

    <!--
        One primary service type's screen: the directory skeleton with the
        type's own colours. The title, the ADD button's accents and the rail's
        back button all wear the type's gradient. The VPS - the first type
        whose fields arrived - fills the surface with its records; the other
        three are still the reference's empty screen: no placeholder art,
        nothing centred in the tab, just the header over the open space.
    -->

    <UserControl.Resources>

        <Style x:Key="SearchBoxStyle" TargetType="TextBox" BasedOn="{StaticResource BareTextBoxStyle}">
            <Setter Property="FontFamily" Value="{StaticResource BalooFont}" />
            <Setter Property="FontSize" Value="{StaticResource FieldValueFontSize}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header .......................................................... -->
        <Grid Grid.Row="0" Margin="0,0,0,24" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <!-- The type's name, in the type's gradient. Set from code:
                     the kind arrives after this view exists. -->
                <TextBlock x:Name="TitleText"
                           Text="SERVICES"
                           FontFamily="{StaticResource BaumansFont}"
                           FontSize="{StaticResource SectionTitleFontSize}"
                           CharacterSpacing="20"
                           TextTrimming="CharacterEllipsis"
                           LineStackingStrategy="BlockLineHeight"
                           LineHeight="36" />
                <TextBlock x:Name="SubtitleText"
                           Text=""
                           FontFamily="{StaticResource BalooFont}"
                           FontSize="{StaticResource SectionSubtitleFontSize}"
                           Foreground="{StaticResource SectionSubtitleBrush}"
                           TextTrimming="CharacterEllipsis"
                           LineStackingStrategy="BlockLineHeight"
                           LineHeight="20" />
            </StackPanel>

            <Grid Grid.Column="1" VerticalAlignment="Center" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border x:Name="SearchHost"
                        Grid.Column="0"
                        Width="304"
                        Height="42"
                        CornerRadius="21"
                        Padding="16,0,16,0"
                        Background="{StaticResource HeaderActionFillBrush}"
                        BorderBrush="{StaticResource SearchBorderBrush}"
                        BorderThickness="1">
                    <Border.Resources>
                        <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="Transparent" />

                        <!--
                            Without these the focused and pointer-over visual states
                            in the stock TextBox template set Foreground to the theme
                            brush, which on a machine running Windows in dark mode is
                            white - white text on a white card.
                        -->
                        <SolidColorBrush x:Key="TextControlForeground" Color="#2B2F33" />
                        <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#2B2F33" />
                        <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#2B2F33" />
                        <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="#8C9196" />
                        <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                        <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                        <Thickness x:Key="TextControlThemePadding">0</Thickness>
                        <x:Double x:Key="TextControlThemeMinHeight">0</x:Double>
                        <x:Double x:Key="TextControlThemeMinWidth">0</x:Double>
                    </Border.Resources>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Viewbox Grid.Column="0"
                                 Width="18"
                                 Height="18"
                                 VerticalAlignment="Center">
                            <Canvas Width="18" Height="18">
                                <Path Data="M13.5 8A5.5 5.5 0 1 1 2.5 8A5.5 5.5 0 1 1 13.5 8 M12.2 12.2L16 16"
                                      Stroke="{StaticResource SearchPlaceholderBrush}"
                                      StrokeThickness="1.8"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" />
                            </Canvas>
                        </Viewbox>

                        <!--
                            The directory's search, routed in code: the types
                            with fields each have a directory of their own, and
                            the box serves whichever screen is drilled in. On
                            the types still waiting for fields it sits idle,
                            exactly like the ADD button beside it.
                        -->
                        <TextBox x:Name="SearchInput"
                                 Grid.Column="1"
                                 Style="{StaticResource SearchBoxStyle}"
                                 PlaceholderText="SEARCH..."
                                 PlaceholderForeground="{StaticResource SearchPlaceholderBrush}"
                                 TextChanged="OnSearchInputChanged" />
                    </Grid>
                </Border>

                <!--
                    ADD <TYPE>: the type's colour on the accents. Awake for the
                    VPS, whose fields have arrived; asleep for the other three
                    until theirs do. The state is set from the kind in
                    code-behind, where the kind is known.
                -->
                <Button x:Name="AddRecordButton"
                        Grid.Column="1"
                        Style="{StaticResource BareButtonStyle}"
                        IsEnabled="False"
                        ToolTipService.ToolTip="Records arrive with the next step"
                        Click="OnAddRecordClick">
                    <Border CornerRadius="21"
                            Padding="14,0,18,0"
                            Height="42"
                            Background="{StaticResource HeaderActionFillBrush}"
                            BorderBrush="{StaticResource SearchBorderBrush}"
                            BorderThickness="1">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="10"
                                    VerticalAlignment="Center">
                            <Grid Width="18" Height="18" VerticalAlignment="Center">
                                <Rectangle x:Name="AddPlusFill"
                                           Width="18"
                                           Height="18"
                                           RadiusX="6"
                                           RadiusY="6"
                                           Fill="{StaticResource AddActionBorderBrush}" />
                                <Viewbox Width="18" Height="18">
                                    <Canvas Width="18" Height="18">
                                        <Path Data="M3.74951 8.99999H14.2507 M9.00011 3.74939V14.2506"
                                              Stroke="#FFFFFF"
                                              StrokeThickness="2"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round" />
                                    </Canvas>
                                </Viewbox>
                            </Grid>
                            <TextBlock x:Name="AddText"
                                       Text="ADD RECORD"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource JerseyFont}"
                                       FontSize="{StaticResource ButtonFontSize}"
                                       CharacterSpacing="40" />
                        </StackPanel>
                    </Border>
                </Button>
            </Grid>
        </Grid>

        <!--
            The records surface. The reference draws the header over open
            space; the directories that fill it arrive one type at a time, and
            the VPS - the first with fields - is deferred so it is only ever
            realized in a drill, where its repeater gets a measured viewport.
        -->
        <Grid x:Name="RecordsSurface" Grid.Row="1">
            <!--
                One list per type with fields, each deferred so it is only ever
                realized in its own drill, where its repeater gets a measured
                viewport.
            -->
            <views:VpsRecordsView x:Name="VpsList" x:Load="False" />
            <views:WalletsRecordsView x:Name="WalletsList" x:Load="False" />
        </Grid>
    </Grid>
</UserControl>
