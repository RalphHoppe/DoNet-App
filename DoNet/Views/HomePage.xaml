<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DoNet.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DoNet.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource AppBackgroundBrush}">

    <Page.Resources>
        <Storyboard x:Key="IntroStoryboard">
            <DoubleAnimation Storyboard.TargetName="Rail"
                             Storyboard.TargetProperty="(UIElement.Opacity)"
                             From="0" To="1" Duration="0:0:0.34" />
            <DoubleAnimation Storyboard.TargetName="RailSlide"
                             Storyboard.TargetProperty="X"
                             From="-26" To="0" Duration="0:0:0.42">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="ContentSurface"
                             Storyboard.TargetProperty="(UIElement.Opacity)"
                             From="0" To="1" BeginTime="0:0:0.08" Duration="0:0:0.40" />
            <DoubleAnimation Storyboard.TargetName="ContentScale"
                             Storyboard.TargetProperty="ScaleX"
                             From="0.985" To="1" BeginTime="0:0:0.08" Duration="0:0:0.46">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="ContentScale"
                             Storyboard.TargetProperty="ScaleY"
                             From="0.985" To="1" BeginTime="0:0:0.08" Duration="0:0:0.46">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Page.Resources>

    <Grid Padding="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="68" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Navigation rail ................................................... -->
        <Border x:Name="Rail"
                Grid.Column="0"
                Background="{StaticResource SidebarBackgroundBrush}"
                CornerRadius="20">
            <Border.RenderTransform>
                <TranslateTransform x:Name="RailSlide" />
            </Border.RenderTransform>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--
                    The ring from the lockup, on its own. Stroked rather than filled, so
                    the hole stays transparent: an Ellipse's stroke straddles its edge,
                    which makes the drawn diameter Width + StrokeThickness = 26.
                -->
                <Grid Grid.Row="0"
                      Width="26"
                      Height="26"
                      Margin="0,24,0,0"
                      HorizontalAlignment="Center">
                    <Ellipse Width="19"
                             Height="19"
                             StrokeThickness="7"
                             Stroke="{StaticResource BrandPrimaryBrush}" />
                </Grid>

                <StackPanel Grid.Row="1"
                            Margin="0,36,0,0"
                            Spacing="22"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top">

                    <controls:NavRailButton
                        Label="Services"
                        AccentBrush="{StaticResource NavSelectedBrush}"
                        IsSelected="{x:Bind ViewModel.IsServicesSelected, Mode=OneWay}"
                        Command="{x:Bind ViewModel.SelectServicesCommand}"
                        IconData="M4,5.9 H14 A2,2 0 0 1 16,7.9 V13.1 A2,2 0 0 1 14,15.1 H4 A2,2 0 0 1 2,13.1 V7.9 A2,2 0 0 1 4,5.9 Z M6.9,5.9 V4.5 A1.3,1.3 0 0 1 8.2,3.2 H9.8 A1.3,1.3 0 0 1 11.1,4.5 V5.9 M7.8,10.5 H10.2" />

                    <controls:NavRailButton
                        Label="Persons"
                        AccentBrush="{StaticResource NavSelectedBrush}"
                        IsSelected="{x:Bind ViewModel.IsPersonsSelected, Mode=OneWay}"
                        Command="{x:Bind ViewModel.SelectPersonsCommand}"
                        IconData="M9.3,6.2 A2.5,2.5 0 1 1 4.3,6.2 A2.5,2.5 0 1 1 9.3,6.2 Z M2.7,15.1 V14 C2.7,12.1 4.2,10.6 6.1,10.6 H7.5 C9.4,10.6 10.9,12.1 10.9,14 V15.1 M11.8,4.1 A2.5,2.5 0 0 1 11.8,8.3 M12.9,10.6 H13.3 C15.2,10.6 16.7,12.1 16.7,14 V15.1" />

                    <controls:NavRailButton
                        Label="Sites"
                        AccentBrush="{StaticResource NavSelectedBrush}"
                        IsSelected="{x:Bind ViewModel.IsSitesSelected, Mode=OneWay}"
                        Command="{x:Bind ViewModel.SelectSitesCommand}"
                        IconData="M9,15.6 C9,15.6 13.6,11.1 13.6,6.9 A4.6,4.6 0 1 0 4.4,6.9 C4.4,11.1 9,15.6 9,15.6 Z M10.9,6.8 A1.9,1.9 0 1 1 7.1,6.8 A1.9,1.9 0 1 1 10.9,6.8 Z" />
                </StackPanel>

                <!--
                    Permanently "selected" so it is always filled. It is an action, not a
                    destination, so it never takes part in the rail's selection.
                -->
                <controls:NavRailButton
                    Grid.Row="2"
                    Margin="0,0,0,16"
                    HorizontalAlignment="Center"
                    Label="Lock DoNet"
                    AccentBrush="{StaticResource LockActionBrush}"
                    IsSelected="True"
                    Command="{x:Bind ViewModel.LockCommand}"
                    IconData="M4.6,7.7 H13.4 A1.9,1.9 0 0 1 15.3,9.6 V13.5 A1.9,1.9 0 0 1 13.4,15.4 H4.6 A1.9,1.9 0 0 1 2.7,13.5 V9.6 A1.9,1.9 0 0 1 4.6,7.7 Z M5.7,7.7 V5.5 A3.3,3.3 0 0 1 12.3,5.5 V7.7 M9,10.6 V12.5" />
            </Grid>
        </Border>

        <!--
            Deliberately empty. The sections have no content yet, so this is the bare
            surface from the design; it becomes the host when those screens arrive.
        -->
        <Border x:Name="ContentSurface"
                Grid.Column="2"
                Background="{StaticResource ContentBackgroundBrush}"
                CornerRadius="20"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <ScaleTransform x:Name="ContentScale" ScaleX="1" ScaleY="1" />
            </Border.RenderTransform>
        </Border>
    </Grid>
</Page>
