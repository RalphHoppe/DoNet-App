<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DoNet.Views.VpsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:DoNet.Controls"
    mc:Ignorable="d">

    <!--
        The VPS record dialog: the hand-built form for the first primary type.

        One control serves all three modes - add, edit, preview - because they
        differ in which cells are editable and what the button says, not in what
        they contain. It is the person dialog's shape with two grids in it: the
        VPS's own fields, then the system information section. The system is not
        a picker - a system belongs to exactly one VPS and is created in the same
        form - so its fields are simply the second half of this one.

        The balance trio is the form's one piece of arithmetic and it lives in
        the view model: the exchange rate is one Bitcoin in the balance's
        currency, so typing the rate fills Bitcoin and typing Bitcoin fills the
        rate, whichever the user leaves for the form to do.
    -->

    <UserControl.Resources>

        <!-- The section label over the system grid, the tables' header voice. -->
        <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource BaumansFont}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="{StaticResource BrandPrimaryBrush}" />
            <Setter Property="CharacterSpacing" Value="20" />
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
            <Setter Property="LineHeight" Value="22" />
        </Style>

        <!-- The dialog's entrance: a short rise and settle under a fading scrim. -->
        <Storyboard x:Key="OpenStoryboard">
            <DoubleAnimation Storyboard.TargetName="Scrim"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.16" />
            <DoubleAnimation Storyboard.TargetName="CardOffset"
                             Storyboard.TargetProperty="Y"
                             From="18" To="0" Duration="0:0:0.26">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="CardScale"
                             Storyboard.TargetProperty="ScaleX"
                             From="0.985" To="1" Duration="0:0:0.26">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="CardScale"
                             Storyboard.TargetProperty="ScaleY"
                             From="0.985" To="1" Duration="0:0:0.26">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Card"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.20" />
        </Storyboard>

        <!--
            PREVIEW turning into the edit form. The cells are the same either
            way, so a hard swap reads as a glitch; a short dip and rise makes it
            read as the same panel changing state.
        -->
        <Storyboard x:Key="ModeChangeStoryboard">
            <DoubleAnimation Storyboard.TargetName="FieldHost"
                             Storyboard.TargetProperty="Opacity"
                             From="0.25" To="1" Duration="0:0:0.26">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="FieldShift"
                             Storyboard.TargetProperty="Y"
                             From="10" To="0" Duration="0:0:0.30">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="HeaderBlock"
                             Storyboard.TargetProperty="Opacity"
                             From="0.3" To="1" Duration="0:0:0.24" />
            <DoubleAnimation Storyboard.TargetName="FooterBlock"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.28" />
        </Storyboard>

        <Storyboard x:Key="CloseStoryboard" Completed="OnCloseCompleted">
            <DoubleAnimation Storyboard.TargetName="Scrim"
                             Storyboard.TargetProperty="Opacity"
                             To="0" Duration="0:0:0.14" />
            <DoubleAnimation Storyboard.TargetName="Card"
                             Storyboard.TargetProperty="Opacity"
                             To="0" Duration="0:0:0.14" />
            <DoubleAnimation Storyboard.TargetName="CardOffset"
                             Storyboard.TargetProperty="Y"
                             To="12" Duration="0:0:0.14">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

    </UserControl.Resources>

    <Grid x:Name="Root" Visibility="Collapsed"
          PreviewKeyDown="OnFieldKeyDown">

        <Rectangle x:Name="Scrim" Fill="#59000000" Tapped="OnScrimTapped" />

        <Border x:Name="Card"
                MaxWidth="1180"
                Margin="24"
                CornerRadius="26"
                Background="{StaticResource CardBackgroundBrush}"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1" />
                    <TranslateTransform x:Name="CardOffset" Y="0" />
                </TransformGroup>
            </Border.RenderTransform>

            <Grid Padding="40,32,40,28" RowSpacing="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header .................................................. -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel x:Name="HeaderBlock" Grid.Column="0">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="40"
                                     Height="40"
                                     Margin="0,0,14,0"
                                     VerticalAlignment="Center">
                                <controls:TypeMark Kind="Vps" />
                            </Viewbox>
                            <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                                       FontFamily="{StaticResource BaumansFont}"
                                       FontSize="{StaticResource SectionTitleFontSize}"
                                       Foreground="{StaticResource BrandPrimaryBrush}"
                                       CharacterSpacing="20"
                                       VerticalAlignment="Center"
                                       LineStackingStrategy="BlockLineHeight"
                                       LineHeight="40" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}"
                                   FontFamily="{StaticResource BalooFont}"
                                   FontSize="{StaticResource SectionSubtitleFontSize}"
                                   Foreground="{StaticResource SectionSubtitleBrush}"
                                   TextWrapping="Wrap"
                                   LineStackingStrategy="BlockLineHeight"
                                   LineHeight="20" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            VerticalAlignment="Top"
                            Style="{StaticResource BareButtonStyle}"
                            ToolTipService.ToolTip="Close"
                            Click="OnCloseClick">
                        <Border Width="22"
                                Height="22"
                                Margin="8"
                                CornerRadius="11"
                                Background="#FF5F57" />
                    </Button>
                </Grid>

                <!-- Fields ................................................... -->
                <!--
                    Thirty-three cells in one scrolling host: the form is taller
                    than some windows are, and a dialog that grows past the screen
                    is not a dialog that works at all sizes.
                -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollMode="Disabled">
                    <StackPanel x:Name="FieldHost" Spacing="24">
                        <StackPanel.RenderTransform>
                            <TranslateTransform x:Name="FieldShift" Y="0" />
                        </StackPanel.RenderTransform>

                        <!--
                            The VPS's own fields, in the workbook's order, read like a
                            page: left to right, top to bottom - the person, site and
                            account the VPS hangs off, then its name, then its money,
                            its dates, its cycle, its node, its country, its note.
                            The units are not fields of their own: the currency hangs
                            off the balance and the d/w/m/y off the cycle, inside the
                            same box, so no one has to guess whose currency it is.

                            No RowSpacing: the rows below the wide layout's last stay
                            empty for the narrow state to fill, and spacing between
                            empty rows is dead height. The gap between two rows is
                            the cells' own bottom margin instead.
                        -->
                        <Grid x:Name="FieldGrid">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="ColLeft" Width="*" />
                                <ColumnDefinition x:Name="ColMiddle" Width="*" />
                                <ColumnDefinition x:Name="ColRight" Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <controls:FieldCell x:Name="RecordIdCell"
                              Grid.Row="0"
                              Grid.Column="0"
                              Margin="0,0,0,16"
                              VerticalAlignment="Top"
                              Label="#"
                              IconKind="Hash"
                              Placeholder="Assigned on save"
                              Value="{x:Bind ViewModel.IdDisplay, Mode=TwoWay}"
                              Kind="{x:Bind ViewModel.AutoFieldKind, Mode=OneWay}"
                              ShowCopy="{x:Bind ViewModel.IsPreview, Mode=OneWay}" />

                            <controls:FieldCell x:Name="PersonCell"
                              Grid.Row="0"
                              Grid.Column="1"
                              Margin="0,0,0,16"
                              VerticalAlignment="Top"
                              Label="PERSON"
                              IconKind="User"
                              TabOrder="1"
                              Placeholder="Pick a person"
                              Value="{x:Bind ViewModel.PersonLabel, Mode=TwoWay}"
                              InputKind="Choice"
                              Options="{x:Bind ViewModel.PersonOptions, Mode=OneWay}"
                              Kind="{x:Bind ViewModel.FieldKind, Mode=OneWay}"
                              ShowCopy="{x:Bind ViewModel.IsPreview, Mode=OneWay}" />

                            <controls:FieldCell x:Name="SiteCell"
                              Grid.Row="0"
                              Grid.Column="2"
                              Margin="0,0,0,16"
                              VerticalAlignment="Top"
                              Label="SITE"
                              IconKind="Globe"
                              TabOrder="2"
                              Placeholder="Pick a site"
                              Value="{x:Bind ViewModel.SiteLabel, Mode=TwoWay}"
                              InputKind="Choice"
                              Options="{x:Bind ViewModel.SiteOptions, Mode=OneWay}"
                              Kind="{x:Bind ViewModel.FieldKind, Mode=OneWay}"
                              ShowCopy="{x:Bind ViewModel.IsPreview, Mode=OneWay}" />

                            <controls:FieldCell x:Name="AccountCell"
                              Grid.Row="1"
                              Grid.Column="0"
                              Margin="0,0,0,16"
                              VerticalAlignment="Top"
                              Label="ACCOUNT"
                              IconKind="Account"
                              TabOrder="3"
                              Placeholder="Pick an account"
                              Value="{x:Bind ViewModel.AccountLabel, Mode=TwoWay}"
                              InputKind="Choice"
                              Options="{x:Bind ViewModel.AccountOptions, Mode=OneWay}"
                              Kind="{x:Bind ViewModel.FieldKind, Mode=OneWay}"
                              ShowCopy="{x:Bind ViewModel.IsPreview, Mode=OneWay}" />

                            <controls:FieldCell x:Name="NameCell"
                              Grid.Row="1"
                              Grid.Column="1"
                              Margin="0,0,0,16"
                              VerticalAlignment="Top"
                              Label="VPS NAME"
                              IconKind="Tag"
                              TabOrder="4"
                              Placeholder="Enter the VPS name"
                              Value="{x:Bind ViewModel.Name, Mode=TwoWay}"
                              Kind="{x:Bind ViewModel.FieldKind, Mode=OneWay}"
                              ShowCopy="{x:Bind ViewModel.IsPreview, Mode=OneWay}" />

                            <controls:FieldCell x:Name="BalanceCell"
                              Grid.Row="1"
                              Grid.Column="2"
                              Margin="0,0,0,16"
                              VerticalAlignment="Top"
                              Label="BALANCE"
                              IconKind="CreditCard"
                              TabOrder="5"
                              Placeholder="Enter the balance"
                              Value="{x:Bind ViewModel.BalanceText, Mode=TwoWay}"
                              UnitOptions="{x:Bind ViewModel.CurrencyOptions, Mode=OneWay}"
                              UnitValue="{x:Bind ViewModel.CurrencyLabel, Mode=TwoWay}"
                              UnitPlaceholder="Currency"
                              Kind="{x:Bind ViewModel.FieldKind, Mode=OneWay}"
                              ShowCopy="{x:Bind ViewModel.IsPreview, Mode=OneWay}" />

                            <controls:FieldCell x:Name="BtcCell"
                              Grid.Row="2"
                              Grid.Column="0"
                              Margin="0,0,0,16"
                              VerticalAlignment="Top"
                              Label="BALANCE IN BTC"
                              IconKind="Hash"
                              TabOrder="6"
                              Placeholder="Typed or filled from the rate"
                              Value="{x:Bind ViewModel.BtcText, Mode=TwoWay}"
                              Kind="{x:Bind ViewModel.FieldKind, Mode=OneWay}"
                              ShowCopy="{x:Bind ViewModel.IsPreview, Mode=OneWay}" />

                            <controls:FieldCell x:Name="RateCell"
                              Grid.Row="2"
                              Grid.Column="1"
                              Margin="0,0,0,16"
                              VerticalAlignment="Top"
                              Label="EXCHANGE-RATE"
                              IconKind="Hash"
                              TabOrder="7"
                              Placeholder="In the currency"
                              Value="{x:Bind ViewModel.RateText, Mode=TwoWay}"
                              PrefixText="1 BTC ="
                              Kind="{x:Bind ViewModel.FieldKind, Mode=OneWay}"
                              ShowCopy="{x:Bind ViewModel.IsPreview, Mode=OneWay}" />

                            <controls:FieldCell x:Name="CreatedCell"
                              Grid.Row="2"
                              Grid.Column="2"
                              Margin="0,0,0,16"
                              VerticalAlignment="Top"
                              Label="CREATED AT"
                              IconKind="Clock"
                              TabOrder="8"
                              Value="{x:Bind ViewModel.CreatedAt, Mode=TwoWay}"
                              InputKind="Date"
                              Kind="{x:Bind ViewModel.FieldKind, Mode=OneWay}"
                              ShowCopy="{x:Bind ViewModel.IsPreview, Mode=OneWay}" />

                            <controls:FieldCell x:Name="OutCell"
                              Grid.Row="3"
                              Grid.Column="0"
                              Margin="0,0,0,16"
                              VerticalAlignment="Top"
                              Label="OUT DATE"
                              IconKind="Calendar"
                              TabOrder="9"
                              Value="{x:Bind ViewModel.OutDate, Mode=TwoWay}"
                              InputKind="Date"
                              Kind="{x:Bind ViewModel.FieldKind, Mode=OneWay}"
                              ShowCopy="{x:Bind ViewModel.IsPreview, Mode=OneWay}" />

                            <controls:FieldCell x:Name="CycleCell"
                              Grid.Row="3"
                              Grid.Column="1"
                              Margin="0,0,0,16"
                              VerticalAlignment="Top"
                              Label="SUBSCRIPTION CYCLE"
                              IconKind="Calendar"
                              TabOrder="10"
                              Placeholder="Enter the number"
                              Value="{x:Bind ViewModel.CycleValueText, Mode=TwoWay}"
                              UnitOptions="{x:Bind ViewModel.CycleUnitOptions, Mode=OneWay}"
                              UnitValue="{x:Bind ViewModel.CycleUnitLabel, Mode=TwoWay}"
                              UnitPlaceholder="Unit"
                              Kind="{x:Bind ViewModel.FieldKind, Mode=OneWay}"
                              ShowCopy="{x:Bind ViewModel.IsPreview, Mode=OneWay}" />

                            <controls:FieldCell x:Name="NodeCell"
                              Grid.Row="3"
                              Grid.Column="2"
                              Margin="0,0,0,16"
                              VerticalAlignment="Top"
                              Label="NODE"
                              IconKind="Briefcase"
                              TabOrder="11"
                              Placeholder="Pick the VPS this one connects to"
                              Value="{x:Bind ViewModel.NodeLabel, Mode=TwoWay}"
                              InputKind="Choice"
                              Options="{x:Bind ViewModel.NodeOptions, Mode=OneWay}"
                              Kind="{x:Bind ViewModel.FieldKind, Mode=OneWay}"
                              ShowCopy="{x:Bind ViewModel.IsPreview, Mode=OneWay}" />

                            <controls:FieldCell x:Name="CountryCell"
                              Grid.Row="4"
                              Grid.Column="0"
                              Margin="0,0,0,16"
                              VerticalAlignment="Top"
                              Label="COUNTRY"
                              IconKind="GlobeMeridian"
                              TabOrder="12"
                              Placeholder="Enter the country"
                              Value="{x:Bind ViewModel.Country, Mode=TwoWay}"
                              InputKind="Country"
                              Kind="{x:Bind ViewModel.FieldKind, Mode=OneWay}"
                              ShowCopy="{x:Bind ViewModel.IsPreview, Mode=OneWay}" />

                            <controls:FieldCell x:Name="NoteCell"
                              Grid.Row="4"
                              Grid.Column="1"
                              Grid.ColumnSpan="2"
                              Margin="0"
                              VerticalAlignment="Top"
                              Label="NOTE"
                              IconKind="Info"
                              TabOrder="13"
                              Placeholder="Anything worth remembering"
                              Value="{x:Bind ViewModel.Note, Mode=TwoWay}"
                              InputKind="Multiline"
                              Kind="{x:Bind ViewModel.FieldKind, Mode=OneWay}"
                              ShowCopy="{x:Bind ViewModel.IsPreview, Mode=OneWay}" />
                        </Grid>

                        <!-- The system section, its own grid under the VPS's. -->
                        <TextBlock Text="SYSTEM INFORMATION"
                                   Style="{StaticResource SectionLabelStyle}" />

                        <!--
                            The system underneath, same rule: the workbook's order,
                            left to right, top to bottom. The port's number hangs off
                            its protocol as a typed unit - "SSH | 55475" is one fact,
                            not two fields that happen to be neighbours.
                        -->
                        <Grid x:Name="SystemGrid">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="SysColLeft" Width="*" />
                                <ColumnDefinition x:Name="SysColMiddle" Width="*" />
                                <ColumnDefinition x:Name="SysColRight" Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <controls:FieldCell x:Name="SystemIdCell"
                              Grid.Row="0"
                              Grid.Column="0"
                              Margin="0,0,0,16"
                              VerticalAlignment="Top"
                              Label="#"
                              IconKind="Hash"
                              Placeholder="Assigned with the VPS"
                              Value="{x:Bind ViewModel.SystemIdDisplay, Mode=TwoWay}"
                              Kind="{x:Bind ViewModel.AutoFieldKind, Mode=OneWay}"
                              ShowCopy="{x:Bind ViewModel.IsPreview, Mode=OneWay}" />

                            <controls:FieldCell x:Name="OsCell"
                              Grid.Row="0"
                              Grid.Column="1"
                              Margin="0,0,0,16"
                              VerticalAlignment="Top"
                              Label="OS"
                              IconKind="Info"
                              TabOrder="14"
                              Placeholder="e.g. Debian 12"
                              Value="{x:Bind ViewModel.Os, Mode=TwoWay}"
                              Kind="{x:Bind ViewModel.FieldKind, Mode=OneWay}"
                              ShowCopy="{x:Bind ViewModel.IsPreview, Mode=OneWay}" />

                            <controls:FieldCell x:Name="IpCell"
                              Grid.Row="0"
                              Grid.Column="2"
                              Margin="0,0,0,16"
                              VerticalAlignment="Top"
                              Label="IP ADDRESS"
                              IconKind="Globe"
                              TabOrder="15"
                              Placeholder="Enter the address"
                              Value="{x:Bind ViewModel.Ip, Mode=TwoWay}"
                              Kind="{x:Bind ViewModel.FieldKind, Mode=OneWay}"
                              ShowCopy="{x:Bind ViewModel.IsPreview, Mode=OneWay}" />

                            <controls:FieldCell x:Name="PortCell"
                              Grid.Row="1"
                              Grid.Column="0"
                              Margin="0,0,0,16"
                              VerticalAlignment="Top"
                              Label="PORT"
                              IconKind="Key"
                              TabOrder="16"
                              Placeholder="e.g. SSH"
                              Value="{x:Bind ViewModel.Port, Mode=TwoWay}"
                              UnitIsText="True"
                              UnitValue="{x:Bind ViewModel.PortNumber, Mode=TwoWay}"
                              UnitPlaceholder="e.g. 55475"
                              Kind="{x:Bind ViewModel.FieldKind, Mode=OneWay}"
                              ShowCopy="{x:Bind ViewModel.IsPreview, Mode=OneWay}" />

                            <controls:FieldCell x:Name="UsernameCell"
                              Grid.Row="1"
                              Grid.Column="1"
                              Margin="0,0,0,16"
                              VerticalAlignment="Top"
                              Label="USERNAME"
                              IconKind="User"
                              TabOrder="18"
                              Placeholder="Enter the login user"
                              Value="{x:Bind ViewModel.Username, Mode=TwoWay}"
                              Kind="{x:Bind ViewModel.FieldKind, Mode=OneWay}"
                              ShowCopy="{x:Bind ViewModel.IsPreview, Mode=OneWay}" />

                            <controls:FieldCell x:Name="UserPasswordCell"
                              Grid.Row="1"
                              Grid.Column="2"
                              Margin="0,0,0,16"
                              VerticalAlignment="Top"
                              Label="USER PASSWORD"
                              IconKind="Lock"
                              TabOrder="19"
                              Placeholder="Enter the password"
                              Value="{x:Bind ViewModel.UserPassword, Mode=TwoWay}"
                              IsSecret="True"
                              ShowGenerate="{x:Bind ViewModel.IsEditing, Mode=OneWay}"
                              Kind="{x:Bind ViewModel.FieldKind, Mode=OneWay}"
                              ShowCopy="{x:Bind ViewModel.IsPreview, Mode=OneWay}" />

                            <controls:FieldCell x:Name="RootUserCell"
                              Grid.Row="2"
                              Grid.Column="0"
                              Margin="0,0,0,16"
                              VerticalAlignment="Top"
                              Label="ROOT USER"
                              IconKind="User"
                              TabOrder="20"
                              Placeholder="e.g. root"
                              Value="{x:Bind ViewModel.RootUser, Mode=TwoWay}"
                              Kind="{x:Bind ViewModel.FieldKind, Mode=OneWay}"
                              ShowCopy="{x:Bind ViewModel.IsPreview, Mode=OneWay}" />

                            <controls:FieldCell x:Name="RootPasswordCell"
                              Grid.Row="2"
                              Grid.Column="1"
                              Margin="0,0,0,16"
                              VerticalAlignment="Top"
                              Label="ROOT PASSWORD"
                              IconKind="Lock"
                              TabOrder="21"
                              Placeholder="Enter the root password"
                              Value="{x:Bind ViewModel.RootPassword, Mode=TwoWay}"
                              IsSecret="True"
                              ShowGenerate="{x:Bind ViewModel.IsEditing, Mode=OneWay}"
                              Kind="{x:Bind ViewModel.FieldKind, Mode=OneWay}"
                              ShowCopy="{x:Bind ViewModel.IsPreview, Mode=OneWay}" />

                            <controls:FieldCell x:Name="CpuCell"
                              Grid.Row="2"
                              Grid.Column="2"
                              Margin="0,0,0,16"
                              VerticalAlignment="Top"
                              Label="CPU"
                              IconKind="Info"
                              TabOrder="22"
                              Placeholder="e.g. Intel Xeon E-2388G"
                              Value="{x:Bind ViewModel.Cpu, Mode=TwoWay}"
                              Kind="{x:Bind ViewModel.FieldKind, Mode=OneWay}"
                              ShowCopy="{x:Bind ViewModel.IsPreview, Mode=OneWay}" />

                            <controls:FieldCell x:Name="MemoryCell"
                              Grid.Row="3"
                              Grid.Column="0"
                              Margin="0,0,0,16"
                              VerticalAlignment="Top"
                              Label="MEMORY (RAM)"
                              IconKind="Info"
                              TabOrder="23"
                              Placeholder="e.g. 32 GB DDR5"
                              Value="{x:Bind ViewModel.Memory, Mode=TwoWay}"
                              Kind="{x:Bind ViewModel.FieldKind, Mode=OneWay}"
                              ShowCopy="{x:Bind ViewModel.IsPreview, Mode=OneWay}" />

                            <controls:FieldCell x:Name="DiskCell"
                              Grid.Row="3"
                              Grid.Column="1"
                              Margin="0,0,0,16"
                              VerticalAlignment="Top"
                              Label="DISK"
                              IconKind="Info"
                              TabOrder="24"
                              Placeholder="e.g. 2 TB"
                              Value="{x:Bind ViewModel.Disk, Mode=TwoWay}"
                              Kind="{x:Bind ViewModel.FieldKind, Mode=OneWay}"
                              ShowCopy="{x:Bind ViewModel.IsPreview, Mode=OneWay}" />

                            <controls:FieldCell x:Name="BandwidthCell"
                              Grid.Row="3"
                              Grid.Column="2"
                              Margin="0,0,0,16"
                              VerticalAlignment="Top"
                              Label="BANDWIDTH"
                              IconKind="Info"
                              TabOrder="25"
                              Placeholder="e.g. 290 Gbps"
                              Value="{x:Bind ViewModel.Bandwidth, Mode=TwoWay}"
                              Kind="{x:Bind ViewModel.FieldKind, Mode=OneWay}"
                              ShowCopy="{x:Bind ViewModel.IsPreview, Mode=OneWay}" />

                            <controls:FieldCell x:Name="BandwidthSpeedCell"
                              Grid.Row="4"
                              Grid.Column="0"
                              Margin="0,0,0,16"
                              VerticalAlignment="Top"
                              Label="BANDWIDTH SPEED"
                              IconKind="Info"
                              TabOrder="26"
                              Placeholder="e.g. 1 Gbps"
                              Value="{x:Bind ViewModel.BandwidthSpeed, Mode=TwoWay}"
                              Kind="{x:Bind ViewModel.FieldKind, Mode=OneWay}"
                              ShowCopy="{x:Bind ViewModel.IsPreview, Mode=OneWay}" />

                            <controls:FieldCell x:Name="UploadCell"
                              Grid.Row="4"
                              Grid.Column="1"
                              Margin="0,0,0,16"
                              VerticalAlignment="Top"
                              Label="UPLOAD SPEED"
                              IconKind="Info"
                              TabOrder="27"
                              Placeholder="e.g. 316 Mb"
                              Value="{x:Bind ViewModel.UploadSpeed, Mode=TwoWay}"
                              Kind="{x:Bind ViewModel.FieldKind, Mode=OneWay}"
                              ShowCopy="{x:Bind ViewModel.IsPreview, Mode=OneWay}" />

                            <controls:FieldCell x:Name="DownloadCell"
                              Grid.Row="4"
                              Grid.Column="2"
                              Margin="0,0,0,16"
                              VerticalAlignment="Top"
                              Label="DOWNLOAD SPEED"
                              IconKind="Info"
                              TabOrder="28"
                              Placeholder="e.g. 952 Mb"
                              Value="{x:Bind ViewModel.DownloadSpeed, Mode=TwoWay}"
                              Kind="{x:Bind ViewModel.FieldKind, Mode=OneWay}"
                              ShowCopy="{x:Bind ViewModel.IsPreview, Mode=OneWay}" />

                            <controls:FieldCell x:Name="PingCell"
                              Grid.Row="5"
                              Grid.Column="0"
                              Margin="0,0,0,16"
                              VerticalAlignment="Top"
                              Label="PING TIME"
                              IconKind="Clock"
                              TabOrder="29"
                              Placeholder="e.g. 22 Sec"
                              Value="{x:Bind ViewModel.PingTime, Mode=TwoWay}"
                              Kind="{x:Bind ViewModel.FieldKind, Mode=OneWay}"
                              ShowCopy="{x:Bind ViewModel.IsPreview, Mode=OneWay}" />

                            <controls:FieldCell x:Name="SystemNoteCell"
                              Grid.Row="5"
                              Grid.Column="1"
                              Grid.ColumnSpan="2"
                              Margin="0"
                              VerticalAlignment="Top"
                              Label="NOTE"
                              IconKind="Info"
                              TabOrder="30"
                              Placeholder="Anything worth remembering"
                              Value="{x:Bind ViewModel.SystemNote, Mode=TwoWay}"
                              InputKind="Multiline"
                              Kind="{x:Bind ViewModel.FieldKind, Mode=OneWay}"
                              ShowCopy="{x:Bind ViewModel.IsPreview, Mode=OneWay}" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- Footer .................................................. -->
                <Grid x:Name="FooterBlock" Grid.Row="2" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               VerticalAlignment="Center"
                               Text="The record saves with its system information; the name is the one required field."
                               Visibility="{x:Bind ViewModel.IsEditing, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                               FontFamily="{StaticResource BalooFont}"
                               FontSize="{StaticResource FieldValueFontSize}"
                               Foreground="{StaticResource CardMetaBrush}" />

                    <!-- Preview: one full-width action. -->
                    <Button x:Name="PreviewAction"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            HorizontalAlignment="Stretch"
                            Visibility="{x:Bind ViewModel.IsPreview, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                            Style="{StaticResource BareButtonStyle}"
                            Click="OnPrimaryClick">
                        <Border Height="52"
                                CornerRadius="26"
                                Background="{StaticResource BrandPrimaryBrush}">
                            <TextBlock Text="{x:Bind ViewModel.PrimaryActionText, Mode=OneWay}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource JerseyFont}"
                                       FontSize="{StaticResource ButtonFontSize}"
                                       Foreground="#FFFFFF"
                                       CharacterSpacing="40" />
                        </Border>
                    </Button>

                    <!-- Add and edit: cancel plus the commit. -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="14"
                                Visibility="{x:Bind ViewModel.IsEditing, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <Button Style="{StaticResource BareButtonStyle}" Click="OnCancelClick">
                            <Border Height="52"
                                    MinWidth="150"
                                    CornerRadius="26"
                                    Background="{StaticResource CardBackgroundBrush}"
                                    BorderBrush="{StaticResource SearchBorderBrush}"
                                    BorderThickness="1">
                                <TextBlock Text="CANCEL"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontFamily="{StaticResource JerseyFont}"
                                           FontSize="{StaticResource ButtonFontSize}"
                                           Foreground="{StaticResource CardMetaBrush}"
                                           CharacterSpacing="40" />
                            </Border>
                        </Button>

                        <Button Style="{StaticResource BareButtonStyle}"
                                IsEnabled="{x:Bind ViewModel.CanSave, Mode=OneWay}"
                                Click="OnPrimaryClick">
                            <Border Height="52"
                                    MinWidth="210"
                                    CornerRadius="26"
                                    Background="{StaticResource BrandPrimaryBrush}">
                                <TextBlock Text="{x:Bind ViewModel.PrimaryActionText, Mode=OneWay}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontFamily="{StaticResource JerseyFont}"
                                           FontSize="{StaticResource ButtonFontSize}"
                                           Foreground="#FFFFFF"
                                           CharacterSpacing="40" />
                            </Border>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!--
            Below 1000 the three columns cannot hold a readable field box, so the
            form becomes a single scrolling list. The cells are placed, not
            stacked: each one is moved to its reading-order row in the one
            remaining column, so the narrow form reads in the same order the
            wide one does - the workbook's - rather than column by column.
        -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="DialogWidthStates">
                <VisualState x:Name="DialogWide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1000" />
                    </VisualState.StateTriggers>
                </VisualState>

                <VisualState x:Name="DialogNarrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ColMiddle.Width" Value="0" />
                        <Setter Target="ColRight.Width" Value="0" />
                        <Setter Target="FieldGrid.ColumnSpacing" Value="0" />
                        <Setter Target="PersonCell.(Grid.Row)" Value="1" />
                        <Setter Target="PersonCell.(Grid.Column)" Value="0" />
                        <Setter Target="SiteCell.(Grid.Row)" Value="2" />
                        <Setter Target="SiteCell.(Grid.Column)" Value="0" />
                        <Setter Target="AccountCell.(Grid.Row)" Value="3" />
                        <Setter Target="NameCell.(Grid.Row)" Value="4" />
                        <Setter Target="NameCell.(Grid.Column)" Value="0" />
                        <Setter Target="BalanceCell.(Grid.Row)" Value="5" />
                        <Setter Target="BalanceCell.(Grid.Column)" Value="0" />
                        <Setter Target="BtcCell.(Grid.Row)" Value="6" />
                        <Setter Target="RateCell.(Grid.Row)" Value="7" />
                        <Setter Target="RateCell.(Grid.Column)" Value="0" />
                        <Setter Target="CreatedCell.(Grid.Row)" Value="8" />
                        <Setter Target="CreatedCell.(Grid.Column)" Value="0" />
                        <Setter Target="OutCell.(Grid.Row)" Value="9" />
                        <Setter Target="CycleCell.(Grid.Row)" Value="10" />
                        <Setter Target="CycleCell.(Grid.Column)" Value="0" />
                        <Setter Target="NodeCell.(Grid.Row)" Value="11" />
                        <Setter Target="NodeCell.(Grid.Column)" Value="0" />
                        <Setter Target="CountryCell.(Grid.Row)" Value="12" />
                        <Setter Target="NoteCell.(Grid.Row)" Value="13" />
                        <Setter Target="NoteCell.(Grid.Column)" Value="0" />
                        <Setter Target="SysColMiddle.Width" Value="0" />
                        <Setter Target="SysColRight.Width" Value="0" />
                        <Setter Target="SystemGrid.ColumnSpacing" Value="0" />
                        <Setter Target="OsCell.(Grid.Row)" Value="1" />
                        <Setter Target="OsCell.(Grid.Column)" Value="0" />
                        <Setter Target="IpCell.(Grid.Row)" Value="2" />
                        <Setter Target="IpCell.(Grid.Column)" Value="0" />
                        <Setter Target="PortCell.(Grid.Row)" Value="3" />
                        <Setter Target="UsernameCell.(Grid.Row)" Value="4" />
                        <Setter Target="UsernameCell.(Grid.Column)" Value="0" />
                        <Setter Target="UserPasswordCell.(Grid.Row)" Value="5" />
                        <Setter Target="UserPasswordCell.(Grid.Column)" Value="0" />
                        <Setter Target="RootUserCell.(Grid.Row)" Value="6" />
                        <Setter Target="RootPasswordCell.(Grid.Row)" Value="7" />
                        <Setter Target="RootPasswordCell.(Grid.Column)" Value="0" />
                        <Setter Target="CpuCell.(Grid.Row)" Value="8" />
                        <Setter Target="CpuCell.(Grid.Column)" Value="0" />
                        <Setter Target="MemoryCell.(Grid.Row)" Value="9" />
                        <Setter Target="DiskCell.(Grid.Row)" Value="10" />
                        <Setter Target="DiskCell.(Grid.Column)" Value="0" />
                        <Setter Target="BandwidthCell.(Grid.Row)" Value="11" />
                        <Setter Target="BandwidthCell.(Grid.Column)" Value="0" />
                        <Setter Target="BandwidthSpeedCell.(Grid.Row)" Value="12" />
                        <Setter Target="UploadCell.(Grid.Row)" Value="13" />
                        <Setter Target="UploadCell.(Grid.Column)" Value="0" />
                        <Setter Target="DownloadCell.(Grid.Row)" Value="14" />
                        <Setter Target="DownloadCell.(Grid.Column)" Value="0" />
                        <Setter Target="PingCell.(Grid.Row)" Value="15" />
                        <Setter Target="SystemNoteCell.(Grid.Row)" Value="16" />
                        <Setter Target="SystemNoteCell.(Grid.Column)" Value="0" />
                        <Setter Target="Card.Margin" Value="12" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</UserControl>
