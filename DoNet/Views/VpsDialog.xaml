                              Kind="{x:Bind ViewModel.FieldKind, Mode=OneWay}"
                              ShowCopy="{x:Bind ViewModel.IsPreview, Mode=OneWay}" />
                        </Grid>
                    </StackPanel>

                    <!--
                        The information view: not the form with the inputs greyed
                        out, but the record as a sheet of its own. A hero says
                        whose record this is; the sections group what it means -
                        the money, the records it hangs off, the machine under
                        it, the notes - so a reader finds what they came for
                        instead of walking a form's order.
                    -->
                    <StackPanel x:Name="PreviewHost" Spacing="24"
                                Visibility="{x:Bind ViewModel.IsPreview, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" >

                        <!-- The hero: the mark, the name, and where the record sits. -->
                        <Grid ColumnSpacing="18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Viewbox Grid.Column="0"
                                     Width="56"
                                     Height="56"
                                     VerticalAlignment="Center">
                                <controls:TypeMark Kind="Vps" />
                            </Viewbox>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                <TextBlock Text="{x:Bind ViewModel.Name, Mode=OneWay}"
                                           FontFamily="{StaticResource BalooSemiBoldFont}"
                                           FontSize="22"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           LineStackingStrategy="BlockLineHeight"
                                           LineHeight="28" />
                                <TextBlock Text="{x:Bind ViewModel.HeroCaption, Mode=OneWay}"
                                           FontFamily="{StaticResource BalooFont}"
                                           FontSize="{StaticResource CardMetaFontSize}"
                                           Foreground="{StaticResource CardMetaBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           LineStackingStrategy="BlockLineHeight"
                                           LineHeight="18" />
                            </StackPanel>
                        </Grid>

                        <!-- The money: what it holds and what it costs. -->
                        <TextBlock Text="BALANCE &amp; PAYMENTS"
                                   Style="{StaticResource SectionLabelStyle}" />
                        <Grid x:Name="PvMoneyGrid" ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        
                                                    <controls:FieldCell x:Name="PvBalanceCell"
                              Grid.Row="0"
                              Grid.Column="0"
                              Margin="0,0,0,16"
                              VerticalAlignment="Top"
                              Label="BALANCE"
                              IconKind="CreditCard"
                              Value="{x:Bind ViewModel.BalanceText, Mode=OneWay}"
                              UnitValue="{x:Bind ViewModel.CurrencyCode, Mode=OneWay}"
                              Kind="Display"
                              ShowCopy="True" />
                        
                                                    <controls:FieldCell x:Name="PvBtcCell"
                              Grid.Row="0"
                              Grid.Column="1"
                              Margin="0,0,0,16"
                              VerticalAlignment="Top"
                              Label="BALANCE IN BTC"
                              IconKind="Bitcoin"
                              Value="{x:Bind ViewModel.BtcText, Mode=OneWay}"
                              Kind="Display"
                              ShowCopy="True" />
                        
                                                    <controls:FieldCell x:Name="PvRateCell"
                              Grid.Row="1"
                              Grid.Column="0"
                              Margin="0,0,0,16"
                              VerticalAlignment="Top"
                              Label="EXCHANGE-RATE"
                              IconKind="Bitcoin"
                              Value="{x:Bind ViewModel.RateText, Mode=OneWay}"
                              PrefixText="1 BTC ="
                              Kind="Display"
                              ShowCopy="True" />
                        
                                                    <controls:FieldCell x:Name="PvCycleCell"
                              Grid.Row="1"
                              Grid.Column="1"
                              Margin="0,0,0,16"
                              VerticalAlignment="Top"
                              Label="SUBSCRIPTION CYCLE"
                              IconKind="Calendar"
                              Value="{x:Bind ViewModel.CycleValueText, Mode=OneWay}"
                              UnitValue="{x:Bind ViewModel.CycleUnitCode, Mode=OneWay}"
                              Kind="Display"
                              ShowCopy="True" />
                        
                                                    <controls:FieldCell x:Name="PvCreatedCell"
                              Grid.Row="2"
                              Grid.Column="0"
                              Margin="0,0,0,16"
                              VerticalAlignment="Top"
                              Label="CREATED AT"
                              IconKind="Clock"
                              Value="{x:Bind ViewModel.CreatedAt, Mode=OneWay}"
                              Kind="Display"
                              ShowCopy="True" />
                        
                                                    <controls:FieldCell x:Name="PvOutCell"
                              Grid.Row="2"
                              Grid.Column="1"
                              Margin="0,0,0,16"
                              VerticalAlignment="Top"
                              Label="OUT DATE"
                              IconKind="Calendar"
                              Value="{x:Bind ViewModel.OutDate, Mode=OneWay}"
                              Kind="Display"
                              ShowCopy="True" />
                        </Grid>

                        <!-- The vault records this VPS hangs off. -->
                        <TextBlock Text="LINKED RECORDS"
                                   Style="{StaticResource SectionLabelStyle}" />
                        <Grid x:Name="PvLinksGrid" ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        
                                                    <controls:FieldCell x:Name="PvPersonCell"
                              Grid.Row="0"
                              Grid.Column="0"
                              Margin="0,0,0,16"
                              VerticalAlignment="Top"
                              Label="PERSON"
                              IconKind="User"
                              Value="{x:Bind ViewModel.PersonLabel, Mode=OneWay}"
                              Kind="Display"
                              ShowCopy="True" />
                        
                                                    <controls:FieldCell x:Name="PvSiteCell"
                              Grid.Row="0"
                              Grid.Column="1"
                              Margin="0,0,0,16"
                              VerticalAlignment="Top"
                              Label="SITE"
                              IconKind="Globe"
                              Value="{x:Bind ViewModel.SiteLabel, Mode=OneWay}"
                              Kind="Display"
                              ShowCopy="True" />
                        
                                                    <controls:FieldCell x:Name="PvAccountCell"
                              Grid.Row="1"
                              Grid.Column="0"
                              Margin="0,0,0,16"
                              VerticalAlignment="Top"
                              Label="ACCOUNT"
                              IconKind="Account"
                              Value="{x:Bind ViewModel.AccountLabel, Mode=OneWay}"
                              Kind="Display"
                              ShowCopy="True" />
                        
                                                    <controls:FieldCell x:Name="PvNodeCell"
                              Grid.Row="1"
                              Grid.Column="1"
                              Margin="0,0,0,16"
                              VerticalAlignment="Top"
                              Label="NODE"
                              IconKind="Briefcase"
                              Value="{x:Bind ViewModel.NodeLabel, Mode=OneWay}"
                              Kind="Display"
                              ShowCopy="True" />
                        </Grid>

                        <!-- The machine underneath, as one spec sheet. -->
                        <TextBlock Text="SYSTEM INFORMATION"
                                   Style="{StaticResource SectionLabelStyle}" />
                        <Grid x:Name="PvSystemGrid" ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        
                                                    <controls:FieldCell x:Name="PvOsCell"
                              Grid.Row="0"
                              Grid.Column="0"
                              Margin="0,0,0,16"
                              VerticalAlignment="Top"
                              Label="OS"
                              IconKind="Info"
                              Value="{x:Bind ViewModel.Os, Mode=OneWay}"
                              Kind="Display"
                              ShowCopy="True" />
                        
                                                    <controls:FieldCell x:Name="PvIpCell"
                              Grid.Row="0"
                              Grid.Column="1"
                              Margin="0,0,0,16"
                              VerticalAlignment="Top"
                              Label="IP ADDRESS"
                              IconKind="Globe"
                              Value="{x:Bind ViewModel.Ip, Mode=OneWay}"
                              Kind="Display"
                              ShowCopy="True" />
                        
                                                    <controls:FieldCell x:Name="PvPortCell"
                              Grid.Row="1"
                              Grid.Column="0"
                              Margin="0,0,0,16"
                              VerticalAlignment="Top"
                              Label="PORT"
                              IconKind="Key"
                              Value="{x:Bind ViewModel.Port, Mode=OneWay}"
                              UnitValue="{x:Bind ViewModel.PortNumber, Mode=OneWay}"
                              Kind="Display"
                              ShowCopy="True" />
                        
                                                    <controls:FieldCell x:Name="PvUsernameCell"
                              Grid.Row="1"
                              Grid.Column="1"
                              Margin="0,0,0,16"
                              VerticalAlignment="Top"
                              Label="USERNAME"
                              IconKind="User"
                              Value="{x:Bind ViewModel.Username, Mode=OneWay}"
                              Kind="Display"
                              ShowCopy="True" />
                        
                                                    <controls:FieldCell x:Name="PvUserPasswordCell"
                              Grid.Row="2"
                              Grid.Column="0"
                              Margin="0,0,0,16"
                              VerticalAlignment="Top"
                              Label="USER PASSWORD"
                              IconKind="Lock"
                              Value="{x:Bind ViewModel.UserPassword, Mode=OneWay}"
                              IsSecret="True"
                              Kind="Display"
                              ShowCopy="True" />
                        
                                                    <controls:FieldCell x:Name="PvRootUserCell"
                              Grid.Row="2"
                              Grid.Column="1"
                              Margin="0,0,0,16"
                              VerticalAlignment="Top"
                              Label="ROOT USER"
                              IconKind="User"
                              Value="{x:Bind ViewModel.RootUser, Mode=OneWay}"
                              Kind="Display"
                              ShowCopy="True" />
                        
                                                    <controls:FieldCell x:Name="PvRootPasswordCell"
                              Grid.Row="3"
                              Grid.Column="0"
                              Margin="0,0,0,16"
                              VerticalAlignment="Top"
                              Label="ROOT PASSWORD"
                              IconKind="Lock"
                              Value="{x:Bind ViewModel.RootPassword, Mode=OneWay}"
                              IsSecret="True"
                              Kind="Display"
                              ShowCopy="True" />
                        
                                                    <controls:FieldCell x:Name="PvCpuCell"
                              Grid.Row="3"
                              Grid.Column="1"
                              Margin="0,0,0,16"
                              VerticalAlignment="Top"
                              Label="CPU"
                              IconKind="Info"
                              Value="{x:Bind ViewModel.Cpu, Mode=OneWay}"
                              Kind="Display"
                              ShowCopy="True" />
                        
                                                    <controls:FieldCell x:Name="PvMemoryCell"
                              Grid.Row="4"
                              Grid.Column="0"
                              Margin="0,0,0,16"
                              VerticalAlignment="Top"
                              Label="MEMORY (RAM)"
                              IconKind="Info"
                              Value="{x:Bind ViewModel.Memory, Mode=OneWay}"
                              Kind="Display"
                              ShowCopy="True" />
                        
                                                    <controls:FieldCell x:Name="PvDiskCell"
                              Grid.Row="4"
                              Grid.Column="1"
                              Margin="0,0,0,16"
                              VerticalAlignment="Top"
                              Label="DISK"
                              IconKind="Info"
                              Value="{x:Bind ViewModel.Disk, Mode=OneWay}"
                              Kind="Display"
                              ShowCopy="True" />
                        
                                                    <controls:FieldCell x:Name="PvBandwidthCell"
                              Grid.Row="5"
                              Grid.Column="0"
                              Margin="0,0,0,16"
                              VerticalAlignment="Top"
                              Label="BANDWIDTH"
                              IconKind="Info"
                              Value="{x:Bind ViewModel.Bandwidth, Mode=OneWay}"
                              Kind="Display"
                              ShowCopy="True" />
                        
                                                    <controls:FieldCell x:Name="PvBandwidthSpeedCell"
                              Grid.Row="5"
                              Grid.Column="1"
                              Margin="0,0,0,16"
                              VerticalAlignment="Top"
                              Label="BANDWIDTH SPEED"
                              IconKind="Info"
                              Value="{x:Bind ViewModel.BandwidthSpeed, Mode=OneWay}"
                              Kind="Display"
                              ShowCopy="True" />
                        
                                                    <controls:FieldCell x:Name="PvUploadCell"
                              Grid.Row="6"
                              Grid.Column="0"
                              Margin="0,0,0,16"
                              VerticalAlignment="Top"
                              Label="UPLOAD SPEED"
                              IconKind="Info"
                              Value="{x:Bind ViewModel.UploadSpeed, Mode=OneWay}"
                              Kind="Display"
                              ShowCopy="True" />
                        
                                                    <controls:FieldCell x:Name="PvDownloadCell"
                              Grid.Row="6"
                              Grid.Column="1"
                              Margin="0,0,0,16"
                              VerticalAlignment="Top"
                              Label="DOWNLOAD SPEED"
                              IconKind="Info"
                              Value="{x:Bind ViewModel.DownloadSpeed, Mode=OneWay}"
                              Kind="Display"
                              ShowCopy="True" />
                        
                                                    <controls:FieldCell x:Name="PvPingCell"
                              Grid.Row="7"
                              Grid.Column="0"
                              Margin="0,0,0,16"
                              VerticalAlignment="Top"
                              Label="PING TIME"
                              IconKind="Clock"
                              Value="{x:Bind ViewModel.PingTime, Mode=OneWay}"
                              Kind="Display"
                              ShowCopy="True" />
                        </Grid>

                        <!-- The two notes, side by side. -->
                        <TextBlock Text="NOTES"
                                   Style="{StaticResource SectionLabelStyle}" />
                        <Grid x:Name="PvNotesGrid" ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        
                                                    <controls:FieldCell x:Name="PvNoteCell"
                              Grid.Row="0"
                              Grid.Column="0"
                              Margin="0,0,0,16"
                              VerticalAlignment="Top"
                              Label="NOTE"
                              IconKind="Info"
                              Value="{x:Bind ViewModel.Note, Mode=OneWay}"
                              InputKind="Multiline"
                              Kind="Display"
                              ShowCopy="True" />
                        
                                                    <controls:FieldCell x:Name="PvSystemNoteCell"
                              Grid.Row="0"
                              Grid.Column="1"
                              Margin="0,0,0,16"
                              VerticalAlignment="Top"
                              Label="SYSTEM NOTE"
                              IconKind="Info"
                              Value="{x:Bind ViewModel.SystemNote, Mode=OneWay}"
                              InputKind="Multiline"
                              Kind="Display"
                              ShowCopy="True" />
                        </Grid>
                    </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!-- Footer .................................................. -->
                <Grid x:Name="FooterBlock" Grid.Row="2" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               VerticalAlignment="Center"
                               Text="The record saves with its system information; the name is the one required field."
                               Visibility="{x:Bind ViewModel.IsEditing, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                               FontFamily="{StaticResource BalooFont}"
                               FontSize="{StaticResource FieldValueFontSize}"
                               Foreground="{StaticResource CardMetaBrush}" />

                    <!-- Preview: one full-width action. -->
                    <Button x:Name="PreviewAction"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            HorizontalAlignment="Stretch"
                            Visibility="{x:Bind ViewModel.IsPreview, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                            Style="{StaticResource BareButtonStyle}"
                            Click="OnPrimaryClick">
                        <Border Height="52"
                                CornerRadius="26"
                                Background="{StaticResource BrandPrimaryBrush}">
                            <TextBlock Text="{x:Bind ViewModel.PrimaryActionText, Mode=OneWay}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource JerseyFont}"
                                       FontSize="{StaticResource ButtonFontSize}"
                                       Foreground="#FFFFFF"
                                       CharacterSpacing="40" />
                        </Border>
                    </Button>

                    <!-- Add and edit: cancel plus the commit. -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="14"
                                Visibility="{x:Bind ViewModel.IsEditing, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <Button Style="{StaticResource BareButtonStyle}" Click="OnCancelClick">
                            <Border Height="52"
                                    MinWidth="150"
                                    CornerRadius="26"
                                    Background="{StaticResource CardBackgroundBrush}"
                                    BorderBrush="{StaticResource SearchBorderBrush}"
                                    BorderThickness="1">
                                <TextBlock Text="CANCEL"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontFamily="{StaticResource JerseyFont}"
                                           FontSize="{StaticResource ButtonFontSize}"
                                           Foreground="{StaticResource CardMetaBrush}"
                                           CharacterSpacing="40" />
                            </Border>
                        </Button>

                        <Button Style="{StaticResource BareButtonStyle}"
                                IsEnabled="{x:Bind ViewModel.CanSave, Mode=OneWay}"
                                Click="OnPrimaryClick">
                            <Border Height="52"
                                    MinWidth="210"
                                    CornerRadius="26"
                                    Background="{StaticResource BrandPrimaryBrush}">
                                <TextBlock Text="{x:Bind ViewModel.PrimaryActionText, Mode=OneWay}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontFamily="{StaticResource JerseyFont}"
                                           FontSize="{StaticResource ButtonFontSize}"
                                           Foreground="#FFFFFF"
                                           CharacterSpacing="40" />
                            </Border>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!--
            Below 1000 the three columns cannot hold a readable field box, so the
            form becomes a single scrolling list. The cells are placed, not
            stacked: each one is moved to its reading-order row in the one
            remaining column, so the narrow form reads in the same order the
            wide one does - the workbook's - rather than column by column.
        -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="DialogWidthStates">
                <VisualState x:Name="DialogWide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1000" />
                    </VisualState.StateTriggers>
                </VisualState>

                <VisualState x:Name="DialogNarrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ColMiddle.Width" Value="0" />
                        <Setter Target="ColRight.Width" Value="0" />
                        <Setter Target="FieldGrid.ColumnSpacing" Value="0" />
                        <Setter Target="PersonCell.(Grid.Row)" Value="1" />
                        <Setter Target="PersonCell.(Grid.Column)" Value="0" />
                        <Setter Target="SiteCell.(Grid.Row)" Value="2" />
                        <Setter Target="SiteCell.(Grid.Column)" Value="0" />
                        <Setter Target="AccountCell.(Grid.Row)" Value="3" />
                        <Setter Target="NameCell.(Grid.Row)" Value="4" />
                        <Setter Target="NameCell.(Grid.Column)" Value="0" />
                        <Setter Target="BalanceCell.(Grid.Row)" Value="5" />
                        <Setter Target="BalanceCell.(Grid.Column)" Value="0" />
                        <Setter Target="BtcCell.(Grid.Row)" Value="6" />
                        <Setter Target="RateCell.(Grid.Row)" Value="7" />
                        <Setter Target="RateCell.(Grid.Column)" Value="0" />
                        <Setter Target="CreatedCell.(Grid.Row)" Value="8" />
                        <Setter Target="CreatedCell.(Grid.Column)" Value="0" />
                        <Setter Target="OutCell.(Grid.Row)" Value="9" />
                        <Setter Target="CycleCell.(Grid.Row)" Value="10" />
                        <Setter Target="CycleCell.(Grid.Column)" Value="0" />
                        <Setter Target="NodeCell.(Grid.Row)" Value="11" />
                        <Setter Target="NodeCell.(Grid.Column)" Value="0" />
                        <Setter Target="CountryCell.(Grid.Row)" Value="12" />
                        <Setter Target="NoteCell.(Grid.Row)" Value="13" />
                        <Setter Target="NoteCell.(Grid.Column)" Value="0" />
                        <Setter Target="SysColMiddle.Width" Value="0" />
                        <Setter Target="SysColRight.Width" Value="0" />
                        <Setter Target="SystemGrid.ColumnSpacing" Value="0" />
                        <Setter Target="OsCell.(Grid.Row)" Value="1" />
                        <Setter Target="OsCell.(Grid.Column)" Value="0" />
                        <Setter Target="IpCell.(Grid.Row)" Value="2" />
                        <Setter Target="IpCell.(Grid.Column)" Value="0" />
                        <Setter Target="PortCell.(Grid.Row)" Value="3" />
                        <Setter Target="UsernameCell.(Grid.Row)" Value="4" />
                        <Setter Target="UsernameCell.(Grid.Column)" Value="0" />
                        <Setter Target="UserPasswordCell.(Grid.Row)" Value="5" />
                        <Setter Target="UserPasswordCell.(Grid.Column)" Value="0" />
                        <Setter Target="RootUserCell.(Grid.Row)" Value="6" />
                        <Setter Target="RootPasswordCell.(Grid.Row)" Value="7" />
                        <Setter Target="RootPasswordCell.(Grid.Column)" Value="0" />
                        <Setter Target="CpuCell.(Grid.Row)" Value="8" />
                        <Setter Target="CpuCell.(Grid.Column)" Value="0" />
                        <Setter Target="MemoryCell.(Grid.Row)" Value="9" />
                        <Setter Target="DiskCell.(Grid.Row)" Value="10" />
                        <Setter Target="DiskCell.(Grid.Column)" Value="0" />
                        <Setter Target="BandwidthCell.(Grid.Row)" Value="11" />
                        <Setter Target="BandwidthCell.(Grid.Column)" Value="0" />
                        <Setter Target="BandwidthSpeedCell.(Grid.Row)" Value="12" />
                        <Setter Target="UploadCell.(Grid.Row)" Value="13" />
                        <Setter Target="UploadCell.(Grid.Column)" Value="0" />
                        <Setter Target="DownloadCell.(Grid.Row)" Value="14" />
                        <Setter Target="DownloadCell.(Grid.Column)" Value="0" />
                        <Setter Target="PingCell.(Grid.Row)" Value="15" />
                        <Setter Target="SystemNoteCell.(Grid.Row)" Value="16" />
                        <Setter Target="SystemNoteCell.(Grid.Column)" Value="0" />
                        <Setter Target="PvMoneyGrid.ColumnSpacing" Value="0" />
                        <Setter Target="PvBtcCell.(Grid.Row)" Value="1" />
                        <Setter Target="PvBtcCell.(Grid.Column)" Value="0" />
                        <Setter Target="PvRateCell.(Grid.Row)" Value="2" />
                        <Setter Target="PvCycleCell.(Grid.Row)" Value="3" />
                        <Setter Target="PvCycleCell.(Grid.Column)" Value="0" />
                        <Setter Target="PvCreatedCell.(Grid.Row)" Value="4" />
                        <Setter Target="PvOutCell.(Grid.Row)" Value="5" />
                        <Setter Target="PvOutCell.(Grid.Column)" Value="0" />
                        <Setter Target="PvLinksGrid.ColumnSpacing" Value="0" />
                        <Setter Target="PvSiteCell.(Grid.Row)" Value="1" />
                        <Setter Target="PvSiteCell.(Grid.Column)" Value="0" />
                        <Setter Target="PvAccountCell.(Grid.Row)" Value="2" />
                        <Setter Target="PvNodeCell.(Grid.Row)" Value="3" />
                        <Setter Target="PvNodeCell.(Grid.Column)" Value="0" />
