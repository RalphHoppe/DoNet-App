<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DoNet.Views.VpsMapDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:DoNet.Controls"
    mc:Ignorable="d">

    <!--
        The VPS map, as an atlas: the earth as a page, the records as pins.

        The plate is the rendered equirectangular map - x from longitude, y
        from latitude, exactly 2:1 - in the atlas palette: a warm paper sea,
        soft sage land. Every pin is placed by that one rule, so the picture
        and the placement math cannot disagree about where a country is.

        The overview dots the mains, one teardrop per country at the top of
        the country's shape, a count badge where one country holds several.
        A click trades the overview for that main's network: its whole chain
        as pins at their own countries, joined by curved arcs whose dashes
        flow along them.

        The story lives beside the page, not on it: when a network is open,
        a panel slides in on the right carrying the way back, the main's own
        card, and the chain as a readable list - hovering a row lights up
        its pin on the page. The map keeps only what belongs to the map.

        The chooser - the small panel that opens over a badge - is hand-built
        for the same reason the drawers are: the app has no stock dropdowns.
    -->

    <UserControl.Resources>

        <!-- The paper the plate sits on, the same tone the image paints. -->
        <SolidColorBrush x:Key="SeaBrush" Color="#F0EADD" />

        <!--
            The connections: curved arcs whose dashes flow along them - the
            app's own teal for a main's direct children, a quieter sage for
            everything deeper, so depth reads at a glance.
        -->
        <SolidColorBrush x:Key="ConnectionBrush" Color="#4BAA98" />
        <SolidColorBrush x:Key="DeepConnectionBrush" Color="#93BBB0" />

        <!-- The section label over the network list, the tables' header voice. -->
        <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource BaumansFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource BrandPrimaryBrush}" />
            <Setter Property="CharacterSpacing" Value="20" />
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
            <Setter Property="LineHeight" Value="20" />
        </Style>

        <Style x:Key="LegendTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource BalooFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource CardMetaBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
            <Setter Property="LineHeight" Value="16" />
        </Style>

        <Style x:Key="StateTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource BalooSemiBoldFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
            <Setter Property="LineHeight" Value="20" />
        </Style>

        <!-- The story panel arriving: it slides in from the right while the
             map gives it room, the way the service screens' panels do. -->
        <Storyboard x:Key="PanelInStoryboard">
            <DoubleAnimation Storyboard.TargetName="PanelOffset"
                             Storyboard.TargetProperty="X"
                             From="46" To="0" Duration="0:0:0.26">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="NetworkPanel"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.20" />
        </Storyboard>

        <!-- The dialog's entrance: a short rise and settle under a fading scrim. -->
        <Storyboard x:Key="OpenStoryboard">
            <DoubleAnimation Storyboard.TargetName="Scrim"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.16" />
            <DoubleAnimation Storyboard.TargetName="CardOffset"
                             Storyboard.TargetProperty="Y"
                             From="18" To="0" Duration="0:0:0.26">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="CardScale"
                             Storyboard.TargetProperty="ScaleX"
                             From="0.985" To="1" Duration="0:0:0.26">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="CardScale"
                             Storyboard.TargetProperty="ScaleY"
                             From="0.985" To="1" Duration="0:0:0.26">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Card"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.20" />
        </Storyboard>

        <Storyboard x:Key="CloseStoryboard" Completed="OnCloseCompleted">
            <DoubleAnimation Storyboard.TargetName="Scrim"
                             Storyboard.TargetProperty="Opacity"
                             To="0" Duration="0:0:0.14" />
            <DoubleAnimation Storyboard.TargetName="Card"
                             Storyboard.TargetProperty="Opacity"
                             To="0" Duration="0:0:0.14" />
            <DoubleAnimation Storyboard.TargetName="CardOffset"
                             Storyboard.TargetProperty="Y"
                             To="12" Duration="0:0:0.14">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

    </UserControl.Resources>

    <Grid x:Name="Root" Visibility="Collapsed">

        <Rectangle x:Name="Scrim" Fill="#59000000" Tapped="OnScrimTapped" />

        <Border x:Name="Card"
                MaxWidth="1480"
                Margin="24"
                CornerRadius="26"
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="1"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1" />
                    <TranslateTransform x:Name="CardOffset" Y="0" />
                </TransformGroup>
            </Border.RenderTransform>

            <Grid Padding="36,26,36,18" RowSpacing="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header .................................................. -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14">
                        <Viewbox Width="40"
                                 Height="40"
                                 VerticalAlignment="Center">
                            <controls:TypeMark Kind="Vps" />
                        </Viewbox>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="VPS MAP"
                                       FontFamily="{StaticResource BaumansFont}"
                                       FontSize="{StaticResource SectionTitleFontSize}"
                                       Foreground="{StaticResource BrandPrimaryBrush}"
                                       CharacterSpacing="20"
                                       LineStackingStrategy="BlockLineHeight"
                                       LineHeight="40" />
                            <TextBlock Text="The network atlas - every main on the page, the story beside it"
                                       FontFamily="{StaticResource BalooFont}"
                                       FontSize="{StaticResource SectionSubtitleFontSize}"
                                       Foreground="{StaticResource SectionSubtitleBrush}"
                                       LineStackingStrategy="BlockLineHeight"
                                       LineHeight="20" />
                        </StackPanel>
                    </StackPanel>

                    <Button Grid.Column="1"
                            VerticalAlignment="Top"
                            Style="{StaticResource BareButtonStyle}"
                            ToolTipService.ToolTip="Close"
                            Click="OnCloseClick">
                        <Border Width="22"
                                Height="22"
                                Margin="8"
                                CornerRadius="11"
                                Background="#FF5F57" />
                    </Button>
                </Grid>

                <!-- Body: the page, and the story beside it ................ -->
                <Grid Grid.Row="1" ColumnSpacing="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- The map, the page itself. -->
                    <Border Grid.Column="0"
                            CornerRadius="18"
                            Background="{StaticResource SeaBrush}"
                            BorderBrush="#E3DCCB"
                            BorderThickness="1">
                        <!--
                            The wheel zooms about the pointer; a drag from the
                            map itself - the paper or the land, not a pin or a
                            panel - carries the view. Presses on the pins, the
                            chooser and these very handlers' panels never
                            start a drag; the code-behind checks where a
                            press began.
                        -->
                        <Grid x:Name="MapHost"
                              Height="320"
                              SizeChanged="OnMapHostSizeChanged"
                              PointerWheelChanged="OnMapWheel"
                              PointerPressed="OnMapPointerPressed"
                              PointerMoved="OnMapPointerMoved"
                              PointerReleased="OnMapPointerReleased"
                              PointerCanceled="OnMapPointerReleased">

                            <!-- Everything that belongs to the plate is
                                 clipped to it: the connections that cross the
                                 edge where the map ends and restarts leave
                                 the map, not the dialog. -->
                            <Grid x:Name="MapClip">
                                <!--
                                    The plate and its connections share one
                                    canvas, in host pixels: the image is
                                    seated and sized by the view model's
                                    transform, and the arcs run between the
                                    transformed positions.
                                -->
                                <Canvas x:Name="MapCanvas">
                                    <Image x:Name="MapImage"
                                           Source="ms-appx:///Assets/Maps/world-map.png"
                                           Stretch="Fill"
                                           Width="0"
                                           Height="0" />
                                </Canvas>

                                <!--
                                    The pins sit above the arcs and keep their
                                    own size at every zoom. The layer's
                                    transparent background is the map's drag
                                    surface.
                                -->
                                <Canvas x:Name="DotLayer"
                                        Background="Transparent"
                                        Tapped="OnMapBackgroundTapped" />
                            </Grid>

                            <!-- The chooser, seated beside its pin in code. -->
                            <Canvas x:Name="ChooserLayer">
                                <Border x:Name="ChooserCard"
                                        Width="300"
                                        Padding="14"
                                        CornerRadius="16"
                                        Background="{StaticResource CardBackgroundBrush}"
                                        BorderBrush="{StaticResource CardBorderBrush}"
                                        BorderThickness="1"
                                        Visibility="Collapsed">
                                    <StackPanel Spacing="10">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Viewbox Grid.Column="0"
                                                     Width="22"
                                                     Height="16"
                                                     VerticalAlignment="Center">
                                                <controls:FlagIcon x:Name="ChooserFlag" />
                                            </Viewbox>
                                            <TextBlock x:Name="ChooserTitle"
                                                       Grid.Column="1"
                                                       FontFamily="{StaticResource BalooSemiBoldFont}"
                                                       FontSize="12.5"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       TextWrapping="Wrap"
                                                       VerticalAlignment="Center"
                                                       LineStackingStrategy="BlockLineHeight"
                                                       LineHeight="17" />
                                            <Button Grid.Column="2"
                                                    Style="{StaticResource BareButtonStyle}"
                                                    VerticalAlignment="Top"
                                                    Click="OnChooserCloseClick">
                                                <Border Width="20"
                                                        Height="20"
                                                        CornerRadius="10"
                                                        Background="#F1F3F6">
                                                    <TextBlock Text="&#215;"
                                                               FontFamily="{StaticResource BalooSemiBoldFont}"
                                                               FontSize="12"
                                                               Foreground="{StaticResource CardMetaBrush}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               LineStackingStrategy="BlockLineHeight"
                                                               LineHeight="12" />
                                                </Border>
                                            </Button>
                                        </Grid>

                                        <StackPanel x:Name="ChooserRows" Spacing="6" />
                                    </StackPanel>
                                </Border>
                            </Canvas>

                            <!--
                                ZOOM: closer, further, and the whole earth
                                back. The wheel zooms about the pointer and a
                                drag carries the view; these are the same
                                trip with somewhere definite to land.
                            -->
                            <StackPanel HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Margin="14"
                                        Spacing="8">
                                <Button Style="{StaticResource BareButtonStyle}"
                                        ToolTipService.ToolTip="Zoom in"
                                        IsEnabled="{x:Bind ViewModel.CanZoomIn, Mode=OneWay}"
                                        Click="OnZoomInClick">
                                    <Border Width="36"
                                            Height="36"
                                            CornerRadius="18"
                                            Background="#F2FFFFFF"
                                            BorderBrush="{StaticResource CardBorderBrush}"
                                            BorderThickness="1">
                                        <Viewbox Width="15"
                                                 Height="15">
                                            <Canvas Width="18" Height="18">
                                                <Path Data="M9 3.75 V14.25 M3.75 9 H14.25"
                                                      Stroke="#5C6066"
                                                      StrokeThickness="2.2"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round" />
                                            </Canvas>
                                        </Viewbox>
                                    </Border>
                                </Button>

                                <Button Style="{StaticResource BareButtonStyle}"
                                        ToolTipService.ToolTip="Zoom out"
                                        IsEnabled="{x:Bind ViewModel.CanZoomOut, Mode=OneWay}"
                                        Click="OnZoomOutClick">
                                    <Border Width="36"
                                            Height="36"
                                            CornerRadius="18"
                                            Background="#F2FFFFFF"
                                            BorderBrush="{StaticResource CardBorderBrush}"
                                            BorderThickness="1">
                                        <Viewbox Width="15"
                                                 Height="15">
                                            <Canvas Width="18" Height="18">
                                                <Path Data="M3.75 9 H14.25"
                                                      Stroke="#5C6066"
                                                      StrokeThickness="2.2"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round" />
                                            </Canvas>
                                        </Viewbox>
                                    </Border>
                                </Button>

                                <Button Style="{StaticResource BareButtonStyle}"
                                        ToolTipService.ToolTip="Back to the whole earth"
                                        Click="OnZoomResetClick">
                                    <Border Width="36"
                                            Height="36"
                                            CornerRadius="18"
                                            Background="#F2FFFFFF"
                                            BorderBrush="{StaticResource CardBorderBrush}"
                                            BorderThickness="1">
                                        <Viewbox Width="15"
                                                 Height="15">
                                            <Canvas Width="18" Height="18">
                                                <Path Data="M3 6.6 V4.8 Q3 3 4.8 3 H6.6 M11.4 3 H13.2 Q15 3 15 4.8 V6.6 M15 11.4 V13.2 Q15 15 13.2 15 H11.4 M6.6 15 H4.8 Q3 15 3 13.2 V11.4"
                                                      Stroke="#5C6066"
                                                      StrokeThickness="2"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round" />
                                            </Canvas>
                                        </Viewbox>
                                    </Border>
                                </Button>
                            </StackPanel>

                            <!-- The states, centred on the plate. -->
                            <Border HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    CornerRadius="14"
                                    Padding="18,10"
                                    Background="#F2FFFFFF"
                                    BorderBrush="{StaticResource CardBorderBrush}"
                                    BorderThickness="1"
                                    Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Plotting the network..."
                                           Style="{StaticResource StateTextStyle}" />
                            </Border>

                            <Border HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    CornerRadius="14"
                                    Padding="18,10"
                                    Background="#F2FFFFFF"
                                    BorderBrush="{StaticResource CardBorderBrush}"
                                    BorderThickness="1"
                                    Visibility="{x:Bind ViewModel.IsError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="The directory refused - close and try again."
                                           Style="{StaticResource StateTextStyle}" />
                            </Border>

                            <Border HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    CornerRadius="14"
                                    Padding="18,10"
                                    Background="#F2FFFFFF"
                                    BorderBrush="{StaticResource CardBorderBrush}"
                                    BorderThickness="1"
                                    Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="No VPS records yet"
                                               Style="{StaticResource StateTextStyle}" />
                                    <TextBlock Text="Add one, and it lands on the page."
                                               Style="{StaticResource StateTextStyle}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!--
                        The story beside the page: the way back, the main's
                        own card, and its chain as a readable list. Only on
                        show while a network is open - the overview is the
                        whole earth's view and needs no narration. Its
                        arrival is the slide storyboard above.
                    -->
                    <Border x:Name="NetworkPanel"
                            Grid.Column="1"
                            Width="330"
                            CornerRadius="18"
                            Background="#FBFAF7"
                            BorderBrush="#E9E4D8"
                            BorderThickness="1"
                            Visibility="Collapsed"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="PanelOffset" X="0" />
                        </Border.RenderTransform>
                        <Grid RowSpacing="14" Padding="18,16,18,16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- The way back. -->
                            <Button Grid.Row="0"
                                    Style="{StaticResource BareButtonStyle}"
                                    HorizontalAlignment="Left"
                                    Click="OnBackClick">
                                <Border Height="34"
                                        CornerRadius="17"
                                        Padding="14,0"
                                        Background="{StaticResource HeaderActionFillBrush}"
                                        BorderBrush="{StaticResource SearchBorderBrush}"
                                        BorderThickness="1">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <controls:LineIcon Kind="ArrowLeft"
                                                           Width="15"
                                                           Height="15"
                                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Text="ALL MAINS"
                                                   FontFamily="{StaticResource BalooSemiBoldFont}"
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   CharacterSpacing="60"
                                                   VerticalAlignment="Center"
                                                   LineStackingStrategy="BlockLineHeight"
                                                   LineHeight="16" />
                                    </StackPanel>
                                </Border>
                            </Button>

                            <!-- The main's own card. -->
                            <StackPanel Grid.Row="1" Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Viewbox Width="26"
                                             Height="19"
                                             VerticalAlignment="Center">
                                        <controls:FlagIcon Country="{x:Bind ViewModel.FocusedFlagCountry, Mode=OneWay}" />
                                    </Viewbox>
                                    <TextBlock Text="{x:Bind ViewModel.FocusedName, Mode=OneWay}"
                                               FontFamily="{StaticResource BalooSemiBoldFont}"
                                               FontSize="16"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               MaxWidth="260"
                                               VerticalAlignment="Center"
                                               LineStackingStrategy="BlockLineHeight"
                                               LineHeight="21" />
                                </StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.FocusedCountryLabel, Mode=OneWay}"
                                           FontFamily="{StaticResource BalooFont}"
                                           FontSize="12"
                                           Foreground="{StaticResource CardMetaBrush}"
                                           LineStackingStrategy="BlockLineHeight"
                                           LineHeight="16" />
                                <TextBlock Text="{x:Bind ViewModel.FocusedSummary, Mode=OneWay}"
                                           FontFamily="{StaticResource BalooSemiBoldFont}"
                                           FontSize="12"
                                           Foreground="{StaticResource BrandPrimaryBrush}"
                                           LineStackingStrategy="BlockLineHeight"
                                           LineHeight="16" />
                            </StackPanel>

                            <!-- The chain, as a list. -->
                            <TextBlock Grid.Row="2"
                                       Text="THE NETWORK"
                                       Style="{StaticResource SectionLabelStyle}" />

                            <ScrollViewer Grid.Row="3"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollMode="Disabled">
                                <StackPanel x:Name="ChainRows" Spacing="6" />
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Footer: the legend, and the honest footnote about the
                     records that could not be placed. -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <WrapPanel Grid.Column="0"
                               HorizontalSpacing="20"
                               VerticalSpacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Ellipse Width="15"
                                     Height="15"
                                     Fill="#FFFFFF"
                                     Stroke="#FF5F57"
                                     StrokeThickness="2.5"
                                     VerticalAlignment="Center" />
                            <TextBlock Text="MAIN VPS" Style="{StaticResource LegendTextStyle}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Ellipse Width="12"
                                     Height="12"
                                     Fill="#FFFFFF"
                                     Stroke="#7A8798"
                                     StrokeThickness="2"
                                     VerticalAlignment="Center" />
                            <TextBlock Text="CONNECTED VPS" Style="{StaticResource LegendTextStyle}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Border CornerRadius="8"
                                    Padding="5,0"
                                    Background="#FEBC2E"
                                    VerticalAlignment="Center">
                                <TextBlock Text="&#215;3"
                                           FontFamily="{StaticResource JerseyFont}"
                                           FontSize="11"
                                           Foreground="#8A5B12"
                                           LineStackingStrategy="BlockLineHeight"
                                           LineHeight="13" />
                            </Border>
                            <TextBlock Text="MAINS IN ONE COUNTRY" Style="{StaticResource LegendTextStyle}" />
                        </StackPanel>
                        <TextBlock Text="Click a main to open its network"
                                   Style="{StaticResource LegendTextStyle}" />
                    </WrapPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="7"
                                Visibility="{x:Bind ViewModel.HasOffMap, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <controls:LineIcon Kind="Info"
                                           Width="14"
                                           Height="14"
                                           Foreground="{StaticResource CardMetaBrush}"
                                           VerticalAlignment="Center" />
                        <TextBlock Text="{x:Bind ViewModel.OffMapNote, Mode=OneWay}"
                                   Style="{StaticResource LegendTextStyle}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
