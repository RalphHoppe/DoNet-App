<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DoNet.Views.ServiceRecordDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:DoNet.Controls"
    mc:Ignorable="d">

    <!--
        The record dialog for a designed service type, in all three modes:
        preview, add and edit. One control, for the same reason the other dialogs
        are one.

        The form itself is built in code, because what a record carries was
        designed by the user for this type: the XAML is the shell - header,
        scroller, footer - and the fields arrive as FieldCells from the view
        model's editors, each as the input its kind calls for.

        Hosted at the HomePage root like the other dialogs, so it covers the whole
        window including the rail.
    -->

    <UserControl.Resources>

        <Storyboard x:Key="OpenStoryboard">
            <DoubleAnimation Storyboard.TargetName="Scrim"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.16" />
            <DoubleAnimation Storyboard.TargetName="CardOffset"
                             Storyboard.TargetProperty="Y"
                             From="18" To="0" Duration="0:0:0.26">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="CardScale"
                             Storyboard.TargetProperty="ScaleX"
                             From="0.985" To="1" Duration="0:0:0.26">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="CardScale"
                             Storyboard.TargetProperty="ScaleY"
                             From="0.985" To="1" Duration="0:0:0.26">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Card"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.20" />
        </Storyboard>

        <!-- Preview turning into the edit form, the same dip-and-rise as the
             other dialogs: the fields are the same either way, so a hard swap
             would read as a glitch rather than a change of mode. -->
        <Storyboard x:Key="ModeChangeStoryboard">
            <DoubleAnimation Storyboard.TargetName="FormHost"
                             Storyboard.TargetProperty="Opacity"
                             From="0.25" To="1" Duration="0:0:0.26">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="FormShift"
                             Storyboard.TargetProperty="Y"
                             From="10" To="0" Duration="0:0:0.30">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="HeaderBlock"
                             Storyboard.TargetProperty="Opacity"
                             From="0.3" To="1" Duration="0:0:0.24" />
            <DoubleAnimation Storyboard.TargetName="FooterBlock"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.28" />
        </Storyboard>

        <Storyboard x:Key="CloseStoryboard" Completed="OnCloseCompleted">
            <DoubleAnimation Storyboard.TargetName="Scrim"
                             Storyboard.TargetProperty="Opacity"
                             To="0" Duration="0:0:0.14" />
            <DoubleAnimation Storyboard.TargetName="Card"
                             Storyboard.TargetProperty="Opacity"
                             To="0" Duration="0:0:0.14" />
            <DoubleAnimation Storyboard.TargetName="CardOffset"
                             Storyboard.TargetProperty="Y"
                             To="12" Duration="0:0:0.14">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

    </UserControl.Resources>

    <Grid x:Name="Root" Visibility="Collapsed">

        <Rectangle x:Name="Scrim" Fill="#59000000" Tapped="OnScrimTapped" />

        <Border x:Name="Card"
                MaxWidth="1180"
                Margin="24"
                CornerRadius="26"
                Background="{StaticResource CardBackgroundBrush}"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1" />
                    <TranslateTransform x:Name="CardOffset" Y="0" />
                </TransformGroup>
            </Border.RenderTransform>

            <Grid Padding="40,32,40,28" RowSpacing="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header .................................................. -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel x:Name="HeaderBlock" Grid.Column="0">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="40"
                                    Height="40"
                                    CornerRadius="20"
                                    Margin="0,0,14,0"
                                    VerticalAlignment="Center"
                                    Background="{StaticResource CardAvatarBrush}"
                                    BorderBrush="{StaticResource SearchBorderBrush}"
                                    BorderThickness="1">
                                <controls:LineIcon Kind="Briefcase"
                                                   Width="22"
                                                   Height="22"
                                                   Foreground="{StaticResource BrandPrimaryBrush}" />
                            </Border>
                            <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                                       FontFamily="{StaticResource BaumansFont}"
                                       FontSize="{StaticResource SectionTitleFontSize}"
                                       Foreground="{StaticResource BrandPrimaryBrush}"
                                       CharacterSpacing="20"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       LineStackingStrategy="BlockLineHeight"
                                       LineHeight="40" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}"
                                   FontFamily="{StaticResource BalooFont}"
                                   FontSize="{StaticResource SectionSubtitleFontSize}"
                                   Foreground="{StaticResource SectionSubtitleBrush}"
                                   TextWrapping="Wrap"
                                   LineStackingStrategy="BlockLineHeight"
                                   LineHeight="20" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            VerticalAlignment="Top"
                            Style="{StaticResource BareButtonStyle}"
                            ToolTipService.ToolTip="Close"
                            Click="OnCloseClick">
                        <Border Width="22"
                                Height="22"
                                Margin="8"
                                CornerRadius="11"
                                Background="#FF5F57" />
                    </Button>
                </Grid>

                <!-- The form, built from the type's structure ............. -->
                <ScrollViewer Grid.Row="1"
                              Margin="0,0,-26,0"
                              Padding="0,0,26,0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollMode="Disabled">
                    <StackPanel x:Name="FormHost" Spacing="16">
                        <StackPanel.RenderTransform>
                            <TranslateTransform x:Name="FormShift" Y="0" />
                        </StackPanel.RenderTransform>

                        <!-- The record's own fields. -->
                        <StackPanel x:Name="FieldsHost" Spacing="16" />

                        <!-- The tables that ride along with the record, each
                             with its rows. -->
                        <StackPanel x:Name="TablesHost" Spacing="18" />

                        <!--
                            The store's own numbers, read-only in every mode and
                            "Assigned on save" until the store has assigned them.
                        -->
                        <StackPanel x:Name="MetaHost" Spacing="16">
                            <controls:FieldCell x:Name="IdCell"
                                                Label="# &#183; RECORD ID"
                                                IconKind="Hash"
                                                Placeholder="Assigned on save"
                                                Kind="Automatic"
                                                Value="{x:Bind ViewModel.IdDisplay, Mode=OneWay}"
                                                ShowCopy="{x:Bind ViewModel.IsPreview, Mode=OneWay}" />

                            <controls:FieldCell x:Name="CreatedCell"
                                                Label="CREATED AT"
                                                IconKind="Clock"
                                                Placeholder="Assigned on save"
                                                Kind="Automatic"
                                                Value="{x:Bind ViewModel.CreatedAtDisplay, Mode=OneWay}"
                                                ShowCopy="{x:Bind ViewModel.IsPreview, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- Footer ................................................... -->
                <Grid x:Name="FooterBlock" Grid.Row="2" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Preview: one full-width action. -->
                    <Button x:Name="PreviewAction"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            HorizontalAlignment="Stretch"
                            Visibility="{x:Bind ViewModel.IsPreview, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                            Style="{StaticResource BareButtonStyle}"
                            Click="OnPrimaryClick">
                        <Border Height="52"
                                CornerRadius="26"
                                Background="{StaticResource BrandPrimaryBrush}">
                            <TextBlock Text="{x:Bind ViewModel.PrimaryActionText, Mode=OneWay}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource JerseyFont}"
                                       FontSize="{StaticResource ButtonFontSize}"
                                       Foreground="#FFFFFF"
                                       CharacterSpacing="40" />
                        </Border>
                    </Button>

                    <!-- Add and edit: cancel plus the commit. -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="14"
                                Visibility="{x:Bind ViewModel.IsEditing, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <Button Style="{StaticResource BareButtonStyle}" Click="OnCancelClick">
                            <Border Height="52"
                                    MinWidth="150"
                                    CornerRadius="26"
                                    Background="{StaticResource CardBackgroundBrush}"
                                    BorderBrush="{StaticResource SearchBorderBrush}"
                                    BorderThickness="1">
                                <TextBlock Text="CANCEL"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontFamily="{StaticResource JerseyFont}"
                                           FontSize="{StaticResource ButtonFontSize}"
                                           Foreground="{StaticResource CardMetaBrush}"
                                           CharacterSpacing="40" />
                            </Border>
                        </Button>

                        <!--
                            Disabled until the form has enough to save: the name
                            field, when the type has one, has to be filled.
                        -->
                        <Button Style="{StaticResource BareButtonStyle}"
                                IsEnabled="{x:Bind ViewModel.CanSave, Mode=OneWay}"
                                Click="OnPrimaryClick">
                            <Border Height="52"
                                    MinWidth="210"
                                    CornerRadius="26"
                                    Background="{StaticResource BrandPrimaryBrush}">
                                <TextBlock Text="{x:Bind ViewModel.PrimaryActionText, Mode=OneWay}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontFamily="{StaticResource JerseyFont}"
                                           FontSize="{StaticResource ButtonFontSize}"
                                           Foreground="#FFFFFF"
                                           CharacterSpacing="40" />
                            </Border>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="DialogWidthStates">
                <VisualState x:Name="DialogWide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1000" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="DialogNarrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="Card.Margin" Value="12" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</UserControl>
