<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DoNet.Views.ServiceRecordsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:DoNet.Models"
    xmlns:controls="using:DoNet.Controls"
    mc:Ignorable="d">

    <!--
        One service type's own directory: the same header, search, card surface
        and four states as every other screen in the app, filled with what the
        user designed for the type in the structure designer. What changes from
        the type list is behind the title - a back button instead of the rail,
        and the type's name instead of the app's word for the tab.
    -->

    <UserControl.Resources>

        <Style x:Key="SearchBoxStyle" TargetType="TextBox" BasedOn="{StaticResource BareTextBoxStyle}">
            <Setter Property="FontFamily" Value="{StaticResource BalooFont}" />
            <Setter Property="FontSize" Value="{StaticResource FieldValueFontSize}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="StateTitleStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource BalooSemiBoldFont}" />
            <Setter Property="FontSize" Value="{StaticResource CardTitleFontSize}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
            <Setter Property="LineHeight" Value="22" />
        </Style>

        <Style x:Key="StateBodyStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource BalooFont}" />
            <Setter Property="FontSize" Value="{StaticResource SectionSubtitleFontSize}" />
            <Setter Property="Foreground" Value="{StaticResource CardMetaBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="MaxWidth" Value="360" />
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
            <Setter Property="LineHeight" Value="22" />
        </Style>

        <DataTemplate x:Key="RecordCardTemplate" x:DataType="models:ServiceRecord">
            <!--
                The structure and the relationship options come from the host view
                rather than the record: they belong to the type, and one drill-in
                loads them once. Loaded is the moment to hand them over, because a
                recycled card is a new card.
            -->
            <controls:ServiceRecordCard Record="{x:Bind}"
                                        Loaded="OnRecordCardLoaded"
                                        OpenRequested="OnCardOpen"
                                        EditRequested="OnCardEdit"
                                        DeleteRequested="OnCardDelete" />
        </DataTemplate>

    </UserControl.Resources>

    <Grid x:Name="Root" Padding="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header ........................................................... -->
        <Grid x:Name="Header" Grid.Row="0" Margin="0,0,0,24" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="HeaderTitleColumn" Width="*" />
                <ColumnDefinition x:Name="HeaderActionColumn" Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Grid.Column="0"
                  VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Back to the type list: the same disc the section icons sit
                     in, with the back arrow promoted into the icon set. -->
                <Button x:Name="BackButton"
                        Grid.Column="0"
                        Width="{StaticResource SectionDiscSize}"
                        Height="{StaticResource SectionDiscSize}"
                        Style="{StaticResource BareButtonStyle}"
                        ToolTipService.ToolTip="Back to services"
                        Margin="0,0,14,0"
                        VerticalAlignment="Center"
                        Command="{x:Bind ViewModel.GoBackCommand}">
                    <Border Width="{StaticResource SectionDiscSize}"
                            Height="{StaticResource SectionDiscSize}"
                            CornerRadius="{StaticResource SectionDiscCorner}"
                            Background="{StaticResource CardAvatarBrush}"
                            BorderBrush="{StaticResource SearchBorderBrush}"
                            BorderThickness="1">
                        <controls:LineIcon Kind="ArrowLeft"
                                           Width="{StaticResource SectionDiscIconSize}"
                                           Height="{StaticResource SectionDiscIconSize}"
                                           Foreground="{StaticResource BrandPrimaryBrush}" />
                    </Border>
                </Button>

                <Border Grid.Column="1"
                        Width="{StaticResource SectionDiscSize}"
                        Height="{StaticResource SectionDiscSize}"
                        CornerRadius="{StaticResource SectionDiscCorner}"
                        Margin="0,0,14,0"
                        VerticalAlignment="Center"
                        Background="{StaticResource CardAvatarBrush}"
                        BorderBrush="{StaticResource SearchBorderBrush}"
                        BorderThickness="1">
                    <controls:LineIcon Kind="Briefcase"
                                       Width="{StaticResource SectionDiscIconSize}"
                                       Height="{StaticResource SectionDiscIconSize}"
                                       Foreground="{StaticResource BrandPrimaryBrush}" />
                </Border>

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText"
                               Text="SERVICES"
                               FontFamily="{StaticResource BaumansFont}"
                               FontSize="{StaticResource SectionTitleFontSize}"
                               Foreground="{StaticResource BrandPrimaryBrush}"
                               CharacterSpacing="20"
                               TextTrimming="CharacterEllipsis"
                               LineStackingStrategy="BlockLineHeight"
                               LineHeight="36" />
                    <TextBlock Text="Everything filed under this type"
                               FontFamily="{StaticResource BalooFont}"
                               FontSize="{StaticResource SectionSubtitleFontSize}"
                               Foreground="{StaticResource SectionSubtitleBrush}"
                               TextTrimming="CharacterEllipsis"
                               LineStackingStrategy="BlockLineHeight"
                               LineHeight="20" />
                </StackPanel>
            </Grid>

            <Grid x:Name="HeaderActions"
                  Grid.Row="0"
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SearchColumn" Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border x:Name="SearchHost"
                        Grid.Column="0"
                        Width="304"
                        Height="42"
                        CornerRadius="21"
                        Padding="16,0,16,0"
                        Background="{StaticResource CardBackgroundBrush}"
                        BorderBrush="{StaticResource SearchBorderBrush}"
                        BorderThickness="1">
                    <Border.Resources>
                        <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="Transparent" />

                        <!--
                            Without these the focused and pointer-over visual states
                            in the stock TextBox template set Foreground to the theme
                            brush, which on a machine running Windows in dark mode is
                            white - white text on a white card.
                        -->
                        <SolidColorBrush x:Key="TextControlForeground" Color="#2B2F33" />
                        <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#2B2F33" />
                        <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#2B2F33" />
                        <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="#8C9196" />
                        <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                        <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                        <Thickness x:Key="TextControlThemePadding">0</Thickness>
                        <x:Double x:Key="TextControlThemeMinHeight">0</x:Double>
                        <x:Double x:Key="TextControlThemeMinWidth">0</x:Double>
                    </Border.Resources>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Viewbox Grid.Column="0"
                                 Width="18"
                                 Height="18"
                                 VerticalAlignment="Center">
                            <Canvas Width="18" Height="18">
                                <Path Data="M13.5 8A5.5 5.5 0 1 1 2.5 8A5.5 5.5 0 1 1 13.5 8 M12.2 12.2L16 16"
                                      Stroke="{StaticResource SearchPlaceholderBrush}"
                                      StrokeThickness="1.8"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" />
                            </Canvas>
                        </Viewbox>

                        <TextBox Grid.Column="1"
                                 Style="{StaticResource SearchBoxStyle}"
                                 PlaceholderText="SEARCH RECORDS"
                                 PlaceholderForeground="{StaticResource SearchPlaceholderBrush}"
                                 Text="{x:Bind ViewModel.RecordSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                </Border>

                <!-- Reopen the structure designer over what the type holds. -->
                <Button x:Name="EditStructureButton"
                        Grid.Column="1"
                        Style="{StaticResource BareButtonStyle}"
                        ToolTipService.ToolTip="Edit structure"
                        Command="{x:Bind ViewModel.EditStructureCommand}">
                    <Border Width="42"
                            Height="42"
                            CornerRadius="21"
                            Background="{StaticResource CardBackgroundBrush}"
                            BorderBrush="{StaticResource AddActionBorderBrush}"
                            BorderThickness="1">
                        <controls:LineIcon Kind="EditSquare"
                                           Width="19"
                                           Height="19"
                                           Foreground="{StaticResource BrandPrimaryBrush}" />
                    </Border>
                </Button>

                <!-- ADD RECORD, the same supplied icon treatment as every tab. -->
                <Button x:Name="AddRecordButton"
                        Grid.Column="2"
                        Style="{StaticResource BareButtonStyle}"
                        Command="{x:Bind ViewModel.AddRecordCommand}">
                    <Border CornerRadius="21"
                            Padding="14,0,18,0"
                            Height="42"
                            Background="{StaticResource CardBackgroundBrush}"
                            BorderBrush="{StaticResource AddActionBorderBrush}"
                            BorderThickness="1">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="10"
                                    VerticalAlignment="Center">
                            <Grid Width="18" Height="18" VerticalAlignment="Center">
                                <Rectangle Width="18"
                                           Height="18"
                                           RadiusX="6"
                                           RadiusY="6"
                                           Fill="{StaticResource BrandPrimaryBrush}" />
                                <Viewbox Width="18" Height="18">
                                    <Canvas Width="18" Height="18">
                                        <Path Data="M3.74951 8.99999H14.2507 M9.00011 3.74939V14.2506"
                                              Stroke="#FFFFFF"
                                              StrokeThickness="2"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round" />
                                    </Canvas>
                                </Viewbox>
                            </Grid>
                            <TextBlock Text="ADD RECORD"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource JerseyFont}"
                                       FontSize="{StaticResource ButtonFontSize}"
                                       Foreground="{StaticResource BrandPrimaryBrush}"
                                       CharacterSpacing="40" />
                        </StackPanel>
                    </Border>
                </Button>
            </Grid>
        </Grid>

        <!-- Card surface ..................................................... -->
        <Border x:Name="CardSurface"
                Grid.Row="1"
                CornerRadius="26"
                Padding="24"
                Background="{StaticResource CardBackgroundBrush}">

            <Grid>

                <!--
                    Deliberately always visible. An ItemsRepeater inside a collapsed
                    ScrollViewer has no measured viewport, and a collection change
                    reaching it in that state fails with COMException: Unspecified
                    error. The host keeps this view out of the tree until it is
                    drilled in, so the states below paint over an empty surface on
                    the way in and the list is long lived once it is.
                -->
                <ScrollViewer x:Name="CardScroller"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollMode="Disabled"
                              ViewChanged="OnCardScrollChanged"
                              Padding="0,0,4,0">
                    <ItemsRepeater x:Name="CardRepeater"
                                   ItemsSource="{x:Bind ViewModel.Records}"
                                   ItemTemplate="{StaticResource RecordCardTemplate}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout MinItemWidth="430"
                                               MinColumnSpacing="20"
                                               MinRowSpacing="20"
                                               ItemsStretch="Fill" />
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>
                </ScrollViewer>

                <!-- Loading -->
                <Border Background="{StaticResource CardBackgroundBrush}"
                        Visibility="{x:Bind ViewModel.IsRecordLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                        <controls:StateArt Width="112" Height="86" HorizontalAlignment="Center"
                                           Kind="Loading"
                                           IsActive="{x:Bind ViewModel.IsRecordLoading, Mode=OneWay}" />
                        <TextBlock Text="Opening the records"
                                   Style="{StaticResource StateTitleStyle}"
                                   Margin="0,16,0,0" />
                        <TextBlock Text="Just a moment." Style="{StaticResource StateBodyStyle}" />
                    </StackPanel>
                </Border>

                <!-- Empty: the type has been designed but holds nothing -->
                <Border Background="{StaticResource CardBackgroundBrush}"
                        Visibility="{x:Bind ViewModel.IsRecordEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                        <controls:StateArt Width="112" Height="86" HorizontalAlignment="Center"
                                           Kind="Empty"
                                           IsActive="{x:Bind ViewModel.IsRecordEmpty, Mode=OneWay}" />
                        <TextBlock Text="No records yet"
                                   Style="{StaticResource StateTitleStyle}"
                                   Margin="0,16,0,0" />
                        <TextBlock Text="The records you file under this type will appear here."
                                   Style="{StaticResource StateBodyStyle}" />
                    </StackPanel>
                </Border>

                <!-- Empty: records exist, the search excluded them -->
                <Border Background="{StaticResource CardBackgroundBrush}"
                        Visibility="{x:Bind ViewModel.HasRecordNoMatches, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                        <controls:StateArt Width="112" Height="86" HorizontalAlignment="Center"
                                           Kind="NoMatch"
                                           IsActive="{x:Bind ViewModel.HasRecordNoMatches, Mode=OneWay}" />
                        <TextBlock Text="Nothing matches that search"
                                   Style="{StaticResource StateTitleStyle}"
                                   Margin="0,16,0,0" />
                        <TextBlock Text="Try a shorter term, or clear the search to see every record."
                                   Style="{StaticResource StateBodyStyle}" />
                    </StackPanel>
                </Border>

                <!-- Error -->
                <Border Background="{StaticResource CardBackgroundBrush}"
                        Visibility="{x:Bind ViewModel.IsRecordError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                        <controls:StateArt Width="112" Height="86" HorizontalAlignment="Center"
                                           Kind="Error"
                                           IsActive="{x:Bind ViewModel.IsRecordError, Mode=OneWay}" />
                        <TextBlock Text="The records could not be opened"
                                   Style="{StaticResource StateTitleStyle}"
                                   Margin="0,16,0,0" />
                        <TextBlock Text="Nothing was changed. You can try again."
                                   Style="{StaticResource StateBodyStyle}" />
                        <Button Margin="0,20,0,0"
                                HorizontalAlignment="Center"
                                Style="{StaticResource BareButtonStyle}"
                                Command="{x:Bind ViewModel.RetryRecordsCommand}">
                            <Border CornerRadius="20"
                                    Height="40"
                                    Padding="22,0,22,0"
                                    Background="{StaticResource BrandPrimaryBrush}">
                                <TextBlock Text="TRY AGAIN"
                                           VerticalAlignment="Center"
                                           FontFamily="{StaticResource JerseyFont}"
                                           FontSize="{StaticResource ButtonFontSize}"
                                           Foreground="#FFFFFF"
                                           CharacterSpacing="40" />
                            </Border>
                        </Button>
                    </StackPanel>
                </Border>

            </Grid>
        </Border>

        <!--
            Adaptive layout, on the same threshold as every other directory: below
            820 the search row cannot sit beside the title without crushing one of
            them, so it drops to its own line and the search field stretches.
        -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="WidthStates">

                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="820" />
                    </VisualState.StateTriggers>
                </VisualState>

                <VisualState x:Name="NarrowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="Root.Padding" Value="12" />
                        <Setter Target="CardSurface.Padding" Value="12" />
                        <Setter Target="CardSurface.CornerRadius" Value="18" />
                        <Setter Target="Header.Margin" Value="0,0,0,16" />

                        <!-- Actions move under the title and span the full width. -->
                        <Setter Target="HeaderActions.(Grid.Row)" Value="1" />
                        <Setter Target="HeaderActions.(Grid.Column)" Value="0" />
                        <Setter Target="HeaderActions.Margin" Value="0,14,0,0" />
                        <Setter Target="HeaderActionColumn.Width" Value="0" />
                        <Setter Target="SearchColumn.Width" Value="*" />
                        <Setter Target="SearchHost.Width" Value="NaN" />
                    </VisualState.Setters>
                </VisualState>

            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</UserControl>
