<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DoNet.Views.SplashPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DoNet.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource AppBackgroundBrush}">

    <Grid>
        <!--
            StartHidden keeps the lockup blank until the intro runs. It is applied in the
            property setter, which XAML calls while this page is still being constructed,
            so the finished logo never flashes up for a frame first.
        -->
        <controls:DoNetLogo x:Name="Logo"
                            StartHidden="True"
                            Width="320"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
    </Grid>
</Page>
