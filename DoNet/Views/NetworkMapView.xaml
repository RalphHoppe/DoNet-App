<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DoNet.Views.NetworkMapView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:DoNet.Controls"
    xmlns:vm="using:DoNet.ViewModels"
    mc:Ignorable="d">

    <!--
        The VPS map screen: the world as a page, the words beside it.

        The map is a fixed world - 2560 by 1024 world pixels, the plate's
        own latitude band - and everything on it is placed once, in the
        world's own coordinates: the plate image fills it exactly, the
        markers sit on their countries' anchors, the arcs join them. The
        view is a scroller over that world: the wheel zooms about the
        pointer, a drag carries the view, and neither ever moves a marker.
        The markers counter-scale so they stay the same size on screen at
        every depth, and the plate's letterbox - the band of sea the
        scroller shows beside the world when the window is wider than it -
        is part of every screen-to-world conversion, so a zoom is always
        anchored to the point under the pointer.

        The panel carries what a quiet map declines to say: the list -
        every main in the overview, the whole chain stepped in by depth in
        an open network - and, below it, the selected VPS's details as the
        preview's read-only cells. Hovering a row lifts its marker on the
        page; clicking a row is clicking the marker.

        The chooser - the small panel that opens over a country holding
        several mains - is hand-built for the same reason the drawers are:
        the app has no stock dropdowns. It closes the moment the view
        moves, so it can never float loose of its marker.
    -->

    <UserControl.Resources>
        <!-- The connections: gentle arcs, the app's teal for a main's direct
             children, a quieter sage for everything deeper. -->
        <SolidColorBrush x:Key="ConnectionBrush" Color="#4BAA98" />
        <SolidColorBrush x:Key="DeepConnectionBrush" Color="#93BBB0" />

        <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource BaumansFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource BrandPrimaryBrush}" />
            <Setter Property="CharacterSpacing" Value="20" />
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
            <Setter Property="LineHeight" Value="18" />
        </Style>

        <Style x:Key="StateTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource BalooSemiBoldFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
            <Setter Property="LineHeight" Value="20" />
        </Style>

        <!-- The panel's list rows. -->
        <DataTemplate x:Key="RowTemplate" x:DataType="vm:MapRowItem">
            <controls:MapListRow Model="{x:Bind}" />
        </DataTemplate>

        <!-- The panel's detail cells, the preview's read-only vocabulary. -->
        <DataTemplate x:Key="DetailTemplate" x:DataType="vm:MapDetailItem">
            <controls:FieldCell Label="{x:Bind Label}"
                                Value="{x:Bind Value}"
                                UnitValue="{x:Bind Unit}"
                                IconKind="{x:Bind Icon}"
                                Kind="Display"
                                IsSecret="{x:Bind IsSecret}"
                                ShowCopy="{x:Bind ShowCopy}" />
        </DataTemplate>

        <!-- The chooser's rows. -->
        <DataTemplate x:Key="ChooserRowTemplate" x:DataType="vm:MapChooserRow">
            <Button Style="{StaticResource BareButtonStyle}"
                    HorizontalAlignment="Stretch"
                    Tag="{x:Bind Record}"
                    Click="OnChooserRowClick">
                <Border Height="52"
                        CornerRadius="13"
                        Padding="13,5"
                        Background="#F4F6F9"
                        BorderBrush="#E4E6E9"
                        BorderThickness="1">
                    <Grid ColumnSpacing="11">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Viewbox Grid.Column="0"
                                 Width="20"
                                 Height="15"
                                 VerticalAlignment="Center">
                            <controls:FlagIcon Country="{x:Bind FlagCountry}" />
                        </Viewbox>

                        <StackPanel Grid.Column="1"
                                    Spacing="1"
                                    VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Name}"
                                       FontFamily="{StaticResource BalooSemiBoldFont}"
                                       FontSize="13.5"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="200" />
                            <TextBlock Text="{x:Bind Detail}"
                                       FontFamily="{StaticResource BalooFont}"
                                       FontSize="11.5"
                                       Foreground="{StaticResource CardMetaBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="210" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <Border CornerRadius="34"
            Background="{StaticResource CardBackgroundBrush}"
            BorderBrush="{StaticResource CardBorderBrush}"
            BorderThickness="1">
        <Grid>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="392" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- The panel ................................................. -->
            <Grid Grid.Column="0" RowSpacing="12" Padding="26,22,20,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Viewbox Width="30"
                                 Height="30"
                                 VerticalAlignment="Center">
                            <controls:TypeMark Kind="Vps" />
                        </Viewbox>
                        <TextBlock Text="VPS MAP"
                                   FontFamily="{StaticResource BaumansFont}"
                                   FontSize="22"
                                   Foreground="{StaticResource BrandPrimaryBrush}"
                                   CharacterSpacing="20"
                                   VerticalAlignment="Center"
                                   LineStackingStrategy="BlockLineHeight"
                                   LineHeight="28" />
                    </StackPanel>
                    <TextBlock Text="The mains and their networks, the whole earth under them"
                               FontFamily="{StaticResource BalooFont}"
                               FontSize="12.5"
                               Foreground="{StaticResource SectionSubtitleBrush}"
                               TextWrapping="Wrap"
                               LineStackingStrategy="BlockLineHeight"
                               LineHeight="17" />
                </StackPanel>

                <!-- The way back, while a network is open. -->
                <Button Grid.Row="1"
                        Style="{StaticResource BareButtonStyle}"
                        HorizontalAlignment="Left"
                        Visibility="{x:Bind ViewModel.IsFocused, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                        Click="OnBackClick">
                    <Border Height="32"
                            CornerRadius="16"
                            Padding="13,0"
                            Background="{StaticResource HeaderActionFillBrush}"
                            BorderBrush="{StaticResource SearchBorderBrush}"
                            BorderThickness="1">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <controls:LineIcon Kind="ArrowLeft"
                                               Width="14"
                                               Height="14"
                                               Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="ALL MAINS"
                                       FontFamily="{StaticResource BalooSemiBoldFont}"
                                       FontSize="11.5"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       CharacterSpacing="60"
                                       VerticalAlignment="Center"
                                       LineStackingStrategy="BlockLineHeight"
                                       LineHeight="15" />
                        </StackPanel>
                    </Border>
                </Button>

                <!-- The list's own title, whichever list is on show. -->
                <TextBlock Grid.Row="2"
                           x:Name="ListTitle"
                           Text="MAINS"
                           Style="{StaticResource SectionLabelStyle}" />

                <!-- The list itself. -->
                <ScrollViewer Grid.Row="3"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollMode="Disabled">
                    <ItemsRepeater x:Name="RowsRepeater"
                                   ItemTemplate="{StaticResource RowTemplate}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="5" />
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>
                </ScrollViewer>

                <!-- The selected VPS's details, below the list. -->
                <StackPanel Grid.Row="4"
                            Spacing="9"
                            Visibility="{x:Bind ViewModel.IsFocused, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="THE VPS"
                               Style="{StaticResource SectionLabelStyle}" />

                    <StackPanel Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <Viewbox Width="22"
                                     Height="16"
                                     VerticalAlignment="Center"
                                     Visibility="{x:Bind ViewModel.HasSelectedFlag, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                <controls:FlagIcon Country="{x:Bind ViewModel.SelectedFlagCountry, Mode=OneWay}" />
                            </Viewbox>
                            <TextBlock Text="{x:Bind ViewModel.SelectedName, Mode=OneWay}"
                                       FontFamily="{StaticResource BalooSemiBoldFont}"
                                       FontSize="15"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="250"
                                       VerticalAlignment="Center"
                                       LineStackingStrategy="BlockLineHeight"
                                       LineHeight="20" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.SelectedCountryLabel, Mode=OneWay}"
                                   FontFamily="{StaticResource BalooFont}"
                                   FontSize="11.5"
                                   Foreground="{StaticResource CardMetaBrush}"
                                   LineStackingStrategy="BlockLineHeight"
                                   LineHeight="15" />
                        <TextBlock Text="{x:Bind ViewModel.SelectedSummary, Mode=OneWay}"
                                   FontFamily="{StaticResource BalooSemiBoldFont}"
                                   FontSize="11.5"
                                   Foreground="{StaticResource BrandPrimaryBrush}"
                                   LineStackingStrategy="BlockLineHeight"
                                   LineHeight="15" />
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollMode="Disabled"
                                  MaxHeight="320">
                        <ItemsRepeater x:Name="DetailsRepeater"
                                       ItemTemplate="{StaticResource DetailTemplate}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="9" />
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>
                    </ScrollViewer>
                </StackPanel>
            </Grid>

            <!-- The world .................................................. -->
            <Border Grid.Column="1"
                    CornerRadius="0,34,34,0"
                    Background="#F5F1E8">
                <Grid x:Name="MapHost"
                      SizeChanged="OnMapHostSizeChanged"
                      PointerWheelChanged="OnMapWheel"
                      PointerPressed="OnMapPointerPressed"
                      PointerMoved="OnMapPointerMoved"
                      PointerReleased="OnMapPointerReleased"
                      PointerCanceled="OnMapPointerReleased">

                    <!--
                        The scroller owns the view: it clips, it holds the
                        zoom and the offsets, and its ChangeView is the one
                        door through which the view ever moves. User
                        scrolling is disabled - the map's own gestures (the
                        wheel, the drag) decide what moving means - but the
                        scroller's machinery, the clamping to the world's
                        true edges included, keeps working underneath.
                    -->
                    <ScrollViewer x:Name="MapScroll"
                                  HorizontalScrollMode="Disabled"
                                  VerticalScrollMode="Disabled"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Hidden"
                                  IsScrollInertiaEnabled="False"
                                  ZoomMode="Enabled"
                                  ViewChanged="OnScrollViewChanged">

                        <!--
                            The world itself: fixed, in world pixels, its
                            every child placed once and never moved. Centred
                            when the scroller shows more than it holds, so
                            the letterbox splits evenly either side.
                        -->
                        <Grid x:Name="World"
                              Width="2560"
                              Height="1024"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center">
                            <Image Source="ms-appx:///Assets/Maps/world-map.png"
                                   Stretch="Fill" />
                            <Canvas x:Name="ArcLayer" />
                            <Canvas x:Name="MarkerLayer" />
                        </Grid>
                    </ScrollViewer>

                    <!-- The chooser, seated beside its marker in code. -->
                    <Canvas x:Name="ChooserLayer">
                        <Border x:Name="ChooserCard"
                                Width="300"
                                Padding="14"
                                CornerRadius="16"
                                Background="{StaticResource CardBackgroundBrush}"
                                BorderBrush="{StaticResource CardBorderBrush}"
                                BorderThickness="1"
                                Visibility="Collapsed">
                            <StackPanel Spacing="10">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Viewbox Grid.Column="0"
                                             Width="22"
                                             Height="16"
                                             VerticalAlignment="Center">
                                        <controls:FlagIcon x:Name="ChooserFlag" />
                                    </Viewbox>
                                    <TextBlock x:Name="ChooserTitle"
                                               Grid.Column="1"
                                               FontFamily="{StaticResource BalooSemiBoldFont}"
                                               FontSize="12.5"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center"
                                               LineStackingStrategy="BlockLineHeight"
                                               LineHeight="17" />
                                    <Button Grid.Column="2"
                                            Style="{StaticResource BareButtonStyle}"
                                            VerticalAlignment="Top"
                                            Click="OnChooserCloseClick">
                                        <Border Width="20"
                                                Height="20"
                                                CornerRadius="10"
                                                Background="#F1F3F6">
                                            <TextBlock Text="&#215;"
                                                       FontFamily="{StaticResource BalooSemiBoldFont}"
                                                       FontSize="12"
                                                       Foreground="{StaticResource CardMetaBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       LineStackingStrategy="BlockLineHeight"
                                                       LineHeight="12" />
                                        </Border>
                                    </Button>
                                </Grid>

                                <ItemsRepeater x:Name="ChooserRepeater"
                                               ItemTemplate="{StaticResource ChooserRowTemplate}">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Spacing="6" />
                                    </ItemsRepeater.Layout>
                                </ItemsRepeater>
                            </StackPanel>
                        </Border>
                    </Canvas>

                    <!--
                        ZOOM: closer, further, and the whole earth back. The
                        wheel zooms about the pointer and a drag carries the
                        view; these are the same trip with somewhere
                        definite to land.
                    -->
                    <StackPanel HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="14"
                                Spacing="8">
                        <Button Style="{StaticResource BareButtonStyle}"
                                ToolTipService.ToolTip="Zoom in"
                                Click="OnZoomInClick">
                            <Border Width="34"
                                    Height="34"
                                    CornerRadius="17"
                                    Background="#F2FFFFFF"
                                    BorderBrush="{StaticResource CardBorderBrush}"
                                    BorderThickness="1">
                                <Viewbox Width="14"
                                         Height="14">
                                    <Canvas Width="18" Height="18">
                                        <Path Data="M9 3.75 V14.25 M3.75 9 H14.25"
                                              Stroke="#5C6066"
                                              StrokeThickness="2.2"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round" />
                                    </Canvas>
                                </Viewbox>
                            </Border>
                        </Button>

                        <Button Style="{StaticResource BareButtonStyle}"
                                ToolTipService.ToolTip="Zoom out"
                                Click="OnZoomOutClick">
                            <Border Width="34"
                                    Height="34"
                                    CornerRadius="17"
                                    Background="#F2FFFFFF"
                                    BorderBrush="{StaticResource CardBorderBrush}"
                                    BorderThickness="1">
                                <Viewbox Width="14"
                                         Height="14">
                                    <Canvas Width="18" Height="18">
                                        <Path Data="M3.75 9 H14.25"
                                              Stroke="#5C6066"
                                              StrokeThickness="2.2"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round" />
                                    </Canvas>
                                </Viewbox>
                            </Border>
                        </Button>

                        <Button Style="{StaticResource BareButtonStyle}"
                                ToolTipService.ToolTip="Back to the whole earth"
                                Click="OnZoomResetClick">
                            <Border Width="34"
                                    Height="34"
                                    CornerRadius="17"
                                    Background="#F2FFFFFF"
                                    BorderBrush="{StaticResource CardBorderBrush}"
                                    BorderThickness="1">
                                <Viewbox Width="14"
                                         Height="14">
                                    <Canvas Width="18" Height="18">
                                        <Path Data="M3 6.6 V4.8 Q3 3 4.8 3 H6.6 M11.4 3 H13.2 Q15 3 15 4.8 V6.6 M15 11.4 V13.2 Q15 15 13.2 15 H11.4 M6.6 15 H4.8 Q3 15 3 13.2 V11.4"
                                              Stroke="#5C6066"
                                              StrokeThickness="2"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round" />
                                    </Canvas>
                                </Viewbox>
                            </Border>
                        </Button>
                    </StackPanel>

                    <!-- The states, centred on the world, in the app's own
                         illustrations. -->
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="10"
                                Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <controls:StateArt Width="112"
                                           Height="86"
                                           Kind="Loading"
                                           IsActive="True" />
                        <TextBlock Text="Plotting the network..."
                                   Style="{StaticResource StateTextStyle}" />
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="10"
                                Visibility="{x:Bind ViewModel.IsError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <controls:StateArt Width="112"
                                           Height="86"
                                           Kind="Error"
                                           IsActive="False" />
                        <TextBlock Text="The directory refused - go back and try again."
                                   Style="{StaticResource StateTextStyle}" />
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="10"
                                Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <controls:StateArt Width="112"
                                           Height="86"
                                           Kind="Empty"
                                           IsActive="False" />
                        <TextBlock Text="No VPS records yet"
                                   Style="{StaticResource StateTextStyle}" />
                        <TextBlock Text="Add one, and it lands on the page."
                                   Style="{StaticResource StateTextStyle}" />
                    </StackPanel>

                    <!-- The honest footnote about the records that could not
                         be placed. -->
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                Margin="12"
                                Orientation="Horizontal"
                                Spacing="7"
                                Visibility="{x:Bind ViewModel.HasOffMap, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <controls:LineIcon Kind="Info"
                                           Width="13"
                                           Height="13"
                                           Foreground="{StaticResource CardMetaBrush}"
                                           VerticalAlignment="Center" />
                        <TextBlock Text="{x:Bind ViewModel.OffMapNote, Mode=OneWay}"
                                   FontFamily="{StaticResource BalooFont}"
                                   FontSize="11.5"
                                   Foreground="{StaticResource CardMetaBrush}"
                                   VerticalAlignment="Center"
                                   LineStackingStrategy="BlockLineHeight"
                                   LineHeight="15" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
