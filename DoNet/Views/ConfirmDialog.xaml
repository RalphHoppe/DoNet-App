<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DoNet.Views.ConfirmDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        The delete confirmation. Deleting a person removes eighteen fields including
        account passwords and recovery words, and nothing restores them, so it asks
        first. There is no design for this one - it borrows the dialog's surface, the
        danger palette already used by the forgot-password screen, and nothing else.
    -->

    <UserControl.Resources>
        <Storyboard x:Key="OpenStoryboard">
            <DoubleAnimation Storyboard.TargetName="Scrim"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.14" />
            <DoubleAnimation Storyboard.TargetName="CardScale"
                             Storyboard.TargetProperty="ScaleX"
                             From="0.94" To="1" Duration="0:0:0.22">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="CardScale"
                             Storyboard.TargetProperty="ScaleY"
                             From="0.94" To="1" Duration="0:0:0.22">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Card"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.18" />
        </Storyboard>
    </UserControl.Resources>

    <Grid x:Name="Root" Visibility="Collapsed">
        <Rectangle x:Name="Scrim" Fill="#59000000" Tapped="OnScrimTapped" />

        <Border x:Name="Card"
                Width="440"
                CornerRadius="20"
                Padding="28"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Background="{StaticResource CardBackgroundBrush}"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1" />
            </Border.RenderTransform>

            <StackPanel Spacing="10">
                <Viewbox Width="40" Height="40" HorizontalAlignment="Left">
                    <Canvas Width="28" Height="28">
                        <Path Data="M4.7 7.3H23.3 M10.8 7.3V5C10.8 4 11.6 3.2 12.6 3.2H15.4C16.4 3.2 17.2 4 17.2 5V7.3 M20.8 7.3V22C20.8 23 20 23.8 19 23.8H9C8 23.8 7.2 23 7.2 22V7.3 M11.8 12V19 M16.2 12V19"
                              Stroke="{StaticResource DangerBrush}"
                              StrokeThickness="1.5"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round" />
                    </Canvas>
                </Viewbox>

                <TextBlock x:Name="TitleText"
                           FontFamily="{StaticResource BalooSemiBoldFont}"
                           FontSize="20"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           LineStackingStrategy="BlockLineHeight"
                           LineHeight="26" />

                <TextBlock x:Name="BodyText"
                           FontFamily="{StaticResource BalooFont}"
                           FontSize="{StaticResource FieldValueFontSize}"
                           Foreground="{StaticResource CardMetaBrush}"
                           TextWrapping="Wrap"
                           LineStackingStrategy="BlockLineHeight"
                           LineHeight="22" />

                <StackPanel Orientation="Horizontal"
                            Spacing="12"
                            Margin="0,14,0,0"
                            HorizontalAlignment="Right">
                    <Button Style="{StaticResource BareButtonStyle}" Click="OnCancelClick">
                        <Border Height="44"
                                MinWidth="110"
                                CornerRadius="10"
                                Background="{StaticResource CardBackgroundBrush}"
                                BorderBrush="{StaticResource SearchBorderBrush}"
                                BorderThickness="1">
                            <TextBlock Text="CANCEL"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource JerseyFont}"
                                       FontSize="{StaticResource ButtonFontSize}"
                                       Foreground="{StaticResource CardMetaBrush}"
                                       CharacterSpacing="40" />
                        </Border>
                    </Button>

                    <Button Style="{StaticResource BareButtonStyle}" Click="OnConfirmClick">
                        <Border Height="44"
                                MinWidth="110"
                                CornerRadius="10"
                                Background="{StaticResource DangerBrush}">
                            <TextBlock Text="DELETE"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource JerseyFont}"
                                       FontSize="{StaticResource ButtonFontSize}"
                                       Foreground="#FFFFFF"
                                       CharacterSpacing="40" />
                        </Border>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
