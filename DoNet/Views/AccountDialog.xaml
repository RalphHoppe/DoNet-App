<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DoNet.Views.AccountDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:DoNet.Controls"
    mc:Ignorable="d">

    <!--
        The account dialog, in all three modes: ACCOUNT INFO, ADD ACCOUNT and EDIT
        ACCOUNT. One control, for the same reason the other two dialogs are one.

        A single column rather than the other dialogs' two or three. Four fields do
        not need columns, and the design draws them stacked at full width - which also
        means this dialog needs no narrow visual state: one column is already the
        narrow layout.

        Hosted at the HomePage root rather than inside AccountsView so it covers the
        whole window including the rail, which is what a modal should do.
    -->

    <UserControl.Resources>

        <!-- The dialog's entrance: a short rise and settle under a fading scrim. -->
        <Storyboard x:Key="OpenStoryboard">
            <DoubleAnimation Storyboard.TargetName="Scrim"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.16" />
            <DoubleAnimation Storyboard.TargetName="CardOffset"
                             Storyboard.TargetProperty="Y"
                             From="18" To="0" Duration="0:0:0.26">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="CardScale"
                             Storyboard.TargetProperty="ScaleX"
                             From="0.985" To="1" Duration="0:0:0.26">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="CardScale"
                             Storyboard.TargetProperty="ScaleY"
                             From="0.985" To="1" Duration="0:0:0.26">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Card"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.20" />
        </Storyboard>

        <!--
            ACCOUNT INFO turning into the edit form. The fields are the same four
            either way, so a hard swap reads as a glitch rather than a change of
            mode. A short dip and rise makes it the same panel changing state.
        -->
        <Storyboard x:Key="ModeChangeStoryboard">
            <DoubleAnimation Storyboard.TargetName="FieldGrid"
                             Storyboard.TargetProperty="Opacity"
                             From="0.25" To="1" Duration="0:0:0.26">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="FieldShift"
                             Storyboard.TargetProperty="Y"
                             From="10" To="0" Duration="0:0:0.30">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="HeaderBlock"
                             Storyboard.TargetProperty="Opacity"
                             From="0.3" To="1" Duration="0:0:0.24" />
            <DoubleAnimation Storyboard.TargetName="FooterBlock"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.28" />
        </Storyboard>

        <Storyboard x:Key="CloseStoryboard" Completed="OnCloseCompleted">
            <DoubleAnimation Storyboard.TargetName="Scrim"
                             Storyboard.TargetProperty="Opacity"
                             To="0" Duration="0:0:0.14" />
            <DoubleAnimation Storyboard.TargetName="Card"
                             Storyboard.TargetProperty="Opacity"
                             To="0" Duration="0:0:0.14" />
            <DoubleAnimation Storyboard.TargetName="CardOffset"
                             Storyboard.TargetProperty="Y"
                             To="12" Duration="0:0:0.14">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </UserControl.Resources>

    <Grid x:Name="Root" Visibility="Collapsed">

        <Rectangle x:Name="Scrim" Fill="#59000000" Tapped="OnScrimTapped" />

        <Border x:Name="Card"
                MaxWidth="720"
                Margin="24"
                CornerRadius="26"
                Background="{StaticResource CardBackgroundBrush}"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1" />
                    <TranslateTransform x:Name="CardOffset" Y="0" />
                </TransformGroup>
            </Border.RenderTransform>

            <Grid Padding="40,32,40,28" RowSpacing="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header .................................................. -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel x:Name="HeaderBlock" Grid.Column="0">
                        <StackPanel Orientation="Horizontal">
                            <!--
                                The account mark, not a mode mark. The other two
                                dialogs swap plus, pencil and info with the mode; the
                                supplied design keeps the record's own icon in all
                                three, and the title beside it already says the mode.
                            -->
                            <Border Width="40"
                                    Height="40"
                                    CornerRadius="20"
                                    Margin="0,0,14,0"
                                    VerticalAlignment="Center"
                                    Background="{StaticResource CardAvatarBrush}"
                                    BorderBrush="{StaticResource SearchBorderBrush}"
                                    BorderThickness="1">
                                <controls:LineIcon Kind="Account"
                                                   Width="22"
                                                   Height="22"
                                                   Foreground="{StaticResource BrandPrimaryBrush}" />
                            </Border>
                            <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                                       FontFamily="{StaticResource BaumansFont}"
                                       FontSize="{StaticResource SectionTitleFontSize}"
                                       Foreground="{StaticResource BrandPrimaryBrush}"
                                       CharacterSpacing="20"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       LineStackingStrategy="BlockLineHeight"
                                       LineHeight="40" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}"
                                   FontFamily="{StaticResource BalooFont}"
                                   FontSize="{StaticResource SectionSubtitleFontSize}"
                                   Foreground="{StaticResource SectionSubtitleBrush}"
                                   TextWrapping="Wrap"
                                   LineStackingStrategy="BlockLineHeight"
                                   LineHeight="20" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            VerticalAlignment="Top"
                            Style="{StaticResource BareButtonStyle}"
                            ToolTipService.ToolTip="Close"
                            Click="OnCloseClick">
                        <!--
                            The title bar's close dot, at dialog scale. No glyph
                            inside: the red disc is the affordance, the same way the
                            window's own close dot is. The 38px hit target is kept by
                            padding the button, so the mark is small without being
                            hard to hit.
                        -->
                        <Border Width="22"
                                Height="22"
                                Margin="8"
                                CornerRadius="11"
                                Background="#FF5F57" />
                    </Button>
                </Grid>

                <!-- Fields .................................................. -->
                <ScrollViewer Grid.Row="1"
                              Margin="0,0,-26,0"
                              Padding="0,0,26,0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollMode="Disabled">
                    <StackPanel x:Name="FieldGrid" Spacing="16">
                        <StackPanel.RenderTransform>
                            <TranslateTransform x:Name="FieldShift" Y="0" />
                        </StackPanel.RenderTransform>

                        <!--
                            A picker, not a text box. An account has to point at a
                            site that exists, and the id behind the label is what gets
                            stored - so typing a name that nearly matches is not a
                            near miss, it is a record that cannot be saved.
                        -->
                        <controls:FieldCell Label="WEBSITE"
                                            IconKind="Globe"
                                            Placeholder="Select a saved website"
                                            TabOrder="1"
                                            InputKind="Choice"
                                            Options="{x:Bind ViewModel.WebsiteOptions, Mode=OneWay}"
                                            Value="{x:Bind ViewModel.WebsiteLabel, Mode=TwoWay}"
                                            Kind="{x:Bind ViewModel.FieldKind, Mode=OneWay}"
                                            ShowCopy="{x:Bind ViewModel.IsPreview, Mode=OneWay}" />

                        <controls:FieldCell Label="USERNAME/EMAIL"
                                            IconKind="Mail"
                                            Placeholder="Enter username or email"
                                            TabOrder="2"
                                            InputKind="Text"
                                            Value="{x:Bind ViewModel.Username, Mode=TwoWay}"
                                            Kind="{x:Bind ViewModel.FieldKind, Mode=OneWay}"
                                            ShowCopy="{x:Bind ViewModel.IsPreview, Mode=OneWay}" />

                        <controls:FieldCell Label="PASSWORD"
                                            IconKind="Lock"
                                            Placeholder="Enter a password"
                                            TabOrder="3"
                                            IsSecret="True"
                                            ShowGenerate="True"
                                            Value="{x:Bind ViewModel.Password, Mode=TwoWay}"
                                            Kind="{x:Bind ViewModel.FieldKind, Mode=OneWay}"
                                            ShowCopy="{x:Bind ViewModel.IsPreview, Mode=OneWay}" />

                        <controls:FieldCell Label="NOTE"
                                            IconKind="Info"
                                            Placeholder="Add a note about this account"
                                            TabOrder="4"
                                            InputKind="Multiline"
                                            Value="{x:Bind ViewModel.Note, Mode=TwoWay}"
                                            Kind="{x:Bind ViewModel.FieldKind, Mode=OneWay}"
                                            ShowCopy="{x:Bind ViewModel.IsPreview, Mode=OneWay}" />
                    </StackPanel>
                </ScrollViewer>

                <Grid x:Name="FooterBlock" Grid.Row="2" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Preview: one full-width action. -->
                    <Button x:Name="PreviewAction"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            HorizontalAlignment="Stretch"
                            Visibility="{x:Bind ViewModel.IsPreview, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                            Style="{StaticResource BareButtonStyle}"
                            Click="OnPrimaryClick">
                        <Border Height="52"
                                CornerRadius="26"
                                Background="{StaticResource BrandPrimaryBrush}">
                            <TextBlock Text="{x:Bind ViewModel.PrimaryActionText, Mode=OneWay}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource JerseyFont}"
                                       FontSize="{StaticResource ButtonFontSize}"
                                       Foreground="#FFFFFF"
                                       CharacterSpacing="40" />
                        </Border>
                    </Button>

                    <!-- Add and edit: cancel plus the commit. -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="14"
                                Visibility="{x:Bind ViewModel.IsEditing, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <Button Style="{StaticResource BareButtonStyle}" Click="OnCancelClick">
                            <Border Height="52"
                                    MinWidth="150"
                                    CornerRadius="26"
                                    Background="{StaticResource CardBackgroundBrush}"
                                    BorderBrush="{StaticResource SearchBorderBrush}"
                                    BorderThickness="1">
                                <TextBlock Text="CANCEL"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontFamily="{StaticResource JerseyFont}"
                                           FontSize="{StaticResource ButtonFontSize}"
                                           Foreground="{StaticResource CardMetaBrush}"
                                           CharacterSpacing="40" />
                            </Border>
                        </Button>

                        <Button Style="{StaticResource BareButtonStyle}" Click="OnPrimaryClick">
                            <Border Height="52"
                                    MinWidth="210"
                                    CornerRadius="26"
                                    Background="{StaticResource BrandPrimaryBrush}">
                                <TextBlock Text="{x:Bind ViewModel.PrimaryActionText, Mode=OneWay}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontFamily="{StaticResource JerseyFont}"
                                           FontSize="{StaticResource ButtonFontSize}"
                                           Foreground="#FFFFFF"
                                           CharacterSpacing="40" />
                            </Border>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!--
            No width states. The layout is one column at every size; all the narrow
            window needs is for the card to stop holding a 24px margin it cannot
            afford.
        -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="DialogWidthStates">
                <VisualState x:Name="DialogWide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1000" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="DialogNarrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="Card.Margin" Value="12" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</UserControl>
