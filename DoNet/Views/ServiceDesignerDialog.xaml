<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DoNet.Views.ServiceDesignerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:DoNet.Controls"
    xmlns:vm="using:DoNet.ViewModels"
    mc:Ignorable="d">

    <!--
        The structure designer: the window a service type is given its shape in.
        It opens on the first open of a type, and again from the records screen's
        edit-structure button.

        The vocabulary is deliberately not a database's. A row is not "column with
        type varchar" - it is a field with a kind, and the kinds are the things a
        vault record actually holds: text, a note, a number, a date, a password,
        and three pointers into the directories that already exist. A table is not
        a join - it is a list that rides along with every record, filled one row at
        a time in the record form.
    -->

    <UserControl.Resources>

        <!-- The dialog's entrance: a short rise and settle under a fading scrim. -->
        <Storyboard x:Key="OpenStoryboard">
            <DoubleAnimation Storyboard.TargetName="Scrim"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.16" />
            <DoubleAnimation Storyboard.TargetName="CardOffset"
                             Storyboard.TargetProperty="Y"
                             From="18" To="0" Duration="0:0:0.26">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="CardScale"
                             Storyboard.TargetProperty="ScaleX"
                             From="0.985" To="1" Duration="0:0:0.26">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="CardScale"
                             Storyboard.TargetProperty="ScaleY"
                             From="0.985" To="1" Duration="0:0:0.26">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Card"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.20" />
        </Storyboard>

        <Storyboard x:Key="CloseStoryboard" Completed="OnCloseCompleted">
            <DoubleAnimation Storyboard.TargetName="Scrim"
                             Storyboard.TargetProperty="Opacity"
                             To="0" Duration="0:0:0.14" />
            <DoubleAnimation Storyboard.TargetName="Card"
                             Storyboard.TargetProperty="Opacity"
                             To="0" Duration="0:0:0.14" />
            <DoubleAnimation Storyboard.TargetName="CardOffset"
                             Storyboard.TargetProperty="Y"
                             To="12" Duration="0:0:0.14">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- The bare input the field rows' labels and the table names share. -->
        <Style x:Key="DraftBoxStyle" TargetType="TextBox" BasedOn="{StaticResource BareTextBoxStyle}">
            <Setter Property="FontFamily" Value="{StaticResource BalooFont}" />
            <Setter Property="FontSize" Value="{StaticResource FieldValueFontSize}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="14,0,14,0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!-- One field row: the label, the kind, and the row's own controls. -->
        <DataTemplate x:Key="FieldRowTemplate" x:DataType="vm:DesignerFieldDraft">
            <Border CornerRadius="16"
                    Padding="12"
                    Margin="0,0,0,10"
                    Background="{StaticResource CardAvatarBrush}"
                    BorderBrush="{StaticResource FieldBorderBrush}"
                    BorderThickness="1">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="168" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- The label. Updates as it is typed, so the save button
                         keeps up with the row instead of waiting for a blur. -->
                    <Border Grid.Column="0"
                            CornerRadius="12"
                            Background="{StaticResource CardBackgroundBrush}"
                            BorderBrush="{StaticResource FieldBorderBrush}"
                            BorderThickness="1"
                            VerticalAlignment="Stretch">
                        <TextBox Style="{StaticResource DraftBoxStyle}"
                                 PlaceholderText="Field name"
                                 Text="{Binding Label, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </Border>

                    <!-- What the field holds. -->
                    <ComboBox Grid.Column="1"
                              Height="40"
                              FontFamily="{StaticResource BalooFont}"
                              FontSize="{StaticResource FieldValueFontSize}"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              HorizontalAlignment="Stretch"
                              ItemsSource="{x:Bind ViewModel.KindChoices, Mode=OneTime}"
                              SelectedItem="{Binding KindName, Mode=TwoWay}" />

                    <!-- Order and remove. The order is the structure: the card
                         previews the first fields, and the first text field
                         names every record. -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Button Width="36"
                                Height="36"
                                Style="{StaticResource BareButtonStyle}"
                                ToolTipService.ToolTip="Move up"
                                CommandParameter="{Binding}"
                                Click="OnMoveUpClick">
                            <Border Width="36"
                                    Height="36"
                                    CornerRadius="18"
                                    Background="{StaticResource CardBackgroundBrush}"
                                    BorderBrush="{StaticResource FieldBorderBrush}"
                                    BorderThickness="1">
                                <controls:LineIcon Kind="ChevronDown"
                                                   Width="15"
                                                   Height="15"
                                                   Foreground="{StaticResource CardMetaBrush}"
                                                   RenderTransformOrigin="0.5,0.5">
                                    <controls:LineIcon.RenderTransform>
                                        <RotateTransform Angle="180" />
                                    </controls:LineIcon.RenderTransform>
                                </controls:LineIcon>
                            </Border>
                        </Button>

                        <Button Width="36"
                                Height="36"
                                Style="{StaticResource BareButtonStyle}"
                                ToolTipService.ToolTip="Move down"
                                CommandParameter="{Binding}"
                                Click="OnMoveDownClick">
                            <Border Width="36"
                                    Height="36"
                                    CornerRadius="18"
                                    Background="{StaticResource CardBackgroundBrush}"
                                    BorderBrush="{StaticResource FieldBorderBrush}"
                                    BorderThickness="1">
                                <controls:LineIcon Kind="ChevronDown"
                                                   Width="15"
                                                   Height="15"
                                                   Foreground="{StaticResource CardMetaBrush}" />
                            </Border>
                        </Button>

                        <Button Width="36"
                                Height="36"
                                Style="{StaticResource BareButtonStyle}"
                                ToolTipService.ToolTip="Remove field"
                                CommandParameter="{Binding}"
                                Click="OnRemoveClick">
                            <Border Width="36"
                                    Height="36"
                                    CornerRadius="18"
                                    Background="{StaticResource CardBackgroundBrush}"
                                    BorderBrush="{StaticResource FieldBorderBrush}"
                                    BorderThickness="1">
                                <controls:LineIcon Kind="Trash"
                                                   Width="15"
                                                   Height="15"
                                                   Foreground="{StaticResource DangerBrush}" />
                            </Border>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- One table block: a name, its own field rows, and its own add. -->
        <DataTemplate x:Key="TableBlockTemplate" x:DataType="vm:DesignerTableDraft">
            <Border CornerRadius="16"
                    Padding="14"
                    Margin="0,0,0,12"
                    Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource SearchBorderBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="10">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                CornerRadius="12"
                                Background="{StaticResource CardAvatarBrush}"
                                BorderBrush="{StaticResource FieldBorderBrush}"
                                BorderThickness="1">
                            <TextBox Style="{StaticResource DraftBoxStyle}"
                                     Height="40"
                                     PlaceholderText="Table name - e.g. System information"
                                     Text="{Binding Label, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </Border>

                        <Button Grid.Column="1"
                                Width="36"
                                Height="36"
                                Style="{StaticResource BareButtonStyle}"
                                ToolTipService.ToolTip="Remove table"
                                CommandParameter="{Binding}"
                                Click="OnRemoveTableClick">
                            <Border Width="36"
                                    Height="36"
                                    CornerRadius="18"
                                    Background="{StaticResource CardAvatarBrush}"
                                    BorderBrush="{StaticResource FieldBorderBrush}"
                                    BorderThickness="1">
                                <controls:LineIcon Kind="Trash"
                                                   Width="15"
                                                   Height="15"
                                   Foreground="{StaticResource DangerBrush}" />
                            </Border>
                        </Button>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Fields}"
                                  ItemTemplate="{StaticResource FieldRowTemplate}" />

                    <!-- A row shape that belongs to this table alone: the
                         columns of "VPS Systems Informations", not of the record. -->
                    <Button Style="{StaticResource BareButtonStyle}"
                            HorizontalAlignment="Left"
                            CommandParameter="{Binding}"
                            Click="OnAddTableFieldClick">
                        <Border CornerRadius="14"
                                Height="34"
                                Padding="12,0,16,0"
                                Background="{StaticResource CardAvatarBrush}"
                                BorderBrush="{StaticResource FieldBorderBrush}"
                                BorderThickness="1">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <controls:LineIcon Kind="Plus"
                                                   Width="14"
                                                   Height="14"
                                                   Foreground="{StaticResource BrandPrimaryBrush}" />
                                <TextBlock Text="ADD ROW FIELD"
                                           FontFamily="{StaticResource JerseyFont}"
                                           FontSize="12"
                                           Foreground="{StaticResource BrandPrimaryBrush}"
                                           CharacterSpacing="40"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Button>
                </StackPanel>
            </Border>
        </DataTemplate>

    </UserControl.Resources>

    <Grid x:Name="Root" Visibility="Collapsed">

        <Rectangle x:Name="Scrim" Fill="#59000000" Tapped="OnScrimTapped" />

        <Border x:Name="Card"
                MaxWidth="860"
                Margin="24"
                CornerRadius="26"
                Background="{StaticResource CardBackgroundBrush}"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1" />
                    <TranslateTransform x:Name="CardOffset" Y="0" />
                </TransformGroup>
            </Border.RenderTransform>

            <Grid Padding="40,32,40,28" RowSpacing="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header .................................................. -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="40"
                                    Height="40"
                                    CornerRadius="20"
                                    Margin="0,0,14,0"
                                    VerticalAlignment="Center"
                                    Background="{StaticResource CardAvatarBrush}"
                                    BorderBrush="{StaticResource SearchBorderBrush}"
                                    BorderThickness="1">
                                <controls:LineIcon Kind="Briefcase"
                                                   Width="22"
                                                   Height="22"
                                                   Foreground="{StaticResource BrandPrimaryBrush}" />
                            </Border>
                            <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                                       FontFamily="{StaticResource BaumansFont}"
                                       FontSize="{StaticResource SectionTitleFontSize}"
                                       Foreground="{StaticResource BrandPrimaryBrush}"
                                       CharacterSpacing="20"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       LineStackingStrategy="BlockLineHeight"
                                       LineHeight="40" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}"
                                   FontFamily="{StaticResource BalooFont}"
                                   FontSize="{StaticResource SectionSubtitleFontSize}"
                                   Foreground="{StaticResource SectionSubtitleBrush}"
                                   TextWrapping="Wrap"
                                   LineStackingStrategy="BlockLineHeight"
                                   LineHeight="20" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            VerticalAlignment="Top"
                            Style="{StaticResource BareButtonStyle}"
                            ToolTipService.ToolTip="Close"
                            Click="OnCloseClick">
                        <Border Width="22"
                                Height="22"
                                Margin="8"
                                CornerRadius="11"
                                Background="#FF5F57" />
                    </Button>
                </Grid>

                <!-- The designer ........................................... -->
                <ScrollViewer Grid.Row="1"
                              Margin="0,0,-26,0"
                              Padding="0,0,26,0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollMode="Disabled">
                    <StackPanel Spacing="18">

                        <!-- Record fields -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="RECORD FIELDS"
                                       FontFamily="{StaticResource BaumansFont}"
                                       FontSize="16"
                                       Foreground="{StaticResource BrandPrimaryBrush}"
                                       CharacterSpacing="20" />
                            <TextBlock Text="What every record carries, top to bottom. The first text field names every record."
                                       FontFamily="{StaticResource BalooFont}"
                                       FontSize="{StaticResource SectionSubtitleFontSize}"
                                       Foreground="{StaticResource CardMetaBrush}"
                                       TextWrapping="Wrap"
                                       LineStackingStrategy="BlockLineHeight"
                                       LineHeight="20" />
                        </StackPanel>

                        <ItemsControl ItemsSource="{x:Bind ViewModel.Fields, Mode=OneTime}"
                                      ItemTemplate="{StaticResource FieldRowTemplate}" />

                        <Button Style="{StaticResource BareButtonStyle}"
                                HorizontalAlignment="Left"
                                Click="OnAddFieldClick">
                            <Border CornerRadius="16"
                                    Height="40"
                                    Padding="14,0,18,0"
                                    Background="{StaticResource CardBackgroundBrush}"
                                    BorderBrush="{StaticResource AddActionBorderBrush}"
                                    BorderThickness="1">
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <controls:LineIcon Kind="Plus"
                                                       Width="15"
                                                       Height="15"
                                                       Foreground="{StaticResource BrandPrimaryBrush}" />
                                    <TextBlock Text="ADD FIELD"
                                               FontFamily="{StaticResource JerseyFont}"
                                               FontSize="{StaticResource ButtonFontSize}"
                                               Foreground="{StaticResource BrandPrimaryBrush}"
                                               CharacterSpacing="40"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Button>

                        <!-- Repeatable tables -->
                        <StackPanel Spacing="6" Margin="0,10,0,0">
                            <TextBlock Text="REPEATABLE TABLES"
                                       FontFamily="{StaticResource BaumansFont}"
                                       FontSize="16"
                                       Foreground="{StaticResource BrandPrimaryBrush}"
                                       CharacterSpacing="20" />
                            <TextBlock Text="Lists that ride along with every record - a row per system on a VPS, a row per phone number. Filled in the record form, one row at a time."
                                       FontFamily="{StaticResource BalooFont}"
                                       FontSize="{StaticResource SectionSubtitleFontSize}"
                                       Foreground="{StaticResource CardMetaBrush}"
                                       TextWrapping="Wrap"
                                       LineStackingStrategy="BlockLineHeight"
                                       LineHeight="20" />
                        </StackPanel>

                        <ItemsControl ItemsSource="{x:Bind ViewModel.Tables, Mode=OneTime}"
                                      ItemTemplate="{StaticResource TableBlockTemplate}" />

                        <Button Style="{StaticResource BareButtonStyle}"
                                HorizontalAlignment="Left"
                                Click="OnAddTableClick">
                            <Border CornerRadius="16"
                                    Height="40"
                                    Padding="14,0,18,0"
                                    Background="{StaticResource CardBackgroundBrush}"
                                    BorderBrush="{StaticResource AddActionBorderBrush}"
                                    BorderThickness="1">
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <controls:LineIcon Kind="Plus"
                                                       Width="15"
                                                       Height="15"
                                                       Foreground="{StaticResource BrandPrimaryBrush}" />
                                    <TextBlock Text="ADD TABLE"
                                               FontFamily="{StaticResource JerseyFont}"
                                               FontSize="{StaticResource ButtonFontSize}"
                                               Foreground="{StaticResource BrandPrimaryBrush}"
                                               CharacterSpacing="40"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Button>

                    </StackPanel>
                </ScrollViewer>

                <!-- Footer ................................................... -->
                <Grid Grid.Row="2" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            HorizontalAlignment="Right"
                            Style="{StaticResource BareButtonStyle}"
                            Click="OnCancelClick">
                        <Border Height="52"
                                MinWidth="150"
                                CornerRadius="26"
                                Background="{StaticResource CardBackgroundBrush}"
                                BorderBrush="{StaticResource SearchBorderBrush}"
                                BorderThickness="1">
                            <TextBlock Text="CANCEL"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource JerseyFont}"
                                       FontSize="{StaticResource ButtonFontSize}"
                                       Foreground="{StaticResource CardMetaBrush}"
                                       CharacterSpacing="40" />
                        </Border>
                    </Button>

                    <!--
                        Disabled until the structure is worth saving: at least one
                        field, every label filled and unique in its scope.
                    -->
                    <Button Grid.Column="1"
                            Style="{StaticResource BareButtonStyle}"
                            IsEnabled="{x:Bind ViewModel.CanSave, Mode=OneWay}"
                            Click="OnSaveClick">
                        <Border Height="52"
                                MinWidth="210"
                                CornerRadius="26"
                                Background="{StaticResource BrandPrimaryBrush}">
                            <TextBlock Text="SAVE STRUCTURE"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource JerseyFont}"
                                       FontSize="{StaticResource ButtonFontSize}"
                                       Foreground="#FFFFFF"
                                       CharacterSpacing="40" />
                        </Border>
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="DialogWidthStates">
                <VisualState x:Name="DialogWide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1000" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="DialogNarrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="Card.Margin" Value="12" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</UserControl>
