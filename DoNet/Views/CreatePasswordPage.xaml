<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DoNet.Views.CreatePasswordPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DoNet.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource AppBackgroundBrush}">

    <Page.Resources>
        <Storyboard x:Key="IntroStoryboard">
            <DoubleAnimation Storyboard.TargetName="ContentPanel"
                             Storyboard.TargetProperty="(UIElement.Opacity)"
                             From="0" To="1" Duration="0:0:0.30" />
            <DoubleAnimation Storyboard.TargetName="ContentPanel"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                             From="10" To="0" Duration="0:0:0.38">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Page.Resources>

    <Grid>
        <!--
            Fixed 352px column, centred, nudged 24px above the optical centre to match the
            Figma frame. Widths are deliberately fixed rather than proportional - the form
            should not stretch when the window is resized.
        -->
        <StackPanel x:Name="ContentPanel"
                    Width="352"
                    Margin="0,-24,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

            <StackPanel.RenderTransform>
                <TranslateTransform />
            </StackPanel.RenderTransform>

            <controls:DoNetLogo Width="118" HorizontalAlignment="Center" />

            <!--
                Baloo 2 declares a 1.6em line box, so an unpinned TextBlock would be ~26px
                tall and push everything below it out of rhythm. LineHeight pins the slot.
            -->
            <TextBlock Style="{StaticResource SubtitleTextStyle}"
                       Margin="0,26,0,0"
                       LineHeight="20"
                       LineStackingStrategy="BlockLineHeight"
                       Text="Create a password for your DoNet account." />

            <controls:PasswordField x:Name="PasswordInput"
                                    Margin="0,20,0,0"
                                    PlaceholderText="Create password"
                                    Password="{x:Bind ViewModel.Password, Mode=TwoWay}"
                                    HasError="{x:Bind ViewModel.HasPasswordError, Mode=OneWay}"
                                    Submitted="OnFieldSubmitted" />

            <controls:PasswordField x:Name="ConfirmInput"
                                    Margin="0,12,0,0"
                                    PlaceholderText="Retype password"
                                    Password="{x:Bind ViewModel.ConfirmPassword, Mode=TwoWay}"
                                    HasError="{x:Bind ViewModel.HasConfirmError, Mode=OneWay}"
                                    Submitted="OnFieldSubmitted" />

            <!--
                One slot, three states: amber guidance at rest, red on a validation
                failure, green once the vault exists. Identical height in every case, so
                the button below never jumps.
            -->
            <Grid Margin="0,18,0,0" MinHeight="32">

                <Border CornerRadius="8"
                        BorderThickness="1"
                        Background="{StaticResource NoticeBackgroundBrush}"
                        BorderBrush="{StaticResource NoticeBorderBrush}"
                        Visibility="{x:Bind ViewModel.ShowGuidance, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="11,0,12,0">
                        <Canvas Width="16" Height="16" VerticalAlignment="Center">
                            <Path Stretch="None"
                                  Stroke="{StaticResource NoticeForegroundBrush}"
                                  StrokeThickness="1.35"
                                  StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Data="M8,2.5 L15.1,14.1 L0.9,14.1 Z M8,6.6 L8,9.9 M8,11.6 L8,11.75" />
                        </Canvas>
                        <TextBlock Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   FontFamily="{StaticResource BalooFont}"
                                   FontSize="{StaticResource NoticeFontSize}"
                                   LineHeight="16"
                                   LineStackingStrategy="BlockLineHeight"
                                   Foreground="{StaticResource NoticeForegroundBrush}"
                                   Text="Do not forget your password, you will lose all your data." />
                    </StackPanel>
                </Border>

                <Border CornerRadius="8"
                        BorderThickness="1"
                        Background="{StaticResource ErrorBackgroundBrush}"
                        BorderBrush="{StaticResource ErrorBorderBrush}"
                        Visibility="{x:Bind ViewModel.ShowError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="11,0,12,0">
                        <Canvas Width="16" Height="16" VerticalAlignment="Center">
                            <Path Stretch="None"
                                  Stroke="{StaticResource ErrorForegroundBrush}"
                                  StrokeThickness="1.35"
                                  StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Data="M8,2.5 L15.1,14.1 L0.9,14.1 Z M8,6.6 L8,9.9 M8,11.6 L8,11.75" />
                        </Canvas>
                        <TextBlock Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   Width="305"
                                   FontFamily="{StaticResource BalooFont}"
                                   FontSize="{StaticResource NoticeFontSize}"
                                   LineHeight="16"
                                   LineStackingStrategy="BlockLineHeight"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource ErrorForegroundBrush}"
                                   Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <Border CornerRadius="8"
                        BorderThickness="1"
                        Background="{StaticResource SuccessBackgroundBrush}"
                        BorderBrush="{StaticResource SuccessBorderBrush}"
                        Visibility="{x:Bind ViewModel.ShowSuccess, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="11,0,12,0">
                        <Canvas Width="16" Height="16" VerticalAlignment="Center">
                            <Path Stretch="None"
                                  Stroke="{StaticResource SuccessForegroundBrush}"
                                  StrokeThickness="1.6"
                                  StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Data="M3.1,8.5 L6.5,11.9 L12.9,4.4" />
                        </Canvas>
                        <TextBlock Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   FontFamily="{StaticResource BalooFont}"
                                   FontSize="{StaticResource NoticeFontSize}"
                                   LineHeight="16"
                                   LineStackingStrategy="BlockLineHeight"
                                   Foreground="{StaticResource SuccessForegroundBrush}"
                                   Text="Password created successfully." />
                    </StackPanel>
                </Border>
            </Grid>

            <Button Margin="0,18,0,0"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Content="{x:Bind ViewModel.SubmitLabel, Mode=OneWay}"
                    Command="{x:Bind ViewModel.SubmitCommand}" />
        </StackPanel>
    </Grid>
</Page>
