<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DoNet.Views.ServicesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:DoNet.Controls"
    xmlns:views="using:DoNet.Views"
    mc:Ignorable="d">

    <!--
        The v2 Services directory: the four primary types as gradient tiles,
        each opening its own hand-built screen.

        The types are buttons, not cards - each is a 64px rounded square
        carrying the type's gradient from the top-left corner to the
        bottom-right with the type's icon in white inside, and its name set
        beneath in small caps. The row starts at the content's left edge,
        level with the title - not centred in the tab, which is where a
        directory's contents never sit. What the dynamic round put here - the
        catalog cards, the designer, the generated records - stays in the
        codebase and comes back for types the user adds; the primaries are
        code, and this screen is theirs.
    -->

    <UserControl.Resources>

        <Style x:Key="SearchBoxStyle" TargetType="TextBox" BasedOn="{StaticResource BareTextBoxStyle}">
            <Setter Property="FontFamily" Value="{StaticResource BalooFont}" />
            <Setter Property="FontSize" Value="{StaticResource FieldValueFontSize}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- The tile's name, set beneath it. -->
        <Style x:Key="TypeLabelStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource BalooSemiBoldFont}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{StaticResource TypeLabelBrush}" />
            <Setter Property="CharacterSpacing" Value="20" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,12,0,0" />
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
            <Setter Property="LineHeight" Value="20" />
        </Style>

        <!--
            The drill between the type list and a type's screen: the outgoing
            layer dips out fast, the incoming one rises in behind it. Only the
            arriving layer animates; the leaving one is collapsed outright -
            a collapsed layer can neither be clicked nor tabbed into.
        -->
        <Storyboard x:Key="DrillInStoryboard">
            <DoubleAnimation Storyboard.TargetName="ScreenLayer"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.22">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="ScreenShift"
                             Storyboard.TargetProperty="Y"
                             From="14" To="0" Duration="0:0:0.22">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Key="DrillOutStoryboard">
            <DoubleAnimation Storyboard.TargetName="TypeWrapper"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.22">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="TypeShift"
                             Storyboard.TargetProperty="Y"
                             From="14" To="0" Duration="0:0:0.22">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

    </UserControl.Resources>

    <Grid x:Name="Root" Padding="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
            The type list. Collapsed as one unit while a type's screen is on
            show, which is why the header and the marks sit under one name.
        -->
        <Grid x:Name="TypeWrapper" Grid.Row="0" Grid.RowSpan="2">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="TypeShift" Y="0" />
            </Grid.RenderTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header ...................................................... -->
            <!--
                No disc: the v2 header is the title at the content edge, with
                the actions beside it - the section mark now lives in the
                marks themselves.
            -->
            <Grid x:Name="Header" Grid.Row="0" Margin="0,0,0,24" ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="HeaderTitleColumn" Width="*" />
                    <ColumnDefinition x:Name="HeaderActionColumn" Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="SERVICES"
                               FontFamily="{StaticResource BaumansFont}"
                               FontSize="{StaticResource SectionTitleFontSize}"
                               Foreground="{StaticResource BrandPrimaryBrush}"
                               CharacterSpacing="20"
                               TextTrimming="CharacterEllipsis"
                               LineStackingStrategy="BlockLineHeight"
                               LineHeight="36" />
                    <TextBlock Text="Every service saved in your vault"
                               FontFamily="{StaticResource BalooFont}"
                               FontSize="{StaticResource SectionSubtitleFontSize}"
                               Foreground="{StaticResource SectionSubtitleBrush}"
                               TextTrimming="CharacterEllipsis"
                               LineStackingStrategy="BlockLineHeight"
                               LineHeight="20" />
                </StackPanel>

                <Grid x:Name="HeaderActions"
                      Grid.Row="0"
                      Grid.Column="1"
                      VerticalAlignment="Center"
                      ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="SearchColumn" Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- The type list's search, over four names. -->
                    <Border x:Name="SearchHost"
                            Grid.Column="0"
                            Width="304"
                            Height="42"
                            CornerRadius="21"
                            Padding="16,0,16,0"
                            Background="{StaticResource HeaderActionFillBrush}"
                            BorderBrush="{StaticResource SearchBorderBrush}"
                            BorderThickness="1">
                        <Border.Resources>
                            <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="Transparent" />

                            <!--
                                Without these the focused and pointer-over visual states
                                in the stock TextBox template set Foreground to the theme
                                brush, which on a machine running Windows in dark mode is
                                white - white text on a white card.
                            -->
                            <SolidColorBrush x:Key="TextControlForeground" Color="#2B2F33" />
                            <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#2B2F33" />
                            <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#2B2F33" />
                            <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="#8C9196" />
                            <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                            <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                            <Thickness x:Key="TextControlThemePadding">0</Thickness>
                            <x:Double x:Key="TextControlThemeMinHeight">0</x:Double>
                            <x:Double x:Key="TextControlThemeMinWidth">0</x:Double>
                        </Border.Resources>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Viewbox Grid.Column="0"
                                     Width="18"
                                     Height="18"
                                     VerticalAlignment="Center">
                                <Canvas Width="18" Height="18">
                                    <Path Data="M13.5 8A5.5 5.5 0 1 1 2.5 8A5.5 5.5 0 1 1 13.5 8 M12.2 12.2L16 16"
                                          Stroke="{StaticResource SearchPlaceholderBrush}"
                                          StrokeThickness="1.8"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round" />
                                </Canvas>
                            </Viewbox>

                            <TextBox Grid.Column="1"
                                     Style="{StaticResource SearchBoxStyle}"
                                     PlaceholderText="SEARCH DIRECTORY"
                                     PlaceholderForeground="{StaticResource SearchPlaceholderBrush}"
                                     Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                    </Border>

                    <!--
                        Custom service types arrive with the dynamic round; the
                        button stays in place, asleep, until then.
                    -->
                    <Button x:Name="AddServiceButton"
                            Grid.Column="1"
                            Style="{StaticResource BareButtonStyle}"
                            IsEnabled="False"
                            ToolTipService.ToolTip="Custom service types arrive with the next step">
                        <Border CornerRadius="21"
                                Padding="14,0,18,0"
                                Height="42"
                                Background="{StaticResource HeaderActionFillBrush}"
                                BorderBrush="{StaticResource SearchBorderBrush}"
                                BorderThickness="1">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="10"
                                        VerticalAlignment="Center">
                                <Grid Width="18" Height="18" VerticalAlignment="Center">
                                    <Rectangle Width="18"
                                               Height="18"
                                               RadiusX="6"
                                               RadiusY="6"
                                               Fill="{StaticResource AddActionBorderBrush}" />
                                    <Viewbox Width="18" Height="18">
                                        <Canvas Width="18" Height="18">
                                            <Path Data="M3.74951 8.99999H14.2507 M9.00011 3.74939V14.2506"
                                                  Stroke="#FFFFFF"
                                                  StrokeThickness="2"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round" />
                                        </Canvas>
                                    </Viewbox>
                                </Grid>
                                <TextBlock Text="ADD SERVICE"
                                           VerticalAlignment="Center"
                                           FontFamily="{StaticResource JerseyFont}"
                                           FontSize="{StaticResource ButtonFontSize}"
                                           Foreground="{StaticResource CardMetaBrush}"
                                           CharacterSpacing="40" />
                            </StackPanel>
                        </Border>
                    </Button>
                </Grid>
            </Grid>

            <!-- The four primary types ..................................... -->
            <!--
                Left-aligned at the content edge, level with the title above,
                72px between tiles - the reference's row, not a centred grid.

                Pinned to the top explicitly: a horizontal StackPanel left to
                its defaults in a star row stretches to fill it and arranges
                its children centred on the cross axis, which parked the tiles
                in the vertical middle of the tab. Top holds the row under the
                header, where the reference draws it.
            -->
            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        Spacing="72"
                        Margin="0,40,0,0"
                        VerticalAlignment="Top">

                <Button x:Name="VpsButton"
                        Style="{StaticResource BareButtonStyle}"
                        AutomationProperties.Name="VPS"
                        Click="OnVpsClick">
                    <StackPanel>
                        <controls:TypeMark Kind="Vps" />
                        <TextBlock Text="VPS" Style="{StaticResource TypeLabelStyle}" />
                    </StackPanel>
                </Button>

                <Button x:Name="ProxyButton"
                        Style="{StaticResource BareButtonStyle}"
                        AutomationProperties.Name="Proxy"
                        Click="OnProxyClick">
                    <StackPanel>
                        <controls:TypeMark Kind="Proxy" />
                        <TextBlock Text="PROXY" Style="{StaticResource TypeLabelStyle}" />
                    </StackPanel>
                </Button>

                <Button x:Name="DomainButton"
                        Style="{StaticResource BareButtonStyle}"
                        AutomationProperties.Name="Domain"
                        Click="OnDomainClick">
                    <StackPanel>
                        <controls:TypeMark Kind="Domain" />
                        <TextBlock Text="DOMAIN" Style="{StaticResource TypeLabelStyle}" />
                    </StackPanel>
                </Button>

                <Button x:Name="WalletsButton"
                        Style="{StaticResource BareButtonStyle}"
                        AutomationProperties.Name="Wallets"
                        Click="OnWalletsClick">
                    <StackPanel>
                        <controls:TypeMark Kind="Wallets" />
                        <TextBlock Text="WALLETS" Style="{StaticResource TypeLabelStyle}" />
                    </StackPanel>
                </Button>

            </StackPanel>

            <!--
                The type list holds four names, but the search still owes an
                answer when it excludes them all. Top for the same reason as
                the row above: a TextBlock stretched by a star row centres
                its text in the leftover height.
            -->
            <TextBlock x:Name="NoMatchesText"
                       Grid.Row="1"
                       Text="Nothing matches that search."
                       FontFamily="{StaticResource BalooFont}"
                       FontSize="{StaticResource SectionSubtitleFontSize}"
                       Foreground="{StaticResource CardMetaBrush}"
                       Margin="0,28,0,0"
                       VerticalAlignment="Top"
                       Visibility="Collapsed" />

        </Grid>

        <!--
            One primary type's screen, over the type list. Collapsed until its
            type is drilled in - the one state the platform guarantees is
            inert.
        -->
        <Grid x:Name="ScreenLayer"
              Grid.Row="0"
              Grid.RowSpan="2"
              Opacity="0"
              Visibility="Collapsed">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="ScreenShift" Y="14" />
            </Grid.RenderTransform>

            <views:ServiceTypeScreenView x:Name="TypeScreen" />
        </Grid>

        <!--
            Adaptive layout, on the same threshold as every other directory: below
            820 the search row cannot sit beside the title without crushing one of
            them, so it drops to its own line and the search field stretches.
        -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="WidthStates">

                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="820" />
                    </VisualState.StateTriggers>
                </VisualState>

                <VisualState x:Name="NarrowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="Root.Padding" Value="12" />
                        <Setter Target="Header.Margin" Value="0,0,0,16" />

                        <!-- Actions move under the title and span the full width. -->
                        <Setter Target="HeaderActions.(Grid.Row)" Value="1" />
                        <Setter Target="HeaderActions.(Grid.Column)" Value="0" />
                        <Setter Target="HeaderActions.Margin" Value="0,14,0,0" />
                        <Setter Target="HeaderActionColumn.Width" Value="0" />
                        <Setter Target="SearchColumn.Width" Value="*" />
                        <Setter Target="SearchHost.Width" Value="NaN" />
                    </VisualState.Setters>
                </VisualState>

            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</UserControl>
