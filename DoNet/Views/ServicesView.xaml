<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DoNet.Views.ServicesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:DoNet.Models"
    xmlns:controls="using:DoNet.Controls"
    xmlns:views="using:DoNet.Views"
    mc:Ignorable="d">

    <!--
        The Services directory, hosted inside the home screen's content surface.

        The same screen as the other three directories, on purpose: the header, the
        search, the card surface and the four states are what a directory is in this
        app, and the Services tab is where the records to come - a VPS, a phone
        number - will be filed. The cards it shows today are the vocabulary those
        records will be filed under.
    -->

    <UserControl.Resources>

        <Style x:Key="SearchBoxStyle" TargetType="TextBox" BasedOn="{StaticResource BareTextBoxStyle}">
            <Setter Property="FontFamily" Value="{StaticResource BalooFont}" />
            <Setter Property="FontSize" Value="{StaticResource FieldValueFontSize}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Shared by the four message states so they cannot drift apart. -->
        <Style x:Key="StateTitleStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource BalooSemiBoldFont}" />
            <Setter Property="FontSize" Value="{StaticResource CardTitleFontSize}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
            <Setter Property="LineHeight" Value="22" />
        </Style>

        <Style x:Key="StateBodyStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource BalooFont}" />
            <Setter Property="FontSize" Value="{StaticResource SectionSubtitleFontSize}" />
            <Setter Property="Foreground" Value="{StaticResource CardMetaBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="MaxWidth" Value="360" />
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
            <Setter Property="LineHeight" Value="22" />
        </Style>

        <DataTemplate x:Key="ServiceCardTemplate" x:DataType="models:Service">
            <controls:ServiceCard Service="{x:Bind}"
                                  OpenRequested="OnCardOpen"
                                  EditRequested="OnCardEdit"
                                  DeleteRequested="OnCardDelete" />
        </DataTemplate>

        <!--
            The drill between the type list and one type's records, on the settle
            timing the app's other layer changes use. Only the arriving layer
            animates: the leaving one is collapsed outright at the same moment,
            because a layer that is merely invisible can still be tabbed into,
            and one that is invisible and hit-testable sits over the screen
            swallowing clicks. Collapsed is the one state the platform guarantees
            is inert.
        -->
        <Storyboard x:Key="DrillInStoryboard">
            <DoubleAnimation Storyboard.TargetName="RecordsLayer"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.22">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="RecordsShift"
                             Storyboard.TargetProperty="Y"
                             From="14" To="0" Duration="0:0:0.22">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Key="DrillOutStoryboard">
            <DoubleAnimation Storyboard.TargetName="Header"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.22">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="CardSurface"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.22">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="TypeShift"
                             Storyboard.TargetProperty="Y"
                             From="14" To="0" Duration="0:0:0.22">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

    </UserControl.Resources>

    <Grid x:Name="Root" Padding="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
            The type list. Shifts as one unit when the drill changes layers, and
            collapses as one unit while a type's records are on screen - which is
            why the header and the card surface sit under one transform and one
            name.
        -->
        <Grid x:Name="TypeWrapper"
              Grid.Row="0"
              Grid.RowSpan="2">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="TypeShift" Y="0" />
            </Grid.RenderTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

        <!-- Header ........................................................... -->
        <Grid x:Name="Header" Grid.Row="0" Margin="0,0,0,24" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="HeaderTitleColumn" Width="*" />
                <ColumnDefinition x:Name="HeaderActionColumn" Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Grid.Column="0"
                  VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Width="{StaticResource SectionDiscSize}"
                        Height="{StaticResource SectionDiscSize}"
                        CornerRadius="{StaticResource SectionDiscCorner}"
                        Margin="0,0,14,0"
                        VerticalAlignment="Center"
                        Background="{StaticResource CardAvatarBrush}"
                        BorderBrush="{StaticResource SearchBorderBrush}"
                        BorderThickness="1">
                    <!--
                        The briefcase from the rail button, promoted into the icon
                        set so the tab's header and its rail entry carry the same
                        mark - the rule every other section follows.
                    -->
                    <controls:LineIcon Kind="Briefcase"
                                       Width="{StaticResource SectionDiscIconSize}"
                                       Height="{StaticResource SectionDiscIconSize}"
                                       Foreground="{StaticResource BrandPrimaryBrush}" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="SERVICES"
                               FontFamily="{StaticResource BaumansFont}"
                               FontSize="{StaticResource SectionTitleFontSize}"
                               Foreground="{StaticResource BrandPrimaryBrush}"
                               CharacterSpacing="20"
                               TextTrimming="CharacterEllipsis"
                               LineStackingStrategy="BlockLineHeight"
                               LineHeight="36" />
                    <TextBlock Text="Every service saved in your vault"
                               FontFamily="{StaticResource BalooFont}"
                               FontSize="{StaticResource SectionSubtitleFontSize}"
                               Foreground="{StaticResource SectionSubtitleBrush}"
                               TextTrimming="CharacterEllipsis"
                               LineStackingStrategy="BlockLineHeight"
                               LineHeight="20" />
                </StackPanel>
            </Grid>

            <Grid x:Name="HeaderActions"
                  Grid.Row="0"
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SearchColumn" Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border x:Name="SearchHost"
                        Grid.Column="0"
                        Width="304"
                        Height="42"
                        CornerRadius="21"
                        Padding="16,0,16,0"
                        Background="{StaticResource CardBackgroundBrush}"
                        BorderBrush="{StaticResource SearchBorderBrush}"
                        BorderThickness="1">
                    <Border.Resources>
                        <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="Transparent" />

                        <!--
                            Without these the focused and pointer-over visual states
                            in the stock TextBox template set Foreground to the theme
                            brush, which on a machine running Windows in dark mode is
                            white - white text on a white card.
                        -->
                        <SolidColorBrush x:Key="TextControlForeground" Color="#2B2F33" />
                        <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#2B2F33" />
                        <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#2B2F33" />
                        <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="#8C9196" />
                        <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                        <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                        <Thickness x:Key="TextControlThemePadding">0</Thickness>
                        <x:Double x:Key="TextControlThemeMinHeight">0</x:Double>
                        <x:Double x:Key="TextControlThemeMinWidth">0</x:Double>
                    </Border.Resources>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Viewbox Grid.Column="0"
                                 Width="18"
                                 Height="18"
                                 VerticalAlignment="Center">
                            <Canvas Width="18" Height="18">
                                <Path Data="M13.5 8A5.5 5.5 0 1 1 2.5 8A5.5 5.5 0 1 1 13.5 8 M12.2 12.2L16 16"
                                      Stroke="{StaticResource SearchPlaceholderBrush}"
                                      StrokeThickness="1.8"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" />
                            </Canvas>
                        </Viewbox>

                        <TextBox Grid.Column="1"
                                 Style="{StaticResource SearchBoxStyle}"
                                 PlaceholderText="SEARCH DIRECTORY"
                                 PlaceholderForeground="{StaticResource SearchPlaceholderBrush}"
                                 Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                </Border>

                <!-- ADD SERVICE, the same supplied icon treatment as every tab. -->
                <Button x:Name="AddServiceButton"
                        Grid.Column="1"
                        Style="{StaticResource BareButtonStyle}"
                        Command="{x:Bind ViewModel.AddServiceCommand}">
                    <Border CornerRadius="21"
                            Padding="14,0,18,0"
                            Height="42"
                            Background="{StaticResource CardBackgroundBrush}"
                            BorderBrush="{StaticResource AddActionBorderBrush}"
                            BorderThickness="1">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="10"
                                    VerticalAlignment="Center">
                            <Grid Width="18" Height="18" VerticalAlignment="Center">
                                <Rectangle Width="18"
                                           Height="18"
                                           RadiusX="6"
                                           RadiusY="6"
                                           Fill="{StaticResource BrandPrimaryBrush}" />
                                <Viewbox Width="18" Height="18">
                                    <Canvas Width="18" Height="18">
                                        <Path Data="M3.74951 8.99999H14.2507 M9.00011 3.74939V14.2506"
                                              Stroke="#FFFFFF"
                                              StrokeThickness="2"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round" />
                                    </Canvas>
                                </Viewbox>
                            </Grid>
                            <TextBlock Text="ADD SERVICE"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource JerseyFont}"
                                       FontSize="{StaticResource ButtonFontSize}"
                                       Foreground="{StaticResource BrandPrimaryBrush}"
                                       CharacterSpacing="40" />
                        </StackPanel>
                    </Border>
                </Button>
            </Grid>
        </Grid>

        <!-- Card surface ..................................................... -->
        <Border x:Name="CardSurface"
                Grid.Row="1"
                CornerRadius="26"
                Padding="24"
                Background="{StaticResource CardBackgroundBrush}">

            <Grid>

                <!--
                    Deliberately always visible. An ItemsRepeater inside a collapsed
                    ScrollViewer has no measured viewport, and a collection change
                    reaching it in that state fails with COMException: Unspecified
                    error. With nothing selected it draws nothing anyway, and the
                    state panels below paint over it.
                -->
                <ScrollViewer x:Name="CardScroller"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollMode="Disabled"
                              ViewChanged="OnCardScrollChanged"
                              Padding="0,0,4,0">
                    <ItemsRepeater x:Name="CardRepeater"
                                   ItemsSource="{x:Bind ViewModel.Services}"
                                   ItemTemplate="{StaticResource ServiceCardTemplate}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout MinItemWidth="430"
                                               MinColumnSpacing="20"
                                               MinRowSpacing="20"
                                               ItemsStretch="Fill" />
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>
                </ScrollViewer>

                <!-- Loading -->
                <Border Background="{StaticResource CardBackgroundBrush}"
                        Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                        <controls:StateArt Width="112" Height="86" HorizontalAlignment="Center"
                                           Kind="Loading"
                                           IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
                        <TextBlock Text="Opening the directory"
                                   Style="{StaticResource StateTitleStyle}"
                                   Margin="0,16,0,0" />
                        <TextBlock Text="Just a moment." Style="{StaticResource StateBodyStyle}" />
                    </StackPanel>
                </Border>

                <!-- Empty: no service types at all -->
                <Border Background="{StaticResource CardBackgroundBrush}"
                        Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                        <controls:StateArt Width="112" Height="86" HorizontalAlignment="Center"
                                           Kind="Empty"
                                           IsActive="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" />
                        <TextBlock Text="No services yet"
                                   Style="{StaticResource StateTitleStyle}"
                                   Margin="0,16,0,0" />
                        <TextBlock Text="Service types you add will appear here."
                                   Style="{StaticResource StateBodyStyle}" />
                    </StackPanel>
                </Border>

                <!-- Empty: types exist, the search excluded them -->
                <Border Background="{StaticResource CardBackgroundBrush}"
                        Visibility="{x:Bind ViewModel.HasNoMatches, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                        <controls:StateArt Width="112" Height="86" HorizontalAlignment="Center"
                                           Kind="NoMatch"
                                           IsActive="{x:Bind ViewModel.HasNoMatches, Mode=OneWay}" />
                        <TextBlock Text="Nothing matches that search"
                                   Style="{StaticResource StateTitleStyle}"
                                   Margin="0,16,0,0" />
                        <TextBlock Text="Try a shorter term, or clear the search to see every type."
                                   Style="{StaticResource StateBodyStyle}" />
                    </StackPanel>
                </Border>

                <!-- Error -->
                <Border Background="{StaticResource CardBackgroundBrush}"
                        Visibility="{x:Bind ViewModel.IsError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                        <controls:StateArt Width="112" Height="86" HorizontalAlignment="Center"
                                           Kind="Error"
                                           IsActive="{x:Bind ViewModel.IsError, Mode=OneWay}" />
                        <TextBlock Text="The directory could not be opened"
                                   Style="{StaticResource StateTitleStyle}"
                                   Margin="0,16,0,0" />
                        <TextBlock Text="Nothing was changed. You can try again."
                                   Style="{StaticResource StateBodyStyle}" />
                        <Button Margin="0,20,0,0"
                                HorizontalAlignment="Center"
                                Style="{StaticResource BareButtonStyle}"
                                Command="{x:Bind ViewModel.RetryCommand}">
                            <Border CornerRadius="20"
                                    Height="40"
                                    Padding="22,0,22,0"
                                    Background="{StaticResource BrandPrimaryBrush}">
                                <TextBlock Text="TRY AGAIN"
                                           VerticalAlignment="Center"
                                           FontFamily="{StaticResource JerseyFont}"
                                           FontSize="{StaticResource ButtonFontSize}"
                                           Foreground="#FFFFFF"
                                           CharacterSpacing="40" />
                            </Border>
                        </Button>
                    </StackPanel>
                </Border>

            </Grid>
        </Border>

        </Grid>

        <!--
            One type's records, over the type list. Collapsed until its type is
            drilled in, and empty-handed while it is: the card repeater's source
            is attached only for as long as the layer is visible, because a
            collection change reaching a collapsed, unmeasured ItemsRepeater is
            the COMException this app has met before. The host attaches, measures
            and only then lets the records load.
        -->
        <Grid x:Name="RecordsLayer"
              Grid.Row="0"
              Grid.RowSpan="2"
              Opacity="0"
              Visibility="Collapsed">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="RecordsShift" Y="14" />
            </Grid.RenderTransform>

            <views:ServiceRecordsView x:Name="RecordsScreen" />
        </Grid>

        <!--
            Adaptive layout, on the same threshold as every other directory: below
            820 the search row cannot sit beside the title without crushing one of
            them, so it drops to its own line and the search field stretches.
        -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="WidthStates">

                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="820" />
                    </VisualState.StateTriggers>
                </VisualState>

                <VisualState x:Name="NarrowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="Root.Padding" Value="12" />
                        <Setter Target="CardSurface.Padding" Value="12" />
                        <Setter Target="CardSurface.CornerRadius" Value="18" />
                        <Setter Target="Header.Margin" Value="0,0,0,16" />

                        <!-- Actions move under the title and span the full width. -->
                        <Setter Target="HeaderActions.(Grid.Row)" Value="1" />
                        <Setter Target="HeaderActions.(Grid.Column)" Value="0" />
                        <Setter Target="HeaderActions.Margin" Value="0,14,0,0" />
                        <Setter Target="HeaderActionColumn.Width" Value="0" />
                        <Setter Target="SearchColumn.Width" Value="*" />
                        <Setter Target="SearchHost.Width" Value="NaN" />
                    </VisualState.Setters>
                </VisualState>

            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

    </Grid>
</UserControl>
