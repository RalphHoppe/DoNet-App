<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DoNet.Views.WalletDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:DoNet.Controls"
    mc:Ignorable="d">

    <!--
        The wallet record dialog: the hand-built form for the fourth primary
        type, the VPS dialog's structure with the wallet's own fields.

        One control serves all three modes, as two layouts. The add and edit
        modes are the form: one grid in the sheet's order. The preview mode is
        not that form greyed out but a sheet of its own - a hero naming the
        record, then sections grouping what it means.

        The money is the form's one piece of arithmetic and it lives in the
        view model: the exchange rate is what one unit of the wallet's currency
        is worth in dollars, so typing the rate fills the dollars and typing
        the dollars fills the rate, whichever the user leaves for the form to
        do. The rate's prefix says what it prices, and follows the currency.

        The two secrets are masked with reveal and copy, and the password
        offers AUTO GENERATE in the modes that save. The recovery words do not:
        a seed phrase is read off something, not invented here.
    -->

    <UserControl.Resources>

        <!-- The section label over a grid, the tables' header voice. -->
        <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource BaumansFont}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="{StaticResource BrandPrimaryBrush}" />
            <Setter Property="CharacterSpacing" Value="20" />
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
            <Setter Property="LineHeight" Value="22" />
        </Style>

        <!-- The dialog's entrance: a short rise and settle under a fading scrim. -->
        <Storyboard x:Key="OpenStoryboard">
            <DoubleAnimation Storyboard.TargetName="Scrim"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.16" />
            <DoubleAnimation Storyboard.TargetName="CardOffset"
                             Storyboard.TargetProperty="Y"
                             From="18" To="0" Duration="0:0:0.26">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="CardScale"
                             Storyboard.TargetProperty="ScaleX"
                             From="0.985" To="1" Duration="0:0:0.26">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="CardScale"
                             Storyboard.TargetProperty="ScaleY"
                             From="0.985" To="1" Duration="0:0:0.26">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Card"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.20" />
        </Storyboard>

        <!--
            PREVIEW turning into the edit form. A short dip and rise reads as
            the same panel changing state rather than a hard swap.
        -->
        <Storyboard x:Key="ModeChangeStoryboard">
            <DoubleAnimation Storyboard.TargetName="FieldHost"
                             Storyboard.TargetProperty="Opacity"
                             From="0.25" To="1" Duration="0:0:0.26">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="FieldShift"
                             Storyboard.TargetProperty="Y"
                             From="10" To="0" Duration="0:0:0.30">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="HeaderBlock"
                             Storyboard.TargetProperty="Opacity"
                             From="0.3" To="1" Duration="0:0:0.24" />
            <DoubleAnimation Storyboard.TargetName="FooterBlock"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.28" />
        </Storyboard>

        <Storyboard x:Key="CloseStoryboard" Completed="OnCloseCompleted">
            <DoubleAnimation Storyboard.TargetName="Scrim"
                             Storyboard.TargetProperty="Opacity"
                             To="0" Duration="0:0:0.14" />
            <DoubleAnimation Storyboard.TargetName="Card"
                             Storyboard.TargetProperty="Opacity"
                             To="0" Duration="0:0:0.14" />
            <DoubleAnimation Storyboard.TargetName="CardOffset"
                             Storyboard.TargetProperty="Y"
                             To="12" Duration="0:0:0.14">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

    </UserControl.Resources>

    <Grid x:Name="Root" Visibility="Collapsed"
          PreviewKeyDown="OnFieldKeyDown">

        <Rectangle x:Name="Scrim" Fill="#59000000" Tapped="OnScrimTapped" />

        <Border x:Name="Card"
                MaxWidth="1180"
                Margin="24"
                CornerRadius="26"
                Background="{StaticResource CardBackgroundBrush}"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1" />
                    <TranslateTransform x:Name="CardOffset" Y="0" />
                </TransformGroup>
            </Border.RenderTransform>

            <Grid Padding="40,32,40,28" RowSpacing="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header .................................................. -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel x:Name="HeaderBlock" Grid.Column="0">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="40"
                                     Height="40"
                                     Margin="0,0,14,0"
                                     VerticalAlignment="Center">
                                <controls:TypeMark Kind="Wallets" />
                            </Viewbox>
                            <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                                       FontFamily="{StaticResource BaumansFont}"
                                       FontSize="{StaticResource SectionTitleFontSize}"
                                       Foreground="{StaticResource BrandPrimaryBrush}"
                                       CharacterSpacing="20"
                                       VerticalAlignment="Center"
                                       LineStackingStrategy="BlockLineHeight"
                                       LineHeight="40" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}"
                                   FontFamily="{StaticResource BalooFont}"
                                   FontSize="{StaticResource SectionSubtitleFontSize}"
                                   Foreground="{StaticResource SectionSubtitleBrush}"
                                   TextWrapping="Wrap"
                                   LineStackingStrategy="BlockLineHeight"
                                   LineHeight="20" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            VerticalAlignment="Top"
                            Style="{StaticResource BareButtonStyle}"
                            ToolTipService.ToolTip="Close"
                            Click="OnCloseClick">
                        <Border Width="22"
                                Height="22"
                                Margin="8"
                                CornerRadius="11"
                                Background="#FEBC2E" />
                    </Button>
                </Grid>

                <!-- Fields ................................................... -->
                <!--
                    One scrolling host: the form is taller than some windows
                    are, and a dialog that grows past the screen is not a
                    dialog that works at all sizes.
                -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollMode="Disabled">
                    <Grid>
                        <!--
                            The form is one of two layouts in this dialog; the
                            preview is a sheet of its own, and the two hosts
                            trade places with the mode.
                        -->
                        <StackPanel x:Name="FieldHost" Spacing="24"
                                    Visibility="{x:Bind ViewModel.IsForm, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel.RenderTransform>
                                <TranslateTransform x:Name="FieldShift" Y="0" />
                            </StackPanel.RenderTransform>

                            <!--
                                The wallet's fields in the sheet's order, read
                                like a page: whose it is and which wallet, then
                                its number, then its money - the currency hangs
                                off the balance - then the rate, then the two
                                secrets, then the note.
                            -->
                            <Grid x:Name="FieldGrid" ColumnSpacing="24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="ColLeft" Width="*" />
                                    <ColumnDefinition x:Name="ColMiddle" Width="*" />
                                    <ColumnDefinition x:Name="ColRight" Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <controls:FieldCell x:Name="RecordIdCell"
                              Grid.Row="0"
                              Grid.Column="0"
                              Margin="0,0,0,16"
                              VerticalAlignment="Top"
                              Label="#"
                              IconKind="Hash"
                              Placeholder="Assigned on save"
                              Value="{x:Bind ViewModel.IdDisplay, Mode=OneWay}"
                              Kind="{x:Bind ViewModel.AutoFieldKind, Mode=OneWay}"
                              ShowCopy="{x:Bind ViewModel.IsPreview, Mode=OneWay}" />

                                <controls:FieldCell x:Name="PersonCell"
                              Grid.Row="0"
                              Grid.Column="1"
                              Margin="0,0,0,16"
                              VerticalAlignment="Top"
                              Label="PERSON"
                              IconKind="User"
                              TabOrder="1"
                              InputKind="Choice"
                              Placeholder="Pick a person"
                              Value="{x:Bind ViewModel.PersonLabel, Mode=TwoWay}"
                              Options="{x:Bind ViewModel.PersonOptions, Mode=OneWay}"
                              Kind="{x:Bind ViewModel.FieldKind, Mode=OneWay}"
                              ShowCopy="{x:Bind ViewModel.IsPreview, Mode=OneWay}" />

                                <controls:FieldCell x:Name="WalletCell"
                              Grid.Row="0"
                              Grid.Column="2"
                              Margin="0,0,0,16"
                              VerticalAlignment="Top"
                              Label="WALLET"
                              IconKind="Wallet"
                              TabOrder="2"
                              InputKind="Choice"
                              AllowChoiceCustom="True"
                              Placeholder="Pick or type the wallet"
                              Value="{x:Bind ViewModel.Wallet, Mode=TwoWay}"
                              Options="{x:Bind ViewModel.WalletBrandOptions, Mode=OneWay}"
                              Kind="{x:Bind ViewModel.FieldKind, Mode=OneWay}"
                              ShowCopy="{x:Bind ViewModel.IsPreview, Mode=OneWay}" />

                                <controls:FieldCell x:Name="WalletNumberCell"
                              Grid.Row="1"
                              Grid.Column="0"
                              Margin="0,0,0,16"
                              VerticalAlignment="Top"
                              Label="WALLET NUMBER"
                              IconKind="Hash"
                              TabOrder="3"
                              Placeholder="The number or address"
                              Value="{x:Bind ViewModel.WalletNumber, Mode=TwoWay}"
                              Kind="{x:Bind ViewModel.FieldKind, Mode=OneWay}"
                              ShowCopy="{x:Bind ViewModel.IsPreview, Mode=OneWay}" />

                                <controls:FieldCell x:Name="BalanceCell"
                              Grid.Row="1"
                              Grid.Column="1"
                              Margin="0,0,0,16"
                              VerticalAlignment="Top"
                              Label="BALANCE"
                              IconKind="CreditCard"
                              TabOrder="4"
                              InputKind="Decimal"
                              Placeholder="Enter the balance"
                              Value="{x:Bind ViewModel.BalanceText, Mode=TwoWay}"
                              UnitOptions="{x:Bind ViewModel.CurrencyOptions, Mode=OneWay}"
                              UnitValue="{x:Bind ViewModel.CurrencyCode, Mode=TwoWay}"
                              UnitPlaceholder="Currency"
                              Kind="{x:Bind ViewModel.FieldKind, Mode=OneWay}"
                              ShowCopy="{x:Bind ViewModel.IsPreview, Mode=OneWay}" />

                                <controls:FieldCell x:Name="DollarsCell"
                              Grid.Row="1"
                              Grid.Column="2"
                              Margin="0,0,0,16"
                              VerticalAlignment="Top"
                              Label="BALANCE IN DOLLARS"
                              IconKind="Bitcoin"
                              TabOrder="5"
                              InputKind="Decimal"
                              Placeholder="Typed or filled from the rate"
                              Value="{x:Bind ViewModel.DollarsText, Mode=TwoWay}"
                              Kind="{x:Bind ViewModel.FieldKind, Mode=OneWay}"
                              ShowCopy="{x:Bind ViewModel.IsPreview, Mode=OneWay}" />

                                <controls:FieldCell x:Name="RateCell"
                              Grid.Row="2"
                              Grid.Column="0"
                              Margin="0,0,0,16"
                              VerticalAlignment="Top"
                              Label="EXCHANGE-RATE"
                              IconKind="Bitcoin"
                              TabOrder="6"
                              InputKind="Decimal"
                              Placeholder="In dollars"
                              PrefixText="{x:Bind ViewModel.RatePrefix, Mode=OneWay}"
                              Value="{x:Bind ViewModel.RateText, Mode=TwoWay}"
                              Kind="{x:Bind ViewModel.FieldKind, Mode=OneWay}"
                              ShowCopy="{x:Bind ViewModel.IsPreview, Mode=OneWay}" />

                                <controls:FieldCell x:Name="PasswordCell"
                              Grid.Row="2"
                              Grid.Column="1"
                              Margin="0,0,0,16"
                              VerticalAlignment="Top"
                              Label="PASSWORD"
                              IconKind="Lock"
                              TabOrder="7"
                              IsSecret="True"
                              ShowGenerate="{x:Bind ViewModel.IsEditing, Mode=OneWay}"
                              Placeholder="Enter the password"
                              Value="{x:Bind ViewModel.Password, Mode=TwoWay}"
                              Kind="{x:Bind ViewModel.FieldKind, Mode=OneWay}"
                              ShowCopy="{x:Bind ViewModel.IsPreview, Mode=OneWay}" />

                                <controls:FieldCell x:Name="RecoveryCell"
                              Grid.Row="2"
                              Grid.Column="2"
                              Margin="0,0,0,16"
                              VerticalAlignment="Top"
                              Label="RECOVERY WORDS"
                              IconKind="Key"
                              TabOrder="8"
                              IsSecret="True"
                              Placeholder="The seed phrase, as words"
                              Value="{x:Bind ViewModel.RecoveryWords, Mode=TwoWay}"
                              Kind="{x:Bind ViewModel.FieldKind, Mode=OneWay}"
                              ShowCopy="{x:Bind ViewModel.IsPreview, Mode=OneWay}" />

                                <controls:FieldCell x:Name="NoteCell"
                              Grid.Row="3"
                              Grid.Column="0"
                              Grid.ColumnSpan="3"
                              Margin="0"
                              VerticalAlignment="Top"
                              Label="NOTE"
                              IconKind="Info"
                              TabOrder="9"
                              InputKind="Multiline"
                              Placeholder="Anything worth remembering"
                              Value="{x:Bind ViewModel.Note, Mode=TwoWay}"
                              Kind="{x:Bind ViewModel.FieldKind, Mode=OneWay}"
                              ShowCopy="{x:Bind ViewModel.IsPreview, Mode=OneWay}" />
                            </Grid>
                        </StackPanel>

                        <!--
                            The information view: the record as a sheet of its
                            own. A hero says whose record this is; the sections
                            group what it means - the money, the owner, the
                            keys, the note.
                        -->
                        <StackPanel x:Name="PreviewHost" Spacing="24"
                                    Visibility="{x:Bind ViewModel.IsPreview, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">

                            <!-- The hero: the mark, the brand, and the caption. -->
                            <Grid ColumnSpacing="18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Viewbox Grid.Column="0"
                                         Width="56"
                                         Height="56"
                                         VerticalAlignment="Center">
                                    <controls:TypeMark Kind="Wallets" />
                                </Viewbox>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                    <TextBlock Text="{x:Bind ViewModel.Wallet, Mode=OneWay}"
                                               FontFamily="{StaticResource BalooSemiBoldFont}"
                                               FontSize="22"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               LineStackingStrategy="BlockLineHeight"
                                               LineHeight="28" />
                                    <TextBlock Text="{x:Bind ViewModel.HeroCaption, Mode=OneWay}"
                                               FontFamily="{StaticResource BalooFont}"
                                               FontSize="{StaticResource CardMetaFontSize}"
                                               Foreground="{StaticResource CardMetaBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               LineStackingStrategy="BlockLineHeight"
                                               LineHeight="18" />
                                </StackPanel>
                            </Grid>

                            <!-- The money: what it holds and what that is worth. -->
                            <TextBlock Text="BALANCE &amp; PAYMENTS"
                                       Style="{StaticResource SectionLabelStyle}" />
                            <Grid x:Name="PvMoneyGrid" ColumnSpacing="24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <controls:FieldCell x:Name="PvBalanceCell"
                              Grid.Row="0"
                              Grid.Column="0"
                              Margin="0,0,0,16"
                              VerticalAlignment="Top"
                              Label="BALANCE"
                              IconKind="CreditCard"
                              Value="{x:Bind ViewModel.BalanceText, Mode=OneWay}"
                              UnitValue="{x:Bind ViewModel.CurrencyCode, Mode=OneWay}"
                              Kind="Display"
                              ShowCopy="True" />

                                <controls:FieldCell x:Name="PvDollarsCell"
                              Grid.Row="0"
                              Grid.Column="1"
                              Margin="0,0,0,16"
                              VerticalAlignment="Top"
                              Label="BALANCE IN DOLLARS"
                              IconKind="Bitcoin"
                              Value="{x:Bind ViewModel.DollarsText, Mode=OneWay}"
                              Kind="Display"
                              ShowCopy="True" />

                                <controls:FieldCell x:Name="PvRateCell"
                              Grid.Row="1"
                              Grid.Column="0"
                              Grid.ColumnSpan="2"
                              Margin="0"
                              VerticalAlignment="Top"
                              Label="EXCHANGE-RATE"
                              IconKind="Bitcoin"
                              PrefixText="{x:Bind ViewModel.RatePrefix, Mode=OneWay}"
                              Value="{x:Bind ViewModel.RateText, Mode=OneWay}"
                              Kind="Display"
                              ShowCopy="True" />
                            </Grid>

                            <!-- The vault record this wallet hangs off. -->
                            <TextBlock Text="LINKED RECORDS"
                                       Style="{StaticResource SectionLabelStyle}" />
                            <Grid x:Name="PvLinksGrid" ColumnSpacing="24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <controls:FieldCell x:Name="PvPersonCell"
                              Grid.Row="0"
                              Grid.Column="0"
                              Grid.ColumnSpan="2"
                              Margin="0"
                              VerticalAlignment="Top"
                              Label="PERSON"
                              IconKind="User"
                              Value="{x:Bind ViewModel.PersonLabel, Mode=OneWay}"
                              Kind="Display"
                              ShowCopy="True" />

                                <controls:FieldCell x:Name="PvNumberCell"
                              Grid.Row="1"
                              Grid.Column="0"
                              Grid.ColumnSpan="2"
                              Margin="0"
                              VerticalAlignment="Top"
                              Label="WALLET NUMBER"
                              IconKind="Hash"
                              Value="{x:Bind ViewModel.WalletNumber, Mode=OneWay}"
                              Kind="Display"
                              ShowCopy="True" />
                            </Grid>

                            <!-- The keys: masked, revealed deliberately. -->
                            <TextBlock Text="ACCESS"
                                       Style="{StaticResource SectionLabelStyle}" />
                            <Grid x:Name="PvAccessGrid" ColumnSpacing="24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <controls:FieldCell x:Name="PvPasswordCell"
                              Grid.Row="0"
                              Grid.Column="0"
                              Margin="0,0,0,16"
                              VerticalAlignment="Top"
                              Label="PASSWORD"
                              IconKind="Lock"
                              IsSecret="True"
                              Value="{x:Bind ViewModel.Password, Mode=OneWay}"
                              Kind="Display"
                              ShowCopy="True" />

                                <controls:FieldCell x:Name="PvRecoveryCell"
                              Grid.Row="0"
                              Grid.Column="1"
                              Margin="0,0,0,16"
                              VerticalAlignment="Top"
                              Label="RECOVERY WORDS"
                              IconKind="Key"
                              IsSecret="True"
                              Value="{x:Bind ViewModel.RecoveryWords, Mode=OneWay}"
                              Kind="Display"
                              ShowCopy="True" />
                            </Grid>

                            <!-- The note. -->
                            <TextBlock Text="NOTE"
                                       Style="{StaticResource SectionLabelStyle}" />
                            <Grid x:Name="PvNoteGrid" ColumnSpacing="24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <controls:FieldCell x:Name="PvNoteCell"
                              Grid.Row="0"
                              Grid.Column="0"
                              Grid.ColumnSpan="2"
                              Margin="0"
                              VerticalAlignment="Top"
                              Label="NOTE"
                              IconKind="Info"
                              InputKind="Multiline"
                              Value="{x:Bind ViewModel.Note, Mode=OneWay}"
                              Kind="Display"
                              ShowCopy="True" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!-- Footer .................................................. -->
                <Grid x:Name="FooterBlock" Grid.Row="2" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               VerticalAlignment="Center"
                               Text="The wallet's brand is the one required field."
                               Visibility="{x:Bind ViewModel.IsEditing, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                               FontFamily="{StaticResource BalooFont}"
                               FontSize="{StaticResource FieldValueFontSize}"
                               Foreground="{StaticResource CardMetaBrush}" />

                    <!-- Preview: one full-width action. -->
                    <Button x:Name="PreviewAction"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            HorizontalAlignment="Stretch"
                            Visibility="{x:Bind ViewModel.IsPreview, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                            Style="{StaticResource BareButtonStyle}"
                            Click="OnPrimaryClick">
                        <Border Height="52"
                                CornerRadius="26"
                                Background="{StaticResource BrandPrimaryBrush}">
                            <TextBlock Text="{x:Bind ViewModel.PrimaryActionText, Mode=OneWay}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource JerseyFont}"
                                       FontSize="{StaticResource ButtonFontSize}"
                                       Foreground="#FFFFFF"
                                       CharacterSpacing="40" />
                        </Border>
                    </Button>

                    <!-- Add and edit: cancel plus the commit. -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="14"
                                Visibility="{x:Bind ViewModel.IsEditing, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <Button Style="{StaticResource BareButtonStyle}" Click="OnCancelClick">
                            <Border Height="52"
                                    MinWidth="150"
                                    CornerRadius="26"
                                    Background="{StaticResource CardBackgroundBrush}"
                                    BorderBrush="{StaticResource SearchBorderBrush}"
                                    BorderThickness="1">
                                <TextBlock Text="CANCEL"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontFamily="{StaticResource JerseyFont}"
                                           FontSize="{StaticResource ButtonFontSize}"
                                           Foreground="{StaticResource CardMetaBrush}"
                                           CharacterSpacing="40" />
                            </Border>
                        </Button>

                        <Button Style="{StaticResource BareButtonStyle}"
                                IsEnabled="{x:Bind ViewModel.CanSave, Mode=OneWay}"
                                Click="OnPrimaryClick">
                            <Border Height="52"
                                    MinWidth="210"
                                    CornerRadius="26"
                                    Background="{StaticResource BrandPrimaryBrush}">
                                <TextBlock Text="{x:Bind ViewModel.PrimaryActionText, Mode=OneWay}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontFamily="{StaticResource JerseyFont}"
                                           FontSize="{StaticResource ButtonFontSize}"
                                           Foreground="#FFFFFF"
                                           CharacterSpacing="40" />
                            </Border>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!--
            Below 1000 the three columns cannot hold a readable field box, so
            the form becomes a single scrolling list; every cell moves to its
            reading-order row, so the narrow form reads like the wide one.
        -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="DialogWidthStates">
                <VisualState x:Name="DialogWide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1000" />
                    </VisualState.StateTriggers>
                </VisualState>

                <VisualState x:Name="DialogNarrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ColMiddle.Width" Value="0" />
                        <Setter Target="ColRight.Width" Value="0" />
                        <Setter Target="FieldGrid.ColumnSpacing" Value="0" />
                        <Setter Target="PersonCell.(Grid.Row)" Value="1" />
                        <Setter Target="PersonCell.(Grid.Column)" Value="0" />
                        <Setter Target="WalletCell.(Grid.Row)" Value="2" />
