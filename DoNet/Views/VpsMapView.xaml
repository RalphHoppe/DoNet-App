<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DoNet.Views.VpsMapView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:DoNet.Controls"
    mc:Ignorable="d">

    <!--
        The VPS map as a screen of its own, laid out the way the quiet map
        apps do it: the map is the page, and the words live in a panel
        beside it.

        The page is the rendered equirectangular earth - x from longitude,
        y from latitude, exactly 2:1 - in near-white and pale grey, so calm
        that the markers are the only things speaking on it. Every marker is
        placed by that one rule, so the picture and the placement math
        cannot disagree about where a country is.

        The panel carries everything the map declines to say: the list -
        every main in the overview, the whole chain in an open network, each
        row stepped in by its depth - and, below it, the selected VPS's
        important details as the preview's read-only cells. Hovering a row
        stands its marker up; clicking one is clicking the marker.

        The overview dots the mains, one delta per country, a count chip
        where one country holds several. A click trades the overview for
        that main's network: its whole chain as markers joined by curved
        arcs whose dashes flow along them, framed to fit.

        The chooser - the small panel that opens over a chip - is hand-built
        for the same reason the drawers are: the app has no stock dropdowns.
    -->

    <UserControl.Resources>

        <!--
            The connections: curved arcs whose dashes flow along them - the
            app's own teal for a main's direct children, a quieter sage for
            everything deeper, so depth reads at a glance.
        -->
        <SolidColorBrush x:Key="ConnectionBrush" Color="#4BAA98" />
        <SolidColorBrush x:Key="DeepConnectionBrush" Color="#93BBB0" />

        <!-- The section labels, the tables' header voice. -->
        <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource BaumansFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource BrandPrimaryBrush}" />
            <Setter Property="CharacterSpacing" Value="20" />
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
            <Setter Property="LineHeight" Value="18" />
        </Style>

        <Style x:Key="StateTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource BalooSemiBoldFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
            <Setter Property="LineHeight" Value="20" />
        </Style>

    </UserControl.Resources>

    <!-- The screen: the panel's words on the left, the earth beside them. -->
    <Border CornerRadius="34"
            Background="{StaticResource CardBackgroundBrush}"
            BorderBrush="{StaticResource CardBorderBrush}"
            BorderThickness="1">
        <Grid>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="392" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- The panel ................................................. -->
            <Grid Grid.Column="0" RowSpacing="12" Padding="26,22,20,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Viewbox Width="30"
                                 Height="30"
                                 VerticalAlignment="Center">
                            <controls:TypeMark Kind="Vps" />
                        </Viewbox>
                        <TextBlock Text="VPS MAP"
                                   FontFamily="{StaticResource BaumansFont}"
                                   FontSize="22"
                                   Foreground="{StaticResource BrandPrimaryBrush}"
                                   CharacterSpacing="20"
                                   VerticalAlignment="Center"
                                   LineStackingStrategy="BlockLineHeight"
                                   LineHeight="28" />
                    </StackPanel>
                    <TextBlock Text="The mains and their networks, the whole earth under them"
                               FontFamily="{StaticResource BalooFont}"
                               FontSize="12.5"
                               Foreground="{StaticResource SectionSubtitleBrush}"
                               TextWrapping="Wrap"
                               LineStackingStrategy="BlockLineHeight"
                               LineHeight="17" />
                </StackPanel>

                <!-- The way back, while a network is open. -->
                <Button Grid.Row="1"
                        Style="{StaticResource BareButtonStyle}"
                        HorizontalAlignment="Left"
                        Visibility="{x:Bind ViewModel.IsFocused, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                        Click="OnBackClick">
                    <Border Height="32"
                            CornerRadius="16"
                            Padding="13,0"
                            Background="{StaticResource HeaderActionFillBrush}"
                            BorderBrush="{StaticResource SearchBorderBrush}"
                            BorderThickness="1">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <controls:LineIcon Kind="ArrowLeft"
                                               Width="14"
                                               Height="14"
                                               Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="ALL MAINS"
                                       FontFamily="{StaticResource BalooSemiBoldFont}"
                                       FontSize="11.5"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       CharacterSpacing="60"
                                       VerticalAlignment="Center"
                                       LineStackingStrategy="BlockLineHeight"
                                       LineHeight="15" />
                        </StackPanel>
                    </Border>
                </Button>

                <!-- The list's own title, whichever list is on show. -->
                <TextBlock Grid.Row="2"
                           x:Name="ListTitle"
                           Text="MAINS"
                           Style="{StaticResource SectionLabelStyle}" />

                <!-- The list itself. -->
                <ScrollViewer Grid.Row="3"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollMode="Disabled">
                    <StackPanel x:Name="ListRows" Spacing="5" />
                </ScrollViewer>

                <!-- The selected VPS's details, below the list. -->
                <StackPanel Grid.Row="4"
                            Spacing="9"
                            Visibility="{x:Bind ViewModel.IsFocused, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="THE VPS"
                               Style="{StaticResource SectionLabelStyle}" />

                    <!-- The selection's own card, compact. -->
                    <StackPanel x:Name="SelectionCard" Spacing="2" />
                </StackPanel>
            </Grid>

            <!-- The earth .................................................. -->
            <Border Grid.Column="1"
                    CornerRadius="0,34,34,0"
                    Background="#EFF1F4">
                <!--
                    The wheel zooms about the pointer; a drag from the map
                    itself - the sea or the land, not a marker or a panel -
                    carries the view. Presses on the markers and the chooser
                    never start a drag; the code-behind checks where a press
                    began.
                -->
                <Grid x:Name="MapHost"
                      SizeChanged="OnMapHostSizeChanged"
                      PointerWheelChanged="OnMapWheel"
                      PointerPressed="OnMapPointerPressed"
                      PointerMoved="OnMapPointerMoved"
                      PointerReleased="OnMapPointerReleased"
                      PointerCanceled="OnMapPointerReleased">

                    <!-- Everything that belongs to the plate is clipped to
                         it: the connections that cross the edge where the
                         map ends and restarts leave the map, not the
                         screen. -->
                    <Grid x:Name="MapClip">
                        <!--
                            The plate and its connections share one canvas,
                            in host pixels: the image is seated and sized by
                            the view model's transform, and the arcs run
                            between the transformed positions.
                        -->
                        <Canvas x:Name="MapCanvas">
                            <Image x:Name="MapImage"
                                   Source="ms-appx:///Assets/Maps/world-map.png"
                                   Stretch="Fill"
                                   Width="0"
                                   Height="0" />
                        </Canvas>

                        <!--
                            The markers sit above the arcs and keep their own
                            size at every zoom. The layer's transparent
                            background is the map's drag surface.
                        -->
                        <Canvas x:Name="DotLayer"
                                Background="Transparent"
                                Tapped="OnMapBackgroundTapped" />
                    </Grid>

                    <!-- The chooser, seated beside its marker in code. -->
                    <Canvas x:Name="ChooserLayer">
                        <Border x:Name="ChooserCard"
                                Width="300"
                                Padding="14"
                                CornerRadius="16"
                                Background="{StaticResource CardBackgroundBrush}"
                                BorderBrush="{StaticResource CardBorderBrush}"
                                BorderThickness="1"
                                Visibility="Collapsed">
                            <StackPanel Spacing="10">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Viewbox Grid.Column="0"
                                             Width="22"
                                             Height="16"
                                             VerticalAlignment="Center">
                                        <controls:FlagIcon x:Name="ChooserFlag" />
                                    </Viewbox>
                                    <TextBlock x:Name="ChooserTitle"
                                               Grid.Column="1"
                                               FontFamily="{StaticResource BalooSemiBoldFont}"
                                               FontSize="12.5"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center"
                                               LineStackingStrategy="BlockLineHeight"
                                               LineHeight="17" />
                                    <Button Grid.Column="2"
                                            Style="{StaticResource BareButtonStyle}"
                                            VerticalAlignment="Top"
                                            Click="OnChooserCloseClick">
                                        <Border Width="20"
                                                Height="20"
                                                CornerRadius="10"
                                                Background="#F1F3F6">
                                            <TextBlock Text="&#215;"
                                                       FontFamily="{StaticResource BalooSemiBoldFont}"
                                                       FontSize="12"
                                                       Foreground="{StaticResource CardMetaBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       LineStackingStrategy="BlockLineHeight"
                                                       LineHeight="12" />
                                        </Border>
                                    </Button>
                                </Grid>

                                <StackPanel x:Name="ChooserRows" Spacing="6" />
                            </StackPanel>
                        </Border>
                    </Canvas>

                    <!--
                        ZOOM: closer, further, and the whole earth back. The
                        wheel zooms about the pointer and a drag carries the
                        view; these are the same trip with somewhere definite
                        to land.
                    -->
                    <StackPanel HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="14"
                                Spacing="8">
                        <Button Style="{StaticResource BareButtonStyle}"
                                ToolTipService.ToolTip="Zoom in"
                                IsEnabled="{x:Bind ViewModel.CanZoomIn, Mode=OneWay}"
                                Click="OnZoomInClick">
                            <Border Width="34"
                                    Height="34"
                                    CornerRadius="17"
                                    Background="#F2FFFFFF"
                                    BorderBrush="{StaticResource CardBorderBrush}"
                                    BorderThickness="1">
                                <Viewbox Width="14"
                                         Height="14">
                                    <Canvas Width="18" Height="18">
                                        <Path Data="M9 3.75 V14.25 M3.75 9 H14.25"
                                              Stroke="#5C6066"
                                              StrokeThickness="2.2"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round" />
                                    </Canvas>
                                </Viewbox>
                            </Border>
                        </Button>

                        <Button Style="{StaticResource BareButtonStyle}"
                                ToolTipService.ToolTip="Zoom out"
                                IsEnabled="{x:Bind ViewModel.CanZoomOut, Mode=OneWay}"
                                Click="OnZoomOutClick">
                            <Border Width="34"
                                    Height="34"
                                    CornerRadius="17"
                                    Background="#F2FFFFFF"
                                    BorderBrush="{StaticResource CardBorderBrush}"
                                    BorderThickness="1">
                                <Viewbox Width="14"
                                         Height="14">
                                    <Canvas Width="18" Height="18">
                                        <Path Data="M3.75 9 H14.25"
                                              Stroke="#5C6066"
                                              StrokeThickness="2.2"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round" />
                                    </Canvas>
                                </Viewbox>
                            </Border>
                        </Button>

                        <Button Style="{StaticResource BareButtonStyle}"
                                ToolTipService.ToolTip="Back to the whole earth"
                                Click="OnZoomResetClick">
                            <Border Width="34"
                                    Height="34"
                                    CornerRadius="17"
                                    Background="#F2FFFFFF"
                                    BorderBrush="{StaticResource CardBorderBrush}"
                                    BorderThickness="1">
                                <Viewbox Width="14"
                                         Height="14">
                                    <Canvas Width="18" Height="18">
                                        <Path Data="M3 6.6 V4.8 Q3 3 4.8 3 H6.6 M11.4 3 H13.2 Q15 3 15 4.8 V6.6 M15 11.4 V13.2 Q15 15 13.2 15 H11.4 M6.6 15 H4.8 Q3 15 3 13.2 V11.4"
                                              Stroke="#5C6066"
                                              StrokeThickness="2"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round" />
                                    </Canvas>
                                </Viewbox>
                            </Border>
                        </Button>
                    </StackPanel>

                    <!-- The states, centred on the plate. -->
                    <Border HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            CornerRadius="14"
                            Padding="18,10"
                            Background="#F2FFFFFF"
                            BorderBrush="{StaticResource CardBorderBrush}"
                            BorderThickness="1"
                            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Plotting the network..."
                                   Style="{StaticResource StateTextStyle}" />
                    </Border>

                    <Border HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            CornerRadius="14"
                            Padding="18,10"
                            Background="#F2FFFFFF"
                            BorderBrush="{StaticResource CardBorderBrush}"
                            BorderThickness="1"
                            Visibility="{x:Bind ViewModel.IsError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="The directory refused - go back and try again."
                                   Style="{StaticResource StateTextStyle}" />
                    </Border>

                    <Border HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            CornerRadius="14"
                            Padding="18,10"
                            Background="#F2FFFFFF"
                            BorderBrush="{StaticResource CardBorderBrush}"
                            BorderThickness="1"
                            Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Spacing="2">
                            <TextBlock Text="No VPS records yet"
                                       Style="{StaticResource StateTextStyle}" />
                            <TextBlock Text="Add one, and it lands on the page."
                                       Style="{StaticResource StateTextStyle}" />
                        </StackPanel>
                    </Border>

                    <!-- The honest footnote about the records that could not
                         be placed. -->
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                Margin="12"
                                Orientation="Horizontal"
                                Spacing="7"
                                Visibility="{x:Bind ViewModel.HasOffMap, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <controls:LineIcon Kind="Info"
                                           Width="13"
                                           Height="13"
                                           Foreground="{StaticResource CardMetaBrush}"
                                           VerticalAlignment="Center" />
                        <TextBlock Text="{x:Bind ViewModel.OffMapNote, Mode=OneWay}"
                                   FontFamily="{StaticResource BalooFont}"
                                   FontSize="11.5"
                                   Foreground="{StaticResource CardMetaBrush}"
                                   VerticalAlignment="Center"
                                   LineStackingStrategy="BlockLineHeight"
                                   LineHeight="15" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
