<?xml version="1.0" encoding="utf-8"?>
<!--
    The app's single theme entry point: App.xaml merges only this file.

    Colors.xaml and Fonts.xaml are merged *here* rather than alongside this file in
    App.xaml on purpose. A StaticResource inside one merged dictionary cannot reliably
    see keys from a sibling merged dictionary, but it can always see keys from its own
    MergedDictionaries - so the styles below are guaranteed to resolve the palette.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ms-appx:///Styles/Colors.xaml" />
        <ResourceDictionary Source="ms-appx:///Styles/Fonts.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--
        The shared flat-button template: 8px radius, Jersey 25 caption, no border.

        Hover and press are a translucent black wash over whatever Background the button
        was given, rather than a second and third brush per colour. That is what lets the
        primary and destructive buttons share one template instead of duplicating it -
        and it means a new button colour needs one brush, not four.

        The wash has to be overridden inside the template rather than with Setters,
        because the stock template's visual states re-apply their own brushes on
        hover/press and would win over a plain Setter.
    -->
    <Style x:Key="FlatButtonStyle" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextOnBrandBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Height" Value="40" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="{StaticResource JerseyFont}" />
        <Setter Property="FontSize" Value="{StaticResource ButtonFontSize}" />
        <Setter Property="CharacterSpacing" Value="40" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root"
                          Background="{TemplateBinding Background}"
                          CornerRadius="{TemplateBinding CornerRadius}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Shade.Opacity" Value="0.08" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Shade.Opacity" Value="0.16" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <!-- Sits over the fill but under the content, so only the
                             background darkens and the caption stays pure white. -->
                        <Grid x:Name="Shade"
                              Background="#000000"
                              Opacity="0"
                              CornerRadius="{TemplateBinding CornerRadius}" />

                        <ContentPresenter x:Name="ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Padding="{TemplateBinding Padding}"
                                          Foreground="{TemplateBinding Foreground}"
                                          FontFamily="{TemplateBinding FontFamily}"
                                          FontSize="{TemplateBinding FontSize}"
                                          CharacterSpacing="{TemplateBinding CharacterSpacing}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                          AutomationProperties.AccessibilityView="Raw" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The primary call to action. -->
    <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource FlatButtonStyle}">
        <Setter Property="Background" Value="{StaticResource BrandPrimaryBrush}" />
    </Style>

    <!-- Destructive. Only used for "RESET", which erases everything. -->
    <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource FlatButtonStyle}">
        <Setter Property="Background" Value="{StaticResource DangerBrush}" />
    </Style>

    <!--
        A quiet text link - "Forgot password?" on the lock screen.

        HyperlinkButton is templated away rather than restyled: its default brings accent
        colouring, an underline and a 4px padding box, none of which the design has. The
        hover cue is a darkening of the text, since there is no room for a background.
    -->
    <Style x:Key="LinkButtonStyle" TargetType="HyperlinkButton">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontFamily" Value="{StaticResource BalooFont}" />
        <Setter Property="FontSize" Value="{StaticResource LinkFontSize}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="HyperlinkButton">
                    <Grid x:Name="Root" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="ContentPresenter.Foreground"
                                                Value="{StaticResource TextPrimaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="ContentPresenter.Foreground"
                                                Value="{StaticResource TextPlaceholderBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="ContentPresenter.Foreground"
                                                Value="{StaticResource TextPlaceholderBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <!--
                            Foreground is set on the presenter, not on the content, so the
                            state setters above cascade down to the TextBlock inside by
                            normal property inheritance.
                        -->
                        <ContentPresenter x:Name="ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Foreground="{TemplateBinding Foreground}"
                                          FontFamily="{TemplateBinding FontFamily}"
                                          FontSize="{TemplateBinding FontSize}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                          AutomationProperties.AccessibilityView="Raw" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Centred body copy under the logo. -->
    <Style x:Key="SubtitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BalooFont}" />
        <Setter Property="FontSize" Value="{StaticResource SubtitleFontSize}" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Centred screen title, a step up from the subtitle. -->
    <Style x:Key="TitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextStyle}">
        <Setter Property="FontSize" Value="{StaticResource TitleFontSize}" />
    </Style>

</ResourceDictionary>
