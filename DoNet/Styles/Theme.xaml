<?xml version="1.0" encoding="utf-8"?>
<!--
    The app's single theme entry point: App.xaml merges only this file.

    Colors.xaml and Fonts.xaml are merged *here* rather than alongside this file in
    App.xaml on purpose. A StaticResource inside one merged dictionary cannot reliably
    see keys from a sibling merged dictionary, but it can always see keys from its own
    MergedDictionaries - so the styles below are guaranteed to resolve the palette.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ms-appx:///Styles/Colors.xaml" />
        <ResourceDictionary Source="ms-appx:///Styles/Fonts.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--
        The shared flat-button template: 8px radius, Jersey 25 caption, no border.

        Hover and press are a translucent black wash over whatever Background the button
        was given, rather than a second and third brush per colour. That is what lets the
        primary and destructive buttons share one template instead of duplicating it -
        and it means a new button colour needs one brush, not four.

        The wash has to be overridden inside the template rather than with Setters,
        because the stock template's visual states re-apply their own brushes on
        hover/press and would win over a plain Setter.
    -->
    <Style x:Key="FlatButtonStyle" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextOnBrandBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Height" Value="40" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="{StaticResource JerseyFont}" />
        <Setter Property="FontSize" Value="{StaticResource ButtonFontSize}" />
        <Setter Property="CharacterSpacing" Value="40" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root"
                          Background="{TemplateBinding Background}"
                          CornerRadius="{TemplateBinding CornerRadius}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Shade.Opacity" Value="0.08" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Shade.Opacity" Value="0.16" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <!-- Sits over the fill but under the content, so only the
                             background darkens and the caption stays pure white. -->
                        <Grid x:Name="Shade"
                              Background="#000000"
                              Opacity="0"
                              CornerRadius="{TemplateBinding CornerRadius}" />

                        <ContentPresenter x:Name="ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Padding="{TemplateBinding Padding}"
                                          Foreground="{TemplateBinding Foreground}"
                                          FontFamily="{TemplateBinding FontFamily}"
                                          FontSize="{TemplateBinding FontSize}"
                                          CharacterSpacing="{TemplateBinding CharacterSpacing}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                          AutomationProperties.AccessibilityView="Raw" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The primary call to action. -->
    <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource FlatButtonStyle}">
        <Setter Property="Background" Value="{StaticResource BrandPrimaryBrush}" />
    </Style>

    <!-- Destructive. Only used for "RESET", which erases everything. -->
    <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource FlatButtonStyle}">
        <Setter Property="Background" Value="{StaticResource DangerBrush}" />
    </Style>

    <!--
        A quiet text link - "Forgot password?" on the lock screen.

        HyperlinkButton is templated away rather than restyled: its default brings accent
        colouring, an underline and a 4px padding box, none of which the design has. The
        hover cue is a darkening of the text, since there is no room for a background.
    -->
    <Style x:Key="LinkButtonStyle" TargetType="HyperlinkButton">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontFamily" Value="{StaticResource BalooFont}" />
        <Setter Property="FontSize" Value="{StaticResource LinkFontSize}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="HyperlinkButton">
                    <Grid x:Name="Root" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="ContentPresenter.Foreground"
                                                Value="{StaticResource TextPrimaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="ContentPresenter.Foreground"
                                                Value="{StaticResource TextPlaceholderBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="ContentPresenter.Foreground"
                                                Value="{StaticResource TextPlaceholderBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <!--
                            Foreground is set on the presenter, not on the content, so the
                            state setters above cascade down to the TextBlock inside by
                            normal property inheritance.
                        -->
                        <ContentPresenter x:Name="ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Foreground="{TemplateBinding Foreground}"
                                          FontFamily="{TemplateBinding FontFamily}"
                                          FontSize="{TemplateBinding FontSize}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                          AutomationProperties.AccessibilityView="Raw" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Centred body copy under the logo. -->
    <Style x:Key="SubtitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BalooFont}" />
        <Setter Property="FontSize" Value="{StaticResource SubtitleFontSize}" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Centred screen title, a step up from the subtitle. -->
    <Style x:Key="TitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextStyle}">
        <Setter Property="FontSize" Value="{StaticResource TitleFontSize}" />
    </Style>

    <!--
        Caption buttons: a plain coloured dot.

        The clickable Button is 20x20 while the dot is 12x12, so the hit target is
        comfortable without the dots drifting apart - at this size the gap between them
        is the 8px the design shows. Hover and press darken the dot rather than drawing
        a glyph inside it, which keeps them quiet.
    -->
    <Style x:Key="CaptionButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <!-- Transparent fill rather than none, so the whole 20x20 square
                         is hit-testable and not just the dot. -->
                    <Grid Background="Transparent">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Shade.Opacity" Value="0.16" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Shade.Opacity" Value="0.30" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Ellipse Width="12" Height="12" Fill="{TemplateBinding Background}" />
                        <Ellipse x:Name="Shade" Width="12" Height="12" Fill="#000000" Opacity="0" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!--
        The rail button's hit target. It draws nothing: the disc, icon and every state
        are rendered by NavRailButton above it. Background must be an explicit brush
        rather than left unset, or the template root has nothing to hit-test against.
    -->
    <Style x:Key="NavRailHitStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="CornerRadius" Value="28" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="{TemplateBinding Background}"
                          CornerRadius="{TemplateBinding CornerRadius}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        A button that is nothing but its content.

        Distinct from NavRailHitStyle, which is deliberately a bare Grid with no
        ContentPresenter because the rail draws its own visuals underneath and only
        needs an invisible hit target. Using that style for a button whose content IS
        the visual renders an invisible rectangle - which is exactly what happened to
        ADD PERSON. This one presents its content and carries the pointer feedback.
    -->
    <Style x:Key="BareButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <ContentPresenter x:Name="Presenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />

                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Presenter"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.82" Duration="0:0:0.08" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Presenter"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.65" Duration="0:0:0.08" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Presenter"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.4" Duration="0" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Strips a Flyout back to nothing so the card menu can supply its own surface and
        its own entrance animation. Without this the menu would sit inside a second,
        system-drawn panel with its own padding and corner radius.
    -->
    <Style x:Key="BareFlyoutPresenterStyle" TargetType="FlyoutPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="MaxWidth" Value="1000" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollMode" Value="Disabled" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="FlyoutPresenter">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NavToolTipStyle" TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource TooltipBackgroundBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TooltipForegroundBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource BalooFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="12,4,12,6" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <!--
        A text box with no chrome and, most importantly, no clear button.

        The stock TextBox template puts a round "x" inside the field whenever it has
        focus and content. There is no property that turns it off - it is a template
        part named DeleteButton, and no theme resource reaches it - so the only way to
        be rid of it is to supply a template without one. That is what this is: the
        three parts TextBox actually requires (BorderElement, ContentElement and
        PlaceholderTextContentPresenter, which the control finds by name and drives
        itself) and nothing else.

        Fewer elements per field is also simply cheaper. A form of sixteen fields drops
        sixteen buttons, their visual-state groups and their animations out of the tree.

        Colours, padding and sizing deliberately come from the control's own properties
        rather than being baked in, so the hosting Border can keep setting them the way
        the rest of the app already does.
    -->
    <Style x:Key="BareTextBoxStyle" TargetType="TextBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />

        <!--
            Control.HorizontalContentAlignment defaults to Center, and the stock TextBox
            template never binds it, so it never shows. This template does bind it, which
            means it has to be set here or every field centres its text and placeholder.
        -->
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Auto" />
        <Setter Property="ScrollViewer.VerticalScrollMode" Value="Auto" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Hidden" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <!--
                            Named BorderElement because TextBox looks for it; it carries
                            nothing, since the field's frame is drawn by the Border that
                            hosts the control.
                        -->
                        <Border x:Name="BorderElement"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}" />

                        <!--
                            TextBox shows and hides this itself, by part name, as the
                            text changes. It must not take the pointer or the caret will
                            not land where it was clicked.
                        -->
                        <ContentControl x:Name="PlaceholderTextContentPresenter"
                                        Grid.Row="0"
                                        Margin="{TemplateBinding Padding}"
                                        Padding="0"
                                        Content="{TemplateBinding PlaceholderText}"
                                        Foreground="{TemplateBinding PlaceholderForeground}"
                                        FontFamily="{TemplateBinding FontFamily}"
                                        FontSize="{TemplateBinding FontSize}"
                                        FontWeight="{TemplateBinding FontWeight}"
                                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                        IsHitTestVisible="False"
                                        IsTabStop="False" />

                        <ScrollViewer x:Name="ContentElement"
                                      Padding="{TemplateBinding Padding}"
                                      HorizontalScrollMode="{TemplateBinding ScrollViewer.HorizontalScrollMode}"
                                      VerticalScrollMode="{TemplateBinding ScrollViewer.VerticalScrollMode}"
                                      HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                      VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                      IsTabStop="False"
                                      IsHorizontalRailEnabled="False"
                                      IsVerticalRailEnabled="False"
                                      ZoomMode="Disabled"
                                      AutomationProperties.AccessibilityView="Raw" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
