<?xml version="1.0" encoding="utf-8"?>
<!--
    DoNet palette. The brand teal, the home surfaces and their strokes are the
    design's own values; the hover, pressed and disabled steps are derived from the
    teal so they move with it.

    Colors are declared separately from Brushes because the logo gradient needs raw
    Color values for its GradientStops.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Brand ................................................................ -->
    <Color x:Key="BrandTealDeepColor">#49A48C</Color>
    <Color x:Key="BrandTealSoftColor">#83CDB4</Color>
    <Color x:Key="BrandPrimaryColor">#4BAA98</Color>
    <Color x:Key="BrandPrimaryHoverColor">#449989</Color>
    <Color x:Key="BrandPrimaryPressedColor">#3C887A</Color>
    <Color x:Key="BrandPrimaryDisabledColor">#BBDFD8</Color>

    <SolidColorBrush x:Key="BrandPrimaryBrush" Color="{StaticResource BrandPrimaryColor}" />
    <SolidColorBrush x:Key="BrandPrimaryHoverBrush" Color="{StaticResource BrandPrimaryHoverColor}" />
    <SolidColorBrush x:Key="BrandPrimaryPressedBrush" Color="{StaticResource BrandPrimaryPressedColor}" />
    <SolidColorBrush x:Key="BrandPrimaryDisabledBrush" Color="{StaticResource BrandPrimaryDisabledColor}" />

    <!-- Surfaces ............................................................. -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="FieldBackgroundBrush" Color="#FFFFFF" />

    <!-- Text ................................................................. -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#2B2F33" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5C6066" />
    <SolidColorBrush x:Key="TextPlaceholderBrush" Color="#8C9196" />
    <SolidColorBrush x:Key="TextOnBrandBrush" Color="#FFFFFF" />

    <!-- Fields ............................................................... -->
    <SolidColorBrush x:Key="FieldBorderBrush" Color="#E4E6E9" />
    <SolidColorBrush x:Key="FieldBorderHoverBrush" Color="#CFD3D8" />
    <SolidColorBrush x:Key="FieldBorderFocusedBrush" Color="#429882" />
    <SolidColorBrush x:Key="FieldBorderErrorBrush" Color="#D9705F" />
    <SolidColorBrush x:Key="FieldIconBrush" Color="#A0A5AB" />
    <SolidColorBrush x:Key="FieldIconHoverBrush" Color="#F0F1F2" />
    <SolidColorBrush x:Key="FieldIconPressedBrush" Color="#E4E6E9" />

    <!-- Amber notice (the "do not forget your password" strip) ............... -->
    <SolidColorBrush x:Key="NoticeBackgroundBrush" Color="#FDF4E7" />
    <SolidColorBrush x:Key="NoticeBorderBrush" Color="#F6DEB4" />
    <SolidColorBrush x:Key="NoticeForegroundBrush" Color="#C4710B" />

    <!-- Caption buttons ...................................................... -->
    <SolidColorBrush x:Key="CaptionMinimizeBrush" Color="#28C840" />
    <SolidColorBrush x:Key="CaptionMaximizeBrush" Color="#FEBC2E" />
    <SolidColorBrush x:Key="CaptionCloseBrush" Color="#FF5F57" />

    <!-- Destructive: the reset action on the forgot-password screen .......... -->
    <SolidColorBrush x:Key="DangerBrush" Color="#E01B24" />
    <SolidColorBrush x:Key="DangerHeadingBrush" Color="#A4161A" />
    <SolidColorBrush x:Key="DangerBodyBrush" Color="#C0392B" />

    <!-- Green notice, shown in the same slot when the vault is created ...... -->
    <SolidColorBrush x:Key="SuccessBackgroundBrush" Color="#EAF6F1" />
    <SolidColorBrush x:Key="SuccessBorderBrush" Color="#BFE0D2" />
    <SolidColorBrush x:Key="SuccessForegroundBrush" Color="#2E7D5B" />

    <!-- Red notice, shown in the same slot when validation fails ............. -->
    <SolidColorBrush x:Key="ErrorBackgroundBrush" Color="#FDECEA" />
    <SolidColorBrush x:Key="ErrorBorderBrush" Color="#F3C6C0" />
    <SolidColorBrush x:Key="ErrorForegroundBrush" Color="#C0392B" />

</ResourceDictionary>
