<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DoNet.Controls.FieldCell"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        One labelled field box, in every variant the two dialogs need: read-only with a
        COPY button, editable with a placeholder, automatic (greyed, assigned by the
        store), and secret (masked with a reveal toggle, optionally with AUTO GENERATE).

        Built once rather than eighteen times. The add and preview dialogs are the same
        grid of cells in different modes, so duplicating this markup per field would
        guarantee they drift apart.
    -->

    <Border x:Name="Shell"
            CornerRadius="12"
            Padding="16,12,12,12"
            Background="{StaticResource CardBackgroundBrush}"
            BorderBrush="{StaticResource SearchBorderBrush}"
            BorderThickness="1">

        <Border.Resources>
            <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
            <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="Transparent" />
            <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
            <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="Transparent" />
            <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
            <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
            <Thickness x:Key="TextControlThemePadding">0</Thickness>
            <x:Double x:Key="TextControlThemeMinHeight">0</x:Double>
            <x:Double x:Key="TextControlThemeMinWidth">0</x:Double>
        </Border.Resources>

        <Grid RowSpacing="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="LabelText"
                       Grid.Row="0"
                       FontFamily="{StaticResource BalooFont}"
                       FontSize="{StaticResource FieldLabelFontSize}"
                       Foreground="{StaticResource FieldLabelBrush}"
                       CharacterSpacing="60"
                       TextTrimming="CharacterEllipsis"
                       LineStackingStrategy="BlockLineHeight"
                       LineHeight="14" />

            <Grid Grid.Row="1" ColumnSpacing="10" MinHeight="30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Read-only value, used by the preview dialog. -->
                <TextBlock x:Name="ValueText"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           FontFamily="{StaticResource BalooFont}"
                           FontSize="{StaticResource FieldValueFontSize}"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           TextTrimming="CharacterEllipsis"
                           LineStackingStrategy="BlockLineHeight"
                           LineHeight="20" />

                <!-- Editable value. -->
                <TextBox x:Name="ValueInput"
                         Grid.Column="0"
                         Visibility="Collapsed"
                         VerticalAlignment="Center"
                         FontFamily="{StaticResource BalooFont}"
                         FontSize="{StaticResource FieldValueFontSize}"
                         Foreground="{StaticResource TextPrimaryBrush}"
                         PlaceholderForeground="{StaticResource SearchPlaceholderBrush}"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0"
                         MinHeight="0"
                         MinWidth="0"
                         TextChanged="OnInputChanged" />

                <!-- Secret value, masked until revealed. -->
                <PasswordBox x:Name="SecretInput"
                             Grid.Column="0"
                             Visibility="Collapsed"
                             VerticalAlignment="Center"
                             FontFamily="{StaticResource BalooFont}"
                             FontSize="{StaticResource FieldValueFontSize}"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             PlaceholderForeground="{StaticResource SearchPlaceholderBrush}"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="0"
                             MinHeight="0"
                             MinWidth="0"
                             PasswordRevealMode="Hidden"
                             PasswordChanged="OnSecretChanged" />

                <!-- Reveal toggle for secret fields. -->
                <Button x:Name="RevealButton"
                        Grid.Column="1"
                        Visibility="Collapsed"
                        Width="28"
                        Height="28"
                        VerticalAlignment="Center"
                        Style="{StaticResource BareButtonStyle}"
                        Click="OnRevealClick">
                    <Viewbox Width="18" Height="18">
                        <Canvas Width="20" Height="20">
                            <Path x:Name="EyeGlyph"
                                  Data="M10 4C5.5 4 2.2 7.4 1 10C2.2 12.6 5.5 16 10 16C14.5 16 17.8 12.6 19 10C17.8 7.4 14.5 4 10 4Z M12.5 10A2.5 2.5 0 1 1 7.5 10A2.5 2.5 0 1 1 12.5 10"
                                  Stroke="{StaticResource FieldLabelBrush}"
                                  StrokeThickness="1.4"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" />
                            <Path x:Name="EyeSlash"
                                  Visibility="Collapsed"
                                  Data="M3.5 3.5L16.5 16.5"
                                  Stroke="{StaticResource FieldLabelBrush}"
                                  StrokeThickness="1.4"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" />
                        </Canvas>
                    </Viewbox>
                </Button>

                <!-- AUTO GENERATE, on the two password fields in the add/edit form. -->
                <Button x:Name="GenerateButton"
                        Grid.Column="2"
                        Visibility="Collapsed"
                        VerticalAlignment="Center"
                        Style="{StaticResource BareButtonStyle}"
                        Click="OnGenerateClick">
                    <Border CornerRadius="8"
                            Height="30"
                            Padding="12,0,12,0"
                            Background="{StaticResource CardBackgroundBrush}"
                            BorderBrush="{StaticResource SearchBorderBrush}"
                            BorderThickness="1">
                        <TextBlock Text="AUTO GENERATE"
                                   VerticalAlignment="Center"
                                   FontFamily="{StaticResource JerseyFont}"
                                   FontSize="13"
                                   Foreground="{StaticResource CardMetaBrush}"
                                   CharacterSpacing="40" />
                    </Border>
                </Button>

                <!-- COPY, on the preview dialog. -->
                <Button x:Name="CopyButton"
                        Grid.Column="3"
                        Visibility="Collapsed"
                        VerticalAlignment="Center"
                        Style="{StaticResource BareButtonStyle}"
                        Click="OnCopyClick">
                    <Border x:Name="CopyShell"
                            CornerRadius="8"
                            Height="30"
                            Padding="10,0,12,0"
                            Background="{StaticResource CardBackgroundBrush}"
                            BorderBrush="{StaticResource SearchBorderBrush}"
                            BorderThickness="1">
                        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                            <Viewbox Width="15" Height="15" VerticalAlignment="Center">
                                <Canvas Width="18" Height="18">
                                    <Path Data="M6 6.5C6 5.4 6.9 4.5 8 4.5H13.5C14.6 4.5 15.5 5.4 15.5 6.5V12C15.5 13.1 14.6 14 13.5 14H8C6.9 14 6 13.1 6 12Z M12 4.5V4C12 2.9 11.1 2 10 2H4.5C3.4 2 2.5 2.9 2.5 4V9.5C2.5 10.6 3.4 11.5 4.5 11.5H5"
                                          Stroke="{StaticResource CardMetaBrush}"
                                          StrokeThickness="1.4"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock x:Name="CopyLabel"
                                       Text="COPY"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource JerseyFont}"
                                       FontSize="13"
                                       Foreground="{StaticResource CardMetaBrush}"
                                       CharacterSpacing="40" />
                        </StackPanel>
                    </Border>
                </Button>
            </Grid>
        </Grid>
    </Border>
</UserControl>
