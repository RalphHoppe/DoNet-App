<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DoNet.Controls.PaymentMethodIcon"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    IsTabStop="False">

    <!--
        The six built-in payment marks, plus a neutral fallback for anything the user
        typed in themselves.

        Each mark is x:Load="False" and realised through FindName when Key is applied,
        so an instance builds only the one it was asked for. A website card can show
        six of these at once and the add dialog shows every option at least twice, so
        building all seven drawings in every instance would be most of a thousand
        elements to draw a handful of small logos.

        Drawn on a 24x24 canvas and scaled by a Viewbox, so one control serves the
        20px chips, the card and the preview panel.
    -->
    <Viewbox Stretch="Uniform">
        <Grid Width="24" Height="24">

            <!-- PayPal: the interlocking double P. -->
            <Canvas x:Name="PayPalMark" x:Load="False" Width="24" Height="24">
                <Path Fill="#009CDE"
                      Data="M9.8 22.1L10.3 18.8H13.6C17 18.8 19.6 16.7 20.1 13.3C20.5 10.8 19.3 9 17.2 8.3C17.3 8.7 17.3 9.2 17.2 9.7C16.6 13.3 14 15.3 10.4 15.3H7.6L6.5 22.1Z" />
                <Path Fill="#003087"
                      Data="M7.4 2.2H12.9C15.9 2.2 18.1 3.9 17.6 7.1C17 10.5 14.4 12.5 10.9 12.5H8.3L7.4 18.2H3.9Z" />
            </Canvas>

            <!-- Apple Pay: the Apple mark. -->
            <Canvas x:Name="ApplePayMark" x:Load="False" Width="24" Height="24">
                <Path Fill="#000000"
                      Data="M17.05 12.54C17.02 9.86 19.24 8.57 19.34 8.51C18.09 6.68 16.15 6.43 15.46 6.4C13.81 6.23 12.24 7.37 11.4 7.37C10.56 7.37 9.27 6.42 7.9 6.45C6.1 6.48 4.44 7.5 3.52 9.11C1.65 12.35 3.04 17.14 4.86 19.77C5.75 21.06 6.81 22.5 8.2 22.45C9.54 22.4 10.05 21.58 11.67 21.58C13.29 21.58 13.75 22.45 15.17 22.42C16.61 22.4 17.53 21.11 18.41 19.82C19.43 18.33 19.85 16.88 19.88 16.81C19.85 16.8 17.08 15.73 17.05 12.54Z" />
                <Path Fill="#000000"
                      Data="M14.9 4.72C15.64 3.82 16.14 2.58 16 1.34C14.93 1.38 13.64 2.05 12.88 2.95C12.2 3.74 11.6 5.01 11.76 6.22C12.95 6.31 14.16 5.62 14.9 4.72Z" />
            </Canvas>

            <!-- Google Pay: the four-colour G. -->
            <Canvas x:Name="GooglePayMark" x:Load="False" Width="24" Height="24">
                <Path Fill="#4285F4"
                      Data="M23.04 12.26C23.04 11.44 22.97 10.66 22.83 9.9H12V14.36H18.19C17.92 15.8 17.11 17.02 15.89 17.84V20.74H19.61C21.79 18.74 23.04 15.78 23.04 12.26Z" />
                <Path Fill="#34A853"
                      Data="M12 24C15.11 24 17.72 22.97 19.61 20.74L15.89 17.84C14.86 18.53 13.54 18.94 12 18.94C8.99 18.94 6.45 16.91 5.54 14.18H1.69V17.16C3.59 21.39 7.49 24 12 24Z" />
                <Path Fill="#FBBC05"
                      Data="M5.54 14.18C5.31 13.49 5.18 12.76 5.18 12C5.18 11.24 5.31 10.51 5.54 9.82V6.84H1.69C0.91 8.39 0.47 10.15 0.47 12C0.47 13.85 0.91 15.61 1.69 17.16Z" />
                <Path Fill="#EA4335"
                      Data="M12 5.06C13.7 5.06 15.22 5.64 16.42 6.79L19.69 3.52C17.71 1.67 15.11 0.64 12 0.64C7.49 0.64 3.59 3.25 1.69 7.48L5.54 10.46C6.45 7.73 8.99 5.06 12 5.06Z" />
            </Canvas>

            <!-- Bitcoin. -->
            <Canvas x:Name="BitcoinMark" x:Load="False" Width="24" Height="24">
                <Ellipse Width="24" Height="24" Fill="#F7931A" />
                <Path Stroke="#FFFFFF" StrokeThickness="1.7"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      Data="M9.4 6.9V17.3 M9.4 6.9H13.1C14.5 6.9 15.4 7.8 15.4 9C15.4 10.3 14.5 11.1 13.1 11.1H9.4 M9.4 11.1H13.7C15.2 11.1 16.1 12 16.1 13.2C16.1 14.5 15.2 15.4 13.7 15.4H9.4" />
                <Path Stroke="#FFFFFF" StrokeThickness="1.5" StrokeStartLineCap="Round"
                      Data="M11.2 5.1V6.9 M13.3 5.1V6.9 M11.2 15.4V17.3 M13.3 15.4V17.3" />
            </Canvas>

            <!-- Ethereum. -->
            <Canvas x:Name="EthereumMark" x:Load="False" Width="24" Height="24">
                <Path Fill="#8A9CF0" Data="M12 1.5L5.6 12.1L12 15.9L18.4 12.1Z" />
                <Path Fill="#627EEA" Data="M12 1.5L12 15.9L18.4 12.1Z" />
                <Path Fill="#8A9CF0" Data="M12 17.3L5.6 13.4L12 22.5L18.4 13.4Z" />
                <Path Fill="#627EEA" Data="M12 17.3L12 22.5L18.4 13.4Z" />
            </Canvas>

            <!-- USDT. -->
            <Canvas x:Name="UsdtMark" x:Load="False" Width="24" Height="24">
                <Ellipse Width="24" Height="24" Fill="#26A17B" />
                <Path Fill="#FFFFFF" Data="M6.4 6.6H17.6V9.3H13.4V11.1H10.6V9.3H6.4Z" />
                <Path Fill="#FFFFFF" Data="M10.6 12.6H13.4V18.4H10.6Z" />
                <Ellipse Canvas.Left="7" Canvas.Top="9.9" Width="10" Height="3.8"
                         Stroke="#FFFFFF" StrokeThickness="1.4" />
            </Canvas>

            <!--
                Anything the user added themselves. A plain card outline rather than an
                invented logo: a made-up mark next to six real ones reads as a brand
                the reader has failed to recognise.
            -->
            <Canvas x:Name="GenericMark" x:Load="False" Width="24" Height="24">
                <Rectangle Canvas.Left="2" Canvas.Top="5" Width="20" Height="14"
                           RadiusX="3" RadiusY="3"
                           Fill="#F8FAFC" Stroke="#8C9196" StrokeThickness="1.5" />
                <Rectangle Canvas.Left="2" Canvas.Top="8.5" Width="20" Height="3" Fill="#8C9196" />
                <Rectangle Canvas.Left="5" Canvas.Top="14" Width="6" Height="2"
                           RadiusX="1" RadiusY="1" Fill="#8C9196" />
            </Canvas>

        </Grid>
    </Viewbox>
</UserControl>
