<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DoNet.Controls.PersonCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        A directory card.

        Its own control rather than a DataTemplate because of the menu: named elements
        inside a DataTemplate cannot be reached from code, and the menu needs to be
        animated. As a control it gets a code-behind and ordinary x:Name access.

        No copy buttons on the field cells - they were cut after the design was drawn.
    -->

    <UserControl.Resources>

        <Style x:Key="MenuItemStyle" TargetType="Button" BasedOn="{StaticResource BareButtonStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource BalooFont}" />
            <Setter Property="FontSize" Value="{StaticResource FieldLabelFontSize}" />
            <Setter Property="Foreground" Value="{StaticResource FieldLabelBrush}" />
            <Setter Property="CharacterSpacing" Value="60" />
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
            <Setter Property="LineHeight" Value="14" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="FieldValueStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource BalooFont}" />
            <Setter Property="FontSize" Value="{StaticResource FieldValueFontSize}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
            <Setter Property="LineHeight" Value="20" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!--
            The drawer opening. The bar grows out of the dots while the two icons fade
            up into it, staggered so they arrive as the space for them appears rather
            than being there waiting.

            EnableDependentAnimation is mandatory: Height cannot be animated on the
            composition thread, and without it the animation is silently dropped and
            the bar simply snaps open.
        -->
        <Storyboard x:Key="MenuOpen">
            <DoubleAnimation Storyboard.TargetName="MenuSurface"
                             Storyboard.TargetProperty="Height"
                             EnableDependentAnimation="True"
                             To="106" Duration="0:0:0.26">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="MenuSurface"
                             Storyboard.TargetProperty="Opacity"
                             To="1" Duration="0:0:0.14" />
            <DoubleAnimation Storyboard.TargetName="DotsRotation"
                             Storyboard.TargetProperty="Angle"
                             To="90" Duration="0:0:0.26">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <DoubleAnimation Storyboard.TargetName="EditItem"
                             Storyboard.TargetProperty="Opacity"
                             BeginTime="0:0:0.07" To="1" Duration="0:0:0.16" />
            <DoubleAnimation Storyboard.TargetName="EditOffset"
                             Storyboard.TargetProperty="Y"
                             BeginTime="0:0:0.07" To="0" Duration="0:0:0.20">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <DoubleAnimation Storyboard.TargetName="DeleteItem"
                             Storyboard.TargetProperty="Opacity"
                             BeginTime="0:0:0.12" To="1" Duration="0:0:0.16" />
            <DoubleAnimation Storyboard.TargetName="DeleteOffset"
                             Storyboard.TargetProperty="Y"
                             BeginTime="0:0:0.12" To="0" Duration="0:0:0.20">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Key="MenuClose">
            <DoubleAnimation Storyboard.TargetName="MenuSurface"
                             Storyboard.TargetProperty="Height"
                             EnableDependentAnimation="True"
                             To="36" Duration="0:0:0.20">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="MenuSurface"
                             Storyboard.TargetProperty="Opacity"
                             BeginTime="0:0:0.08" To="0" Duration="0:0:0.12" />
            <DoubleAnimation Storyboard.TargetName="DotsRotation"
                             Storyboard.TargetProperty="Angle"
                             To="0" Duration="0:0:0.20" />
            <DoubleAnimation Storyboard.TargetName="EditItem"
                             Storyboard.TargetProperty="Opacity"
                             To="0" Duration="0:0:0.10" />
            <DoubleAnimation Storyboard.TargetName="EditOffset"
                             Storyboard.TargetProperty="Y"
                             To="-8" Duration="0:0:0.14" />
            <DoubleAnimation Storyboard.TargetName="DeleteItem"
                             Storyboard.TargetProperty="Opacity"
                             To="0" Duration="0:0:0.10" />
            <DoubleAnimation Storyboard.TargetName="DeleteOffset"
                             Storyboard.TargetProperty="Y"
                             To="-8" Duration="0:0:0.14" />
        </Storyboard>

    </UserControl.Resources>

    <Border x:Name="Shell"
            Background="{StaticResource CardBackgroundBrush}"
            BorderBrush="{StaticResource CardBorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="20"
            DoubleTapped="OnDoubleTapped"
            PointerExited="OnCardPointerExited">

        <Grid RowSpacing="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Identity row -->
            <Grid Grid.Row="0" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Width="56"
                        Height="56"
                        CornerRadius="28"
                        Background="{StaticResource CardAvatarBrush}"
                        BorderBrush="{StaticResource SearchBorderBrush}"
                        BorderThickness="1">
                    <TextBlock x:Name="AvatarText"
                               FontFamily="{StaticResource BalooFont}"
                               FontSize="15"
                               Foreground="{StaticResource FieldLabelBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="NameText"
                               FontFamily="{StaticResource BalooSemiBoldFont}"
                               FontSize="{StaticResource CardTitleFontSize}"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               LineStackingStrategy="BlockLineHeight"
                               LineHeight="22" />
                    <TextBlock x:Name="CaptionText"
                               Text="Record preview"
                               FontFamily="{StaticResource BalooFont}"
                               FontSize="{StaticResource FieldValueFontSize}"
                               Foreground="{StaticResource CardMetaBrush}"
                               Margin="0,2,0,0"
                               TextTrimming="CharacterEllipsis"
                               LineStackingStrategy="BlockLineHeight"
                               LineHeight="20" />
                </StackPanel>

                <!--
                    Replaces the "Preview" caption from the first design.

                    A drawer, not a floating menu: the surface is the three-dot button,
                    grown downward into a rounded vertical bar with the actions inside
                    it. Nothing detaches and nothing appears alongside - the control the
                    user pressed is the control that opens, which is why it reads as
                    being pulled out of the dots rather than popping up over them.

                    Icon-only. At this size a label would set the bar's width, and the
                    two actions are the two most recognisable icons there are.
                -->
                <Grid Grid.Column="2" Width="36" VerticalAlignment="Top">

                    <Border x:Name="MenuSurface"
                            Width="36"
                            Height="36"
                            CornerRadius="18"
                            VerticalAlignment="Top"
                            Opacity="0"
                            Background="{StaticResource CardBackgroundBrush}"
                            BorderBrush="{StaticResource SearchBorderBrush}"
                            BorderThickness="1" />

                    <StackPanel VerticalAlignment="Top">

                        <Button x:Name="MenuButton"
                                Width="36"
                                Height="36"
                                Style="{StaticResource BareButtonStyle}"
                                ToolTipService.ToolTip="More actions"
                                Click="OnMenuToggle">
                            <Grid Background="Transparent">
                                <StackPanel x:Name="Dots"
                                            Orientation="Horizontal"
                                            Spacing="3"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            RenderTransformOrigin="0.5,0.5">
                                    <StackPanel.RenderTransform>
                                        <RotateTransform x:Name="DotsRotation" Angle="0" />
                                    </StackPanel.RenderTransform>
                                    <Ellipse Width="3.5" Height="3.5" Fill="{StaticResource CardMetaBrush}" />
                                    <Ellipse Width="3.5" Height="3.5" Fill="{StaticResource CardMetaBrush}" />
                                    <Ellipse Width="3.5" Height="3.5" Fill="{StaticResource CardMetaBrush}" />
                                </StackPanel>
                            </Grid>
                        </Button>

                        <Button x:Name="EditItem"
                                Width="36"
                                Height="34"
                                Opacity="0"
                                IsHitTestVisible="False"
                                Style="{StaticResource BareButtonStyle}"
                                ToolTipService.ToolTip="Edit"
                                Click="OnEditClick">
                            <Button.RenderTransform>
                                <TranslateTransform x:Name="EditOffset" Y="-8" />
                            </Button.RenderTransform>
                            <Grid Background="Transparent">
                                <Viewbox Width="17" Height="17"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center">
                                    <Canvas Width="20" Height="20">
                                        <Path Data="M13.2 3.3L16.7 6.8 M14.6 1.9C15.2 1.3 16.2 1.3 16.8 1.9L18.1 3.2C18.7 3.8 18.7 4.8 18.1 5.4L5.6 17.9L1.5 18.5L2.1 14.4Z"
                                              Stroke="{StaticResource TextPrimaryBrush}"
                                              StrokeThickness="1.5"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round" />
                                    </Canvas>
                                </Viewbox>
                            </Grid>
                        </Button>

                        <Button x:Name="DeleteItem"
                                Width="36"
                                Height="34"
                                Opacity="0"
                                IsHitTestVisible="False"
                                Style="{StaticResource BareButtonStyle}"
                                ToolTipService.ToolTip="Delete"
                                Click="OnDeleteClick">
                            <Button.RenderTransform>
                                <TranslateTransform x:Name="DeleteOffset" Y="-8" />
                            </Button.RenderTransform>
                            <Grid Background="Transparent">
                                <Viewbox Width="17" Height="17"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center">
                                    <Canvas Width="20" Height="20">
                                        <Path Data="M2.8 5.2H17.2 M7.5 5.2V3.4C7.5 2.6 8.1 2 8.9 2H11.1C11.9 2 12.5 2.6 12.5 3.4V5.2 M15.3 5.2V16.6C15.3 17.4 14.7 18 13.9 18H6.1C5.3 18 4.7 17.4 4.7 16.6V5.2 M8.2 9V14.2 M11.8 9V14.2"
                                              Stroke="{StaticResource DangerBrush}"
                                              StrokeThickness="1.5"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round" />
                                    </Canvas>
                                </Viewbox>
                            </Grid>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Nine of the eighteen columns, in the design's three by three. -->
            <Grid Grid.Row="1" RowSpacing="18" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0">
                    <TextBlock Text="#" Style="{StaticResource FieldLabelStyle}" />
                    <TextBlock x:Name="IdValue" Style="{StaticResource FieldValueStyle}" />
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="1">
                    <TextBlock Text="FIRST NAME" Style="{StaticResource FieldLabelStyle}" />
                    <TextBlock x:Name="FirstNameValue" Style="{StaticResource FieldValueStyle}" />
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="2">
                    <TextBlock Text="LAST NAME" Style="{StaticResource FieldLabelStyle}" />
                    <TextBlock x:Name="LastNameValue" Style="{StaticResource FieldValueStyle}" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0">
                    <TextBlock Text="GENDER" Style="{StaticResource FieldLabelStyle}" />
                    <TextBlock x:Name="GenderValue" Style="{StaticResource FieldValueStyle}" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1">
                    <TextBlock Text="DATE OF BIRTH" Style="{StaticResource FieldLabelStyle}" />
                    <TextBlock x:Name="DobValue" Style="{StaticResource FieldValueStyle}" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2">
                    <TextBlock Text="COUNTRY" Style="{StaticResource FieldLabelStyle}" />
                    <TextBlock x:Name="CountryValue" Style="{StaticResource FieldValueStyle}" />
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="0">
                    <TextBlock Text="EMAIL" Style="{StaticResource FieldLabelStyle}" />
                    <TextBlock x:Name="EmailValue" Style="{StaticResource FieldValueStyle}" />
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="1">
                    <TextBlock Text="CREATED AT" Style="{StaticResource FieldLabelStyle}" />
                    <TextBlock x:Name="CreatedValue" Style="{StaticResource FieldValueStyle}" />
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="2">
                    <TextBlock Text="NOTE" Style="{StaticResource FieldLabelStyle}" />
                    <TextBlock x:Name="NoteValue" Style="{StaticResource FieldValueStyle}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
