<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DoNet.Controls.PersonCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        A directory card.

        Its own control rather than a DataTemplate because of the menu: named elements
        inside a DataTemplate cannot be reached from code, and the menu needs to be
        animated. As a control it gets a code-behind and ordinary x:Name access.

        No copy buttons on the field cells - they were cut after the design was drawn.
    -->

    <UserControl.Resources>

        <Style x:Key="MenuItemStyle" TargetType="Button" BasedOn="{StaticResource BareButtonStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource BalooFont}" />
            <Setter Property="FontSize" Value="{StaticResource FieldLabelFontSize}" />
            <Setter Property="Foreground" Value="{StaticResource FieldLabelBrush}" />
            <Setter Property="CharacterSpacing" Value="60" />
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
            <Setter Property="LineHeight" Value="14" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="FieldValueStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource BalooFont}" />
            <Setter Property="FontSize" Value="{StaticResource FieldValueFontSize}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
            <Setter Property="LineHeight" Value="20" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!--
            The menu's entrance. A flyout already fades itself in; this adds the scale
            and the small downward settle that makes it read as being drawn out of the
            button rather than appearing on top of it.
        -->
        <Storyboard x:Key="MenuIntro">
            <DoubleAnimation Storyboard.TargetName="MenuScale"
                             Storyboard.TargetProperty="ScaleX"
                             From="0.92" To="1" Duration="0:0:0.18">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="MenuScale"
                             Storyboard.TargetProperty="ScaleY"
                             From="0.80" To="1" Duration="0:0:0.20">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="MenuOffset"
                             Storyboard.TargetProperty="Y"
                             From="-10" To="0" Duration="0:0:0.20">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="MenuRoot"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.14" />
        </Storyboard>
    </UserControl.Resources>

    <Border x:Name="Shell"
            Background="{StaticResource CardBackgroundBrush}"
            BorderBrush="{StaticResource CardBorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="20"
            DoubleTapped="OnDoubleTapped">

        <Grid RowSpacing="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Identity row -->
            <Grid Grid.Row="0" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Width="56"
                        Height="56"
                        CornerRadius="28"
                        Background="{StaticResource CardAvatarBrush}"
                        BorderBrush="{StaticResource SearchBorderBrush}"
                        BorderThickness="1">
                    <TextBlock x:Name="AvatarText"
                               FontFamily="{StaticResource BalooFont}"
                               FontSize="18"
                               Foreground="{StaticResource FieldLabelBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="NameText"
                               FontFamily="{StaticResource BalooSemiBoldFont}"
                               FontSize="{StaticResource CardTitleFontSize}"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               LineStackingStrategy="BlockLineHeight"
                               LineHeight="22" />
                    <TextBlock x:Name="CaptionText"
                               Text="Record preview"
                               FontFamily="{StaticResource BalooFont}"
                               FontSize="{StaticResource FieldValueFontSize}"
                               Foreground="{StaticResource CardMetaBrush}"
                               Margin="0,2,0,0"
                               TextTrimming="CharacterEllipsis"
                               LineStackingStrategy="BlockLineHeight"
                               LineHeight="20" />
                </StackPanel>

                <!--
                    Replaces the "Preview" caption from the first design. A flyout is
                    used rather than a hand-placed overlay so dismissing on click-away
                    and on Escape, and staying inside the window, all come for free.
                -->
                <Button x:Name="MenuButton"
                        Grid.Column="2"
                        Width="32"
                        Height="32"
                        VerticalAlignment="Center"
                        Style="{StaticResource BareButtonStyle}"
                        ToolTipService.ToolTip="More actions">
                    <Border Background="Transparent" CornerRadius="8">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="3"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <Ellipse Width="3.5" Height="3.5" Fill="{StaticResource CardMetaBrush}" />
                            <Ellipse Width="3.5" Height="3.5" Fill="{StaticResource CardMetaBrush}" />
                            <Ellipse Width="3.5" Height="3.5" Fill="{StaticResource CardMetaBrush}" />
                        </StackPanel>
                    </Border>

                    <Button.Flyout>
                        <Flyout x:Name="MenuFlyout"
                                Placement="BottomEdgeAlignedRight"
                                FlyoutPresenterStyle="{StaticResource BareFlyoutPresenterStyle}"
                                Opened="OnMenuOpened">
                            <Border x:Name="MenuRoot"
                                    CornerRadius="12"
                                    Padding="6"
                                    MinWidth="168"
                                    Background="{StaticResource CardBackgroundBrush}"
                                    BorderBrush="{StaticResource SearchBorderBrush}"
                                    BorderThickness="1"
                                    RenderTransformOrigin="1,0">
                                <Border.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform x:Name="MenuScale" ScaleX="1" ScaleY="1" />
                                        <TranslateTransform x:Name="MenuOffset" Y="0" />
                                    </TransformGroup>
                                </Border.RenderTransform>

                                <StackPanel Spacing="2">
                                    <Button Style="{StaticResource MenuItemStyle}" Click="OnEditClick">
                                        <Border Background="Transparent"
                                                CornerRadius="8"
                                                Padding="10,8,12,8">
                                            <StackPanel Orientation="Horizontal" Spacing="11">
                                                <Viewbox Width="17" Height="17" VerticalAlignment="Center">
                                                    <Canvas Width="20" Height="20">
                                                        <Path Data="M13.2 3.3L16.7 6.8 M14.6 1.9C15.2 1.3 16.2 1.3 16.8 1.9L18.1 3.2C18.7 3.8 18.7 4.8 18.1 5.4L5.6 17.9L1.5 18.5L2.1 14.4Z"
                                                              Stroke="{StaticResource TextPrimaryBrush}"
                                                              StrokeThickness="1.5"
                                                              StrokeStartLineCap="Round"
                                                              StrokeEndLineCap="Round"
                                                              StrokeLineJoin="Round" />
                                                    </Canvas>
                                                </Viewbox>
                                                <TextBlock Text="Edit"
                                                           VerticalAlignment="Center"
                                                           FontFamily="{StaticResource BalooFont}"
                                                           FontSize="{StaticResource FieldValueFontSize}"
                                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                            </StackPanel>
                                        </Border>
                                    </Button>

                                    <Button Style="{StaticResource MenuItemStyle}" Click="OnDeleteClick">
                                        <Border Background="Transparent"
                                                CornerRadius="8"
                                                Padding="10,8,12,8">
                                            <StackPanel Orientation="Horizontal" Spacing="11">
                                                <Viewbox Width="17" Height="17" VerticalAlignment="Center">
                                                    <Canvas Width="20" Height="20">
                                                        <Path Data="M2.8 5.2H17.2 M7.5 5.2V3.4C7.5 2.6 8.1 2 8.9 2H11.1C11.9 2 12.5 2.6 12.5 3.4V5.2 M15.3 5.2V16.6C15.3 17.4 14.7 18 13.9 18H6.1C5.3 18 4.7 17.4 4.7 16.6V5.2 M8.2 9V14.2 M11.8 9V14.2"
                                                              Stroke="{StaticResource DangerBrush}"
                                                              StrokeThickness="1.5"
                                                              StrokeStartLineCap="Round"
                                                              StrokeEndLineCap="Round"
                                                              StrokeLineJoin="Round" />
                                                    </Canvas>
                                                </Viewbox>
                                                <TextBlock Text="Delete"
                                                           VerticalAlignment="Center"
                                                           FontFamily="{StaticResource BalooFont}"
                                                           FontSize="{StaticResource FieldValueFontSize}"
                                                           Foreground="{StaticResource DangerBrush}" />
                                            </StackPanel>
                                        </Border>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </Grid>

            <!-- Nine of the eighteen columns, in the design's three by three. -->
            <Grid Grid.Row="1" RowSpacing="18" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0">
                    <TextBlock Text="#" Style="{StaticResource FieldLabelStyle}" />
                    <TextBlock x:Name="IdValue" Style="{StaticResource FieldValueStyle}" />
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="1">
                    <TextBlock Text="FIRST NAME" Style="{StaticResource FieldLabelStyle}" />
                    <TextBlock x:Name="FirstNameValue" Style="{StaticResource FieldValueStyle}" />
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="2">
                    <TextBlock Text="LAST NAME" Style="{StaticResource FieldLabelStyle}" />
                    <TextBlock x:Name="LastNameValue" Style="{StaticResource FieldValueStyle}" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0">
                    <TextBlock Text="GENDER" Style="{StaticResource FieldLabelStyle}" />
                    <TextBlock x:Name="GenderValue" Style="{StaticResource FieldValueStyle}" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1">
                    <TextBlock Text="DATE OF BIRTH" Style="{StaticResource FieldLabelStyle}" />
                    <TextBlock x:Name="DobValue" Style="{StaticResource FieldValueStyle}" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2">
                    <TextBlock Text="COUNTRY" Style="{StaticResource FieldLabelStyle}" />
                    <TextBlock x:Name="CountryValue" Style="{StaticResource FieldValueStyle}" />
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="0">
                    <TextBlock Text="EMAIL" Style="{StaticResource FieldLabelStyle}" />
                    <TextBlock x:Name="EmailValue" Style="{StaticResource FieldValueStyle}" />
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="1">
                    <TextBlock Text="CREATED AT" Style="{StaticResource FieldLabelStyle}" />
                    <TextBlock x:Name="CreatedValue" Style="{StaticResource FieldValueStyle}" />
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="2">
                    <TextBlock Text="NOTE" Style="{StaticResource FieldLabelStyle}" />
                    <TextBlock x:Name="NoteValue" Style="{StaticResource FieldValueStyle}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
