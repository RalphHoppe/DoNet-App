<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DoNet.Controls.PersonCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DoNet.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        A directory card.

        Its own control rather than a DataTemplate because of the menu: named elements
        inside a DataTemplate cannot be reached from code, and the menu needs to be
        animated. As a control it gets a code-behind and ordinary x:Name access.

        No copy buttons on the field cells - they were cut after the design was drawn.
    -->

    <UserControl.Resources>

        <Style x:Key="MenuItemStyle" TargetType="Button" BasedOn="{StaticResource BareButtonStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>


        <Style x:Key="FieldValueStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource BalooFont}" />
            <Setter Property="FontSize" Value="{StaticResource FieldValueFontSize}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
            <Setter Property="LineHeight" Value="20" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!--
            The actions arriving under the pointer. Opacity and a translate are both
            independent animations, so they run on the compositor thread and stay
            smooth while the directory is scrolling behind them. Nothing here touches
            a layout property, which is why there is no EnableDependentAnimation -
            unlike the drawer this replaces, which had to animate Height.

            Out is quicker than in. Arriving wants to feel unhurried; leaving wants to
            be gone by the time the pointer reaches the next card.
        -->
        <Storyboard x:Key="ActionsShow">
            <DoubleAnimation Storyboard.TargetName="ActionLayer"
                             Storyboard.TargetProperty="Opacity"
                             To="1" Duration="0:0:0.18" />
            <DoubleAnimation Storyboard.TargetName="ActionShift"
                             Storyboard.TargetProperty="X"
                             To="0" Duration="0:0:0.22">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Key="ActionsHide">
            <DoubleAnimation Storyboard.TargetName="ActionLayer"
                             Storyboard.TargetProperty="Opacity"
                             To="0" Duration="0:0:0.14" />
            <DoubleAnimation Storyboard.TargetName="ActionShift"
                             Storyboard.TargetProperty="X"
                             To="14" Duration="0:0:0.16">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

    </UserControl.Resources>

    <Border x:Name="Shell"
            Background="{StaticResource CardBackgroundBrush}"
            BorderBrush="{StaticResource CardBorderBrush}"
            BorderThickness="1"
            CornerRadius="26"
            Padding="20"
            DoubleTapped="OnDoubleTapped"
            PointerEntered="OnCardPointerEntered"
            PointerExited="OnCardPointerExited">

        <Grid RowSpacing="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Identity row: the avatar's initial, the name, and the caption. -->
            <Grid Grid.Row="0" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Width="56"
                        Height="56"
                        CornerRadius="28"
                        Background="{StaticResource CardAvatarBrush}"
                        BorderBrush="{StaticResource SearchBorderBrush}"
                        BorderThickness="1">
                    <TextBlock x:Name="AvatarText"
                               FontFamily="{StaticResource BalooSemiBoldFont}"
                               FontSize="20"
                               Foreground="{StaticResource BrandPrimaryBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="NameText"
                               FontFamily="{StaticResource BalooSemiBoldFont}"
                               FontSize="{StaticResource CardTitleFontSize}"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               LineStackingStrategy="BlockLineHeight"
                               LineHeight="22" />
                    <TextBlock x:Name="CaptionText"
                               Text="Record preview"
                               FontFamily="{StaticResource BalooFont}"
                               FontSize="{StaticResource FieldValueFontSize}"
                               Foreground="{StaticResource CardMetaBrush}"
                               Margin="0,2,0,0"
                               TextTrimming="CharacterEllipsis"
                               LineStackingStrategy="BlockLineHeight"
                               LineHeight="20" />
                </StackPanel>

            </Grid>

            <!-- Nine of the eighteen columns, in the design's three by three. -->
            <Grid Grid.Row="1" RowSpacing="18" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0">
                    <controls:FieldLabel Text="#" IconKind="Hash" />
                    <TextBlock x:Name="IdValue" Style="{StaticResource FieldValueStyle}" />
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="1">
                    <controls:FieldLabel Text="FIRST NAME" IconKind="User" />
                    <TextBlock x:Name="FirstNameValue" Style="{StaticResource FieldValueStyle}" />
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="2">
                    <controls:FieldLabel Text="LAST NAME" IconKind="User" />
                    <TextBlock x:Name="LastNameValue" Style="{StaticResource FieldValueStyle}" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0">
                    <controls:FieldLabel Text="GENDER" IconKind="Users" />
                    <TextBlock x:Name="GenderValue" Style="{StaticResource FieldValueStyle}" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1">
                    <controls:FieldLabel Text="DATE OF BIRTH" IconKind="Calendar" />
                    <TextBlock x:Name="DobValue" Style="{StaticResource FieldValueStyle}" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2">
                    <controls:FieldLabel Text="COUNTRY" IconKind="GlobeMeridian" />
                    <TextBlock x:Name="CountryValue" Style="{StaticResource FieldValueStyle}" />
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="0">
                    <controls:FieldLabel Text="EMAIL" IconKind="Mail" />
                    <TextBlock x:Name="EmailValue" Style="{StaticResource FieldValueStyle}" />
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="1">
                    <controls:FieldLabel Text="CREATED AT" IconKind="Clock" />
                    <TextBlock x:Name="CreatedValue" Style="{StaticResource FieldValueStyle}" />
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="2">
                    <controls:FieldLabel Text="NOTE" IconKind="Info" />
                    <TextBlock x:Name="NoteValue" Style="{StaticResource FieldValueStyle}" />
                </StackPanel>
            </Grid>
        
            <!--
                Edit and delete, while the pointer is over the card.

                They share the grid's cell instead of taking a column, so the fields
                keep the card's full width when the actions are not there - a column
                reserved for them would indent every record permanently for the sake
                of something visible a fraction of the time.

                They also appear when one of them takes keyboard focus. A hover-only
                affordance is a mouse-only affordance, and these are the only route to
                edit and delete.
            -->
            <StackPanel x:Name="ActionLayer"
                        Grid.Row="0"
                        Grid.RowSpan="2"
                        Spacing="12"
                        Opacity="0"
                        IsHitTestVisible="False"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                <StackPanel.RenderTransform>
                    <TranslateTransform x:Name="ActionShift" X="14" />
                </StackPanel.RenderTransform>

                <Button x:Name="EditAction"
                        Width="40"
                        Height="40"
                        Style="{StaticResource BareButtonStyle}"
                        ToolTipService.ToolTip="Edit"
                        GotFocus="OnActionGotFocus"
                        LostFocus="OnActionLostFocus"
                        PointerEntered="OnActionPointerEntered"
                        PointerExited="OnActionPointerExited"
                        Click="OnEditClick">
                    <Border Width="40"
                            Height="40"
                            CornerRadius="20"
                            Background="{StaticResource BrandPrimaryBrush}">
                        <controls:LineIcon Kind="EditSquare"
                                           Width="18"
                                           Height="18"
                                           Foreground="White" />
                    </Border>
                </Button>

                <Button x:Name="DeleteAction"
                        Width="40"
                        Height="40"
                        Style="{StaticResource BareButtonStyle}"
                        ToolTipService.ToolTip="Delete"
                        GotFocus="OnActionGotFocus"
                        LostFocus="OnActionLostFocus"
                        PointerEntered="OnActionPointerEntered"
                        PointerExited="OnActionPointerExited"
                        Click="OnDeleteClick">
                    <Border Width="40"
                            Height="40"
                            CornerRadius="20"
                            Background="{StaticResource DangerBrush}">
                        <controls:LineIcon Kind="Trash"
                                           Width="18"
                                           Height="18"
                                           Foreground="White" />
                    </Border>
                </Button>
            </StackPanel>

        </Grid>
    </Border>
</UserControl>
