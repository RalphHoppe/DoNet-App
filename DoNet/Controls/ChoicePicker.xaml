<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DoNet.Controls.ChoicePicker"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DoNet.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    IsTabStop="True"
    UseSystemFocusVisuals="False"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Center">

    <!--
        The app's own dropdown.

        The stock ComboBox was replaced rather than restyled. Its list is a system
        surface: grey rather than the app's white, 8px corners against the app's 16
        and 26, system type instead of Baloo, and the system accent for selection.
        Those come from the popup's own theme resources and from a template that
        cannot be reached from the field it belongs to, and overriding the dozen or so
        keys involved is both more code and more guesswork than owning the list.

        What is here instead: a white surface at 20, rows that hover as 13px pills in
        the app's teal, a filter box for the long lists, and a leading visual per row -
        a flag for countries, the field's own icon everywhere else.
    -->

    <!--
        No ColumnSpacing. A Grid spaces around a collapsed column just as it does
        around a visible one, and both the flag and the tick are collapsed most of
        the time, so the gaps live on the items that need them.
    -->
    <Grid x:Name="Presenter"
          Background="Transparent"
          Tapped="OnPresenterTapped">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!--
            The selected country's flag, shown in the closed field as well as the open
            list. Collapsed for every other kind of list, where the field already has
            its own icon beside the label and a second copy would only repeat it.
        -->
        <controls:FlagIcon x:Name="PresenterFlag"
                           Grid.Column="0"
                           Margin="0,0,9,0"
                           VerticalAlignment="Center"
                           Visibility="Collapsed" />

        <TextBlock x:Name="ValueLabel"
                   Grid.Column="1"
                   VerticalAlignment="Center"
                   FontFamily="{StaticResource BalooFont}"
                   FontSize="{StaticResource FieldValueFontSize}"
                   Foreground="{StaticResource TextPrimaryBrush}"
                   TextTrimming="CharacterEllipsis"
                   LineStackingStrategy="BlockLineHeight"
                   LineHeight="22" />

        <controls:LineIcon x:Name="Chevron"
                           Grid.Column="2"
                           Kind="ChevronDown"
                           Width="15"
                           Height="15"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource FieldLabelBrush}"
                           RenderTransformOrigin="0.5,0.5">
            <controls:LineIcon.RenderTransform>
                <RotateTransform x:Name="ChevronSpin" />
            </controls:LineIcon.RenderTransform>
        </controls:LineIcon>

        <FlyoutBase.AttachedFlyout>
            <Flyout x:Name="Drawer"
                    Placement="BottomEdgeAlignedLeft"
                    Opening="OnDrawerOpening"
                    Opened="OnDrawerOpened"
                    Closed="OnDrawerClosed">

                <Flyout.FlyoutPresenterStyle>
                    <Style TargetType="FlyoutPresenter">
                        <!--
                            The field's own white, not a softer surface grey: a drawer
                            that drops out of a white field and arrives grey reads as
                            a system surface that was tinted, not a surface that
                            belongs to the field.
                        -->
                        <Setter Property="Background" Value="{StaticResource FieldBackgroundBrush}" />
                        <Setter Property="BorderBrush" Value="{StaticResource SearchBorderBrush}" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="CornerRadius" Value="20" />
                        <Setter Property="Padding" Value="0" />

                        <!--
                            The stock presenter reserves 96px of width and caps at 456.
                            This one is sized by its content, which is sized to the
                            field, so both have to come off.
                        -->
                        <Setter Property="MinWidth" Value="0" />
                        <Setter Property="MaxWidth" Value="1200" />
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Disabled" />
                        <Setter Property="ScrollViewer.VerticalScrollMode" Value="Disabled" />
                        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
                    </Style>
                </Flyout.FlyoutPresenterStyle>

                <Grid x:Name="DrawerBody" RowSpacing="0">
                    <Grid.Resources>
                        <!--
                            Scoped to the drawer, so nothing else in the app inherits a
                            teal list. These are the keys the stock container reads for
                            its own states; the alternative is a full ListViewItem
                            template, which is forty more lines to say the same thing.
                        -->
                        <SolidColorBrush x:Key="ListViewItemBackground" Color="Transparent" />
                        <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#F0F7F5" />
                        <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="#E4F0EC" />
                        <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#E4F0EC" />
                        <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#DBEBE6" />
                        <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#D2E6E0" />
                        <SolidColorBrush x:Key="ListViewItemForeground" Color="#2B2F33" />
                        <SolidColorBrush x:Key="ListViewItemForegroundPointerOver" Color="#2B2F33" />
                        <SolidColorBrush x:Key="ListViewItemForegroundSelected" Color="#2B2F33" />
                        <SolidColorBrush x:Key="ListViewItemFocusVisualPrimaryBrush" Color="Transparent" />
                        <SolidColorBrush x:Key="ListViewItemFocusVisualSecondaryBrush" Color="Transparent" />
                        <SolidColorBrush x:Key="ListViewItemFocusBorderBrush" Color="Transparent" />
                        <SolidColorBrush x:Key="ListViewItemFocusSecondaryBorderBrush" Color="Transparent" />

                        <!-- The left accent bar WinUI draws beside a selected row. -->
                        <x:Boolean x:Key="ListViewItemSelectionIndicatorVisualEnabled">False</x:Boolean>

                        <!--
                            The row's rounded corners. The stock ListViewItem template
                            draws its hover and selection fills inside a
                            ListViewItemPresenter, whose CornerRadius is bound to this
                            theme resource - not to the row's own CornerRadius
                            property, which the template never reads. Setting the
                            property rounds nothing; overriding the resource the
                            presenter actually consults is the one way in.
                        -->
                        <CornerRadius x:Key="ListViewItemCornerRadius">13</CornerRadius>

                        <Style x:Key="DrawerRowStyle" TargetType="ListViewItem">
                            <Setter Property="MinHeight" Value="42" />
                            <Setter Property="Height" Value="42" />
                            <Setter Property="Padding" Value="12,0" />
                            <Setter Property="Margin" Value="8,1" />

                            <!-- Control defaults this to Center, which would centre
                                 every row's content instead of filling the row. -->
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Setter Property="UseSystemFocusVisuals" Value="False" />
                        </Style>
                    </Grid.Resources>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--
                        Shown only for the long lists. Five genders do not need
                        searching; a hundred and ninety-six countries do.
                    -->
                    <Border x:Name="FilterShell"
                            Grid.Row="0"
                            Height="40"
                            Margin="12,12,12,4"
                            CornerRadius="16"
                            Padding="12,0"
                            Background="{StaticResource CardAvatarBrush}"
                            BorderBrush="{StaticResource SearchBorderBrush}"
                            BorderThickness="1"
                            Visibility="Collapsed">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <controls:LineIcon Grid.Column="0"
                                               Kind="Search"
                                               Width="16"
                                               Height="16"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource SearchPlaceholderBrush}" />

                            <TextBox x:Name="FilterBox"
                                     Grid.Column="1"
                                     Style="{StaticResource BareTextBoxStyle}"
                                     VerticalAlignment="Center"
                                     PlaceholderForeground="{StaticResource SearchPlaceholderBrush}"
                                     TextChanged="OnFilterChanged"
                                     KeyDown="OnFilterKeyDown" />
                        </Grid>
                    </Border>

                    <ListView x:Name="Rows"
                              Grid.Row="1"
                              Padding="0,6"
                              SelectionMode="Single"
                              IsItemClickEnabled="False"
                              Background="Transparent"
                              BorderThickness="0"
                              ItemContainerStyle="{StaticResource DrawerRowStyle}"
                              ScrollViewer.HorizontalScrollMode="Disabled"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              SelectionChanged="OnRowChosen">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="controls:ChoiceOption">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <controls:FlagIcon
                                        Grid.Column="0"
                                        Margin="0,0,11,0"
                                        VerticalAlignment="Center"
                                        Country="{x:Bind Country}"
                                        Visibility="{x:Bind HasFlag}" />

                                    <controls:LineIcon
                                        Grid.Column="0"
                                        Width="17"
                                        Height="17"
                                        Margin="0,0,11,0"
                                        VerticalAlignment="Center"
                                        Kind="{x:Bind IconKind}"
                                        Foreground="{StaticResource BrandPrimaryBrush}"
                                        Visibility="{x:Bind HasIcon}" />

                                    <TextBlock Grid.Column="1"
                                               VerticalAlignment="Center"
                                               Text="{x:Bind Label}"
                                               FontFamily="{StaticResource BalooFont}"
                                               FontSize="{StaticResource FieldValueFontSize}"
                                               TextTrimming="CharacterEllipsis"
                                               LineStackingStrategy="BlockLineHeight"
                                               LineHeight="22" />

                                    <controls:LineIcon
                                        Grid.Column="2"
                                        Width="16"
                                        Height="16"
                                        Margin="10,0,0,0"
                                        Kind="Check"
                                        VerticalAlignment="Center"
                                        Foreground="{StaticResource BrandPrimaryBrush}"
                                        Visibility="{x:Bind IsChosen, Mode=OneWay}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Shown when a filter matches nothing at all. -->
                    <TextBlock x:Name="NoMatches"
                               Grid.Row="2"
                               Margin="20,8,20,18"
                               Visibility="Collapsed"
                               FontFamily="{StaticResource BalooFont}"
                               FontSize="{StaticResource FieldValueFontSize}"
                               Foreground="{StaticResource SearchPlaceholderBrush}"
                               LineStackingStrategy="BlockLineHeight"
                               LineHeight="22" />

                    <!--
                        The way out of a picker that does not have the thing you need.
                        Set AddLabel and this appears under the list: the account form
                        puts "Add a website" here, so a record that needs a site the
                        picker cannot offer is one tap away from the form that creates
                        it, rather than a cancelled dialog and a detour through the
                        Websites tab.
                    -->
                    <Button x:Name="AddRow"
                            Grid.Row="3"
                            Margin="12,4,12,12"
                            Padding="0"
                            HorizontalAlignment="Stretch"
                            Style="{StaticResource BareButtonStyle}"
                            Click="OnAddRowClick">
                        <Border Height="42"
                                CornerRadius="13"
                                Background="{StaticResource FieldBackgroundBrush}"
                                BorderBrush="{StaticResource AddActionBorderBrush}"
                                BorderThickness="1">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="9"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <controls:LineIcon Kind="Plus"
                                                   Width="15"
                                                   Height="15"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource BrandPrimaryBrush}" />

                                <TextBlock x:Name="AddRowLabel"
                                           VerticalAlignment="Center"
                                           FontFamily="{StaticResource BalooFont}"
                                           FontSize="{StaticResource FieldValueFontSize}"
                                           Foreground="{StaticResource BrandPrimaryBrush}"
                                           LineStackingStrategy="BlockLineHeight"
                                           LineHeight="22" />
                            </StackPanel>
                        </Border>
                    </Button>
                </Grid>
            </Flyout>
        </FlyoutBase.AttachedFlyout>
    </Grid>
</UserControl>
