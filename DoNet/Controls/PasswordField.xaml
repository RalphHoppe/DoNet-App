<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DoNet.Controls.PasswordField"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border x:Name="FieldBorder"
            Height="38"
            CornerRadius="8"
            BorderThickness="1"
            BorderBrush="{StaticResource FieldBorderBrush}"
            Background="{StaticResource FieldBackgroundBrush}">

        <!--
            Border colour is driven through the visual state manager rather than by
            assigning brushes from code, so the palette stays entirely in XAML.
            GoToState is called on the UserControl and finds these groups because the
            Border is the control's first child.
        -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="FieldStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                    <VisualState.Setters>
                        <Setter Target="FieldBorder.BorderBrush" Value="{StaticResource FieldBorderHoverBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Focused">
                    <VisualState.Setters>
                        <Setter Target="FieldBorder.BorderBrush" Value="{StaticResource FieldBorderFocusedBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Error">
                    <VisualState.Setters>
                        <Setter Target="FieldBorder.BorderBrush" Value="{StaticResource FieldBorderErrorBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Border.Resources>
            <!--
                The stock PasswordBox brings its own box: a background, a 1px border, a 2px
                accent underline on focus and a reveal button. The design wants none of
                that - the rounded Border above *is* the field.

                These have to be resource overrides rather than Setters on the PasswordBox,
                because the default template re-applies its own brushes from the visual
                states on hover and focus, which would beat any local value.
            -->
            <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
            <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="Transparent" />

            <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
            <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="Transparent" />

            <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
            <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
            <Thickness x:Key="TextControlThemePadding">0</Thickness>
            <x:Double x:Key="TextControlThemeMinHeight">0</x:Double>
            <x:Double x:Key="TextControlThemeMinWidth">0</x:Double>

            <SolidColorBrush x:Key="TextControlForeground" Color="#2B2F33" />
            <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#2B2F33" />
            <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#2B2F33" />

            <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#8C9196" />
            <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#8C9196" />
            <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#8C9196" />

            <!--
                The reveal toggle. Square, quiet, and only as wide as its hit target needs
                to be - the design shows no chrome around it until the pointer arrives.
            -->
            <Style x:Key="RevealToggleStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Width" Value="28" />
                <Setter Property="Height" Value="28" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="Root"
                                  Background="Transparent"
                                  CornerRadius="{TemplateBinding CornerRadius}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background"
                                                        Value="{StaticResource FieldIconHoverBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background"
                                                        Value="{StaticResource FieldIconPressedBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled" />
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>

                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  AutomationProperties.AccessibilityView="Raw" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Border.Resources>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--
                Outline padlock drawn on a 16x16 grid, as a Path rather than a Segoe Fluent
                glyph so its weight matches the hairline in the design and it cannot fall
                back to a missing-glyph box.

                The Canvas is what fixes the icon's box. A Path with Stretch="None" reports
                only its ink size but still renders at the geometry's own coordinates, so
                on its own it would sit a couple of pixels down and to the right of its
                layout slot. Inside a fixed 16x16 Canvas the coordinates line up exactly.
            -->
            <Canvas Grid.Column="0"
                    Width="16"
                    Height="16"
                    Margin="13,0,0,0"
                    VerticalAlignment="Center">
                <Path Stretch="None"
                      Stroke="{StaticResource FieldIconBrush}"
                      StrokeThickness="1.3"
                      StrokeLineJoin="Round"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      Data="M4.4,7.2 H11.6 A1.8,1.8 0 0 1 13.4,9 V12.4 A1.8,1.8 0 0 1 11.6,14.2 H4.4 A1.8,1.8 0 0 1 2.6,12.4 V9 A1.8,1.8 0 0 1 4.4,7.2 Z M5.3,7.2 V5.2 A2.7,2.7 0 0 1 10.7,5.2 V7.2" />
            </Canvas>

            <PasswordBox x:Name="Input"
                         Grid.Column="1"
                         Margin="13,0,12,0"
                         VerticalAlignment="Center"
                         VerticalContentAlignment="Center"
                         BorderThickness="0"
                         Background="Transparent"
                         Padding="0"
                         MinHeight="0"
                         FontFamily="{StaticResource BalooFont}"
                         FontSize="{StaticResource FieldFontSize}"
                         PasswordRevealMode="Hidden"
                         PasswordChanged="OnInputPasswordChanged"
                         GotFocus="OnFocusChanged"
                         LostFocus="OnFocusChanged"
                         KeyDown="OnInputKeyDown" />

            <!--
                Shown only when ShowRevealButton is set, so the create-password screen keeps
                the plain two-element field from its design while the lock screen gets the
                eye. Collapsed by default; the code-behind also widens the PasswordBox's
                right margin back out when there is no button to make room for.
            -->
            <Button x:Name="RevealToggle"
                    Grid.Column="2"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    Visibility="Collapsed"
                    Style="{StaticResource RevealToggleStyle}"
                    Click="OnRevealToggleClick"
                    GotFocus="OnFocusChanged"
                    LostFocus="OnFocusChanged">
                <Canvas Width="16" Height="16">
                    <Path Stretch="None"
                          Stroke="{StaticResource FieldIconBrush}"
                          StrokeThickness="1.3"
                          StrokeLineJoin="Round"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Data="M8,3.4 C11.2,3.4 13.9,5.3 15.1,8 C13.9,10.7 11.2,12.6 8,12.6 C4.8,12.6 2.1,10.7 0.9,8 C2.1,5.3 4.8,3.4 8,3.4 Z" />
                    <Path Stretch="None"
                          Stroke="{StaticResource FieldIconBrush}"
                          StrokeThickness="1.3"
                          Data="M10.05,8 A2.05,2.05 0 1 1 5.95,8 A2.05,2.05 0 1 1 10.05,8 Z" />
                    <Path x:Name="RevealSlash"
                          Stretch="None"
                          Visibility="Collapsed"
                          Stroke="{StaticResource FieldIconBrush}"
                          StrokeThickness="1.3"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Data="M2.8,13.2 L13.2,2.8" />
                </Canvas>
            </Button>
        </Grid>
    </Border>
</UserControl>
