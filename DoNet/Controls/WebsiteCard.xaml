<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DoNet.Controls.WebsiteCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:DoNet.Controls"
    mc:Ignorable="d">

    <!--
        A directory card.

        Its own control rather than a DataTemplate because of the menu: named elements
        inside a DataTemplate cannot be reached from code, and the menu needs to be
        animated. As a control it gets a code-behind and ordinary x:Name access.

        No copy buttons on the field cells - they were cut after the design was drawn.
    -->

    <UserControl.Resources>

        <Style x:Key="MenuItemStyle" TargetType="Button" BasedOn="{StaticResource BareButtonStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>


        <Style x:Key="FieldValueStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource BalooFont}" />
            <Setter Property="FontSize" Value="{StaticResource FieldValueFontSize}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
            <Setter Property="LineHeight" Value="20" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!--
            The drawer opening. The bar grows out of the dots while the two icons fade
            up into it, staggered so they arrive as the space for them appears rather
            than being there waiting.

            EnableDependentAnimation is mandatory: Height cannot be animated on the
            composition thread, and without it the animation is silently dropped and
            the bar simply snaps open.
        -->
        <Storyboard x:Key="MenuOpen">
            <DoubleAnimation Storyboard.TargetName="MenuSurface"
                             Storyboard.TargetProperty="Height"
                             EnableDependentAnimation="True"
                             To="106" Duration="0:0:0.26">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="MenuSurface"
                             Storyboard.TargetProperty="Opacity"
                             To="1" Duration="0:0:0.14" />
            <DoubleAnimation Storyboard.TargetName="DotsRotation"
                             Storyboard.TargetProperty="Angle"
                             To="90" Duration="0:0:0.26">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <DoubleAnimation Storyboard.TargetName="EditItem"
                             Storyboard.TargetProperty="Opacity"
                             BeginTime="0:0:0.07" To="1" Duration="0:0:0.16" />
            <DoubleAnimation Storyboard.TargetName="EditOffset"
                             Storyboard.TargetProperty="Y"
                             BeginTime="0:0:0.07" To="0" Duration="0:0:0.20">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <DoubleAnimation Storyboard.TargetName="DeleteItem"
                             Storyboard.TargetProperty="Opacity"
                             BeginTime="0:0:0.12" To="1" Duration="0:0:0.16" />
            <DoubleAnimation Storyboard.TargetName="DeleteOffset"
                             Storyboard.TargetProperty="Y"
                             BeginTime="0:0:0.12" To="0" Duration="0:0:0.20">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Key="MenuClose">
            <DoubleAnimation Storyboard.TargetName="MenuSurface"
                             Storyboard.TargetProperty="Height"
                             EnableDependentAnimation="True"
                             To="36" Duration="0:0:0.20">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="MenuSurface"
                             Storyboard.TargetProperty="Opacity"
                             BeginTime="0:0:0.08" To="0" Duration="0:0:0.12" />
            <DoubleAnimation Storyboard.TargetName="DotsRotation"
                             Storyboard.TargetProperty="Angle"
                             To="0" Duration="0:0:0.20" />
            <DoubleAnimation Storyboard.TargetName="EditItem"
                             Storyboard.TargetProperty="Opacity"
                             To="0" Duration="0:0:0.10" />
            <DoubleAnimation Storyboard.TargetName="EditOffset"
                             Storyboard.TargetProperty="Y"
                             To="-8" Duration="0:0:0.14" />
            <DoubleAnimation Storyboard.TargetName="DeleteItem"
                             Storyboard.TargetProperty="Opacity"
                             To="0" Duration="0:0:0.10" />
            <DoubleAnimation Storyboard.TargetName="DeleteOffset"
                             Storyboard.TargetProperty="Y"
                             To="-8" Duration="0:0:0.14" />
        </Storyboard>

    </UserControl.Resources>

    <Border x:Name="Shell"
            Background="{StaticResource CardBackgroundBrush}"
            BorderBrush="{StaticResource CardBorderBrush}"
            BorderThickness="1"
            CornerRadius="26"
            Padding="20"
            DoubleTapped="OnDoubleTapped"
            PointerExited="OnCardPointerExited">

        <Grid RowSpacing="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--
                Identity row. Lifted above the field grid so the drawer, which opens
                downward out of its own bounds, draws over the fields instead of under
                them.
            -->
            <Grid Grid.Row="0" ColumnSpacing="16" Canvas.ZIndex="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Width="56"
                        Height="56"
                        CornerRadius="28"
                        Background="{StaticResource CardAvatarBrush}"
                        BorderBrush="{StaticResource SearchBorderBrush}"
                        BorderThickness="1">
                    <TextBlock x:Name="AvatarText"
                               FontFamily="{StaticResource BalooSemiBoldFont}"
                               FontSize="20"
                               Foreground="{StaticResource BrandPrimaryBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="NameText"
                               FontFamily="{StaticResource BalooSemiBoldFont}"
                               FontSize="{StaticResource CardTitleFontSize}"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               LineStackingStrategy="BlockLineHeight"
                               LineHeight="22" />
                    <TextBlock x:Name="CaptionText"
                               Text="Record preview"
                               FontFamily="{StaticResource BalooFont}"
                               FontSize="{StaticResource FieldValueFontSize}"
                               Foreground="{StaticResource CardMetaBrush}"
                               Margin="0,2,0,0"
                               TextTrimming="CharacterEllipsis"
                               LineStackingStrategy="BlockLineHeight"
                               LineHeight="20" />
                </StackPanel>

                <!--
                    Replaces the "Preview" caption from the first design.

                    A drawer, not a floating menu: the surface is the three-dot button,
                    grown downward into a rounded vertical bar with the actions inside
                    it. Nothing detaches and nothing appears alongside - the control the
                    user pressed is the control that opens, which is why it reads as
                    being pulled out of the dots rather than popping up over them.

                    Icon-only. At this size a label would set the bar's width, and the
                    two actions are the two most recognisable icons there are.
                -->
                <!--
                    A Canvas, fixed at the closed size and centred on the avatar, and
                    the choice of panel is the whole trick.

                    The host must stay 36x36 so the identity row stays as tall as the
                    avatar and the card does not resize as the drawer grows - the two
                    action buttons hold their layout space even at zero opacity, so a
                    self-sizing host made the row as tall as the fully open drawer.

                    A Grid of that size would clip the drawer, though. WinUI applies a
                    layout clip whenever a child is arranged smaller than it asked to
                    be, and a Grid arranges children inside its own 36px box - so the
                    surface animating to 106 was cut back to 36, and the buttons below
                    the dots vanished with it. A Canvas arranges each child at its own
                    desired size, so nothing is clipped and the drawer overflows
                    downward over the fields. The identity row carries Canvas.ZIndex so
                    it does so in front of them.
                -->
                <Canvas Grid.Column="2"
                        Width="36"
                        Height="36"
                        VerticalAlignment="Center">

                    <Border x:Name="MenuSurface"
                            Width="36"
                            Height="36"
                            CornerRadius="18"
                            Opacity="0"
                            Background="{StaticResource CardBackgroundBrush}"
                            BorderBrush="{StaticResource SearchBorderBrush}"
                            BorderThickness="1" />

                    <StackPanel>

                        <Button x:Name="MenuButton"
                                Width="36"
                                Height="36"
                                Style="{StaticResource BareButtonStyle}"
                                ToolTipService.ToolTip="More actions"
                                Click="OnMenuToggle">
                            <Grid Background="Transparent">
                                <StackPanel x:Name="Dots"
                                            Orientation="Horizontal"
                                            Spacing="3"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            RenderTransformOrigin="0.5,0.5">
                                    <StackPanel.RenderTransform>
                                        <RotateTransform x:Name="DotsRotation" Angle="0" />
                                    </StackPanel.RenderTransform>
                                    <Ellipse Width="3.5" Height="3.5" Fill="{StaticResource CardMetaBrush}" />
                                    <Ellipse Width="3.5" Height="3.5" Fill="{StaticResource CardMetaBrush}" />
                                    <Ellipse Width="3.5" Height="3.5" Fill="{StaticResource CardMetaBrush}" />
                                </StackPanel>
                            </Grid>
                        </Button>

                        <Button x:Name="EditItem"
                                Width="36"
                                Height="34"
                                Opacity="0"
                                IsHitTestVisible="False"
                                Style="{StaticResource BareButtonStyle}"
                                ToolTipService.ToolTip="Edit"
                                Click="OnEditClick">
                            <Button.RenderTransform>
                                <TranslateTransform x:Name="EditOffset" Y="-8" />
                            </Button.RenderTransform>
                            <Grid Background="Transparent">
                                <Viewbox Width="17" Height="17"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center">
                                    <Canvas Width="20" Height="20">
                                        <Path Data="M13.2 3.3L16.7 6.8 M14.6 1.9C15.2 1.3 16.2 1.3 16.8 1.9L18.1 3.2C18.7 3.8 18.7 4.8 18.1 5.4L5.6 17.9L1.5 18.5L2.1 14.4Z"
                                              Stroke="{StaticResource TextPrimaryBrush}"
                                              StrokeThickness="1.5"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round" />
                                    </Canvas>
                                </Viewbox>
                            </Grid>
                        </Button>

                        <Button x:Name="DeleteItem"
                                Width="36"
                                Height="34"
                                Opacity="0"
                                IsHitTestVisible="False"
                                Style="{StaticResource BareButtonStyle}"
                                ToolTipService.ToolTip="Delete"
                                Click="OnDeleteClick">
                            <Button.RenderTransform>
                                <TranslateTransform x:Name="DeleteOffset" Y="-8" />
                            </Button.RenderTransform>
                            <Grid Background="Transparent">
                                <Viewbox Width="17" Height="17"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center">
                                    <Canvas Width="20" Height="20">
                                        <Path Data="M2.8 5.2H17.2 M7.5 5.2V3.4C7.5 2.6 8.1 2 8.9 2H11.1C11.9 2 12.5 2.6 12.5 3.4V5.2 M15.3 5.2V16.6C15.3 17.4 14.7 18 13.9 18H6.1C5.3 18 4.7 17.4 4.7 16.6V5.2 M8.2 9V14.2 M11.8 9V14.2"
                                              Stroke="{StaticResource DangerBrush}"
                                              StrokeThickness="1.5"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round" />
                                    </Canvas>
                                </Viewbox>
                            </Grid>
                        </Button>
                    </StackPanel>
                </Canvas>
            </Grid>

            <!-- Five of the seven columns, in the design's two by three. -->
            <Grid Grid.Row="1" RowSpacing="18" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0">
                    <controls:FieldLabel Text="NAME" IconKind="Tag" />
                    <TextBlock x:Name="NameValue" Style="{StaticResource FieldValueStyle}" />
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="1">
                    <controls:FieldLabel Text="DOMAIN" IconKind="Globe" />
                    <TextBlock x:Name="DomainValue" Style="{StaticResource FieldValueStyle}" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0">
                    <controls:FieldLabel Text="DESCRIPTION" IconKind="FileText" />
                    <TextBlock x:Name="DescriptionValue" Style="{StaticResource FieldValueStyle}" />
                </StackPanel>

                <!--
                    Chips rather than a comma list, so the methods read as a set of
                    things rather than a sentence. The dash below is what shows when
                    none are selected; the two swap in code.
                -->
                <StackPanel Grid.Row="1" Grid.Column="1">
                    <controls:FieldLabel Text="AVAILABLE PAYMENT METHODS" IconKind="CreditCard" />
                    <TextBlock x:Name="NoMethodsValue" Style="{StaticResource FieldValueStyle}" />
                    <controls:WrapPanel x:Name="MethodChips"
                                        Margin="0,6,0,0"
                                        ItemSpacing="6"
                                        LineSpacing="6"
                                        MaxLines="1"
                                        UseLastChildAsOverflow="True">
                        <!--
                            Always the last child, and never removed. The panel keeps
                            room for it only when something did not fit, and reads its
                            width before it knows the count - hence the MinWidth, so
                            "+1" and "+12" reserve the same space and the second
                            measuring pass agrees with the first.
                        -->
                        <TextBlock x:Name="MoreMethods"
                                   MinWidth="26"
                                   FontFamily="{StaticResource BalooFont}"
                                   FontSize="12"
                                   Foreground="{StaticResource CardMetaBrush}"
                                   VerticalAlignment="Center"
                                   LineStackingStrategy="BlockLineHeight"
                                   LineHeight="19" />
                    </controls:WrapPanel>
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="0">
                    <controls:FieldLabel Text="NOTE" IconKind="Info" />
                    <TextBlock x:Name="NoteValue" Style="{StaticResource FieldValueStyle}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
