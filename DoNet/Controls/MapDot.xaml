<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DoNet.Controls.MapDot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        One marker on the VPS map - the small delta a location wears.

        A triangle pointing at the country it marks: the map's own colour
        for a main, a quiet slate for a VPS connected into an open network,
        a white halo so both read over land and sea alike. The tip lands
        exactly on the anchor; the caller seats the control by it.

        The marker's words - the callout that names the place on hover, the
        count chip when one country holds several mains, the ring when this
        is the VPS whose story the panel is telling - live on an overhang
        canvas, not in the root grid: a grid hands its children its own size
        and the root is the marker's footprint, so words measured inside it
        would wrap to a letter a line. A canvas measures against infinity;
        the elements are seated on it in code, in the Apply pattern the
        cards use. The hovered marker also lifts itself above its siblings
        on the layer, so its callout is never spoken from underneath them.
    -->

    <UserControl.Resources>

        <!-- The two fills a marker can wear. -->
        <SolidColorBrush x:Key="MainFillBrush" Color="#FF5F57" />
        <SolidColorBrush x:Key="NodeFillBrush" Color="#7A8798" />

        <!-- The callout arriving and leaving, quickly enough to feel
             attached to the pointer rather than animated in its own right. -->
        <Storyboard x:Key="TipShow">
            <DoubleAnimation Storyboard.TargetName="Callout"
                             Storyboard.TargetProperty="Opacity"
                             To="1" Duration="0:0:0.10" />
        </Storyboard>

        <Storyboard x:Key="TipHide">
            <DoubleAnimation Storyboard.TargetName="Callout"
                             Storyboard.TargetProperty="Opacity"
                             To="0" Duration="0:0:0.08" />
        </Storyboard>

        <!-- The marker standing up toward the pointer, growing from its
             tip - also driven by the panel, when the marker's row is
             hovered there. -->
        <Storyboard x:Key="HoverOn">
            <DoubleAnimation Storyboard.TargetName="HoverScale"
                             Storyboard.TargetProperty="ScaleX"
                             To="1.22" Duration="0:0:0.12">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="HoverScale"
                             Storyboard.TargetProperty="ScaleY"
                             To="1.22" Duration="0:0:0.12">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Key="HoverOff">
            <DoubleAnimation Storyboard.TargetName="HoverScale"
                             Storyboard.TargetProperty="ScaleX"
                             To="1" Duration="0:0:0.12">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="HoverScale"
                             Storyboard.TargetProperty="ScaleY"
                             To="1" Duration="0:0:0.12">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- The marker's arrival: a drop from just above its place, fading
             in - built in code, where the stagger lives. -->
    </UserControl.Resources>

    <!--
        The root is the marker's footprint, transparent so the whole of it
        is the hit target. The scale transform grows from the tip, which is
        where the marker is planted.
    -->
    <Grid x:Name="Root"
          Background="Transparent"
          PointerEntered="OnPointerEntered"
          PointerExited="OnPointerExited">
        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="EntryScale" ScaleX="1" ScaleY="1" />
                <ScaleTransform x:Name="HoverScale" ScaleX="1" ScaleY="1" />
            </TransformGroup>
        </Grid.RenderTransform>

        <Button Style="{StaticResource BareButtonStyle}"
                Click="OnClick">
            <Grid>
                <!-- The delta itself: its geometry is built in code, sized
                     to the marker's width, tip at the bottom. -->
                <Path x:Name="Delta"
                      Fill="{StaticResource MainFillBrush}"
                      Stroke="#FFFFFF"
                      StrokeThickness="2"
                      StrokeLineJoin="Round" />
            </Grid>
        </Button>

        <!--
            The overhang: zero-sized on purpose, a canvas measures its
            children against infinity and never clips them. Seated in code;
            nothing here is a hit target.
        -->
        <Canvas x:Name="Overhang"
                Width="0"
                Height="0"
                IsHitTestVisible="False">

            <!-- The ring when this is the VPS whose story the panel tells:
                 a quiet teal circle around the delta, a white halo under it
                 so it reads over any land. -->
            <Ellipse x:Name="SelectHalo"
                     Stroke="#FFFFFF"
                     StrokeThickness="4.5"
                     Opacity="0" />
            <Ellipse x:Name="SelectRing"
                     Stroke="#4BAA98"
                     StrokeThickness="2.5"
                     Opacity="0" />

            <!-- A country holding several mains wears its count, off the
                 delta's right shoulder. -->
            <Border x:Name="CountBadge"
                    CornerRadius="10"
                    Padding="7,1"
                    Background="#FEBC2E"
                    BorderBrush="#FFFFFF"
                    BorderThickness="1.5"
                    Visibility="Collapsed">
                <TextBlock x:Name="CountText"
                           FontFamily="{StaticResource JerseyFont}"
                           FontSize="13"
                           Foreground="#8A5B12"
                           LineStackingStrategy="BlockLineHeight"
                           LineHeight="14" />
            </Border>

            <!-- The hover callout: the place's name, in words, above the
                 marker. Flags live in the panel's list; the map's words stay
                 plain. -->
            <Border x:Name="Callout"
                    CornerRadius="10"
                    Padding="9,2"
                    Background="#FFFFFF"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1"
                    Opacity="0">
                <TextBlock x:Name="CalloutText"
                           FontFamily="{StaticResource BalooSemiBoldFont}"
                           FontSize="12"
                           Foreground="#2B2F33"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="180"
                           LineStackingStrategy="BlockLineHeight"
                           LineHeight="15" />
            </Border>
        </Canvas>
    </Grid>
</UserControl>
