<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DoNet.Controls.MapDot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:DoNet.Controls"
    mc:Ignorable="d">

    <!--
        One dot on the VPS map.

        The dot itself is a white coin carrying the country's flag, with the
        ring saying what the record is: the VPS's own red for a main, the
        app's slate for a VPS connected into an open network.

        Everything that hangs off the coin - the count badge, the MAIN tag,
        the label, the hover card - lives in an overhang canvas, not in the
        root grid. A grid hands its children its own size, and this root is
        the coin's little square, so a label measured inside it would wrap to
        one letter a line. A canvas measures its children against infinity,
        which is what a thing that overhangs its box needs; the elements are
        seated on it in code, in the Apply pattern the cards use, because the
        pin is a plain object refreshed by replacement. The caller positions
        the control on the map canvas; this control only ever owns its own
        square.
    -->

    <UserControl.Resources>

        <!-- The rings a dot can wear, here so the code can hand them to the
             coin without building colours itself. On the dark plate the main
        keeps the VPS's own red and a connected VPS goes silver. -->
        <SolidColorBrush x:Key="MainRingBrush" Color="#FF5F57" />
        <SolidColorBrush x:Key="NodeRingBrush" Color="#9FB2CC" />

        <Style x:Key="TipTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource BalooFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#D6DADE" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="MaxWidth" Value="226" />
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
            <Setter Property="LineHeight" Value="16" />
        </Style>

        <!-- The hover card arriving and leaving, quickly enough to feel
             attached to the pointer rather than animated in its own right. -->
        <Storyboard x:Key="TipShow">
            <DoubleAnimation Storyboard.TargetName="TipCard"
                             Storyboard.TargetProperty="Opacity"
                             To="1" Duration="0:0:0.10" />
        </Storyboard>

        <Storyboard x:Key="TipHide">
            <DoubleAnimation Storyboard.TargetName="TipCard"
                             Storyboard.TargetProperty="Opacity"
                             To="0" Duration="0:0:0.08" />
        </Storyboard>

        <!--
            The main's heartbeat: a red ring swelling out of the coin and
            fading, over and over. Only the root of an open network wears it -
            the pulse is how the eye finds the centre of the network.
        -->
        <Storyboard x:Key="PulseStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="PulseScale"
                             Storyboard.TargetProperty="ScaleX"
                             From="1" To="1.85" Duration="0:0:1.7">
                <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="PulseScale"
                             Storyboard.TargetProperty="ScaleY"
                             From="1" To="1.85" Duration="0:0:1.7">
                <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="PulseRing"
                             Storyboard.TargetProperty="Opacity"
                             From="0.6" To="0" Duration="0:0:1.7">
                <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- The dot leaning toward the pointer. -->
        <Storyboard x:Key="HoverOn">
            <DoubleAnimation Storyboard.TargetName="HoverScale"
                             Storyboard.TargetProperty="ScaleX"
                             To="1.14" Duration="0:0:0.12">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="HoverScale"
                             Storyboard.TargetProperty="ScaleY"
                             To="1.14" Duration="0:0:0.12">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Key="HoverOff">
            <DoubleAnimation Storyboard.TargetName="HoverScale"
                             Storyboard.TargetProperty="ScaleX"
                             To="1" Duration="0:0:0.12">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="HoverScale"
                             Storyboard.TargetProperty="ScaleY"
                             To="1" Duration="0:0:0.12">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

    </UserControl.Resources>

    <!--
        The root is exactly the coin's square - the hit target is the dot and
        nothing else. The scale transforms belong to the whole visual, so the
        overhang grows with the coin on hover.
    -->
    <Grid x:Name="Root"
          Width="34"
          Height="34"
          RenderTransformOrigin="0.5,0.5"
          PointerEntered="OnPointerEntered"
          PointerExited="OnPointerExited">
        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="EntryScale" ScaleX="1" ScaleY="1" />
                <ScaleTransform x:Name="HoverScale" ScaleX="1" ScaleY="1" />
            </TransformGroup>
        </Grid.RenderTransform>

        <!-- The main's heartbeat ring, behind everything, never a hit target. -->
        <Ellipse x:Name="PulseRing"
                 Stroke="#FF5F57"
                 StrokeThickness="2"
                 Opacity="0"
                 IsHitTestVisible="False"
                 RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform>
                <ScaleTransform x:Name="PulseScale" ScaleX="1" ScaleY="1" />
            </Ellipse.RenderTransform>
        </Ellipse>

        <Button Style="{StaticResource BareButtonStyle}"
                Click="OnClick">
            <Grid>
                <!-- The main's glow on the dark plate: a wide soft wash and a
                     bright ring just outside the coin. -->
                <Ellipse x:Name="HaloWash"
                         Opacity="0"
                         Stroke="#24FF5F57"
                         StrokeThickness="10" />
                <Ellipse x:Name="Halo"
                         Opacity="0"
                         Stroke="#59FF5F57"
                         StrokeThickness="1.5" />

                <!-- The coin: white fill, the ring saying what the record is. -->
                <Ellipse x:Name="Coin"
                         Fill="#FFFFFF"
                         Stroke="{StaticResource MainRingBrush}"
                         StrokeThickness="3" />

                <!-- The country's flag, or the globe when there is none. -->
                <Viewbox x:Name="FlagBox"
                         Width="21"
                         Height="15">
                    <controls:FlagIcon x:Name="Flag" />
                </Viewbox>
                <Viewbox x:Name="NoCountryBox"
                         Width="16"
                         Height="16"
                         Visibility="Collapsed">
                    <controls:LineIcon Kind="Globe"
                                       Width="16"
                                       Height="16"
                                       Foreground="#A0A5AB" />
                </Viewbox>
            </Grid>
        </Button>

        <!--
            The overhang: zero-sized on purpose, a canvas measures its
            children against infinity and never clips them, so the badge, the
            tag, the label and the hover card can be as wide as their words.
            Seated in code; none of them is a hit target.
        -->
        <Canvas x:Name="Overhang"
                Width="0"
                Height="0"
                IsHitTestVisible="False">

            <!-- A country holding several mains wears its count. -->
            <Border x:Name="CountBadge"
                    CornerRadius="10"
                    Padding="7,1"
                    Background="#FEBC2E"
                    BorderBrush="#FFFFFF"
                    BorderThickness="1.5"
                    Visibility="Collapsed">
                <TextBlock x:Name="CountText"
                           FontFamily="{StaticResource JerseyFont}"
                           FontSize="13"
                           Foreground="#8A5B12"
                           LineStackingStrategy="BlockLineHeight"
                           LineHeight="14" />
            </Border>

            <!-- The network's root, named so it cannot be mistaken for a
                 child. -->
            <Border x:Name="MainTag"
                    CornerRadius="8"
                    Padding="8,1"
                    Background="#FF5F57"
                    Visibility="Collapsed">
                <TextBlock Text="MAIN"
                           FontFamily="{StaticResource BalooSemiBoldFont}"
                           FontSize="10.5"
                           Foreground="#FFFFFF"
                           CharacterSpacing="80"
                           LineStackingStrategy="BlockLineHeight"
                           LineHeight="13" />
            </Border>

            <!-- The words under the dot: a country in the overview, a name in
                 a network. A pill, so it stays readable over land and sea
                 alike. -->
            <Border x:Name="LabelPill"
                    CornerRadius="10"
                    Padding="9,2"
                    Background="#B30E1626"
                    BorderBrush="#2E4058"
                    BorderThickness="1"
                    Visibility="Collapsed">
                <TextBlock x:Name="LabelText"
                           FontFamily="{StaticResource BalooFont}"
                           FontSize="12"
                           Foreground="#E8EEF7"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="150"
                           LineStackingStrategy="BlockLineHeight"
                           LineHeight="15" />
            </Border>

            <!-- The hover card: the country in words, the record's name, and
                 its place in the network. -->
            <Border x:Name="TipCard"
                    CornerRadius="12"
                    Padding="12,10"
                    Background="{StaticResource TooltipBackgroundBrush}"
                    Opacity="0">
                <StackPanel Spacing="3">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Viewbox x:Name="TipFlagBox"
                                 Width="18"
                                 Height="13"
                                 VerticalAlignment="Center">
                            <controls:FlagIcon x:Name="TipFlag" />
                        </Viewbox>
                        <TextBlock x:Name="TipTitle"
                                   FontFamily="{StaticResource BalooSemiBoldFont}"
                                   FontSize="13"
                                   Foreground="#FFFFFF"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="200"
                                   VerticalAlignment="Center"
                                   LineStackingStrategy="BlockLineHeight"
                                   LineHeight="17" />
                    </StackPanel>
                    <TextBlock x:Name="TipDetail" Style="{StaticResource TipTextStyle}" />
                    <TextBlock x:Name="TipMeta" Style="{StaticResource TipTextStyle}" />
                </StackPanel>
            </Border>
        </Canvas>
    </Grid>
</UserControl>
