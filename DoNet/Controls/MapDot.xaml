<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DoNet.Controls.MapDot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:DoNet.Controls"
    mc:Ignorable="d">

    <!--
        One pin on the VPS map - the classic map marker.

        A teardrop: a round head carrying the country's flag, tapering to a
        point whose tip lands exactly on the country it marks. The stroke
        says what the record is - the VPS's own red for a main, the app's
        slate for a VPS connected into an open network - and the pin's size
        says it too: a main's head is bigger than a connected VPS's. The
        focused main's tip carries a soft red ping, so the eye finds the
        network's centre on the page.

        The pin's words - the count badge for a country holding several
        mains, the label under the tip, the hover card - live on an overhang
        canvas, not in the root grid: a grid hands its children its own size
        and the root is the pin's footprint, so words measured inside it
        would wrap to a letter a line. A canvas measures against infinity;
        the elements are seated on it in code, in the Apply pattern the
        cards use, because the pin is a plain object refreshed by
        replacement. The caller seats the control so the TIP sits on the
        anchor; this control only ever owns its own footprint.
    -->

    <UserControl.Resources>

        <!-- The two strokes a pin can wear, here so the code can hand them
             to the body without building colours itself. -->
        <SolidColorBrush x:Key="MainRingBrush" Color="#FF5F57" />
        <SolidColorBrush x:Key="NodeRingBrush" Color="#7A8798" />

        <Style x:Key="TipTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource BalooFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#7A8798" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="MaxWidth" Value="226" />
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
            <Setter Property="LineHeight" Value="16" />
        </Style>

        <!-- The hover card arriving and leaving, quickly enough to feel
             attached to the pointer rather than animated in its own right. -->
        <Storyboard x:Key="TipShow">
            <DoubleAnimation Storyboard.TargetName="TipCard"
                             Storyboard.TargetProperty="Opacity"
                             To="1" Duration="0:0:0.10" />
        </Storyboard>

        <Storyboard x:Key="TipHide">
            <DoubleAnimation Storyboard.TargetName="TipCard"
                             Storyboard.TargetProperty="Opacity"
                             To="0" Duration="0:0:0.08" />
        </Storyboard>

        <!-- The pin leaning toward the pointer, growing from its tip. -->
        <Storyboard x:Key="HoverOn">
            <DoubleAnimation Storyboard.TargetName="HoverScale"
                             Storyboard.TargetProperty="ScaleX"
                             To="1.12" Duration="0:0:0.12">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="HoverScale"
                             Storyboard.TargetProperty="ScaleY"
                             To="1.12" Duration="0:0:0.12">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Key="HoverOff">
            <DoubleAnimation Storyboard.TargetName="HoverScale"
                             Storyboard.TargetProperty="ScaleX"
                             To="1" Duration="0:0:0.12">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="HoverScale"
                             Storyboard.TargetProperty="ScaleY"
                             To="1" Duration="0:0:0.12">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!--
            The focused main's ping: a red ring swelling out of the tip and
            fading, over and over - a heartbeat at the exact point on the
            earth the network hangs from.
        -->
        <Storyboard x:Key="PulseStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="PulseScale"
                             Storyboard.TargetProperty="ScaleX"
                             From="1" To="2.6" Duration="0:0:1.7">
                <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="PulseScale"
                             Storyboard.TargetProperty="ScaleY"
                             From="1" To="2.6" Duration="0:0:1.7">
                <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="PulseRing"
                             Storyboard.TargetProperty="Opacity"
                             From="0.55" To="0" Duration="0:0:1.7">
                <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

    </UserControl.Resources>

    <!--
        The root is the pin's footprint, transparent so the whole of it is
        the hit target. The scale transforms belong to the whole visual and
        grow from the tip, which is where the pin is planted.
    -->
    <Grid x:Name="Root"
          Background="Transparent"
          RenderTransformOrigin="0.5,0.95"
          PointerEntered="OnPointerEntered"
          PointerExited="OnPointerExited">
        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="EntryScale" ScaleX="1" ScaleY="1" />
                <ScaleTransform x:Name="HoverScale" ScaleX="1" ScaleY="1" />
            </TransformGroup>
        </Grid.RenderTransform>

        <Button Style="{StaticResource BareButtonStyle}"
                Click="OnClick">
            <Grid>
                <!-- The pin's soft ground shadow. -->
                <Ellipse x:Name="GroundShadow"
                         Fill="#23000000" />

                <!-- The pin itself: white body, the stroke saying what the
                     record is. Its geometry is built in code, sized to the
                     pin's head. -->
                <Path x:Name="PinBody"
                      Fill="#FFFFFF"
                      Stroke="{StaticResource MainRingBrush}"
                      StrokeThickness="2.5"
                      StrokeLineJoin="Round" />

                <!-- The country's flag in the head, or the globe when there
                     is no country. -->
                <Viewbox x:Name="FlagBox">
                    <controls:FlagIcon x:Name="Flag" />
                </Viewbox>
                <Viewbox x:Name="NoCountryBox"
                         Visibility="Collapsed">
                    <controls:LineIcon Kind="Globe"
                                       Width="16"
                                       Height="16"
                                       Foreground="#A0A5AB" />
                </Viewbox>
            </Grid>
        </Button>

        <!--
            The overhang: zero-sized on purpose, a canvas measures its
            children against infinity and never clips them. Seated in code;
            nothing here is a hit target.
        -->
        <Canvas x:Name="Overhang"
                Width="0"
                Height="0"
                IsHitTestVisible="False">

            <!-- The focused main's ping, planted at the tip. -->
            <Ellipse x:Name="PulseRing"
                     Stroke="#FF5F57"
                     StrokeThickness="2"
                     Opacity="0"
                     RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <ScaleTransform x:Name="PulseScale" ScaleX="1" ScaleY="1" />
                </Ellipse.RenderTransform>
            </Ellipse>

            <!-- A country holding several mains wears its count, off the
                 head's top-right shoulder. -->
            <Border x:Name="CountBadge"
                    CornerRadius="10"
                    Padding="7,1"
                    Background="#FEBC2E"
                    BorderBrush="#FFFFFF"
                    BorderThickness="1.5"
                    Visibility="Collapsed">
                <TextBlock x:Name="CountText"
                           FontFamily="{StaticResource JerseyFont}"
                           FontSize="13"
                           Foreground="#8A5B12"
                           LineStackingStrategy="BlockLineHeight"
                           LineHeight="14" />
            </Border>

            <!-- The words under the tip: a country in the overview, a name
                 in a network. -->
            <Border x:Name="LabelPill"
                    CornerRadius="10"
                    Padding="9,2"
                    Background="#FFFFFF"
                    BorderBrush="#E4E6E9"
                    BorderThickness="1"
                    Visibility="Collapsed">
                <TextBlock x:Name="LabelText"
                           FontFamily="{StaticResource BalooFont}"
                           FontSize="12"
                           Foreground="#5C6066"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="150"
                           LineStackingStrategy="BlockLineHeight"
                           LineHeight="15" />
            </Border>

            <!-- The hover card: the country in words, the record's name, and
                 its place in the network. -->
            <Border x:Name="TipCard"
                    CornerRadius="12"
                    Padding="12,10"
                    Background="#FFFFFF"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1"
                    Opacity="0">
                <StackPanel Spacing="3">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Viewbox x:Name="TipFlagBox"
                                 Width="18"
                                 Height="13"
                                 VerticalAlignment="Center">
                            <controls:FlagIcon x:Name="TipFlag" />
                        </Viewbox>
                        <TextBlock x:Name="TipTitle"
                                   FontFamily="{StaticResource BalooSemiBoldFont}"
                                   FontSize="13"
                                   Foreground="#2B2F33"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="200"
                                   VerticalAlignment="Center"
                                   LineStackingStrategy="BlockLineHeight"
                                   LineHeight="17" />
                    </StackPanel>
                    <TextBlock x:Name="TipDetail"
                               FontFamily="{StaticResource BalooSemiBoldFont}"
                               FontSize="12.5"
                               Foreground="#5C6066" />
                    <TextBlock x:Name="TipMeta" Style="{StaticResource TipTextStyle}" />
                </StackPanel>
            </Border>
        </Canvas>
    </Grid>
</UserControl>
