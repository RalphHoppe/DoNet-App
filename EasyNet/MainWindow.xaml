<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="EasyNet.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="EasyNet">

    <!--
        No SystemBackdrop: the design is flat white edge to edge, and Mica
        would tint it. The system title bar is removed entirely in the
        code-behind, so the pages own the whole window and the close button
        below is the only window chrome - the design shows a single round
        X at the top right and nothing else. The window opens at a
        comfortable desktop size and can shrink to the composition plus
        its margins; below that there is nothing left to show.
    -->
    <Grid Background="{ThemeResource PageBrush}">

        <Frame x:Name="RootFrame">
            <Frame.ContentTransitions>
                <TransitionCollection>
                    <!-- The platform's own quiet cross-fade between screens. -->
                    <NavigationThemeTransition />
                </TransitionCollection>
            </Frame.ContentTransitions>
        </Frame>

        <!--
            Declared to the window manager as the caption region in the
            code-behind, which is what makes dragging, double-click maximise,
            the right-click system menu and edge snapping work. There is
            deliberately no PointerPressed handler: emulating a drag from one
            is what breaks all of the above.
        -->
        <Grid x:Name="DragRegion"
              Height="48"
              VerticalAlignment="Top"
              Background="Transparent">

            <!--
                The window's X: the design's own round, 32 px across, 16 px
                from the corner, with the drawn X inside - weight exact, no
                glyph fallback on any machine.
            -->
            <Button x:Name="CloseButton"
                    Width="32"
                    Height="32"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,16,0"
                    Style="{StaticResource CloseButtonStyle}"
                    Click="OnCloseClick">
                <Path Width="10.6"
                      Height="10.6"
                      Stretch="None"
                      Fill="{ThemeResource CloseBrush}"
                      Data="M10.3 1.58C10.66 1.22 10.66 0.63 10.3 0.27C9.94 -0.09 9.35 -0.09 8.99 0.27L5.28 3.98L1.58 0.27C1.22 -0.09 0.63 -0.09 0.27 0.27C-0.09 0.63 -0.09 1.22 0.27 1.58L3.98 5.28L0.27 8.99C-0.09 9.35 -0.09 9.94 0.27 10.3C0.63 10.66 1.22 10.66 1.58 10.3L5.28 6.59L8.99 10.3C9.35 10.66 9.94 10.66 10.3 10.3C10.66 9.94 10.66 9.35 10.3 8.99L6.59 5.28L10.3 1.58Z" />
            </Button>
        </Grid>
    </Grid>
</Window>
