<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="EasyNet.Views.UnlockPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:EasyNet.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    SizeChanged="OnPageSizeChanged">

    <!--
        The lock screen, per the handoff: the logo and the form side by
        side while there is room for both - 596 - and stacked, logo above
        form, below that; the form taking the remaining width beside the
        logo and the whole width below it; the composition centred by the
        Screen, scrolling rather than clipping when the window is short.
        The type is the handoff's scale: ExtraBold 25/32, Regular 14/20.

        The beside/stacked markup below is the beside one - the handoff's
        own reference arrangement - and the stacked one is applied from
        the code-behind below 596. An AdaptiveTrigger owned that switch
        first and never fired on a window eight hundred wide: the base
        state shipped as-is, the form squeezed into the logo's column and
        the whole composition clipped. A switch this central cannot be
        allowed to fail quietly, so the page now owns it itself.
    -->
    <controls:Screen>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="212" />
                <ColumnDefinition Width="28" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="28" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- The brand: the design's own raster, contained, never shrunk. -->
            <Image x:Name="Logo"
                   Grid.Column="0"
                   Grid.Row="0"
                   Width="212"
                   Height="212"
                   Stretch="Uniform"
                   Source="ms-appx:///Assets/Brand/logo.png" />

            <!-- The form: introduction, then the password section. -->
            <StackPanel x:Name="Form"
                        Grid.Column="2"
                        Grid.Row="0"
                        MinWidth="304"
                        HorizontalAlignment="Stretch">
                <StackPanel Spacing="6">
                    <TextBlock FontFamily="{StaticResource ExtraBoldFont}"
                               FontSize="25"
                               LineHeight="32"
                               LineStackingStrategy="BlockLineHeight"
                               Foreground="{ThemeResource InkStrongBrush}"
                               TextWrapping="Wrap"
                               Text="Unlock to access your data." />
                    <TextBlock FontFamily="{StaticResource TextFont}"
                               FontSize="14"
                               LineHeight="20"
                               LineStackingStrategy="BlockLineHeight"
                               Foreground="{ThemeResource InkSoftBrush}"
                               TextWrapping="Wrap"
                               Text="Enter your password to unlock the app and access your locked data." />
                </StackPanel>

                <StackPanel Margin="0,20,0,0">
                    <controls:PasswordField x:Name="PasswordField"
                                            Label="Password"
                                            Placeholder="Enter your password" />

                    <TextBlock x:Name="ErrorLine"
                               Margin="0,8,0,0"
                               FontFamily="{StaticResource TextFont}"
                               FontSize="13"
                               Foreground="{ThemeResource InkSoftBrush}"
                               TextWrapping="Wrap"
                               Text="That password doesn't match this vault."
                               Visibility="{x:Bind ViewModel.HasError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

                    <!--
                        The action: the icon-and-word group centred in a
                        pill that hugs it, floored at 148 - the design's
                        open padlock beside the word.
                    -->
                    <Button Margin="0,16,0,0"
                            HorizontalAlignment="Left"
                            Style="{StaticResource ActionButtonStyle}"
                            IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}"
                            Click="OnUnlockClick">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Grid Width="20" Height="20" VerticalAlignment="Center">
                                <Path HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Stroke="{ThemeResource InkBrush}"
                                      StrokeThickness="1.6"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Data="M2 7.2H10C11.1 7.2 12 8.1 12 9.2V14.2C12 15.3 11.1 16.2 10 16.2H2C0.9 16.2 0 15.3 0 14.2V9.2C0 8.1 0.9 7.2 2 7.2Z M3 7.2V4.2C2.99 3.31 3.27 2.44 3.81 1.72C4.35 1.01 5.11 0.5 5.97 0.27C6.83 0.04 7.75 0.11 8.57 0.46C9.39 0.81 10.07 1.42 10.5 2.2 M6 10.2V13.2" />
                            </Grid>
                            <TextBlock VerticalAlignment="Center"
                                       FontFamily="{StaticResource BoldFont}"
                                       FontSize="15"
                                       LineHeight="20"
                                       LineStackingStrategy="BlockLineHeight"
                                       Foreground="{ThemeResource InkBrush}"
                                       Text="Unlock" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>
    </controls:Screen>
</Page>
