<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="EasyNet.Views.UnlockPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:EasyNet.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        The same skeleton as the create screen - the mockups are deliberate
        about that - with the one field a lock asks for, and the word it says
        when the answer is wrong.
    -->
    <Grid Background="{ThemeResource PaperBrush}">

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="WidthStates">
                <VisualState x:Name="WideState" />
                <VisualState x:Name="NarrowState">
                    <VisualState.Setters>
                        <Setter Target="Lockup.Visibility" Value="Collapsed" />
                        <Setter Target="LockupColumn.Width" Value="0" />
                        <Setter Target="Form.(FrameworkElement.Margin)" Value="48,78,48,0" />
                        <Setter Target="Form.MaxWidth" Value="560" />
                        <Setter Target="Form.HorizontalAlignment" Value="Center" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LockupColumn" Width="352" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel x:Name="Lockup"
                    Grid.Column="0"
                    Margin="86,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Spacing="10">
            <controls:EasyNetMark Mode="Static" Width="142" />
            <controls:EasyNetWordmark Mode="Static" Width="199" />
        </StackPanel>

        <StackPanel x:Name="Form"
                    Grid.Column="1"
                    Margin="0,78,0,0"
                    HorizontalAlignment="Left"
                    MaxWidth="840">

            <TextBlock Text="Unlock to access your data."
                       FontFamily="{StaticResource DisplayFont}"
                       FontSize="44"
                       FontWeight="SemiBold"
                       Foreground="{ThemeResource TitleBrush}" />

            <TextBlock Margin="0,14,0,0"
                       FontFamily="{StaticResource TextFont}"
                       FontSize="20"
                       Foreground="{ThemeResource MetaBrush}"
                       TextWrapping="Wrap"
                       Text="Enter your password to unlock the app and access your locked data." />

            <TextBlock Margin="0,64,0,0"
                       FontFamily="{StaticResource TextFont}"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="{ThemeResource InkSoftBrush}"
                       Text="PASSWORD" />

            <controls:PasswordField x:Name="PasswordField"
                                    Margin="0,10,0,0"
                                    Placeholder="Enter your password" />

            <TextBlock x:Name="ErrorLine"
                       Margin="2,6,0,0"
                       FontFamily="{StaticResource TextFont}"
                       FontSize="14"
                       Foreground="{ThemeResource DangerBrush}"
                       Visibility="{x:Bind ViewModel.HasError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                       Text="That password doesn't match this vault." />

            <Button x:Name="UnlockAction"
                    Margin="0,64,0,0"
                    HorizontalAlignment="Left"
                    MinWidth="0"
                    MinHeight="0"
                    Padding="10,8"
                    CornerRadius="12"
                    IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}"
                    Click="OnUnlockClick">
                <Button.Resources>
                    <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#F2F3F5" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#E9EAEE" />
                    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />
                </Button.Resources>
                <StackPanel Orientation="Horizontal" Spacing="14">
                    <Canvas Width="46" Height="40" VerticalAlignment="Center">
                        <Path Stroke="{ThemeResource InkSoftBrush}"
                              StrokeThickness="2.6"
                              StrokeLineJoin="Round"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Data="M15,19 V12.5 A8,8 0 0 1 31,12.5 V19" />
                        <Path Stroke="{ThemeResource InkSoftBrush}"
                              StrokeThickness="2.6"
                              StrokeLineJoin="Round"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Data="M9,19 H37 A5,5 0 0 1 42,24 V33 A5,5 0 0 1 37,38 H9 A5,5 0 0 1 4,33 V24 A5,5 0 0 1 9,19 Z" />
                        <Path Stroke="{ThemeResource InkSoftBrush}"
                              StrokeThickness="2.2"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Data="M23,25.5 V31" />
                        <Ellipse Canvas.Left="19.4"
                                 Canvas.Top="21.6"
                                 Width="7.2"
                                 Height="7.2"
                                 Stroke="{ThemeResource InkSoftBrush}"
                                 StrokeThickness="2.2" />
                    </Canvas>
                    <TextBlock VerticalAlignment="Center"
                               FontFamily="{StaticResource DisplayFont}"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource InkSoftBrush}"
                               Text="Unlock" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Page>
