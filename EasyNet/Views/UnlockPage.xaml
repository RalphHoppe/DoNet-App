<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="EasyNet.Views.UnlockPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:EasyNet.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        The lock screen, laid out exactly as its SVG draws it: a white page,
        the brand standing at the left, the form at the right, the whole
        700 x 400 composition centred in whatever room the window has. The
        type is the measured scale - ExtraBold 25 for the heading, Light 14
        beneath it - and the action carries the design's open padlock.
    -->
    <Grid Background="{ThemeResource PageBrush}">
        <ScrollViewer HorizontalContentAlignment="Center"
                      VerticalContentAlignment="Center"
                      HorizontalScrollMode="Disabled">
            <Grid Width="700" Height="400">

                <!-- The brand: the mark and the word, still, in their 112 box. -->
                <StackPanel Width="112"
                            Height="112"
                            Margin="36,144,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Spacing="3">
                    <controls:EasyNetMark Mode="Static" Width="71" HorizontalAlignment="Center" />
                    <controls:EasyNetWordmark Mode="Static" Width="97" HorizontalAlignment="Center" />
                </StackPanel>

                <!-- The form: text left-aligned at the field's left edge. -->
                <StackPanel Margin="176,0,36,0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Top">
                    <TextBlock Margin="0,90,0,0"
                               FontFamily="{StaticResource ExtraBoldFont}"
                               FontSize="25"
                               Foreground="{ThemeResource InkStrongBrush}"
                               Text="Unlock to access your data." />

                    <TextBlock Margin="0,6,0,0"
                               MaxWidth="430"
                               FontFamily="{StaticResource LightFont}"
                               FontSize="14"
                               Foreground="{ThemeResource InkSoftBrush}"
                               TextWrapping="Wrap"
                               Text="Enter your password to unlock the app and access your locked data." />

                    <controls:PasswordField Margin="0,21,0,0"
                                            x:Name="PasswordField"
                                            Label="Password"
                                            Placeholder="Enter your password" />

                    <TextBlock x:Name="ErrorLine"
                               Margin="58,8,0,0"
                               FontFamily="{StaticResource LightFont}"
                               FontSize="13"
                               Foreground="{ThemeResource InkSoftBrush}"
                               Text="That password doesn't match this vault."
                               Visibility="{x:Bind ViewModel.HasError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

                    <!-- The action: the design's open padlock beside the word. -->
                    <Button Margin="0,16,0,0"
                            HorizontalAlignment="Left"
                            Style="{StaticResource ActionButtonStyle}"
                            IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}"
                            Click="OnUnlockClick">
                        <StackPanel Orientation="Horizontal" Spacing="19">
                            <Path Width="12" Height="16.2"
                                  VerticalAlignment="Center"
                                  Stretch="None"
                                  Stroke="{ThemeResource InkBrush}"
                                  StrokeThickness="1.6"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Data="M2 7.2H10C11.1 7.2 12 8.1 12 9.2V14.2C12 15.3 11.1 16.2 10 16.2H2C0.9 16.2 0 15.3 0 14.2V9.2C0 8.1 0.9 7.2 2 7.2Z M3 7.2V4.2C2.99 3.31 3.27 2.44 3.81 1.72C4.35 1.01 5.11 0.5 5.97 0.27C6.83 0.04 7.75 0.11 8.57 0.46C9.39 0.81 10.07 1.42 10.5 2.2 M6 10.2V13.2" />
                            <TextBlock VerticalAlignment="Center"
                                       FontFamily="{StaticResource BoldFont}"
                                       FontSize="15"
                                       Foreground="{ThemeResource InkBrush}"
                                       Text="Unlock" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
