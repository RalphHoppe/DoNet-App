<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="EasyNet.Views.CreatePasswordPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:EasyNet.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        The password-generation screen: the lock screen's own language with
        a second field - the same rhythm, the same pieces, the same type
        scale - because the two doors are the same shape or the app feels
        askew walking between them. The action carries the padlock-and-
        clock: a lock that also keeps time.
    -->
    <Grid Background="{ThemeResource PageBrush}">
        <ScrollViewer HorizontalContentAlignment="Center"
                      VerticalContentAlignment="Center"
                      HorizontalScrollMode="Disabled">
            <Grid Width="700" Height="430">

                <!-- The brand: the mark and the word, still, in their 112 box. -->
                <StackPanel Width="112"
                            Height="112"
                            Margin="36,144,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Spacing="3">
                    <controls:EasyNetMark Mode="Static" Width="71" HorizontalAlignment="Center" />
                    <controls:EasyNetWordmark Mode="Static" Width="97" HorizontalAlignment="Center" />
                </StackPanel>

                <StackPanel Margin="176,0,36,0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Top">
                    <TextBlock Margin="0,90,0,0"
                               FontFamily="{StaticResource ExtraBoldFont}"
                               FontSize="25"
                               Foreground="{ThemeResource InkStrongBrush}"
                               Text="Create your password." />

                    <TextBlock Margin="0,6,0,0"
                               MaxWidth="430"
                               FontFamily="{StaticResource LightFont}"
                               FontSize="14"
                               Foreground="{ThemeResource InkSoftBrush}"
                               TextWrapping="Wrap"
                               Text="Create a password to protect your data. Use it to unlock EasyNet." />

                    <controls:PasswordField Margin="0,21,0,0"
                                            x:Name="PasswordField"
                                            Label="Password"
                                            Placeholder="Enter your password" />

                    <TextBlock Margin="58,6,0,0"
                               FontFamily="{StaticResource LightFont}"
                               FontSize="13"
                               Foreground="{ThemeResource InkSoftBrush}"
                               Text="Use at least 8 characters."
                               Visibility="{x:Bind ViewModel.ShowLengthHint, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

                    <controls:PasswordField Margin="0,12,0,0"
                                            x:Name="ConfirmField"
                                            Label="Re-enter password"
                                            Placeholder="Re-enter your password" />

                    <TextBlock Margin="58,6,0,0"
                               FontFamily="{StaticResource LightFont}"
                               FontSize="13"
                               Foreground="{ThemeResource InkSoftBrush}"
                               Text="The two passwords don't match."
                               Visibility="{x:Bind ViewModel.ShowMismatchHint, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

                    <!--
                        The action. The padlock-and-clock is reconstructed
                        from the designer's description of it - shackle,
                        body, a small clock at the body's corner - until its
                        exact SVG arrives, and then it will be swapped for
                        the verbatim vector like every other icon.
                    -->
                    <Button Margin="0,16,0,0"
                            HorizontalAlignment="Left"
                            Style="{StaticResource ActionButtonStyle}"
                            IsEnabled="{x:Bind ViewModel.CanCreate, Mode=OneWay}"
                            Click="OnCreateClick">
                        <StackPanel Orientation="Horizontal" Spacing="19">
                            <Grid Width="16.4" Height="18.5" VerticalAlignment="Center">
                                <Path Stroke="{ThemeResource InkBrush}"
                                      StrokeThickness="1.6"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Data="M3.6 8.9V4.72C3.6 2.78 5.55 0.83 7.49 0.83C9.43 0.83 11.38 2.78 11.38 4.72V8.9 M2.46 8.9H11.44C12.21 8.9 12.84 9.53 12.84 10.3V15.9C12.84 16.67 12.21 17.3 11.44 17.3H2.46C1.69 17.3 1.06 16.67 1.06 15.9V10.3C1.06 9.53 1.69 8.9 2.46 8.9Z M12.99 15.1V13.3 M12.99 15.1L14.3 15.9" />
                                <!-- The clock's face: white, so the body's edge ends at its rim. -->
                                <Path Fill="{ThemeResource PageBrush}"
                                      Stroke="{ThemeResource InkBrush}"
                                      StrokeThickness="1.6"
                                      Data="M15.59 15.1C15.59 16.54 14.43 17.7 12.99 17.7C11.55 17.7 10.39 16.54 10.39 15.1C10.39 13.66 11.55 12.5 12.99 12.5C14.43 12.5 15.59 13.66 15.59 15.1Z" />
                            </Grid>
                            <TextBlock VerticalAlignment="Center"
                                       FontFamily="{StaticResource BoldFont}"
                                       FontSize="15"
                                       Foreground="{ThemeResource InkBrush}"
                                       Text="Create Password" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
