<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="EasyNet.Views.CreatePasswordPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:EasyNet.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        The mockups' layout, at its own numbers: the lockup at the left on its
        own third, the form beginning a quarter of the way across, the title
        a seventh of the way down. Nothing is centred that the design drew
        left, and nothing is boxed that the design drew open.
    -->
    <Grid Background="{ThemeResource PaperBrush}">

        <VisualStateManager.VisualStateGroups>
            <!--
                Below the wide layout's width the lockup steps aside rather
                than squeezing the form; the form then centres and caps its
                width, because a password form is one readable column, not a
                stretched one.
            -->
            <VisualStateGroup x:Name="WidthStates">
                <VisualState x:Name="WideState" />
                <VisualState x:Name="NarrowState">
                    <VisualState.Setters>
                        <Setter Target="Lockup.Visibility" Value="Collapsed" />
                        <Setter Target="LockupColumn.Width" Value="0" />
                        <Setter Target="Form.(FrameworkElement.Margin)" Value="48,78,48,0" />
                        <Setter Target="Form.MaxWidth" Value="560" />
                        <Setter Target="Form.HorizontalAlignment" Value="Center" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LockupColumn" Width="352" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--
            The lockup: the mark above the word, the settled logo - it has
            nothing to announce here that an entrance would say better than
            its own stillness. Margin 86 is the mockups' own left edge for it.
        -->
        <StackPanel x:Name="Lockup"
                    Grid.Column="0"
                    Margin="86,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Spacing="10">
            <controls:EasyNetMark Mode="Static" Width="142" />
            <controls:EasyNetWordmark Mode="Static" Width="199" />
        </StackPanel>

        <!--
            The form: top-anchored at the mockups' own rhythm - title, one
            quiet line under it, then the pair of fields and the action, each
            where the mockups put them rather than evenly spread.
        -->
        <StackPanel x:Name="Form"
                    Grid.Column="1"
                    Margin="0,78,0,0"
                    HorizontalAlignment="Left"
                    MaxWidth="840">

            <TextBlock Text="Create your password."
                       FontFamily="{StaticResource DisplayFont}"
                       FontSize="44"
                       FontWeight="SemiBold"
                       Foreground="{ThemeResource TitleBrush}" />

            <TextBlock Margin="0,14,0,0"
                       FontFamily="{StaticResource TextFont}"
                       FontSize="20"
                       Foreground="{ThemeResource MetaBrush}"
                       TextWrapping="Wrap"
                       Text="Create a password to protect your data. Use it to unlock EasyNet." />

            <!-- The first field: the only one the mockups gave a label. -->
            <TextBlock Margin="0,64,0,0"
                       FontFamily="{StaticResource TextFont}"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="{ThemeResource InkSoftBrush}"
                       Text="PASSWORD" />

            <controls:PasswordField x:Name="PasswordField"
                                    Margin="0,10,0,0"
                                    Placeholder="Enter your password" />

            <TextBlock Margin="2,6,0,0"
                       FontFamily="{StaticResource TextFont}"
                       FontSize="14"
                       Foreground="{ThemeResource MetaBrush}"
                       Visibility="{x:Bind ViewModel.ShowLengthHint, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                       Text="Use at least 8 characters." />

            <controls:PasswordField x:Name="ConfirmField"
                                    Margin="0,28,0,0"
                                    Placeholder="Re-enter your password" />

            <TextBlock Margin="2,6,0,0"
                       FontFamily="{StaticResource TextFont}"
                       FontSize="14"
                       Foreground="{ThemeResource DangerBrush}"
                       Visibility="{x:Bind ViewModel.ShowMismatchHint, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                       Text="The two passwords don't match." />

            <!--
                The action, as the mockups draw it: no button box, just the
                padlock and the words. It is a button underneath, so the
                keyboard can reach it, wearing nothing.
            -->
            <Button x:Name="CreateAction"
                    Margin="0,64,0,0"
                    HorizontalAlignment="Left"
                    MinWidth="0"
                    MinHeight="0"
                    Padding="10,8"
                    CornerRadius="12"
                    IsEnabled="{x:Bind ViewModel.CanCreate, Mode=OneWay}"
                    Click="OnCreateClick">
                <Button.Resources>
                    <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#F2F3F5" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#E9EAEE" />
                    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />
                </Button.Resources>
                <StackPanel Orientation="Horizontal" Spacing="14">
                    <Canvas Width="46" Height="40" VerticalAlignment="Center">
                        <Path x:Name="ActionShackle"
                              Stroke="{ThemeResource InkSoftBrush}"
                              StrokeThickness="2.6"
                              StrokeLineJoin="Round"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Data="M15,19 V12.5 A8,8 0 0 1 31,12.5 V19" />
                        <Path x:Name="ActionBody"
                              Stroke="{ThemeResource InkSoftBrush}"
                              StrokeThickness="2.6"
                              StrokeLineJoin="Round"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Data="M9,19 H37 A5,5 0 0 1 42,24 V33 A5,5 0 0 1 37,38 H9 A5,5 0 0 1 4,33 V24 A5,5 0 0 1 9,19 Z" />
                        <Path x:Name="ActionKeyholeStem"
                              Stroke="{ThemeResource InkSoftBrush}"
                              StrokeThickness="2.2"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Data="M23,25.5 V31" />
                        <Ellipse x:Name="ActionKeyholeBow"
                                 Canvas.Left="19.4"
                                 Canvas.Top="21.6"
                                 Width="7.2"
                                 Height="7.2"
                                 Stroke="{ThemeResource InkSoftBrush}"
                                 StrokeThickness="2.2" />
                    </Canvas>
                    <TextBlock x:Name="ActionLabel"
                               VerticalAlignment="Center"
                               FontFamily="{StaticResource DisplayFont}"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource InkSoftBrush}"
                               Text="Create Password" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Page>
