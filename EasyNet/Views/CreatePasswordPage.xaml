<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="EasyNet.Views.CreatePasswordPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:EasyNet.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    SizeChanged="OnPageSizeChanged">

    <!--
        The password-generation screen: the lock screen's own responsive
        skeleton with a second field - the same rhythm, the same pieces,
        the same type scale - because the two doors are the same shape or
        the app feels askew walking between them. The action carries the
        padlock-and-clock: a lock that also keeps time.

        The beside/stacked markup below is the beside one - the handoff's
        own reference arrangement - and the stacked one is applied from
        the code-behind below 588. An AdaptiveTrigger owned that switch
        first and never fired on a window eight hundred wide; a switch
        this central cannot be allowed to fail quietly.
    -->
    <controls:Screen>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="212" />
                <ColumnDefinition Width="28" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="28" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- The brand: the design's own raster, contained, never shrunk. -->
            <Image x:Name="Logo"
                   Grid.Column="0"
                   Grid.Row="0"
                   Width="212"
                   Height="212"
                   Stretch="Uniform"
                   Source="ms-appx:///Assets/Brand/logo.png" />

            <!-- The form: introduction, then the password section. -->
            <StackPanel x:Name="Form"
                        Grid.Column="2"
                        Grid.Row="0"
                        MinWidth="296"
                        HorizontalAlignment="Stretch">
                <StackPanel Spacing="6">
                    <TextBlock FontFamily="{StaticResource ExtraBoldFont}"
                               FontSize="25"
                               LineHeight="32"
                               LineStackingStrategy="BlockLineHeight"
                               Foreground="{ThemeResource InkStrongBrush}"
                               TextWrapping="Wrap"
                               Text="Create your password." />
                    <TextBlock FontFamily="{StaticResource TextFont}"
                               FontSize="14"
                               LineHeight="20"
                               LineStackingStrategy="BlockLineHeight"
                               Foreground="{ThemeResource InkSoftBrush}"
                               TextWrapping="Wrap"
                               Text="Create a password to protect your data. Use it to unlock EasyNet." />
                </StackPanel>

                <StackPanel Margin="0,20,0,0">
                    <controls:PasswordField x:Name="PasswordField"
                                            Label="Password"
                                            Placeholder="Enter your password" />

                    <TextBlock Margin="0,8,0,0"
                               FontFamily="{StaticResource TextFont}"
                               FontSize="13"
                               Foreground="{ThemeResource InkSoftBrush}"
                               TextWrapping="Wrap"
                               Text="Use at least 8 characters."
                               Visibility="{x:Bind ViewModel.ShowLengthHint, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

                    <controls:PasswordField Margin="0,12,0,0"
                                            x:Name="ConfirmField"
                                            Label="Re-enter password"
                                            Placeholder="Re-enter your password" />

                    <TextBlock Margin="0,8,0,0"
                               FontFamily="{StaticResource TextFont}"
                               FontSize="13"
                               Foreground="{ThemeResource InkSoftBrush}"
                               TextWrapping="Wrap"
                               Text="The two passwords don't match."
                               Visibility="{x:Bind ViewModel.ShowMismatchHint, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

                    <!--
                        The action. The padlock-and-clock is reconstructed
                        from the designer's description of it - shackle,
                        body, a small clock at the body's corner - until
                        its exact SVG arrives, and then it will be swapped
                        for the verbatim vector like every other icon.
                    -->
                    <Button Margin="0,16,0,0"
                            HorizontalAlignment="Center"
                            Style="{StaticResource ActionButtonStyle}"
                            IsEnabled="{x:Bind ViewModel.CanCreate, Mode=OneWay}"
                            Click="OnCreateClick">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Grid Width="20" Height="20" VerticalAlignment="Center">
                                <Path HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Stroke="{ThemeResource InkBrush}"
                                      StrokeThickness="1.6"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Data="M3.6 8.9V4.72C3.6 2.78 5.55 0.83 7.49 0.83C9.43 0.83 11.38 2.78 11.38 4.72V8.9 M2.46 8.9H11.44C12.21 8.9 12.84 9.53 12.84 10.3V15.9C12.84 16.67 12.21 17.3 11.44 17.3H2.46C1.69 17.3 1.06 16.67 1.06 15.9V10.3C1.06 9.53 1.69 8.9 2.46 8.9Z M12.99 15.1V13.3 M12.99 15.1L14.3 15.9" />
                                <!-- The clock's face: white, so the body's ring ends at its rim. -->
                                <Path Fill="{ThemeResource PageBrush}"
                                      Stroke="{ThemeResource InkBrush}"
                                      StrokeThickness="1.6"
                                      Data="M15.59 15.1C15.59 16.54 14.43 17.7 12.99 17.7C11.55 17.7 10.39 16.54 10.39 15.1C10.39 13.66 11.55 12.5 12.99 12.5C14.43 12.5 15.59 13.66 15.59 15.1Z" />
                            </Grid>
                            <TextBlock VerticalAlignment="Center"
                                       FontFamily="{StaticResource BoldFont}"
                                       FontSize="15"
                                       LineHeight="20"
                                       LineStackingStrategy="BlockLineHeight"
                                       Foreground="{ThemeResource InkBrush}"
                                       Text="Create Password" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>
    </controls:Screen>
</Page>
