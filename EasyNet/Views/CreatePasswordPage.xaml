<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="EasyNet.Views.CreatePasswordPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:EasyNet.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        A startup screen's register: one centred column, the lockup above,
        the form below - everything the small window needs and nothing it
        does not. The fields are the design's three separate pieces; the
        action is the glass language with the padlock beside its words.
    -->
    <Grid Background="{ThemeResource PaperBrush}">
        <StackPanel VerticalAlignment="Center"
                    Margin="70,0"
                    MaxWidth="400">

            <StackPanel HorizontalAlignment="Center"
                        Spacing="4">
                <controls:EasyNetMark Mode="Static" Width="84" />
                <controls:EasyNetWordmark Mode="Static" Width="118" />
            </StackPanel>

            <TextBlock Margin="0,28,0,0"
                       Text="Create your password."
                       FontFamily="{StaticResource DisplayFont}"
                       FontSize="30"
                       FontWeight="SemiBold"
                       Foreground="{ThemeResource TitleBrush}" />

            <TextBlock Margin="0,8,0,0"
                       FontFamily="{StaticResource TextFont}"
                       FontSize="15"
                       Foreground="{ThemeResource MetaBrush}"
                       TextWrapping="Wrap"
                       Text="Create a password to protect your data. Use it to unlock EasyNet." />

            <controls:PasswordField x:Name="PasswordField"
                                    Margin="0,30,0,0"
                                    Placeholder="Enter your password" />

            <TextBlock Margin="2,6,0,0"
                       FontFamily="{StaticResource TextFont}"
                       FontSize="13"
                       Foreground="{ThemeResource MetaBrush}"
                       Visibility="{x:Bind ViewModel.ShowLengthHint, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                       Text="Use at least 8 characters." />

            <controls:PasswordField x:Name="ConfirmField"
                                    Margin="0,14,0,0"
                                    Placeholder="Re-enter your password" />

            <TextBlock Margin="2,6,0,0"
                       FontFamily="{StaticResource TextFont}"
                       FontSize="13"
                       Foreground="{ThemeResource DangerBrush}"
                       Visibility="{x:Bind ViewModel.ShowMismatchHint, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                       Text="The two passwords don't match." />

            <!--
                The action: the glass language with the padlock beside its
                words - the design's own 15x20 icon, the same one the fields
                carry, drawn here in its resting ink.
            -->
            <Button x:Name="CreateAction"
                    Margin="0,32,0,0"
                    HorizontalAlignment="Left"
                    Height="50"
                    Style="{StaticResource GlassButtonStyle}"
                    IsEnabled="{x:Bind ViewModel.CanCreate, Mode=OneWay}"
                    Click="OnCreateClick">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Viewbox Stretch="Uniform" Width="17" Height="22">
                        <Canvas Width="15" Height="20">
                            <Path Stroke="{ThemeResource InkSoftBrush}"
                                  StrokeThickness="2"
                                  StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Data="M3.54,9.4 V4.73 A3.95,3.95 0 0 1 11.43,4.73 V9.4" />
                            <Path Stroke="{ThemeResource InkSoftBrush}"
                                  StrokeThickness="2"
                                  StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Data="M3.27,9.15 H11.69 A2,2 0 0 1 13.69,11.15 V16.46 A2,2 0 0 1 11.69,18.46 H3.27 A2,2 0 0 1 1.27,16.46 V11.15 A2,2 0 0 1 3.27,9.15 Z" />
                            <Ellipse Canvas.Left="5.98"
                                     Canvas.Top="12.22"
                                     Width="3"
                                     Height="3"
                                     Stroke="{ThemeResource InkSoftBrush}"
                                     StrokeThickness="2" />
                        </Canvas>
                    </Viewbox>
                    <TextBlock VerticalAlignment="Center"
                               FontFamily="{StaticResource DisplayFont}"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource InkSoftBrush}"
                               Text="Create Password" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Page>
