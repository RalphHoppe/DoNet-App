<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="EasyNet.Views.SplashPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:EasyNet.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        The brand's moment: the mark assembles, the word rises letter by
        letter, and then the logo simply lives - light travelling its ring -
        while the app decides where this run is going. Nothing else is on the
        screen, which is the whole point of a splash: one thing, held well.
    -->
    <Grid Background="{ThemeResource PageBrush}">
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="14">
            <controls:EasyNetMark Mode="Splash" Width="240" />
            <controls:EasyNetWordmark Mode="Splash" Width="340" />
        </StackPanel>
    </Grid>
</Page>
