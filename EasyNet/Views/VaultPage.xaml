<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="EasyNet.Views.VaultPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:EasyNet.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        An honest placeholder, in the design's language: the vault is open,
        its screens are waiting on their designs, and the one thing this
        page can do for real - lock again - is offered with the padlock-
        and-clock. When the vault's own screens arrive, this page is
        replaced rather than decorated around.
    -->
    <Grid Background="{ThemeResource PageBrush}">
        <ScrollViewer HorizontalContentAlignment="Center"
                      VerticalContentAlignment="Center"
                      HorizontalScrollMode="Disabled">
            <StackPanel HorizontalAlignment="Center">
                <StackPanel HorizontalAlignment="Center" Spacing="3">
                    <controls:EasyNetMark Mode="Static" Width="71" HorizontalAlignment="Center" />
                    <controls:EasyNetWordmark Mode="Static" Width="97" HorizontalAlignment="Center" />
                </StackPanel>

                <TextBlock Margin="0,36,0,0"
                           HorizontalAlignment="Center"
                           FontFamily="{StaticResource ExtraBoldFont}"
                           FontSize="25"
                           Foreground="{ThemeResource InkStrongBrush}"
                           Text="The vault is open." />

                <TextBlock Margin="0,6,0,0"
                           HorizontalAlignment="Center"
                           FontFamily="{StaticResource TextFont}"
                           FontSize="14"
                           Foreground="{ThemeResource InkSoftBrush}"
                           Text="The vault's screens are waiting on their designs." />

                <Button Margin="0,32,0,0"
                        HorizontalAlignment="Center"
                        Style="{StaticResource ActionButtonStyle}"
                        Command="{x:Bind ViewModel.LockCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="19">
                        <Grid Width="16.4" Height="18.5" VerticalAlignment="Center">
                            <Path Stroke="{ThemeResource InkBrush}"
                                  StrokeThickness="1.6"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Data="M3.6 8.9V4.72C3.6 2.78 5.55 0.83 7.49 0.83C9.43 0.83 11.38 2.78 11.38 4.72V8.9 M2.46 8.9H11.44C12.21 8.9 12.84 9.53 12.84 10.3V15.9C12.84 16.67 12.21 17.3 11.44 17.3H2.46C1.69 17.3 1.06 16.67 1.06 15.9V10.3C1.06 9.53 1.69 8.9 2.46 8.9Z M12.99 15.1V13.3 M12.99 15.1L14.3 15.9" />
                            <Path Fill="{ThemeResource PageBrush}"
                                  Stroke="{ThemeResource InkBrush}"
                                  StrokeThickness="1.6"
                                  Data="M15.59 15.1C15.59 16.54 14.43 17.7 12.99 17.7C11.55 17.7 10.39 16.54 10.39 15.1C10.39 13.66 11.55 12.5 12.99 12.5C14.43 12.5 15.59 13.66 15.59 15.1Z" />
                        </Grid>
                        <TextBlock VerticalAlignment="Center"
                                   FontFamily="{StaticResource BoldFont}"
                                   FontSize="15"
                                   Foreground="{ThemeResource InkBrush}"
                                   Text="Lock" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
