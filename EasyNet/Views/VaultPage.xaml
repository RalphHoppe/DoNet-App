<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="EasyNet.Views.VaultPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:EasyNet.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        An honest placeholder, not a pretend home: the vault is open, the
        next screens are waiting on their designs, and the one thing this
        page can do for real - lock again - is offered in the glass language
        with the padlock-and-clock icon. When the vault's own screens arrive,
        this page is replaced rather than decorated around.
    -->
    <Grid Background="{ThemeResource PageBrush}">
        <ScrollViewer HorizontalContentAlignment="Center"
                      VerticalContentAlignment="Center"
                      HorizontalScrollMode="Disabled">
            <Border MaxWidth="560"
                    Margin="28,32"
                    Padding="40"
                    CornerRadius="22"
                    Background="{ThemeResource CardBrush}"
                    BorderBrush="{ThemeResource PaperBrush}"
                    BorderThickness="1"
                    Shadow="{StaticResource ElevationShadow}"
                    Translation="0,0,20">
                <StackPanel HorizontalAlignment="Center">
                    <controls:EasyNetMark Mode="Loop" Width="120" />
                    <TextBlock Margin="0,24,0,0"
                               HorizontalAlignment="Center"
                               FontFamily="{StaticResource DisplayFont}"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource TitleBrush}"
                               Text="The vault is open." />
                    <TextBlock Margin="0,8,0,0"
                               HorizontalAlignment="Center"
                               FontFamily="{StaticResource TextFont}"
                               FontSize="14"
                               Foreground="{ThemeResource MetaBrush}"
                               TextWrapping="Wrap"
                               Text="The vault's screens are waiting on their designs - this is a placeholder." />
                    <Button Margin="0,28,0,0"
                            HorizontalAlignment="Center"
                            Height="46"
                            Style="{StaticResource GlassButtonStyle}"
                            Command="{x:Bind ViewModel.LockCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <!--
                                The padlock at rest and time beside it - the
                                clock a stroke-circle with its hand.
                            -->
                            <Viewbox Stretch="Uniform" Width="19" Height="20">
                                <Canvas Width="19" Height="20">
                                    <Path Stroke="{ThemeResource InkSoftBrush}"
                                          StrokeThickness="2"
                                          StrokeLineJoin="Round"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Data="M3.55,8.4 V3.82 A3.79,3.79 0 0 1 10.91,3.82 V8.4" />
                                    <Path Stroke="{ThemeResource InkSoftBrush}"
                                          StrokeThickness="2"
                                          StrokeLineJoin="Round"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Data="M3.27,9.11 H9.16 A2,2 0 0 1 11.16,11.11 V16.72 A2,2 0 0 1 9.16,18.72 H3.27 A2,2 0 0 1 1.27,16.72 V11.11 A2,2 0 0 1 3.27,9.11 Z" />
                                    <Ellipse Canvas.Left="8.24"
                                             Canvas.Top="10.03"
                                             Width="9.5"
                                             Height="9.5"
                                             Stroke="{ThemeResource InkSoftBrush}"
                                             StrokeThickness="2" />
                                    <Path Stroke="{ThemeResource InkSoftBrush}"
                                          StrokeThickness="2"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Data="M12.99,12.62 V14.7 L14.05,15.45" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock VerticalAlignment="Center"
                                       FontFamily="{StaticResource DisplayFont}"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource InkSoftBrush}"
                                       Text="Lock" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</Page>
