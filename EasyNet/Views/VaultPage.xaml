<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="EasyNet.Views.VaultPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:EasyNet.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        The vault's home, from the designer's screen: a grey sidebar panel
        floating on the white page with sixteen of air and rounded corners,
        carrying the brand's small lockup, the WORKSPACE label, the active
        category card in its amber ring, the four category rows, and at the
        bottom the compact-view line and the lock. The main area beside it
        is the next design's to give; it holds one honest sentence until
        then. Every number here is measured from the design's own render,
        recorded in docs/home-screen.md.
    -->

    <Page.Resources>
        <!--
            The home action: the design's own smaller pill - 36 tall, floor
            148, the same anatomy as the lock screen's button at the size
            this screen draws it.
        -->
        <Style x:Key="HomeActionStyle" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="MinWidth" Value="148" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="TabNavigation" Value="Local" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Height="36" MinWidth="148" HorizontalAlignment="Left">
                            <Grid controls:PieceShadow.Mask="ms-appx:///Assets/Shadows/button36.png" />
                            <Border CornerRadius="18"
                                    Background="{ThemeResource PieceFillBrush}">
                                <ContentPresenter Margin="16,0"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Background="{ThemeResource PageBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="296" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- The sidebar: the panel and its sixteen of air on three sides. -->
        <Grid Grid.Column="0" Margin="16,16,0,16">
            <Grid controls:PieceShadow.Mask="ms-appx:///Assets/Shadows/panel.png" />
            <Border CornerRadius="20" Background="{ThemeResource HomePanelBrush}">
                <Grid Padding="20,35,20,26">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- The panel's upper half: brand, label, categories. -->
                    <StackPanel Grid.Row="0">
                        <!--
                            The brand's small lockup: the mark over the
                            wordmark, each centred on the pair's own axis,
                            with WORKSPACE beneath on the same axis - the
                            design places the group nine in from the edge.
                        -->
                        <StackPanel Width="66" Margin="9,0,0,0">
                            <controls:EasyNetMark Mode="Static"
                                                  Width="48"
                                                  HorizontalAlignment="Center" />
                            <controls:EasyNetWordmark Mode="Static"
                                                      Width="66"
                                                      Margin="0,1,0,0" />
                            <TextBlock Margin="0,42,0,0"
                                       HorizontalAlignment="Center"
                                       FontFamily="{StaticResource BoldFont}"
                                       FontSize="11"
                                       CharacterSpacing="150"
                                       Foreground="{ThemeResource InkSoftBrush}"
                                       Text="WORKSPACE" />
                        </StackPanel>

                        <!-- The active category: white, in a hairline amber ring. -->
                        <Grid Width="224" Height="48" Margin="0,24,0,0" HorizontalAlignment="Left">
                            <Grid controls:PieceShadow.Mask="ms-appx:///Assets/Shadows/card.png" />
                            <Border CornerRadius="24"
                                    Background="#FFFFFF"
                                    BorderBrush="{ThemeResource PieceEdgeActiveBrush}"
                                    BorderThickness="2.5">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                                    <Image Width="20"
                                           Height="20"
                                           Stretch="Uniform"
                                           Source="ms-appx:///Assets/Home/characters.png" />
                                    <TextBlock Margin="16,0,0,0"
                                               VerticalAlignment="Center"
                                               FontFamily="{StaticResource BoldFont}"
                                               FontSize="15"
                                               LineHeight="20"
                                               LineStackingStrategy="BlockLineHeight"
                                               Foreground="{ThemeResource InkStrongBrush}"
                                               Text="Characters" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- The categories, each in its own quiet pill. -->
                        <Grid Width="224" Height="35" Margin="0,16,0,0" HorizontalAlignment="Left">
                            <Grid controls:PieceShadow.Mask="ms-appx:///Assets/Shadows/row.png" />
                            <Border CornerRadius="17.5" Background="{ThemeResource PieceFillBrush}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                                    <Image Width="20"
                                           Height="20"
                                           Stretch="Uniform"
                                           Source="ms-appx:///Assets/Home/websites.png" />
                                    <TextBlock Margin="16,0,0,0"
                                               VerticalAlignment="Center"
                                               FontFamily="{StaticResource TextFont}"
                                               FontSize="15"
                                               LineHeight="20"
                                               LineStackingStrategy="BlockLineHeight"
                                               Foreground="{ThemeResource InkSoftBrush}"
                                               Text="Websites" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Width="224" Height="35" Margin="0,21,0,0" HorizontalAlignment="Left">
                            <Grid controls:PieceShadow.Mask="ms-appx:///Assets/Shadows/row.png" />
                            <Border CornerRadius="17.5" Background="{ThemeResource PieceFillBrush}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                                    <Image Width="20"
                                           Height="20"
                                           Stretch="Uniform"
                                           Source="ms-appx:///Assets/Home/accounts.png" />
                                    <TextBlock Margin="16,0,0,0"
                                               VerticalAlignment="Center"
                                               FontFamily="{StaticResource TextFont}"
                                               FontSize="15"
                                               LineHeight="20"
                                               LineStackingStrategy="BlockLineHeight"
                                               Foreground="{ThemeResource InkSoftBrush}"
                                               Text="Accounts" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Width="224" Height="35" Margin="0,21,0,0" HorizontalAlignment="Left">
                            <Grid controls:PieceShadow.Mask="ms-appx:///Assets/Shadows/row.png" />
                            <Border CornerRadius="17.5" Background="{ThemeResource PieceFillBrush}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                                    <Image Width="20"
                                           Height="20"
                                           Stretch="Uniform"
                                           Source="ms-appx:///Assets/Home/wallets.png" />
                                    <TextBlock Margin="16,0,0,0"
                                               VerticalAlignment="Center"
                                               FontFamily="{StaticResource TextFont}"
                                               FontSize="15"
                                               LineHeight="20"
                                               LineStackingStrategy="BlockLineHeight"
                                               Foreground="{ThemeResource InkSoftBrush}"
                                               Text="Wallets" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Width="224" Height="35" Margin="0,21,0,0" HorizontalAlignment="Left">
                            <Grid controls:PieceShadow.Mask="ms-appx:///Assets/Shadows/row.png" />
                            <Border CornerRadius="17.5" Background="{ThemeResource PieceFillBrush}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                                    <Image Width="20"
                                           Height="20"
                                           Stretch="Uniform"
                                           Source="ms-appx:///Assets/Home/services.png" />
                                    <TextBlock Margin="16,0,0,0"
                                               VerticalAlignment="Center"
                                               FontFamily="{StaticResource TextFont}"
                                               FontSize="15"
                                               LineHeight="20"
                                               LineStackingStrategy="BlockLineHeight"
                                               Foreground="{ThemeResource InkSoftBrush}"
                                               Text="Services" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <!-- The panel's foot: the compact-view line and the lock. -->
                    <StackPanel Grid.Row="2">
                        <Grid Width="224">
                            <TextBlock VerticalAlignment="Center"
                                       FontFamily="{StaticResource TextFont}"
                                       FontSize="13"
                                       Foreground="{ThemeResource InkSoftBrush}"
                                       Text="Compact view" />
                            <Image Width="5"
                                   Height="8"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Source="ms-appx:///Assets/Home/chevron.png" />
                        </Grid>

                        <Button Margin="0,45,0,0"
                                HorizontalAlignment="Left"
                                Style="{StaticResource HomeActionStyle}"
                                Command="{x:Bind ViewModel.LockCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Grid Width="20" Height="20" VerticalAlignment="Center">
                                    <!-- The design's closed padlock, verbatim. -->
                                    <Path HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Fill="{ThemeResource InkBrush}"
                                          Opacity="0.9"
                                          Data="F0M 3.12 8.35 L 2.81 5.51 C 2.77 5.15 2.77 4.78 2.81 4.42 L 2.83 4.21 C 3.07 2.04 4.78 0.32 6.95 0.07 C 7.32 0.02 7.68 0.02 8.05 0.07 C 10.22 0.32 11.93 2.04 12.17 4.21 L 12.19 4.42 C 12.23 4.78 12.23 5.15 12.19 5.51 L 11.88 8.35 L 12.56 8.41 C 13.65 8.49 14.53 9.31 14.71 10.38 C 15.07 12.62 15.07 14.9 14.71 17.13 C 14.53 18.2 13.65 19.02 12.56 19.1 L 11.07 19.22 C 8.69 19.41 6.31 19.41 3.93 19.22 L 2.44 19.1 C 1.35 19.02 0.47 18.2 0.29 17.13 C -0.07 14.9 -0.07 12.62 0.29 10.38 C 0.47 9.31 1.35 8.49 2.44 8.41 L 3.12 8.35 Z M 7.13 1.56 C 7.37 1.53 7.62 1.53 7.87 1.56 C 9.35 1.73 10.52 2.9 10.68 4.38 L 10.7 4.58 C 10.73 4.84 10.73 5.09 10.7 5.35 L 10.38 8.24 C 8.46 8.12 6.54 8.12 4.62 8.24 L 4.3 5.35 C 4.27 5.09 4.27 4.84 4.3 4.58 L 4.32 4.38 C 4.48 2.9 5.65 1.73 7.13 1.56 Z M 10.95 9.78 C 8.65 9.6 6.35 9.6 4.05 9.78 L 2.55 9.9 C 2.16 9.94 1.84 10.23 1.77 10.62 C 1.43 12.7 1.43 14.81 1.77 16.89 C 1.84 17.28 2.16 17.58 2.55 17.61 L 4.05 17.73 C 6.35 17.91 8.65 17.91 10.95 17.73 L 12.44 17.61 C 12.84 17.58 13.16 17.28 13.23 16.89 C 13.57 14.81 13.57 12.7 13.23 10.62 C 13.16 10.23 12.84 9.94 12.44 9.9 L 10.95 9.78 Z M 7.5 12.26 C 6.67 12.26 6 12.93 6 13.76 C 6 14.58 6.67 15.26 7.5 15.26 C 8.33 15.26 9 14.58 9 13.76 C 9 12.93 8.33 12.26 7.5 12.26 Z" />
                                </Grid>
                                <TextBlock VerticalAlignment="Center"
                                           FontFamily="{StaticResource BoldFont}"
                                           FontSize="15"
                                           LineHeight="20"
                                           LineStackingStrategy="BlockLineHeight"
                                           Foreground="{ThemeResource InkBrush}"
                                           Text="Lock" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- The main area: the next design's to give. -->
        <StackPanel Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
            <TextBlock HorizontalAlignment="Center"
                       FontFamily="{StaticResource ExtraBoldFont}"
                       FontSize="25"
                       LineHeight="32"
                       LineStackingStrategy="BlockLineHeight"
                       Foreground="{ThemeResource InkStrongBrush}"
                       Text="The vault is open." />
            <TextBlock Margin="0,6,0,0"
                       HorizontalAlignment="Center"
                       FontFamily="{StaticResource TextFont}"
                       FontSize="14"
                       LineHeight="20"
                       LineStackingStrategy="BlockLineHeight"
                       Foreground="{ThemeResource InkSoftBrush}"
                       Text="Its screens are waiting on their designs." />
        </StackPanel>
    </Grid>
</Page>
