<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="EasyNet.Views.VaultPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:EasyNet.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        An honest placeholder, not a pretend home: the vault is open, the
        next screens are waiting on their designs, and the one thing this
        page can do for real - lock again - is offered plainly. When the
        vault's own screens arrive, this page is replaced rather than
        decorated around.
    -->
    <Grid Background="{ThemeResource PaperBrush}">
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="12">
            <controls:EasyNetMark Mode="Loop" Width="170" />
            <TextBlock Margin="0,26,0,0"
                       HorizontalAlignment="Center"
                       FontFamily="{StaticResource DisplayFont}"
                       FontSize="32"
                       FontWeight="SemiBold"
                       Foreground="{ThemeResource TitleBrush}"
                       Text="The vault is open." />
            <TextBlock HorizontalAlignment="Center"
                       FontFamily="{StaticResource TextFont}"
                       FontSize="16"
                       Foreground="{ThemeResource MetaBrush}"
                       Text="The vault's screens are waiting on their designs - this is a placeholder." />
            <Button Margin="0,40,0,0"
                    HorizontalAlignment="Center"
                    MinWidth="0"
                    MinHeight="0"
                    Padding="12,6"
                    CornerRadius="10"
                    Command="{x:Bind ViewModel.LockCommand}">
                <Button.Resources>
                    <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#F2F3F5" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#E9EAEE" />
                    <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                </Button.Resources>
                <TextBlock FontFamily="{StaticResource TextFont}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource MetaBrush}"
                           Text="Lock" />
            </Button>
        </StackPanel>
    </Grid>
</Page>
