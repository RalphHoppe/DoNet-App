                            </Grid>
                        <TextBlock VerticalAlignment="Center"
                                   FontFamily="{StaticResource BoldFont}"
                                   FontSize="15"
                                   Foreground="{ThemeResource InkBrush}"
                                   Text="Lock" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
