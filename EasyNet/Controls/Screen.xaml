<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="EasyNet.Controls.Screen"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        The design's screen scaffold: a white page that centres its content,
        gives it the design's outer padding (26 all sides) and stops it
        growing at the design's content maximum (767 plus the padding).
        When the window is too short for the content, the centring hands
        over to scrolling so nothing is ever clipped out of reach - the
        handoff's rule for short viewports.
    -->
    <Grid Background="{ThemeResource PageBrush}">
        <ScrollViewer x:Name="Scroll"
                      HorizontalScrollMode="Disabled"
                      VerticalScrollMode="Auto"
                      VerticalScrollBarVisibility="Auto">

            <!--
                The fitter: never shorter than the viewport. Content that
                fits centres inside it; content that does not grows it, and
                so stays within the scroller's reach. A centred child taller
                than the viewport is the one thing a ScrollViewer otherwise
                clips with no way back - the top and the bottom of the
                composition both vanish, which is exactly what it did the
                day this wrapper was rebuilt around a measured screenshot.
            -->
            <Grid MinHeight="{x:Bind Scroll.ViewportHeight, Mode=OneWay}">

                <!--
                    The host: the viewport's own width until the design's
                    content maximum, then capped and centred - fill up to
                    the cap, centre beyond it. The width is bound rather
                    than stretched because a stretch-capped element hugs
                    the left of its slot, and the composition should not
                    care how wide the window happens to be.
                -->
                <Grid x:Name="Host"
                      Width="{x:Bind Scroll.ViewportWidth, Mode=OneWay}"
                      MaxWidth="819"
                      Padding="26"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center">
                    <ContentPresenter Content="{x:Bind Content, Mode=OneWay}" />
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
