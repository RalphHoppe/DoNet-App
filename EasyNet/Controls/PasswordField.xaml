<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="EasyNet.Controls.PasswordField"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:EasyNet.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        The design's labeled field, per its handoff: the label in Bold 14/20
        above, 8 of air, then the control row - the padlock in its own white
        round, the word in its own white pill that takes the remaining
        width (never less than 180), the eye in its own white round - 52 px
        tall, 10 px of air between, each wearing the inset 5.5 ring and
        floating on the one shadow. The pill's corners sit a little under
        the full half-height round of the circles - a little less round,
        just enough to tell a capsule from a circle. The icons are the design's own vectors,
        verbatim, each centred in a 20 x 20 container.
    -->
    <UserControl.Resources>
        <!--
            The stock PasswordBox brings its own box: a background, a border,
            an accent underline on focus. These have to be resource overrides
            rather than properties on the control, because the default
            template re-applies its own brushes from the visual states on
            hover and focus, which would beat any local value.
        -->
        <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="Transparent" />

        <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="Transparent" />

        <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
        <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
        <Thickness x:Key="TextControlThemePadding">0</Thickness>
        <x:Double x:Key="TextControlThemeMinHeight">0</x:Double>
        <x:Double x:Key="TextControlThemeMinWidth">0</x:Double>

        <SolidColorBrush x:Key="TextControlForeground" Color="#424349" />
        <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#424349" />
        <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#424349" />

        <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#74757A" />
        <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#74757A" />
        <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#74757A" />
    </UserControl.Resources>

    <StackPanel>
        <VisualStateManager.VisualStateGroups>
            <!-- Focus leans the pill's ring one step louder. -->
            <VisualStateGroup x:Name="FocusStates">
                <VisualState x:Name="Resting" />
                <VisualState x:Name="Focused">
                    <VisualState.Setters>
                        <Setter Target="FieldFrame.BorderBrush" Value="{ThemeResource PieceEdgeFocusedBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            <!-- A refused word turns the rings to ink: quiet, but unmistakable. -->
            <VisualStateGroup x:Name="ValidityStates">
                <VisualState x:Name="Valid" />
                <VisualState x:Name="Invalid">
                    <VisualState.Setters>
                        <Setter Target="FieldFrame.BorderBrush" Value="{ThemeResource PieceEdgeInvalidBrush}" />
                        <Setter Target="IconFrame.BorderBrush" Value="{ThemeResource PieceEdgeInvalidBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            <!-- The eye goes ink while the word shows. -->
            <VisualStateGroup x:Name="RevealStates">
                <VisualState x:Name="Hid" />
                <VisualState x:Name="Shown">
                    <VisualState.Setters>
                        <Setter Target="EyePath.Stroke" Value="{ThemeResource InkBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!--
            The label, above the pill's left edge (the round sits left of
            it). A field with no label - the create screen's second field -
            collapses the line and its gap entirely.
        -->
        <TextBlock x:Name="LabelLine"
                   FontFamily="{StaticResource BoldFont}"
                   FontSize="14"
                   LineHeight="20"
                   LineStackingStrategy="BlockLineHeight"
                   Foreground="{ThemeResource InkBrush}"
                   Text="{x:Bind Label, Mode=OneWay}" />

        <!-- The control row: 52 + 10 + input (fill, min 180) + 10 + 52. -->
        <Grid x:Name="Row"
              MinWidth="304"
              Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="52" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="52" />
            </Grid.ColumnDefinitions>

            <!-- The padlock, in its own round. -->
            <Grid Grid.Column="0" Width="52" Height="52">
                <Grid controls:PieceShadow.Mask="ms-appx:///Assets/Shadows/circle52.png" />
                <Border x:Name="IconFrame"
                        CornerRadius="26"
                        Background="{ThemeResource PieceFillBrush}"
                        BorderBrush="{ThemeResource PieceEdgeBrush}"
                        BorderThickness="5.5"
                        IsHitTestVisible="False">
                    <Grid Width="20" Height="20">
                        <!--
                            The design's closed padlock, verbatim: its masked
                            stroke resolved back to the shapes that actually
                            print - shackle band, body band, keyhole dot.
                        -->
                        <Path HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Fill="{ThemeResource InkBrush}"
                              Opacity="0.9"
                              Data="F0M 3.12 8.35 L 2.81 5.51 C 2.77 5.15 2.77 4.78 2.81 4.42 L 2.83 4.21 C 3.07 2.04 4.78 0.32 6.95 0.07 C 7.32 0.02 7.68 0.02 8.05 0.07 C 10.22 0.32 11.93 2.04 12.17 4.21 L 12.19 4.42 C 12.23 4.78 12.23 5.15 12.19 5.51 L 11.88 8.35 L 12.56 8.41 C 13.65 8.49 14.53 9.31 14.71 10.38 C 15.07 12.62 15.07 14.9 14.71 17.13 C 14.53 18.2 13.65 19.02 12.56 19.1 L 11.07 19.22 C 8.69 19.41 6.31 19.41 3.93 19.22 L 2.44 19.1 C 1.35 19.02 0.47 18.2 0.29 17.13 C -0.07 14.9 -0.07 12.62 0.29 10.38 C 0.47 9.31 1.35 8.49 2.44 8.41 L 3.12 8.35 Z M 7.13 1.56 C 7.37 1.53 7.62 1.53 7.87 1.56 C 9.35 1.73 10.52 2.9 10.68 4.38 L 10.7 4.58 C 10.73 4.84 10.73 5.09 10.7 5.35 L 10.38 8.24 C 8.46 8.12 6.54 8.12 4.62 8.24 L 4.3 5.35 C 4.27 5.09 4.27 4.84 4.3 4.58 L 4.32 4.38 C 4.48 2.9 5.65 1.73 7.13 1.56 Z M 10.95 9.78 C 8.65 9.6 6.35 9.6 4.05 9.78 L 2.55 9.9 C 2.16 9.94 1.84 10.23 1.77 10.62 C 1.43 12.7 1.43 14.81 1.77 16.89 C 1.84 17.28 2.16 17.58 2.55 17.61 L 4.05 17.73 C 6.35 17.91 8.65 17.91 10.95 17.73 L 12.44 17.61 C 12.84 17.58 13.16 17.28 13.23 16.89 C 13.57 14.81 13.57 12.7 13.23 10.62 C 13.16 10.23 12.84 9.94 12.44 9.9 L 10.95 9.78 Z M 7.5 12.26 C 6.67 12.26 6 12.93 6 13.76 C 6 14.58 6.67 15.26 7.5 15.26 C 8.33 15.26 9 14.58 9 13.76 C 9 12.93 8.33 12.26 7.5 12.26 Z" />
                    </Grid>
                </Border>
            </Grid>

            <!-- The word, in its own pill: the piece that stretches. -->
            <Grid Grid.Column="2" MinWidth="180">
                <Grid controls:PieceShadow.Mask="ms-appx:///Assets/Shadows/pill52.png" />
                <Border x:Name="FieldFrame"
                        Height="52"
                        CornerRadius="22"
                        Background="{ThemeResource PieceFillBrush}"
                        BorderBrush="{ThemeResource PieceEdgeBrush}"
                        BorderThickness="5.5">
                    <!--
                        18 of air from the surface's outer edge; the ring is
                        an inset, so it must not eat into that padding.
                    -->
                    <PasswordBox x:Name="Input"
                                 VerticalAlignment="Center"
                                 Margin="12.5,0"
                                 FontFamily="{StaticResource TextFont}"
                                 FontSize="15"
                                 PasswordRevealMode="Hidden"
                                 PasswordChanged="OnInputPasswordChanged"
                                 GotFocus="OnInputFocusChanged"
                                 LostFocus="OnInputFocusChanged"
                                 KeyDown="OnInputKeyDown" />
                </Border>
            </Grid>

            <!-- The eye, in its own round: a ghost button over the drawn piece. -->
            <Grid Grid.Column="4" Width="52" Height="52">
                <Grid controls:PieceShadow.Mask="ms-appx:///Assets/Shadows/circle52.png" />
                <Border CornerRadius="26"
                        Background="{ThemeResource PieceFillBrush}"
                        BorderBrush="{ThemeResource PieceEdgeBrush}"
                        BorderThickness="5.5"
                        IsHitTestVisible="False">
                    <Grid Width="20" Height="20">
                        <!-- The design's eye, verbatim: outline and iris, stroked. -->
                        <Path x:Name="EyePath"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Stroke="{ThemeResource InkSoftBrush}"
                              StrokeThickness="1.7"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Data="M0.05 6.12C-0.02 5.94 -0.02 5.73 0.05 5.54C0.73 3.9 1.88 2.5 3.35 1.51C4.82 0.53 6.56 0 8.33 0C10.11 0 11.84 0.53 13.32 1.51C14.79 2.5 15.94 3.9 16.61 5.54C16.68 5.73 16.68 5.94 16.61 6.12C15.94 7.76 14.79 9.16 13.32 10.15C11.84 11.14 10.11 11.67 8.33 11.67C6.56 11.67 4.82 11.14 3.35 10.15C1.88 9.16 0.73 7.76 0.05 6.12Z M10.83 5.83C10.83 7.21 9.71 8.33 8.33 8.33C6.95 8.33 5.83 7.21 5.83 5.83C5.83 4.45 6.95 3.33 8.33 3.33C9.71 3.33 10.83 4.45 10.83 5.83Z" />
                    </Grid>
                </Border>
                <Button x:Name="RevealToggle"
                        Width="52"
                        Height="52"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Padding="0"
                        TabIndex="1"
                        Background="Transparent"
                        BorderThickness="0"
                        Style="{StaticResource GhostButtonStyle}"
                        Click="OnRevealToggleClick" />
            </Grid>
        </Grid>
    </StackPanel>
</UserControl>
