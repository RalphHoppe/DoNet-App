<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="EasyNet.Controls.PasswordField"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        The design's field is three pieces that never touch: the padlock in
        its own glass round, the word in its own glass pill, the eye in its
        own glass round - a row of separate objects, not one boxed input.
        Focus warms the padlock to the brand gradient; a refused word turns
        the padlock and the pill's edge red.
    -->
    <UserControl.Resources>
        <!--
            The stock PasswordBox brings its own box: a background, a border,
            an accent underline on focus. These have to be resource overrides
            rather than properties on the control, because the default
            template re-applies its own brushes from the visual states on
            hover and focus, which would beat any local value.
        -->
        <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="Transparent" />

        <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="Transparent" />

        <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
        <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
        <Thickness x:Key="TextControlThemePadding">0</Thickness>
        <x:Double x:Key="TextControlThemeMinHeight">0</x:Double>
        <x:Double x:Key="TextControlThemeMinWidth">0</x:Double>

        <SolidColorBrush x:Key="TextControlForeground" Color="#1D212C" />
        <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#1D212C" />
        <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#1D212C" />

        <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#74757A" />
        <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#74757A" />
        <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#74757A" />
    </UserControl.Resources>

    <Grid MinHeight="46"
          ColumnSpacing="8">

        <VisualStateManager.VisualStateGroups>
            <!-- The padlock's colour follows the field's life. -->
            <VisualStateGroup x:Name="FocusStates">
                <VisualState x:Name="Resting" />
                <VisualState x:Name="Focused">
                    <VisualState.Setters>
                        <Setter Target="LockShackle.Stroke" Value="{ThemeResource BrandBrush}" />
                        <Setter Target="LockBody.Stroke" Value="{ThemeResource BrandBrush}" />
                        <Setter Target="LockDot.Stroke" Value="{ThemeResource BrandBrush}" />
                        <Setter Target="IconFrame.BorderBrush" Value="{StaticResource GlassEdgeHoverBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup x:Name="ValidityStates">
                <VisualState x:Name="Valid" />
                <VisualState x:Name="Invalid">
                    <VisualState.Setters>
                        <Setter Target="LockShackle.Stroke" Value="{ThemeResource DangerBrush}" />
                        <Setter Target="LockBody.Stroke" Value="{ThemeResource DangerBrush}" />
                        <Setter Target="LockDot.Stroke" Value="{ThemeResource DangerBrush}" />
                        <Setter Target="FieldFrame.BorderBrush" Value="{ThemeResource DangerBrush}" />
                        <Setter Target="IconFrame.BorderBrush" Value="{ThemeResource DangerBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup x:Name="RevealStates">
                <VisualState x:Name="Hid" />
                <VisualState x:Name="Shown">
                    <VisualState.Setters>
                        <Setter Target="EyePath.Stroke" Value="{ThemeResource InkSoftBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!--
            The padlock, in its own glass round: the design's own 15x20 icon,
            redrawn as strokes on its own canvas - the shackle's arch, the
            rounded body, the keyhole dot - and scaled by a Viewbox so the
            stroke weight scales with it.
        -->
        <Border x:Name="IconFrame"
                Grid.Column="0"
                Width="46"
                Height="46"
                CornerRadius="999"
                Background="{StaticResource GlassFillBrush}"
                BorderBrush="{StaticResource GlassEdgeBrush}"
                BorderThickness="1"
                Padding="2"
                IsHitTestVisible="False">
            <Border CornerRadius="999" Background="{ThemeResource PaperBrush}">
                <Viewbox Stretch="Uniform" Width="20" Height="26">
                    <Canvas Width="15" Height="20">
                        <Path x:Name="LockShackle"
                              Stroke="{ThemeResource InkSoftBrush}"
                              StrokeThickness="2"
                              StrokeLineJoin="Round"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Data="M3.54,9.4 V4.73 A3.95,3.95 0 0 1 11.43,4.73 V9.4" />
                        <Path x:Name="LockBody"
                              Stroke="{ThemeResource InkSoftBrush}"
                              StrokeThickness="2"
                              StrokeLineJoin="Round"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Data="M3.27,9.15 H11.69 A2,2 0 0 1 13.69,11.15 V16.46 A2,2 0 0 1 11.69,18.46 H3.27 A2,2 0 0 1 1.27,16.46 V11.15 A2,2 0 0 1 3.27,9.15 Z" />
                        <Ellipse x:Name="LockDot"
                                 Canvas.Left="5.98"
                                 Canvas.Top="12.22"
                                 Width="3"
                                 Height="3"
                                 Stroke="{ThemeResource InkSoftBrush}"
                                 StrokeThickness="2" />
                    </Canvas>
                </Viewbox>
            </Border>
        </Border>

        <!--
            The word, in its own glass pill. A natural-height box centered in
            the white core, which is how its text ends up vertically centered:
            stretching the box and centering its content does not work, and
            this way around never has to.
        -->
        <Border x:Name="FieldFrame"
                Grid.Column="1"
                Height="46"
                CornerRadius="999"
                Background="{StaticResource GlassFillBrush}"
                BorderBrush="{StaticResource GlassEdgeBrush}"
                BorderThickness="1"
                Padding="2">
            <Border CornerRadius="999" Background="{ThemeResource PaperBrush}">
                <PasswordBox x:Name="Input"
                             VerticalAlignment="Center"
                             Margin="16,0"
                             BorderThickness="0"
                             Background="Transparent"
                             Padding="0"
                             MinHeight="0"
                             FontFamily="{StaticResource TextFont}"
                             FontSize="16"
                             PasswordRevealMode="Hidden"
                             PasswordChanged="OnInputPasswordChanged"
                             GotFocus="OnInputFocusChanged"
                             LostFocus="OnInputFocusChanged"
                             KeyDown="OnInputKeyDown" />
            </Border>
        </Border>

        <!--
            The eye, in its own glass round: the design's own 19x14 icon,
            the quiet grey while the word is hidden and the ink once it shows.
        -->
        <Button x:Name="RevealToggle"
                Grid.Column="2"
                Width="46"
                Height="46"
                Padding="0"
                TabIndex="1"
                Style="{StaticResource GlassButtonStyle}"
                Click="OnRevealToggleClick">
            <Viewbox Stretch="Uniform" Width="24" Height="18">
                <Canvas Width="19" Height="14">
                    <Path x:Name="EyePath"
                          Stroke="{ThemeResource MetaBrush}"
                          StrokeThickness="1.7"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          Data="M0.902063 6.97283C0.832613 6.78573 0.832613 6.57992 0.902063 6.39283C1.57848 4.7527 2.72666 3.35036 4.20104 2.36357C5.67542 1.37679 7.4096 0.850006 9.18373 0.850006C10.9579 0.850006 12.692 1.37679 14.1664 2.36357C15.6408 3.35036 16.789 4.7527 17.4654 6.39283C17.5348 6.57992 17.5348 6.78573 17.4654 6.97283C16.789 8.61295 15.6408 10.0153 14.1664 11.0021C12.692 11.9889 10.9579 12.5156 9.18373 12.5156C7.4096 12.5156 5.67542 11.9889 4.20104 11.0021C2.72666 10.0153 1.57848 8.61295 0.902063 6.97283ZM11.6841 6.68253C11.6841 8.06324 10.5648 9.18253 9.18412 9.18253C7.80341 9.18253 6.68412 8.06324 6.68412 6.68253C6.68412 5.30181 7.80341 4.18253 9.18412 4.18253C10.5648 4.18253 11.6841 5.30181 11.6841 6.68253Z" />
                </Canvas>
            </Viewbox>
        </Button>
    </Grid>
</UserControl>
