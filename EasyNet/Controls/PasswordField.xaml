<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="EasyNet.Controls.PasswordField"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        The design's field is no box at all: an outlined padlock, then the
        word, then a circular toggle - all resting on the paper, with nothing
        drawn around them. Focus is the padlock warming to the brand gradient;
        error is it going red. There is deliberately no underline and no
        border, which is what the mockups show.
    -->
    <UserControl.Resources>
        <!--
            The stock PasswordBox brings its own box: a background, a border,
            an accent underline on focus. These have to be resource overrides
            rather than properties on the control, because the default
            template re-applies its own brushes from the visual states on
            hover and focus, which would beat any local value.
        -->
        <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="Transparent" />

        <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="Transparent" />

        <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
        <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
        <Thickness x:Key="TextControlThemePadding">0</Thickness>
        <x:Double x:Key="TextControlThemeMinHeight">0</x:Double>
        <x:Double x:Key="TextControlThemeMinWidth">0</x:Double>

        <SolidColorBrush x:Key="TextControlForeground" Color="#1D212C" />
        <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#1D212C" />
        <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#1D212C" />

        <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#74757A" />
        <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#74757A" />
        <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#74757A" />
    </UserControl.Resources>

    <Grid MinHeight="64"
          ColumnSpacing="18">

        <VisualStateManager.VisualStateGroups>
            <!-- The padlock's colour follows the field's life. -->
            <VisualStateGroup x:Name="FocusStates">
                <VisualState x:Name="Resting" />
                <VisualState x:Name="Focused">
                    <VisualState.Setters>
                        <Setter Target="LockShackle.Stroke" Value="{ThemeResource BrandBrush}" />
                        <Setter Target="LockGlyph.Stroke" Value="{ThemeResource BrandBrush}" />
                        <Setter Target="LockKeyhole.Stroke" Value="{ThemeResource BrandBrush}" />
                        <Setter Target="LockKeyholeBow.Stroke" Value="{ThemeResource BrandBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup x:Name="ValidityStates">
                <VisualState x:Name="Valid" />
                <VisualState x:Name="Invalid">
                    <VisualState.Setters>
                        <Setter Target="LockShackle.Stroke" Value="{ThemeResource DangerBrush}" />
                        <Setter Target="LockGlyph.Stroke" Value="{ThemeResource DangerBrush}" />
                        <Setter Target="LockKeyhole.Stroke" Value="{ThemeResource DangerBrush}" />
                        <Setter Target="LockKeyholeBow.Stroke" Value="{ThemeResource DangerBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup x:Name="RevealStates">
                <VisualState x:Name="Hid" />
                <VisualState x:Name="Shown">
                    <VisualState.Setters>
                        <Setter Target="RevealRing.Stroke" Value="{ThemeResource InkSoftBrush}" />
                        <Setter Target="RevealKeyholeStem.Stroke" Value="{ThemeResource InkSoftBrush}" />
                        <Setter Target="RevealKeyholeBow.Stroke" Value="{ThemeResource InkSoftBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!--
            The outlined padlock, drawn on a fixed 46x40 canvas so its
            coordinates are its own and its weight matches the mockups'
            measured strokes. The keyhole says what the field keeps.
        -->
        <Canvas Grid.Column="0"
                Width="46"
                Height="40"
                VerticalAlignment="Center">
            <Path x:Name="LockShackle"
                  Stroke="{ThemeResource InkSoftBrush}"
                  StrokeThickness="2.6"
                  StrokeLineJoin="Round"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  Data="M15,19 V12.5 A8,8 0 0 1 31,12.5 V19" />
            <Path x:Name="LockGlyph"
                  Stroke="{ThemeResource InkSoftBrush}"
                  StrokeThickness="2.6"
                  StrokeLineJoin="Round"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  Data="M9,19 H37 A5,5 0 0 1 42,24 V33 A5,5 0 0 1 37,38 H9 A5,5 0 0 1 4,33 V24 A5,5 0 0 1 9,19 Z" />
            <Path x:Name="LockKeyhole"
                  Stroke="{ThemeResource InkSoftBrush}"
                  StrokeThickness="2.2"
                  StrokeLineJoin="Round"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  Data="M23,25.5 V31" />
            <Ellipse x:Name="LockKeyholeBow"
                     Canvas.Left="19.4"
                     Canvas.Top="21.6"
                     Width="7.2"
                     Height="7.2"
                     Stroke="{ThemeResource InkSoftBrush}"
                     StrokeThickness="2.2" />
        </Canvas>

        <!--
            The word itself. A natural-height box centered in the row, which
            is how its text ends up vertically centered: stretching the box
            and centering its content does not work, and this way around
            never has to.
        -->
        <PasswordBox x:Name="Input"
                     Grid.Column="1"
                     VerticalAlignment="Center"
                     BorderThickness="0"
                     Background="Transparent"
                     Padding="0"
                     MinHeight="0"
                     FontFamily="{StaticResource TextFont}"
                     FontSize="20"
                     PasswordRevealMode="Hidden"
                     PasswordChanged="OnInputPasswordChanged"
                     GotFocus="OnInputFocusChanged"
                     LostFocus="OnInputFocusChanged"
                     KeyDown="OnInputKeyDown" />

        <!--
            The reveal: a keyhole in a circle. Hidden is the resting state;
            the keyhole turns when the word shows. A circle of forty keeps a
            comfortable pointer target around the drawn thirty-two.
        -->
        <Button x:Name="RevealToggle"
                Grid.Column="2"
                Width="40"
                Height="40"
                VerticalAlignment="Center"
                TabIndex="1"
                Click="OnRevealToggleClick">
            <Button.Resources>
                <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#F2F3F5" />
                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#E9EAEE" />
                <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
                <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
            </Button.Resources>
            <Canvas Width="32"
                    Height="32"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
                <Ellipse x:Name="RevealRing"
                         Canvas.Left="1.5"
                         Canvas.Top="1.5"
                         Width="29"
                         Height="29"
                         Stroke="{ThemeResource MetaBrush}"
                         StrokeThickness="1.8" />
                <Path x:Name="RevealKeyholeStem"
                      Stroke="{ThemeResource MetaBrush}"
                      StrokeThickness="2"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      Data="M16,14.5 V19.5" />
                <Ellipse x:Name="RevealKeyholeBow"
                         Canvas.Left="12.8"
                         Canvas.Top="9.8"
                         Width="6.4"
                         Height="6.4"
                         Stroke="{ThemeResource MetaBrush}"
                         StrokeThickness="2" />
            </Canvas>
        </Button>
    </Grid>
</UserControl>
