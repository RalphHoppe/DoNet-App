<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="EasyNet.Controls.AuthCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:EasyNet.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        The floating card every entry screen lives on: a near-white plate,
        shadowed just enough to sit above the page, centred when there is
        room and scrolled when there is not. The brand sits beside the form
        when the card is wide and above it when the card is narrow - one
        skeleton, two postures, chosen by the width the window actually has.
    -->
    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="WidthStates">
                <VisualState x:Name="WideState">
                    <VisualState.Setters>
                        <Setter Target="Brand.(Grid.Row)" Value="0" />
                        <Setter Target="Brand.(Grid.Column)" Value="0" />
                        <Setter Target="Brand.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="FormHost.(Grid.Row)" Value="0" />
                        <Setter Target="FormHost.(Grid.Column)" Value="2" />
                        <Setter Target="FormHost.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="CardMark.Width" Value="104" />
                        <Setter Target="CardWord.Width" Value="150" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="NarrowState">
                    <VisualState.Setters>
                        <Setter Target="Brand.(Grid.RowSpan)" Value="1" />
                        <Setter Target="Brand.(Grid.ColumnSpan)" Value="3" />
                        <Setter Target="Brand.HorizontalAlignment" Value="Center" />
                        <Setter Target="FormHost.(Grid.Row)" Value="2" />
                        <Setter Target="FormHost.(Grid.Column)" Value="0" />
                        <Setter Target="FormHost.(Grid.ColumnSpan)" Value="3" />
                        <Setter Target="CardMark.Width" Value="76" />
                        <Setter Target="CardWord.Width" Value="110" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <ScrollViewer HorizontalContentAlignment="Center"
                      VerticalContentAlignment="Center"
                      HorizontalScrollMode="Disabled">
            <Border x:Name="Card"
                    MaxWidth="620"
                    Margin="28,32"
                    Padding="38"
                    CornerRadius="22"
                    Background="{ThemeResource CardBrush}"
                    BorderBrush="{ThemeResource PaperBrush}"
                    BorderThickness="1"
                    Shadow="{StaticResource ElevationShadow}"
                    Translation="0,0,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="28" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- The brand: settled, at the card's own scale. -->
                    <StackPanel x:Name="Brand"
                                Grid.Row="0"
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Spacing="8">
                        <controls:EasyNetMark x:Name="CardMark" Mode="Static" Width="104" />
                        <controls:EasyNetWordmark x:Name="CardWord" Mode="Static" Width="150" />
                    </StackPanel>

                    <!-- The screen's form, handed in by whichever page this card serves. -->
                    <ContentPresenter x:Name="FormHost"
                                      Grid.Row="0"
                                      Grid.Column="2"
                                      Content="{x:Bind FormContent, Mode=OneWay}" />
                </Grid>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
