<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="EasyNet.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:EasyNet.Controls"
    xmlns:converters="using:EasyNet.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                The design's tokens, from its handoff. The page is plain
                white; the interactive pieces are white at four fifths,
                each wearing an inset ring of a grey so quiet it only says
                "here is an edge", and each lifted by the one shadow recipe
                (see PieceShadow). The inks are a four-step scale.
            -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="PageBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="PieceFillBrush" Color="#CCFFFFFF" />
                    <SolidColorBrush x:Key="PieceEdgeBrush" Color="#33EAE9E9" />
                    <SolidColorBrush x:Key="PieceEdgeFocusedBrush" Color="#66EAE9E9" />
                    <SolidColorBrush x:Key="PieceEdgeInvalidBrush" Color="#4D303138" />
                    <SolidColorBrush x:Key="InkStrongBrush" Color="#303138" />
                    <SolidColorBrush x:Key="InkBrush" Color="#424349" />
                    <SolidColorBrush x:Key="CloseBrush" Color="#494242" />
                    <SolidColorBrush x:Key="InkSoftBrush" Color="#74757A" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!--
                The brand gradient, in the SVGs' own direction: top-right
                amber to bottom-left orange. Elements that need it in their
                own local coordinates (the wordmark's letters) declare their
                own copy; this one is for everything else.
            -->
            <LinearGradientBrush x:Key="BrandBrush" StartPoint="1,0" EndPoint="0,1">
                <GradientStop Color="#FCBD2E" Offset="0" />
                <GradientStop Color="#F26A17" Offset="1" />
            </LinearGradientBrush>

            <!--
                Nunito, per weight, each loaded from its own file so the
                weight never depends on a matcher. The design's measured
                type scale: headings ExtraBold 25/32, supporting lines
                Regular 14/20, labels Bold 14/20, the word and buttons
                Regular/Bold 15.
            -->
            <FontFamily x:Key="TextFont">ms-appx:///Assets/Fonts/Nunito-Regular.ttf#Nunito</FontFamily>
            <FontFamily x:Key="BoldFont">ms-appx:///Assets/Fonts/Nunito-Bold.ttf#Nunito</FontFamily>
            <FontFamily x:Key="ExtraBoldFont">ms-appx:///Assets/Fonts/Nunito-ExtraBold.ttf#Nunito</FontFamily>

            <!--
                A ghost button: no chrome at all, just its content. Used
                where the piece around the button is the visible thing - the
                eye inside its round - so the button itself must be nothing.
                The template still carries the control's own Background as
                its hit area: an element with no background is not hit
                testable, and a ghost with nothing to click is just a
                decoration that lies about being a button.
            -->
            <Style x:Key="GhostButtonStyle" TargetType="Button">
                <Setter Property="Padding" Value="0" />
                <Setter Property="UseSystemFocusVisuals" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid Background="{TemplateBinding Background}">
                                <ContentPresenter />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--
                The action button, per the handoff: a full pill 52 tall,
                hugging its content with a floor of 148; the icon-and-word
                group sits centred with 16 of air either side and 8 between
                icon and word. The corner radius is half the height, the
                designer's own 26 - which is what the inspector said all
                along, back when the pieces still looked 48 tall.
            -->
            <Style x:Key="ActionButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="52" />
                <Setter Property="MinWidth" Value="148" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="TabNavigation" Value="Local" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid Height="52" MinWidth="148" HorizontalAlignment="Left">
                                <Grid controls:PieceShadow.Mask="ms-appx:///Assets/Shadows/button52.png" />
                                <Border CornerRadius="26"
                                        Background="{ThemeResource PieceFillBrush}"
                                        BorderBrush="{ThemeResource PieceEdgeBrush}"
                                        BorderThickness="5.5">
                                    <ContentPresenter Margin="16,0"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--
                The window's close button: the design's own round, a 32 px
                circle 16 px from the corner, with the thinner 1.75 ring and
                the X drawn rather than glyphed, so its weight is exact and
                it cannot fall back to a missing-glyph box on any machine.
            -->
            <Style x:Key="CloseButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="32" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="TabIndex" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid Width="32" Height="32">
                                <Grid controls:PieceShadow.Mask="ms-appx:///Assets/Shadows/circle32.png" />
                                <Border CornerRadius="16"
                                        Background="{ThemeResource PieceFillBrush}"
                                        BorderBrush="{ThemeResource PieceEdgeBrush}"
                                        BorderThickness="1.75">
                                    <ContentPresenter VerticalAlignment="Center"
                                                      HorizontalAlignment="Center" />
                                </Border>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
