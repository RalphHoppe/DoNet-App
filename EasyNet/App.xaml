<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="EasyNet.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:EasyNet.Controls"
    xmlns:converters="using:EasyNet.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                The design's tokens, every one measured from its SVG. The page
                is plain white; the interactive pieces are white at four
                fifths, edged in a grey so quiet it only says "here is an
                edge", and each is lifted by the one shadow recipe (see
                PieceShadow). The inks are a four-step scale: strong for
                headings, ink for labels and actions, the X's own near-ink,
                and soft for everything secondary.
            -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="PageBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="PieceFillBrush" Color="#CCFFFFFF" />
                    <SolidColorBrush x:Key="PieceEdgeBrush" Color="#33EAE9E9" />
                    <SolidColorBrush x:Key="PieceEdgeFocusedBrush" Color="#66EAE9E9" />
                    <SolidColorBrush x:Key="PieceEdgeInvalidBrush" Color="#4D303138" />
                    <SolidColorBrush x:Key="InkStrongBrush" Color="#303138" />
                    <SolidColorBrush x:Key="InkBrush" Color="#424349" />
                    <SolidColorBrush x:Key="CloseBrush" Color="#494242" />
                    <SolidColorBrush x:Key="InkSoftBrush" Color="#74757A" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!--
                The brand gradient, in the SVGs' own direction: top-right
                amber to bottom-left orange. Elements that need it in their
                own local coordinates (the wordmark's letters) declare their
                own copy; this one is for everything else.
            -->
            <LinearGradientBrush x:Key="BrandBrush" StartPoint="1,0" EndPoint="0,1">
                <GradientStop Color="#FCBD2E" Offset="0" />
                <GradientStop Color="#F26A17" Offset="1" />
            </LinearGradientBrush>

            <!--
                Nunito, per weight, each loaded from its own file so the
                weight never depends on a matcher. The design's type scale,
                measured from its outlined text: headings ExtraBold 25,
                supporting lines Light 14, labels Bold 14, the word and
                buttons Regular/Bold 15.
            -->
            <FontFamily x:Key="LightFont">ms-appx:///Assets/Fonts/Nunito-Light.ttf#Nunito</FontFamily>
            <FontFamily x:Key="TextFont">ms-appx:///Assets/Fonts/Nunito-Regular.ttf#Nunito</FontFamily>
            <FontFamily x:Key="BoldFont">ms-appx:///Assets/Fonts/Nunito-Bold.ttf#Nunito</FontFamily>
            <FontFamily x:Key="ExtraBoldFont">ms-appx:///Assets/Fonts/Nunito-ExtraBold.ttf#Nunito</FontFamily>

            <!--
                A ghost button: no chrome at all, just its content. Used
                where the piece around the button is the visible thing - the
                eye inside its round - so the button itself must be nothing.
            -->
            <Style x:Key="GhostButtonStyle" TargetType="Button">
                <Setter Property="Padding" Value="0" />
                <Setter Property="UseSystemFocusVisuals" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <ContentPresenter />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--
                The action button: a full pill, 48 tall, shadowed by the
                recipe, with its content left-anchored 20 px in - the icon
                first, then 19 px of air, then the word. Its width follows
                its content, floored at the design's 148.
            -->
            <Style x:Key="ActionButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="48" />
                <Setter Property="MinWidth" Value="148" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="TabNavigation" Value="Local" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid Height="48" MinWidth="148" HorizontalAlignment="Left">
                                <Grid controls:PieceShadow.Mask="ms-appx:///Assets/Shadows/button48.png" />
                                <Border CornerRadius="24"
                                        Background="{ThemeResource PieceFillBrush}"
                                        BorderBrush="{ThemeResource PieceEdgeBrush}"
                                        BorderThickness="2.75">
                                    <ContentPresenter Margin="20,0"
                                                      HorizontalAlignment="Left"
                                                      VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--
                The window's close button: the design's own round, a 32 px
                circle 16 px from the corner, with the thinner 1.75 edge and
                the X drawn rather than glyphed, so its weight is exact and
                it cannot fall back to a missing-glyph box on any machine.
            -->
            <Style x:Key="CloseButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="32" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="TabIndex" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid Width="32" Height="32">
                                <Grid controls:PieceShadow.Mask="ms-appx:///Assets/Shadows/circle32.png" />
                                <Border CornerRadius="16"
                                        Background="{ThemeResource PieceFillBrush}"
                                        BorderBrush="{ThemeResource PieceEdgeBrush}"
                                        BorderThickness="1.75">
                                    <ContentPresenter VerticalAlignment="Center"
                                                      HorizontalAlignment="Center" />
                                </Border>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
