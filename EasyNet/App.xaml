<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="EasyNet.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:EasyNet.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                The design's tokens, measured from the mockups and read from the
                SVGs' own stylesheet. Names say what a colour IS, not where it is
                used, so a screen can reach for the right one without knowing the
                others exist.

                Paper    the white the whole app is drawn on
                Ink      the brand's dark, the wordmark's "Easy" and the slabs
                InkSoft  labels and quiet actions - one step lighter than ink
                Title    screen titles - the mockups' measured heading colour
                Meta     subtitles, placeholders, resting icons
                Line     hairlines and tracks, the SVGs' own line token
                Brand    the amber-to-orange gradient, always one direction
            -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="PaperBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="InkBrush" Color="#1D212C" />
                    <SolidColorBrush x:Key="InkSoftBrush" Color="#424349" />
                    <SolidColorBrush x:Key="TitleBrush" Color="#303138" />
                    <SolidColorBrush x:Key="MetaBrush" Color="#74757A" />
                    <SolidColorBrush x:Key="LineBrush" Color="#E2E5EB" />
                    <SolidColorBrush x:Key="CloseBrush" Color="#494242" />
                    <SolidColorBrush x:Key="HoverBrush" Color="#F2F3F5" />
                    <SolidColorBrush x:Key="DangerBrush" Color="#E5484D" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!--
                The brand gradient, in the SVGs' own direction: top-right amber
                to bottom-left orange. Elements that need it in their own local
                coordinates (the wordmark's letters) declare their own copy; this
                one is for everything else.
            -->
            <LinearGradientBrush x:Key="BrandBrush" StartPoint="1,0" EndPoint="0,1">
                <GradientStop Color="#FCBD2E" Offset="0" />
                <GradientStop Color="#F26A17" Offset="1" />
            </LinearGradientBrush>

            <!--
                The UI's type. The wordmark is drawn, not typeset, so this only
                ever speaks for sentences - and the system face is the right one
                for those: it is present everywhere, it renders fast, and it
                never ships a fallback box. Variable falls back to plain on
                Windows 10 by family name.
            -->
            <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
            <FontFamily x:Key="TextFont">Segoe UI Variable Text, Segoe UI</FontFamily>

            <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
